<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DUMP: held by the adb shell, never grantable to ordinary apps, so test scripts can
             drive this receiver but another app on the phone cannot. -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="${applicationId}.DEBUG" />
            </intent-filter>
        </receiver>
        <!-- Screen gallery for design review (debug only); adb shell only, like the receiver. -->
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.P2P" />
    </application>
</manifest>
