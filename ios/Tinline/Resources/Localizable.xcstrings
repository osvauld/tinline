            "value": "Dieses Handy hostet die Gruppe nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone stopped hosting the group."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä puhelin lopetti ryhmän isännöinnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce téléphone n’héberge plus le groupe."
