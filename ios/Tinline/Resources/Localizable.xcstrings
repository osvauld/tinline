    "call_group_about_who": {
      "comment": "Paragraph on the group call details card about who can be a call host.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কল হোস্ট এমন একটি ডিভাইস, যাকে গ্রুপের কোনো অ্যাডমিন বেছে নিয়েছেন এবং যেটি তাতে রাজি হয়েছে। এটা গ্রুপ হোস্ট করা থেকে আলাদা। অ্যাডমিনরা গ্রুপের তথ্য থেকে কল হোস্ট বদলাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Anruf-Host ist ein Gerät, das ein Admin der Gruppe ausgewählt hat und das zugestimmt hat. Das ist getrennt vom Chat-Hosten. Admins können Anruf-Hosts in der Gruppeninfo ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A call host is a device a group admin chose and that agreed to it. It is separate from chat hosting. Admins can change call hosts in Group info."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puheluisäntä on laite, jonka ryhmän ylläpitäjä valitsi ja joka suostui siihen. Se on eri asia kuin keskustelun isännöinti. Ylläpitäjät voivat vaihtaa puheluisäntiä ryhmän tiedoissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un hôte d’appel est un appareil choisi par un admin du groupe et qui a accepté. C’est distinct de l’hébergement du groupe. Les admins peuvent changer d’hôte d’appel dans Infos du groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल होस्ट वह डिवाइस है जिसे ग्रुप के किसी एडमिन ने चुना और जिसने इसे स्वीकार किया। यह ग्रुप होस्टिंग से अलग है। एडमिन ग्रुप की जानकारी में कॉल होस्ट बदल सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഗ്രൂപ്പ് അഡ്മിൻ തിരഞ്ഞെടുക്കുകയും അത് സമ്മതിക്കുകയും ചെയ്ത ഒരു ഉപകരണമാണ് കോൾ ഹോസ്റ്റ്. ഇത് ചാറ്റ് ഹോസ്റ്റിംഗിൽ നിന്ന് വ്യത്യസ്തമാണ്. ഗ്രൂപ്പ് വിവരങ്ങളിൽ അഡ്മിൻമാർക്ക് കോൾ ഹോസ്റ്റുകളെ മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल होस्ट म्हणजे ग्रुपच्या ॲडमिनने निवडलेले आणि ते मान्य केलेले डिव्हाइस. हे चॅट होस्टिंगपेक्षा वेगळे आहे. ॲडमिन ग्रुपच्या माहितीमध्ये कॉल होस्ट बदलू शकतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அழைப்பு ஹோஸ்ட் என்பது குழு நிர்வாகி ஒருவர் தேர்ந்தெடுத்து, அதற்கு ஒப்புக்கொண்ட ஒரு சாதனம். இது குழு ஹோஸ்டிங்கிலிருந்து தனி. குழுத் தகவலில் நிர்வாகிகள் அழைப்பு ஹோஸ்ட்களை மாற்றலாம்."
          }
        }
      }
    },
