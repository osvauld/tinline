        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தொடர்புகள்"
          }
        }
      }
    },
    "onboarding_sync_keep": {
      "comment": "Hint while syncing.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি শেষ না হওয়া পর্যন্ত দুটি ডিভাইসই খোলা আর অনলাইনে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lass beide Geräte geöffnet und online, bis das fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both devices open and online until this finishes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pidä molemmat laitteet auki ja verkossa, kunnes tämä valmistuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gardez les deux appareils ouverts et en ligne jusqu’à la fin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह पूरा होने तक दोनों डिवाइस खुले और ऑनलाइन रखें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് പൂർത്തിയാകുന്നതുവരെ രണ്ട് ഉപകരണങ്ങളും തുറന്ന് ഓൺലൈനിൽ വയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हे पूर्ण होईपर्यंत दोन्ही डिव्हाइस उघडी आणि ऑनलाइन ठेवा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது முடியும் வரை இரண்டு சாதனங்களையும் திறந்து, ஆன்லைனில் வைத்திருங்கள்."
          }
        }
      }
    },
    "onboarding_sync_slow": {
      "comment": "Hint when sync is slow to start.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখনও কিছু আসেনি। অন্য ডিভাইসটি হয়তো অফলাইনে আছে: পরের বার দুটোই অনলাইনে এলে যেখানে থেমেছিল সেখান থেকে আবার শুরু করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch nichts. Das andere Gerät ist vielleicht offline: Es macht dort weiter, wo es aufgehört hat, sobald beide wieder online sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. The other device may be offline: it picks up where it left off the next time both are online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei vielä mitään. Toinen laite ei ehkä ole verkossa: se jatkaa siitä, mihin jäi, kun molemmat ovat seuraavan kerran verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien pour l’instant. L’autre appareil est peut-être hors ligne : il reprendra là où il s’était arrêté la prochaine fois que les deux seront en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी कुछ नहीं आया। हो सकता है दूसरा डिवाइस ऑफ़लाइन हो: अगली बार दोनों के ऑनलाइन होने पर वह वहीं से आगे बढ़ेगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇതുവരെ ഒന്നും എത്തിയില്ല. മറ്റേ ഉപകരണം ഓഫ്‌ലൈനായിരിക്കാം: അടുത്ത തവണ രണ്ടും ഓൺലൈനിലാകുമ്പോൾ നിർത്തിയിടത്തുനിന്ന് തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अजून काहीच नाही. दुसरे डिव्हाइस ऑफलाइन असू शकते: पुढच्या वेळी दोन्ही ऑनलाइन असताना ते जिथे थांबले होते तिथून पुढे सुरू करेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இன்னும் எதுவும் வரவில்லை. மற்றச் சாதனம் ஆஃப்லைனில் இருக்கலாம்: அடுத்த முறை இரண்டும் ஆன்லைனில் இருக்கும்போது விட்ட இடத்திலிருந்து தொடரும்."
          }
        }
      }
    },
    "onboarding_sync_waiting": {
      "comment": "Sync progress value while nothing arrived yet.",
