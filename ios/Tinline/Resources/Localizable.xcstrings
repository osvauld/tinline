    "devices_only_device": {
      "comment": "Warning card in the remove-account dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শুধু এই ডিভাইসেই আপনার অ্যাকাউন্ট আছে। রিকভারি শব্দ ছাড়া এটা আর ফিরিয়ে আনা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist das einzige Gerät mit deinem Konto. Ohne deine Wiederherstellungswörter lässt es sich nicht zurückholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only device with your account. Without your recovery phrase nothing can bring it back."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä on ainoa laite, jolla tilisi on. Ilman palautussanojasi mikään ei voi tuoda sitä takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C’est le seul appareil qui a votre compte. Sans vos mots de récupération, rien ne peut le faire revenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता सिर्फ़ इसी डिवाइस पर है। आपके रिकवरी शब्दों के बिना इसे कोई वापस नहीं ला सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ടുള്ള ഒരേയൊരു ഉപകരണം ഇതാണ്. വീണ്ടെടുക്കൽ വാക്കുകളില്ലാതെ അത് തിരികെ കൊണ്ടുവരാൻ ഒരു വഴിയുമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते असलेले हे एकमेव डिव्हाइस आहे. तुमच्या रिकव्हरी शब्दांशिवाय ते परत आणता येणार नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு உள்ள ஒரே சாதனம் இதுதான். உங்கள் மீட்பு வார்த்தைகள் இல்லாமல் அதை எதுவும் திரும்பக் கொண்டு வர முடியாது."
          }
        }
      }
    },
    "devices_others_keep": {
      "comment": "Line in the remove-account dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অন্য ডিভাইসগুলোতে সবকিছু থেকে যাবে।"
          }
