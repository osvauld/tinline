    },
    "onboarding_opt_restore_sub": {
      "comment": "Description of the restore option.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার %1$@টি রিকভারি শব্দ টাইপ করুন। এই ফোনে পরিচিতির তালিকা খালি থেকে শুরু হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tipp deine %1$@ Wiederherstellungswörter ein. Dieses Handy startet mit einer leeren Kontaktliste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your %1$@ recovery words. This phone starts with an empty contact list."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirjoita %1$@ palautussanaasi. Tämä puhelin aloittaa tyhjällä yhteystietolistalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez vos %1$@ mots de récupération. Ce téléphone démarre avec une liste de contacts vide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने %1$@ रिकवरी शब्द टाइप करें। यह फ़ोन खाली संपर्क सूची से शुरू होगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ %1$@ വീണ്ടെടുക്കൽ വാക്കുകൾ ടൈപ്പ് ചെയ്യുക. ഈ ഫോൺ ഒഴിഞ്ഞ കോൺടാക്റ്റ് ലിസ്റ്റോടെയാണ് തുടങ്ങുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे %1$@ रिकव्हरी शब्द टाइप करा. हा फोन रिकाम्या संपर्क यादीने सुरू होतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் %1$@ மீட்பு வார்த்தைகளைத் தட்டச்சு செய்யுங்கள். இந்த ஃபோன் காலியான தொடர்புப் பட்டியலுடன் தொடங்கும்."
          }
        }
      }
    },
