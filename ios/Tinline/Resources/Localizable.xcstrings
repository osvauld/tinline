    "people_profile_link_note": {
      "comment": "Note in that dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা Tinline-এর বাইরে, আপনার ব্রাউজারে খুলবে। Tinline এটা আপনার জন্য লোড করে না, আর সেখানে কী আছে তার দায়িত্ব নিতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er öffnet sich in deinem Browser, außerhalb von Tinline. Tinline lädt ihn nicht für dich und kann nicht für den Inhalt einstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It opens in your browser, outside Tinline. Tinline doesn’t load it for you, and can’t vouch for what’s there."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se avautuu selaimessasi Tinlinen ulkopuolella. Tinline ei lataa sitä puolestasi eikä voi taata, mitä siellä on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il s’ouvre dans votre navigateur, en dehors de Tinline. Tinline ne le charge pas pour vous et ne peut pas garantir son contenu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह Tinline के बाहर आपके ब्राउज़र में खुलेगा। Tinline इसे आपके लिए लोड नहीं करता, और वहाँ क्या है इसकी गारंटी नहीं दे सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് Tinline-നു പുറത്ത്, നിങ്ങളുടെ ബ്രൗസറിൽ തുറക്കും. Tinline ഇത് നിങ്ങൾക്കായി ലോഡ് ചെയ്യുന്നില്ല, അവിടെ എന്താണെന്ന് ഉറപ്പുനൽകാനും കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ती Tinline बाहेर तुमच्या ब्राउझरमध्ये उघडते. Tinline ती तुमच्यासाठी लोड करत नाही, आणि तिथे काय आहे याची हमी देऊ शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது Tinline-க்கு வெளியே, உங்கள் உலாவியில் திறக்கும். Tinline இதை உங்களுக்காக ஏற்றுவதில்லை, அங்கே உள்ளவற்றுக்கு உத்தரவாதம் தர முடியாது."
          }
        }
      }
    },
