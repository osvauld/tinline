        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇതുവരെ കോൾ ഹോസ്റ്റ് ഇല്ല: ഗ്രൂപ്പ് വിവരങ്ങളിൽ ഒരു അഡ്മിന് ഒരാളെ നിയമിക്കാം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अजून कॉल होस्ट नाही: ॲडमिन ग्रुपच्या माहितीमध्ये तो नेमू शकतात"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இன்னும் அழைப்பு ஹோஸ்ட் இல்லை: குழுத் தகவலில் நிர்வாகி ஒருவரை நியமிக்கலாம்"
