    "group_removed_footer": {
      "comment": "Footer of a group chat after the user was removed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনাকে সরানো হয়েছে, তাই এই গ্রুপে আর মেসেজ পাঠাতে পারবেন না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du wurdest entfernt und kannst dieser Gruppe keine Nachrichten mehr senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were removed and can’t send messages to this group."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinut poistettiin, etkä voi lähettää viestejä tähän ryhmään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez été retiré de ce groupe et ne pouvez plus y envoyer de messages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपको हटा दिया गया है, इसलिए आप इस ग्रुप में संदेश नहीं भेज सकते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളെ നീക്കം ചെയ്തതിനാൽ ഈ ഗ്രൂപ്പിലേക്ക് സന്ദേശങ്ങൾ അയയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्हाला काढून टाकले आहे, त्यामुळे तुम्ही या ग्रुपला संदेश पाठवू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் நீக்கப்பட்டதால், இந்தக் குழுவுக்குச் செய்திகளை அனுப்ப முடியாது."
          }
        }
      }
    },
