          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കോഡുകൾ ഒന്നുതന്നെയാണോ?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड जुळतात का?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குறியீடுகள் பொருந்துகின்றனவா?"
          }
        }
      }
    },
    "link_match_warn": {
      "comment": "Warning under the six digits.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নিজে মিলিয়ে দেখুন। না মিললে, হয়তো অন্য কেউ আগে কোডটি স্ক্যান করেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergleiche sie selbst. Wenn sie abweichen, hat vielleicht jemand anderes den Code zuerst gescannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare them yourself. If they differ, someone else may have scanned the code first."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaa niitä itse. Jos ne eroavat, joku muu on ehkä skannannut koodin ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comparez-les vous-même. S’ils diffèrent, quelqu’un d’autre a peut-être scanné le code avant vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "खुद मिलाकर देखें। अगर अलग हैं, तो हो सकता है किसी और ने पहले कोड स्कैन कर लिया हो।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അവ നിങ്ങൾ തന്നെ ഒത്തുനോക്കുക. വ്യത്യസ്തമാണെങ്കിൽ, മറ്റാരെങ്കിലും ആദ്യം കോഡ് സ്കാൻ ചെയ്തിരിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वतः तुलना करून पहा. ते वेगळे असतील, तर दुसऱ्या कोणीतरी आधी कोड स्कॅन केला असू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்களே ஒப்பிட்டுப் பாருங்கள். அவை வேறுபட்டால், வேறு யாராவது முதலில் குறியீட்டை ஸ்கேன் செய்திருக்கலாம்."
          }
        }
      }
    },
