    "devices_remove_account": {
      "comment": "Reason shown in the screen lock prompt, and the button label.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোন থেকে অ্যাকাউন্ট সরান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konto von diesem Handy entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove account from this phone"
          }
        },
        "fi": {
          "stringUnit": {
