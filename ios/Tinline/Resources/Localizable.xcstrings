    "security_open_failed": {
      "comment": "Error when the recovery backup could not be opened.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ব্যাকআপ খোলা গেল না। আবার চেষ্টা করুন।"
          }
