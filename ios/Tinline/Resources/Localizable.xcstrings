    "people_save_failed": {
      "comment": "Profile save failed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা সেভ করা গেল না। আপনার প্রোফাইল বদলায়নি, আর আপনি যা লিখেছেন তা এখনও এখানে আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ließ sich nicht speichern. Dein Profil ist unverändert, und was du getippt hast, ist noch da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save that. Your profile is unchanged and what you typed is still here."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tallennus ei onnistunut. Profiilisi on ennallaan, ja kirjoittamasi teksti on yhä tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’enregistrer. Votre profil n’a pas changé et ce que vous avez saisi est toujours là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह सहेजा नहीं जा सका। आपकी प्रोफ़ाइल पहले जैसी है और आपने जो लिखा था वह यहीं है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അത് സേവ് ചെയ്യാൻ കഴിഞ്ഞില്ല. നിങ്ങളുടെ പ്രൊഫൈലിന് മാറ്റമില്ല, നിങ്ങൾ ടൈപ്പ് ചെയ്തത് ഇവിടെത്തന്നെയുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते जतन करता आले नाही. तुमचे प्रोफाइल बदललेले नाही आणि तुम्ही टाइप केलेले अजून इथेच आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அதைச் சேமிக்க முடியவில்லை. உங்கள் சுயவிவரம் மாறவில்லை, நீங்கள் தட்டச்சு செய்தது இங்கேயே உள்ளது."
          }
        }
      }
    },
    "people_save_picture_failed": {
      "comment": "Profile picture could not be saved.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ছবি সেভ করা গেল না। আপনার এখনকার ছবি যেমন ছিল তেমনই আছে।"
