        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist zu lang. Jede Angabe darf bis zu %1$@ groß sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is too long. Each piece of information can be up to %1$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä on liian pitkä. Kukin tieto voi olla enintään %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C’est trop long. Chaque information peut faire jusqu’à %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह बहुत लंबा है। हर जानकारी %1$@ तक हो सकती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് വളരെ നീളമുള്ളതാണ്. ഓരോ വിവരവും പരമാവധി %1$@ വരെയാകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हे खूप मोठे आहे. प्रत्येक माहिती जास्तीत जास्त %1$@ असू शकते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது மிக நீளம். ஒவ்வொரு தகவலும் %1$@ வரை இருக்கலாம்."
          }
        }
      }
    },
