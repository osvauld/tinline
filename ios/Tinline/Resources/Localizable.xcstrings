    "onboarding_perm_notif_why": {
      "comment": "Why Tinline asks for notifications.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit du eingehende Anrufe und Nachrichten siehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you see incoming calls and messages."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta näet saapuvat puhelut ja viestit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour voir les appels et messages entrants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ताकि आपको आने वाली कॉल और संदेश दिखें।"
          }
        }
      }
    },
    "onboarding_perms_lead": {
      "comment": "Explanation on the permissions screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline funktioniert wie eine Telefonleitung: Sie bleibt still im Hintergrund offen. Alles hier ist optional, und du kannst es später ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline works like a phone line: it stays open quietly in the background. Each of these is optional, and you can change them later."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline toimii kuin puhelinlinja: se pysyy hiljaa auki taustalla. Jokainen näistä on valinnainen, ja voit muuttaa niitä myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline fonctionne comme une ligne téléphonique : elle reste ouverte discrètement en arrière-plan. Chacune de ces autorisations est facultative, et vous pourrez les changer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline एक फ़ोन लाइन की तरह काम करता है: यह बैकग्राउंड में चुपचाप खुला रहता है। इनमें से कोई भी ज़रूरी नहीं है, और आप इन्हें बाद में बदल सकते हैं।"
          }
        }
      }
    },
    "onboarding_perms_title": {
      "comment": "Title of the permissions screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit Anrufe dich erreichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So calls can reach you"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta puhelut tavoittavat sinut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour que les appels vous parviennent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ताकि कॉल आप तक पहुँच सकें"
          }
        }
      }
    },
    "onboarding_rec_lead_key": {
      "comment": "Explanation when showing the recovery key; the line break is intended.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Wiederherstellungsschlüssel entspricht deinen %1$@ Wörtern, nur in einer Zeile.\nFüg ihn an einem sicheren Ort ein. Ein Passwortmanager eignet sich gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery key is the same as your %1$@ words, as one line.\nPaste it somewhere safe. A password manager works great."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palautusavaimesi on sama kuin %1$@ sanaasi, yhtenä rivinä.\nLiitä se johonkin turvalliseen paikkaan. Salasanojen hallintasovellus sopii hyvin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre clé de récupération équivaut à vos %1$@ mots, en une seule ligne.\nCollez-la dans un endroit sûr. Un gestionnaire de mots de passe convient très bien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी रिकवरी कुंजी आपके %1$@ शब्द ही हैं, एक लाइन में।\nइसे किसी सुरक्षित जगह पेस्ट करें। पासवर्ड मैनेजर बढ़िया रहता है।"
          }
        }
      }
    },
    "onboarding_rec_lead_words": {
      "comment": "Explanation when showing the recovery words; the line break is intended.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du mal das Gerät wechselst, bringen diese %1$@ Wörter dein Konto mit.\nSpeichere eine Kopie an einem sicheren Ort. Papier eignet sich gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you ever switch devices, these %1$@ words bring your account along.\nSave a copy somewhere safe. Paper works great."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jos joskus vaihdat laitetta, nämä %1$@ sanaa tuovat tilisi mukaan.\nTallenna kopio turvalliseen paikkaan. Paperi toimii hyvin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si vous changez un jour d’appareil, ces %1$@ mots emportent votre compte avec vous.\nGardez-en une copie en lieu sûr. Le papier, c’est très bien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर आप कभी डिवाइस बदलें, तो ये %1$@ शब्द आपका खाता साथ ले आते हैं।\nइनकी एक कॉपी किसी सुरक्षित जगह रखें। कागज़ बढ़िया रहता है।"
          }
        }
      }
    },
    "onboarding_rec_title_key": {
      "comment": "Title when showing the recovery key.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hier ist dein Wiederherstellungsschlüssel"
          }
