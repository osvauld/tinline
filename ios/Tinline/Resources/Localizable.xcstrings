    "link_unlinked_lead": {
      "comment": "Explanation after this phone was unlinked by another device; {name} is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অন্য একটি ডিভাইস এই ফোন থেকে %1$@ সরিয়ে দিয়েছে। এর পরিচিতি, চ্যাট আর কল এখান থেকে মুছে গেছে। আপনার অন্য ডিভাইসগুলোতে কোনো প্রভাব পড়েনি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eines deiner anderen Geräte hat %1$@ von diesem Handy entfernt. Kontakte, Chats und Anrufe des Kontos wurden hier gelöscht. Deine anderen Geräte sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was removed from this phone by one of your other devices. Its contacts, chats and calls are deleted here. Your other devices are not affected."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksi muista laitteistasi poisti tältä puhelimelta tilin %1$@. Sen yhteystiedot, keskustelut ja puhelut on poistettu täältä. Muihin laitteisiisi tämä ei vaikuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ a été retiré de ce téléphone par l’un de vos autres appareils. Ses contacts, discussions et appels sont supprimés ici. Vos autres appareils ne sont pas concernés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके किसी दूसरे डिवाइस ने इस फ़ोन से %1$@ हटा दिया। इसके संपर्क, चैट और कॉल यहाँ से मिटा दिए गए हैं। आपके दूसरे डिवाइस पर इसका कोई असर नहीं है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ മറ്റൊരു ഉപകരണം ഈ ഫോണിൽ നിന്ന് %1$@ എന്ന അക്കൗണ്ട് നീക്കം ചെയ്തു. അതിന്റെ കോൺടാക്റ്റുകളും ചാറ്റുകളും കോളുകളും ഇവിടെ നിന്ന് ഇല്ലാതാക്കി. നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളെ ഇത് ബാധിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या इतर डिव्हाइसपैकी एकाने %1$@ हे खाते या फोनवरून काढले. त्याचे संपर्क, चॅट आणि कॉल इथून हटवले आहेत. तुमच्या इतर डिव्हाइसवर याचा काहीही परिणाम होत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் மற்ற சாதனங்களில் ஒன்று இந்த ஃபோனிலிருந்து %1$@ கணக்கை அகற்றியது. அதன் தொடர்புகள், அரட்டைகள், அழைப்புகள் இங்கே நீக்கப்பட்டன. உங்கள் மற்ற சாதனங்கள் பாதிக்கப்படவில்லை."
          }
        }
      }
    },
    "link_unlinked_lead_unnamed": {
      "comment": "Explanation after this phone was unlinked by another device, when the account has no name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অন্য একটি ডিভাইস এই ফোন থেকে আপনার অ্যাকাউন্ট সরিয়ে দিয়েছে। এর পরিচিতি, চ্যাট আর কল এখান থেকে মুছে গেছে। আপনার অন্য ডিভাইসগুলোতে কোনো প্রভাব পড়েনি।"
