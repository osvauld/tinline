    "restore_key_typo": {
      "comment": "Error when the pasted recovery key fails its checksum.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই রিকভারি কী-তে টাইপের ভুল আছে, বা এটি পুরোটা কপি হয়নি। যেখানে সেভ করেছিলেন, সেখান থেকে আবার পেস্ট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In diesem Schlüssel steckt ein Tippfehler, oder er ist abgeschnitten. Füg ihn nochmal aus deiner gespeicherten Kopie ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That key has a typo or is cut short. Paste it again from where you saved it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaimessa on kirjoitusvirhe tai se on katkennut. Liitä se uudelleen sieltä, minne tallensit sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette clé contient une faute de frappe ou est incomplète. Collez-la à nouveau depuis l’endroit où vous l’avez enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस कुंजी में टाइपिंग की गलती है या यह अधूरी है। जहाँ आपने इसे सहेजा था, वहाँ से फिर से पेस्ट करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ കീയിൽ ഒരു അക്ഷരത്തെറ്റുണ്ട്, അല്ലെങ്കിൽ അത് മുറിഞ്ഞുപോയി. സേവ് ചെയ്ത ഇടത്തുനിന്ന് വീണ്ടും പേസ്റ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्या कीमध्ये टायपिंगची चूक आहे किंवा ती अपूर्ण आहे. तुम्ही जिथे जतन केली आहे तिथून ती पुन्हा पेस्ट करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்த விசையில் எழுத்துப் பிழை உள்ளது, அல்லது அது முழுமையாக இல்லை. நீங்கள் சேமித்த இடத்திலிருந்து அதை மீண்டும் ஒட்டுங்கள்."
          }
        }
      }
    },
    "restore_lead_key": {
      "comment": "Intro on the restore screen once a recovery key was pasted.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার রিকভারি কী বসানো হয়েছে। এটা এই ফোনেই থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Wiederherstellungsschlüssel ist drin. Er bleibt auf diesem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery key is in. It stays on this phone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palautusavaimesi on syötetty. Se pysyy tällä puhelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre clé de récupération est saisie. Elle reste sur ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी रिकवरी कुंजी आ गई है। यह इसी फ़ोन पर रहती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ വീണ്ടെടുക്കൽ കീ ചേർത്തു. അത് ഈ ഫോണിൽ മാത്രം നിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमची रिकव्हरी की टाकली आहे. ती या फोनवरच राहते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் மீட்பு விசை உள்ளிடப்பட்டது. அது இந்த ஃபோனிலேயே இருக்கும்."
          }
        }
      }
    },
    "restore_lead_words": {
      "comment": "Intro on the restore screen before a key is pasted.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার %1$@টি শব্দ ক্রম অনুযায়ী টাইপ করুন, অথবা সেগুলো বা আপনার রিকভারি কী প্রথম ঘরে পেস্ট করুন। এগুলো এই ফোনেই থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tipp deine %1$@ Wörter der Reihe nach ein, oder füge sie oder deinen Wiederherstellungsschlüssel ins erste Feld ein. Sie bleiben auf diesem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your %1$@ words in order, or paste them, or your recovery key, into the first box. They stay on this phone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirjoita %1$@ sanaasi järjestyksessä tai liitä ne tai palautusavaimesi ensimmäiseen kenttään. Ne pysyvät tällä puhelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez vos %1$@ mots dans l’ordre, ou collez-les, ou votre clé de récupération, dans la première case. Ils restent sur ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने %1$@ शब्द क्रम से टाइप करें, या पहले बॉक्स में शब्द या अपनी रिकवरी कुंजी पेस्ट करें। ये इसी फ़ोन पर रहते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ %1$@ വാക്കുകൾ ക്രമത്തിൽ ടൈപ്പ് ചെയ്യുക, അല്ലെങ്കിൽ അവയോ നിങ്ങളുടെ വീണ്ടെടുക്കൽ കീയോ ആദ്യത്തെ ബോക്സിൽ പേസ്റ്റ് ചെയ്യുക. അവ ഈ ഫോണിൽ മാത്രം നിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे %1$@ शब्द क्रमाने टाइप करा, किंवा पहिल्या बॉक्समध्ये शब्द किंवा तुमची रिकव्हरी की पेस्ट करा. ते या फोनवरच राहतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் %1$@ வார்த்தைகளை வரிசையாகத் தட்டச்சு செய்யுங்கள், அல்லது அவற்றை அல்லது உங்கள் மீட்பு விசையை முதல் பெட்டியில் ஒட்டுங்கள். அவை இந்த ஃபோனிலேயே இருக்கும்."
          }
        }
      }
    },
