    "onboarding_linked_lead": {
      "comment": "Explanation after linking; {name} is the other device's name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার পরিচিতি আর চ্যাট %1$@ থেকে আসছে, আর দুটিতেই মিলিয়ে রাখা হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kontakte und Chats kommen von %1$@ und bleiben auf beiden Geräten synchron."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts and chats are arriving from %1$@ and will keep in step on both."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteystietosi ja keskustelusi saapuvat laitteelta %1$@ ja pysyvät ajan tasalla molemmissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts et discussions arrivent depuis %1$@ et resteront synchronisés sur les deux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके संपर्क और चैट %1$@ से आ रहे हैं और दोनों पर एक जैसे बने रहेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ കോൺടാക്റ്റുകളും ചാറ്റുകളും %1$@ എന്ന ഉപകരണത്തിൽ നിന്ന് എത്തിക്കൊണ്ടിരിക്കുന്നു, രണ്ടിലും അവ ഒരുപോലെ നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे संपर्क आणि चॅट %1$@ वरून येत आहेत आणि दोन्हीकडे जुळलेले राहतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் தொடர்புகளும் அரட்டைகளும் %1$@ சாதனத்திலிருந்து வந்துகொண்டிருக்கின்றன, இரண்டிலும் ஒத்திசைவாக இருக்கும்."
          }
        }
      }
    },
    "onboarding_linked_lead_unnamed": {
      "comment": "Explanation after linking when the other device has no name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার পরিচিতি আর চ্যাট আপনার অন্য ডিভাইস থেকে আসছে, আর দুটিতেই মিলিয়ে রাখা হবে।"
          }
