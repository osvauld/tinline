    "group_done_invite_one": {
      "comment": "Toast after inviting one contact. {name} is the invited person's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-কে আমন্ত্রণ পাঠানো হয়েছে। গ্রহণ করলেই উনি যোগ দেবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einladung an %1$@ gesendet. Die Person tritt bei, wenn sie annimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation sent to %1$@. They join when they accept."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kutsu lähetetty: %1$@. Hän liittyy hyväksyessään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invitation envoyée à %1$@. Cette personne rejoindra le groupe en acceptant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ को आमंत्रण भेज दिया। स्वीकार करते ही वे जुड़ जाएँगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാൾക്ക് ക്ഷണം അയച്ചു. സ്വീകരിക്കുമ്പോൾ അവർ ചേരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला आमंत्रण पाठवले. त्यांनी स्वीकारल्यावर ते सामील होतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களுக்கு அழைப்பிதழ் அனுப்பப்பட்டது. அவர் ஏற்றுக்கொண்டதும் சேர்வார்."
          }
        }
      }
    },
