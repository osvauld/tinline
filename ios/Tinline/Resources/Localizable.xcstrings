        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "और जगह खाली करने के लिए उनकी चैट से फ़ोटो या फ़ाइलें हटाएँ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കൂടുതൽ സ്ഥലം ഒഴിവാക്കാൻ, അതത് ചാറ്റുകളിൽ നിന്ന് ഫോട്ടോകളോ ഫയലുകളോ നീക്കം ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अधिक जागा मोकळी करण्यासाठी, फोटो किंवा फाइल त्यांच्या चॅटमधून काढा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மேலும் இடத்தைக் காலியாக்க, படங்களையோ கோப்புகளையோ அவற்றின் அரட்டையிலிருந்து அகற்றுங்கள்."
          }
        }
      }
