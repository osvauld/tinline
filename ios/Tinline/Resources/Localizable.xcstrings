    "group_request_accept_note": {
      "comment": "Chat request card note. {name} is their first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রহণ করলে %1$@ শুধু মেসেজের জন্য আপনার পরিচিতিতে যুক্ত হবেন। কল পরে চালু করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du annimmst, wird %1$@ als Kontakt nur für Nachrichten hinzugefügt. Anrufe kannst du später erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting adds %1$@ as a contact for messages only. You can allow calls later."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksyminen lisää henkilön %1$@ yhteystiedoksi vain viestejä varten. Voit sallia puhelut myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accepter ajoute %1$@ comme contact pour les messages uniquement. Vous pourrez autoriser les appels plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकार करने पर %1$@ को सिर्फ़ संदेशों के लिए संपर्क में जोड़ा जाएगा। कॉल की अनुमति आप बाद में दे सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സ്വീകരിച്ചാൽ %1$@ സന്ദേശങ്ങൾക്ക് മാത്രമുള്ള കോൺടാക്റ്റായി ചേരും. കോളുകൾ പിന്നീട് അനുവദിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकारल्यावर %1$@ ला फक्त संदेशांसाठी संपर्क म्हणून जोडले जाईल. कॉलची परवानगी तुम्ही नंतर देऊ शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஏற்றுக்கொண்டால், %1$@ செய்திகளுக்கு மட்டுமான தொடர்பாகச் சேர்க்கப்படுவார். அழைப்புகளைப் பிறகு அனுமதிக்கலாம்."
          }
        }
      }
    },
    "group_request_accept_note_unnamed": {
      "comment": "Note on a chat request card when the requester's name is not known.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রহণ করলে ওঁকে শুধু মেসেজের জন্য আপনার পরিচিতিতে যোগ করা হবে। কল পরে চালু করতে পারবেন।"
