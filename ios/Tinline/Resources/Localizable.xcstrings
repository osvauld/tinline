          "stringUnit": {
            "state": "needs_review",
            "value": "Linkitä toinen laitteeni"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Associer mon autre appareil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मेरा दूसरा डिवाइस लिंक करें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "എന്റെ മറ്റൊരു ഉപകരണം ലിങ്ക് ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "माझे दुसरे डिव्हाइस लिंक करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "என் மற்றொரு சாதனத்துடன் இணை"
          }
        }
      }
    },
    "onboarding_opt_link_sub": {
      "comment": "Description of the link option.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যে ডিভাইসে আপনার অ্যাকাউন্ট আগে থেকেই আছে, তাতে একটি কোড স্ক্যান করুন। আপনার পরিচিতি আর চ্যাট সঙ্গে চলে আসবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanne einen Code auf einem Gerät, das dein Konto schon hat. Deine Kontakte und Chats kommen mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a code on a device that already has your account. Your contacts and chats come along."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skannaa koodi laitteella, jolla tilisi jo on. Yhteystietosi ja keskustelusi tulevat mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez un code sur un appareil qui a déjà votre compte. Vos contacts et vos discussions suivent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जिस डिवाइस पर आपका खाता पहले से है, उस पर दिखा कोड स्कैन करें। आपके संपर्क और चैट साथ आ जाएँगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് ഇതിനകമുള്ള ഒരു ഉപകരണത്തിലെ കോഡ് സ്കാൻ ചെയ്യുക. നിങ്ങളുടെ കോൺടാക്റ്റുകളും ചാറ്റുകളും ഒപ്പം വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते आधीपासून असलेल्या डिव्हाइसवरचा कोड स्कॅन करा. तुमचे संपर्क आणि चॅट सोबत येतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு ஏற்கெனவே உள்ள சாதனத்தில் ஒரு குறியீட்டை ஸ்கேன் செய்யுங்கள். உங்கள் தொடர்புகளும் அரட்டைகளும் கூடவே வரும்."
          }
        }
      }
    },
    "onboarding_opt_restore": {
      "comment": "Option on the Use your account here screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আমার অ্যাকাউন্ট ফিরিয়ে আনুন"
          }
        },
        "de": {
          "stringUnit": {
