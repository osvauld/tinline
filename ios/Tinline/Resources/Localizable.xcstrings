{
  "sourceLanguage": "en",
  "strings": {
    "call_about_encrypted_lead": {
      "comment": "Bold first words of the encryption explanation on the call details card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted."
          }
        }
      }
    },
    "call_about_encrypted_video": {
      "comment": "Rest of the encryption explanation on a video call. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice and picture are encrypted on this device and only decrypted on %1$@’s."
          }
        }
      }
    },
    "call_about_encrypted_voice": {
      "comment": "Rest of the encryption explanation on a voice call. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice is encrypted on this device and only decrypted on %1$@’s."
          }
        }
      }
    },
    "call_about_headline_direct": {
      "comment": "Bold headline on the call details card. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signal · Direct"
          }
        }
      }
    },
    "call_about_headline_reconnecting": {
      "comment": "Bold headline on the call details card while reconnecting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting"
          }
        }
      }
    },
    "call_about_headline_relayed": {
      "comment": "Bold headline on the call details card. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signal · Relayed"
          }
        }
      }
    },
    "call_about_line_direct": {
      "comment": "Explanation for a direct connection. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your call goes straight between your device and %1$@’s."
          }
        }
      }
    },
    "call_about_line_reconnecting": {
      "comment": "Explanation while reconnecting. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped for a moment. Tinline is finding a way back to %1$@."
          }
        }
      }
    },
    "call_about_line_relayed_video": {
      "comment": "Explanation for a relayed video call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices can’t reach each other directly right now, so a relay passes the call along. It can’t listen or watch."
          }
        }
      }
    },
    "call_about_line_relayed_voice": {
      "comment": "Explanation for a relayed voice call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices can’t reach each other directly right now, so a relay passes the call along. It can’t listen."
          }
        }
      }
    },
    "call_about_line_weak": {
      "comment": "Extra sentence appended when the signal is weak. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line is weak, so %1$@’s voice may break up."
          }
        }
      }
    },
    "call_about_reconnecting": {
      "comment": "Accessibility label of the info button while reconnecting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this call. Reconnecting."
          }
        }
      }
    },
    "call_about_signal_direct": {
      "comment": "Accessibility label of the info button. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this call. %1$@ signal, direct."
          }
        }
      }
    },
    "call_about_signal_relayed": {
      "comment": "Accessibility label of the info button. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this call. %1$@ signal, relayed."
          }
        }
      }
    },
    "call_about_stats": {
      "comment": "Network numbers on the call details card. {rtt} is round-trip time in milliseconds, {loss} is the percentage of lost packets.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ms round trip · %2$@%% lost"
          }
        }
      }
    },
    "call_about_their_video": {
      "comment": "Row label on the call details card for the codec the contact sends.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their video"
          }
        }
      }
    },
    "call_about_title": {
      "comment": "Title of the call details card, and accessibility label of the info button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this call"
          }
        }
      }
    },
    "call_about_your_video": {
      "comment": "Row label on the call details card for the codec my camera sends.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video"
          }
        }
      }
    },
    "call_answer": {
      "comment": "Button and accessibility label that answers an incoming call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer"
          }
        }
      }
    },
    "call_answer_with_video": {
      "comment": "Accessibility description of the Video answer button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer with video"
          }
        }
      }
    },
    "call_auto_close": {
      "comment": "Hint on the call-ended screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes by itself after 4 seconds."
          }
        }
      }
    },
    "call_back_continues": {
      "comment": "Accessibility label of the Back button on the call screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back. The call continues"
          }
        }
      }
    },
    "call_badge_direct": {
      "comment": "Badge on the call-ended screen: the call went straight between the phones.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct"
          }
        }
      }
    },
    "call_badge_relayed": {
      "comment": "Badge on the call-ended screen: the call went through a relay.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayed"
          }
        }
      }
    },
    "call_badge_signal": {
      "comment": "Badge on the call-ended screen. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signal"
          }
        }
      }
    },
    "call_call_again": {
      "comment": "Button on the call-ended screen that calls the contact again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call again"
          }
        }
      }
    },
    "call_camera_off": {
      "comment": "Shown on a video call when the contact's camera is off. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@’s camera is off"
          }
        }
      }
    },
    "call_camera_permission_needed": {
      "comment": "Problem line when camera permission is denied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera permission needed - they can still hear you"
          }
        }
      }
    },
    "call_camera_unavailable": {
      "comment": "Problem line when the camera could not be started.",
