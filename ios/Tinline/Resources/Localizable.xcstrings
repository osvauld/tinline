    "devices_unlink_body": {
      "comment": "Body of the unlink dialog.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es hört auf abzugleichen und klingelt nicht mehr bei deinen Anrufen. Wenn es online ist, entfernt es dein Konto von sich selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stops syncing and stops ringing for your calls. If it’s online, it removes your account from itself."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se lopettaa synkronoinnin eikä enää soi puheluillesi. Jos se on verkossa, se poistaa tilisi itseltään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il cesse de se synchroniser et de sonner pour vos appels. S’il est en ligne, il retire lui-même votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह सिंक होना और आपकी कॉल पर घंटी बजना बंद कर देगा। अगर यह ऑनलाइन है, तो यह आपका खाता अपने यहाँ से हटा देगा।"
          }
        }
      }
    },
