        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**%1$@** உங்கள் கணக்கில் சேர விரும்புகிறது. அது கீழே உள்ள அதே ஆறு இலக்கங்களைக் காட்ட வேண்டும்."
          }
        }
      }
    },
    "link_match_body_unnamed": {
      "comment": "Body when comparing codes and the new device has no name. The words **The new device** are bold (markdown stars, keep them around them).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**নতুন ডিভাইসটি** আপনার অ্যাকাউন্টে যোগ দিতে চায়। সেখানে নিচের মতোই ছয়টি সংখ্যা দেখানোর কথা।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Das neue Gerät** möchte deinem Konto beitreten. Es sollte dieselben sechs Ziffern zeigen wie unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**The new device** wants to join your account. It should be showing the same six digits as below."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Uusi laite** haluaa liittyä tiliisi. Sen pitäisi näyttää samat kuusi numeroa kuin alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Le nouvel appareil** veut rejoindre votre compte. Il devrait afficher les six mêmes chiffres que ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**नया डिवाइस** आपके खाते से जुड़ना चाहता है। उस पर नीचे जैसे ही छह अंक दिखने चाहिए।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**പുതിയ ഉപകരണം** നിങ്ങളുടെ അക്കൗണ്ടിൽ ചേരാൻ ആഗ്രഹിക്കുന്നു. അതിൽ താഴെയുള്ള അതേ ആറ് അക്കങ്ങൾ കാണിക്കുന്നുണ്ടാകണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**नवीन डिव्हाइसला** तुमच्या खात्यात सामील व्हायचे आहे. त्यावर खाली दिलेलेच सहा अंक दिसायला हवेत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**புதிய சாதனம்** உங்கள் கணக்கில் சேர விரும்புகிறது. அது கீழே உள்ள அதே ஆறு இலக்கங்களைக் காட்ட வேண்டும்."
          }
        }
      }
    },
    "link_match_title": {
      "comment": "Heading when the user compares codes.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোড দুটো কি মিলছে?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stimmen die Codes überein?"
