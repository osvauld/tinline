        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप इसे कभी भी सेटिंग में बदल सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ക്രമീകരണത്തിൽ എപ്പോൾ വേണമെങ്കിലും ഇത് മാറ്റാം."
