        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ के डिवाइस के स्वीकार करने का इंतज़ार"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാളുടെ ഉപകരണം സ്വീകരിക്കാനായി കാത്തിരിക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ चे डिव्हाइस स्वीकारण्याची वाट पाहत आहे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களின் சாதனம் ஏற்பதற்குக் காத்திருக்கிறது"
          }
        }
      }
    },
    "group_member_cant_receive": {
      "comment": "Sub line. {name} is the first name of the member.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ আপনার কাছ থেকে অনুরোধ পেতে পারবেন না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ kann keine Anfragen von dir empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can’t receive requests from you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ei voi vastaanottaa pyyntöjäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ne peut pas recevoir vos demandes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ तक आपके अनुरोध नहीं पहुँच सकते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാൾക്ക് നിങ്ങളിൽ നിന്ന് അഭ്യർത്ഥനകൾ ലഭിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला तुमच्याकडून विनंत्या मिळू शकत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களால் உங்களிடமிருந்து கோரிக்கைகளைப் பெற முடியாது."
          }
        }
      }
    },
    "group_member_declined_last": {
      "comment": "Sub line. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ আপনার শেষ অনুরোধটি ফিরিয়ে দিয়েছেন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ hat deine letzte Anfrage abgelehnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ declined your last request"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ hylkäsi viimeisimmän pyyntösi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ a refusé votre dernière demande"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने आपका पिछला अनुरोध अस्वीकार किया"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ നിങ്ങളുടെ കഴിഞ്ഞ അഭ്യർത്ഥന നിരസിച്ചു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने तुमची मागची विनंती नाकारली"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கடைசிக் கோரிக்கையை %1$@ நிராகரித்தார்"
          }
        }
      }
    },
    "group_member_desc_admin": {
      "comment": "Spoken description of a member row for a screen reader. {name} is the member's name (with “(you)” after it when it is the user). The member is admin.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, অ্যাডমিন। অপশনগুলো খুলুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, Admin. Aktionen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, admin. Open actions"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, ylläpitäjä. Avaa toiminnot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, admin. Ouvrir les actions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, एडमिन। विकल्प खोलें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, അഡ്മിൻ. പ്രവർത്തനങ്ങൾ തുറക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, ॲडमिन. पर्याय उघडा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, நிர்வாகி. செயல்களைத் திற"
          }
        }
      }
    },
    "group_member_desc_admin_callhost": {
      "comment": "Spoken description of a member row for a screen reader. {name} is the member's name (with “(you)” after it when it is the user). The member is admin and call host.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, অ্যাডমিন ও কল হোস্ট। অপশনগুলো খুলুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, Admin und Anruf-Host. Aktionen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, admin and call host. Open actions"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, ylläpitäjä ja puheluisäntä. Avaa toiminnot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, admin et hôte d’appel. Ouvrir les actions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, एडमिन और कॉल होस्ट। विकल्प खोलें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, അഡ്മിനും കോൾ ഹോസ്റ്റും. പ്രവർത്തനങ്ങൾ തുറക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, ॲडमिन आणि कॉल होस्ट. पर्याय उघडा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, நிர்வாகி, அழைப்பு ஹோஸ்ட். செயல்களைத் திற"
          }
        }
      }
    },
