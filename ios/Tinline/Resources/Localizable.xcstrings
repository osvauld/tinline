    "settings_perms_note": {
      "comment": "Note under the permission rows.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এগুলো আপনার সিস্টেম সেট করে, Tinline নয়। দরকার হলেই শুধু Tinline অনুমতি চায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese legt dein System fest, nicht Tinline. Tinline fragt nur, wenn es eine braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are set by your system, not by Tinline. Tinline asks only when it needs one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nämä asettaa järjestelmäsi, ei Tinline. Tinline kysyy vain, kun tarvitsee jotain niistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces autorisations sont gérées par votre système, pas par Tinline. Tinline ne les demande que lorsqu’il en a besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ये आपके सिस्टम में सेट होते हैं, Tinline में नहीं। Tinline तभी पूछता है जब उसे इनमें से किसी की ज़रूरत हो।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇവ സജ്ജീകരിക്കുന്നത് Tinline അല്ല, നിങ്ങളുടെ സിസ്റ്റമാണ്. ആവശ്യമുള്ളപ്പോൾ മാത്രമേ Tinline ചോദിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या परवानग्या Tinline नाही, तर तुमची सिस्टम सेट करते. Tinline ला गरज असेल तेव्हाच ते विचारते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இவை Tinline-ஆல் அல்ல, உங்கள் சிஸ்டத்தால் அமைக்கப்படுகின்றன. தேவைப்படும்போது மட்டுமே Tinline கேட்கும்."
          }
        }
      }
    },
    "settings_privacy_note": {
      "comment": "Note under the privacy rows.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার পরিচিতিরা আপনার নাম, ছবি আর প্রোফাইল দেখতে পান। আপনি কার সঙ্গে কথা বলেন, Tinline তা লুকায় না, আর আপনার অ্যাকাউন্টে লিঙ্ক করা প্রতিটি ডিভাইস আপনার চ্যাট পড়তে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kontakte sehen deinen Namen, dein Bild und dein Profil. Tinline verbirgt nicht, mit wem du sprichst, und jedes Gerät, das mit deinem Konto verknüpft ist, kann deine Chats lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts see your name, picture and profile. Tinline doesn’t hide who you talk to, and every device linked to your account can read your chats."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteystietosi näkevät nimesi, kuvasi ja profiilisi. Tinline ei piilota, kenen kanssa puhut, ja jokainen tiliisi linkitetty laite voi lukea keskustelusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts voient votre nom, votre photo et votre profil. Tinline ne cache pas avec qui vous parlez, et chaque appareil associé à votre compte peut lire vos discussions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके संपर्क आपका नाम, फ़ोटो और प्रोफ़ाइल देखते हैं। Tinline यह नहीं छिपाता कि आप किससे बात करते हैं, और आपके खाते से लिंक किया हर डिवाइस आपकी चैट पढ़ सकता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ കോൺടാക്റ്റുകൾക്ക് നിങ്ങളുടെ പേരും ഫോട്ടോയും പ്രൊഫൈലും കാണാം. നിങ്ങൾ ആരോടാണ് സംസാരിക്കുന്നതെന്ന് Tinline മറയ്ക്കുന്നില്ല, നിങ്ങളുടെ അക്കൗണ്ടിലേക്ക് ലിങ്ക് ചെയ്ത ഓരോ ഉപകരണത്തിനും നിങ്ങളുടെ ചാറ്റുകൾ വായിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या संपर्कांना तुमचे नाव, फोटो आणि प्रोफाइल दिसते. तुम्ही कोणाशी बोलता हे Tinline लपवत नाही, आणि तुमच्या खात्याशी लिंक केलेले प्रत्येक डिव्हाइस तुमच्या चॅट वाचू शकते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் பெயர், படம், சுயவிவரம் ஆகியவற்றை உங்கள் தொடர்புகள் பார்க்கிறார்கள். நீங்கள் யாருடன் பேசுகிறீர்கள் என்பதை Tinline மறைப்பதில்லை, உங்கள் கணக்குடன் இணைக்கப்பட்ட ஒவ்வொரு சாதனமும் உங்கள் அரட்டைகளைப் படிக்க முடியும்."
          }
        }
      }
    },
