    "people_field_help": {
      "comment": "Explains who sees profile information.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kontakte sehen dein Profil. Entfernte Angaben verschwinden aus deinem Profil; frühere Versionen können im synchronisierten Verlauf bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts can see your profile. Removing information hides it from your profile; earlier versions can remain in synced history."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteystietosi näkevät profiilisi. Tiedon poistaminen piilottaa sen profiilistasi; aiemmat versiot voivat jäädä synkronoituun historiaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts peuvent voir votre profil. Retirer une information la masque de votre profil ; des versions précédentes peuvent rester dans l’historique synchronisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके संपर्क आपकी प्रोफ़ाइल देख सकते हैं। जानकारी हटाने पर वह आपकी प्रोफ़ाइल से छिप जाती है; पुराने संस्करण सिंक किए गए इतिहास में रह सकते हैं।"
          }
        }
      }
    },
