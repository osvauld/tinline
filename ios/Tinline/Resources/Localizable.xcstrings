    "group_removal_text": {
      "comment": "Explanation on the removal page.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Beiträge, die schon auf diesem Gerät sind, behältst du und kannst sie lesen. Posten kannst du nicht mehr, und die Hosts der Gruppe nehmen nichts mehr von dir an. Die Entfernung ist endgültig: Um zurückzukommen, muss dich ein Admin neu einladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You keep the posts already on this device, and you can read them. You can’t post, and the group’s hosts no longer accept anything from you. Removal is final: to come back, an admin has to invite you again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tällä laitteella jo olevat viestit säilyvät, ja voit lukea niitä. Et voi kirjoittaa, eivätkä ryhmän isäntälaitteet enää ota sinulta vastaan mitään. Poisto on lopullinen: palataksesi tarvitset uuden kutsun ylläpitäjältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous gardez les publications déjà présentes sur cet appareil, et vous pouvez les lire. Vous ne pouvez plus publier, et les hôtes du groupe n’acceptent plus rien de votre part. Le retrait est définitif : pour revenir, un admin doit vous inviter à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जो पोस्ट पहले से इस डिवाइस पर हैं, वे आपके पास रहेंगी और आप उन्हें पढ़ सकते हैं। आप पोस्ट नहीं कर सकते, और ग्रुप के होस्ट अब आपसे कुछ स्वीकार नहीं करते। ग्रुप से हटाना स्थायी है: वापस आने के लिए किसी एडमिन को आपको फिर से आमंत्रित करना होगा।"
          }
        }
      }
    },
    "group_removal_title": {
