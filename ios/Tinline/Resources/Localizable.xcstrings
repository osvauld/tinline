    "restore_key_typo": {
      "comment": "Error when the pasted recovery key fails its checksum.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In diesem Schlüssel steckt ein Tippfehler, oder er ist abgeschnitten. Füg ihn nochmal aus deiner gespeicherten Kopie ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That key has a typo or is cut short. Paste it again from where you saved it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaimessa on kirjoitusvirhe tai se on katkennut. Liitä se uudelleen sieltä, minne tallensit sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette clé contient une faute de frappe ou est incomplète. Collez-la à nouveau depuis l’endroit où vous l’avez enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस कुंजी में टाइपिंग की गलती है या यह अधूरी है। जहाँ आपने इसे सहेजा था, वहाँ से फिर से पेस्ट करें।"
          }
        }
      }
    },
    "restore_lead_key": {
