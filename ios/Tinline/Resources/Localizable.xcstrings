        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**%1$@** आपके खाते से जुड़ना चाहता है। उस पर नीचे जैसे ही छह अंक दिखने चाहिए।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**%1$@** നിങ്ങളുടെ അക്കൗണ്ടിൽ ചേരാൻ ആഗ്രഹിക്കുന്നു. അതിൽ താഴെയുള്ള അതേ ആറ് അക്കങ്ങൾ കാണിക്കുന്നുണ്ടാകണം."
          }
