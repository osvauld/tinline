    "group_add_hint": {
      "comment": "Hint under the contact picker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Person bekommt die Einladung in eurem 1:1-Chat und tritt bei, wenn sie annimmt. Sie gilt 7 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person gets the invitation in your 1:1 chat, and joins when they accept. It is valid for 7 days."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokainen saa kutsun teidän kahdenkeskisessä keskustelussanne ja liittyy, kun hyväksyy sen. Kutsu on voimassa 7 päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque personne reçoit l’invitation dans votre discussion privée, et rejoint quand elle accepte. Elle est valable 7 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर व्यक्ति को आमंत्रण आपकी 1:1 चैट में मिलता है, और स्वीकार करने पर वे जुड़ जाते हैं। यह 7 दिन तक मान्य है।"
          }
        }
      }
    },
