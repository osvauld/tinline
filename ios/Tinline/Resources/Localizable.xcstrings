    "shell_contacts_request_sent": {
      "comment": "Line under a contact request the user sent. {name} is the person’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অনুরোধ পাঠানো হয়েছে। %1$@ গ্রহণ করলেই আপনার লাইন খুলে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
