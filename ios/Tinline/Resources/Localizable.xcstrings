    "onboarding_choose_lead": {
      "comment": "Explanation under the Use your account here title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto steckt in seinen Wiederherstellungswörtern, also kannst du es auf zwei Wegen auf dieses Handy holen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is its recovery phrase, so you can bring it to this phone two ways."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi on sen palautussanat, joten voit tuoda sen tälle puhelimelle kahdella tavalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte, ce sont ses mots de récupération : vous pouvez donc le retrouver sur ce téléphone de deux façons."
          }
        },
        "hi": {
