    "group_join_bad": {
      "comment": "Hint when the invite link did not work.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লিঙ্কটি কাজ করেনি: এটা গ্রুপের আমন্ত্রণ নয়, মেয়াদ শেষ হয়ে গেছে, অথবা এর হোস্ট অফলাইনে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Link hat nicht funktioniert: Er ist keine Gruppeneinladung, ist abgelaufen oder sein Host ist offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That link didn’t work: it isn’t a group invite, it expired, or its host is offline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkki ei toiminut: se ei ole ryhmäkutsu, se on vanhentunut tai sen isäntälaite ei ole verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce lien n’a pas marché : ce n’est pas une invitation de groupe, elle a expiré, ou son hôte est hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस लिंक ने काम नहीं किया: यह ग्रुप आमंत्रण नहीं है, इसकी समय-सीमा खत्म हो गई है, या इसका होस्ट ऑफ़लाइन है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ ലിങ്ക് പ്രവർത്തിച്ചില്ല: ഇത് ഗ്രൂപ്പ് ക്ഷണമല്ല, അല്ലെങ്കിൽ കാലാവധി കഴിഞ്ഞു, അല്ലെങ്കിൽ അതിന്റെ ഹോസ്റ്റ് ഓഫ്‌ലൈനാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ती लिंक चालली नाही: ती ग्रुप आमंत्रण नाही, तिची मुदत संपली आहे, किंवा तिचा होस्ट ऑफलाइन आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்த இணைப்பு வேலை செய்யவில்லை: அது குழு அழைப்பிதழ் அல்ல, காலாவதியாகிவிட்டது, அல்லது அதன் ஹோஸ்ட் ஆஃப்லைனில் உள்ளது."
          }
        }
      }
    },
    "group_join_checking": {
      "comment": "Hint while the invite is being checked.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
