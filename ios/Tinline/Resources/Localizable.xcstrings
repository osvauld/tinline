    "people_field_help": {
      "comment": "Explains who sees profile information.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার পরিচিতিরা আপনার প্রোফাইল দেখতে পান। কোনো তথ্য সরালে সেটা প্রোফাইল থেকে লুকিয়ে যায়; আগের সংস্করণ সিঙ্ক করা ইতিহাসে থেকে যেতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kontakte sehen dein Profil. Entfernte Angaben verschwinden aus deinem Profil; frühere Versionen können im synchronisierten Verlauf bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts can see your profile. Removing information hides it from your profile; earlier versions can remain in synced history."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteystietosi näkevät profiilisi. Tiedon poistaminen piilottaa sen profiilistasi; aiemmat versiot voivat jäädä synkronoituun historiaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts peuvent voir votre profil. Retirer une information la masque de votre profil ; des versions précédentes peuvent rester dans l’historique synchronisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके संपर्क आपकी प्रोफ़ाइल देख सकते हैं। जानकारी हटाने पर वह आपकी प्रोफ़ाइल से छिप जाती है; पुराने संस्करण सिंक किए गए इतिहास में रह सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ കോൺടാക്റ്റുകൾക്ക് നിങ്ങളുടെ പ്രൊഫൈൽ കാണാം. ഒരു വിവരം നീക്കം ചെയ്താൽ അത് പ്രൊഫൈലിൽ നിന്ന് മറയും; മുമ്പത്തെ പതിപ്പുകൾ സിങ്ക് ചെയ്ത ചരിത്രത്തിൽ ശേഷിച്ചേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या संपर्कांना तुमचे प्रोफाइल दिसते. माहिती काढल्यावर ती तुमच्या प्रोफाइलवरून लपते; आधीच्या आवृत्त्या सिंक झालेल्या इतिहासात राहू शकतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் சுயவிவரத்தை உங்கள் தொடர்புகள் பார்க்க முடியும். தகவலை அகற்றினால் அது உங்கள் சுயவிவரத்திலிருந்து மறையும்; முந்தைய பதிப்புகள் ஒத்திசைக்கப்பட்ட வரலாற்றில் இருக்கக்கூடும்."
          }
        }
      }
    },
