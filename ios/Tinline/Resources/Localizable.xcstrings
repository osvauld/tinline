    "shell_empty_pick": {
      "comment": "Home hero line with several contacts.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাঁকে খুশি বেছে নিয়ে যখন খুশি হ্যালো বলুন।"
