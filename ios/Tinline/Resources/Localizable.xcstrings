    "call_unreachable_body": {
      "comment": "Explanation when a call could not connect. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ হয়তো অফলাইনে, নেটওয়ার্কের বাইরে, বা এখন কল ধরছেন না। Tinline-এ মেসেজ রেখে যাওয়ার ব্যবস্থা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ist vielleicht offline, ohne Empfang oder nimmt gerade keine Anrufe an. Tinline kann keine Nachrichten hinterlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ may be offline, out of signal, or not taking calls right now. Tinline can’t leave messages."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ei ehkä ole verkossa tai kuuluvuusalueella, tai hän ei ota puheluita vastaan juuri nyt. Tinline ei voi jättää viestejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ est peut-être hors ligne, sans réseau, ou ne prend pas d’appels en ce moment. Tinline ne peut pas laisser de message."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हो सकता है %1$@ ऑफ़लाइन हों, सिग्नल न हो, या अभी कॉल न ले रहे हों। Tinline में संदेश छोड़ने की सुविधा नहीं है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ഓഫ്‌ലൈനായിരിക്കാം, സിഗ്നൽ ഇല്ലാത്തിടത്തായിരിക്കാം, അല്ലെങ്കിൽ ഇപ്പോൾ കോളുകൾ എടുക്കുന്നില്ലായിരിക്കാം. Tinline-ന് സന്ദേശങ്ങൾ ഇട്ടുവയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कदाचित %1$@ ऑफलाइन आहे, नेटवर्कच्या बाहेर आहे, किंवा आत्ता कॉल घेत नाही. Tinline वर निरोप ठेवता येत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ஆஃப்லைனில் இருக்கலாம், சிக்னல் இல்லாமல் இருக்கலாம், அல்லது இப்போது அழைப்புகளை ஏற்காமல் இருக்கலாம். Tinline-ஆல் செய்திகளை விட்டுச் செல்ல முடியாது."
          }
        }
      }
    },
    "call_unreachable_body_blank": {
      "comment": "Explanation when a call could not connect and the contact has no name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "উনি হয়তো অফলাইনে, নেটওয়ার্কের বাইরে, বা এখন কল ধরছেন না। Tinline-এ মেসেজ রেখে যাওয়ার ব্যবস্থা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Person ist vielleicht offline, ohne Empfang oder nimmt gerade keine Anrufe an. Tinline kann keine Nachrichten hinterlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They may be offline, out of signal, or not taking calls right now. Tinline can’t leave messages."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hän ei ehkä ole verkossa tai kuuluvuusalueella, tai hän ei ota puheluita vastaan juuri nyt. Tinline ei voi jättää viestejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette personne est peut-être hors ligne, sans réseau, ou ne prend pas d’appels en ce moment. Tinline ne peut pas laisser de message."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हो सकता है वे ऑफ़लाइन हों, सिग्नल न हो, या अभी कॉल न ले रहे हों। Tinline में संदेश छोड़ने की सुविधा नहीं है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അവർ ഓഫ്‌ലൈനായിരിക്കാം, സിഗ്നൽ ഇല്ലാത്തിടത്തായിരിക്കാം, അല്ലെങ്കിൽ ഇപ്പോൾ കോളുകൾ എടുക്കുന്നില്ലായിരിക്കാം. Tinline-ന് സന്ദേശങ്ങൾ ഇട്ടുവയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कदाचित ते ऑफलाइन आहेत, नेटवर्कच्या बाहेर आहेत, किंवा आत्ता कॉल घेत नाहीत. Tinline वर निरोप ठेवता येत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அவர் ஆஃப்லைனில் இருக்கலாம், சிக்னல் இல்லாமல் இருக்கலாம், அல்லது இப்போது அழைப்புகளை ஏற்காமல் இருக்கலாம். Tinline-ஆல் செய்திகளை விட்டுச் செல்ல முடியாது."
          }
        }
      }
    },
