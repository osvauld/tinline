          }
        }
      }
    },
    "settings_video_note": {
      "comment": "Note under the video quality switch.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রতিটি ভিডিও কল এভাবেই শুরু হয়। কলের সময় শুধু সেই কলের জন্য বদলাতে HD-তে ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Videoanruf startet so. Tippe während eines Anrufs auf HD, um es für diesen Anruf zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every video call starts this way. During a call, tap HD to change it for that call."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokainen videopuhelu alkaa näin. Puhelun aikana voit muuttaa sitä kyseiselle puhelulle napauttamalla HD."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque appel vidéo démarre ainsi. Pendant un appel, touchez HD pour changer cela pour cet appel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर वीडियो कॉल ऐसे ही शुरू होती है। कॉल के दौरान उस कॉल के लिए बदलने को HD पर टैप करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഓരോ വീഡിയോ കോളും ഇങ്ങനെയാണ് തുടങ്ങുക. കോളിനിടയിൽ ആ കോളിനു മാത്രം മാറ്റാൻ HD ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रत्येक व्हिडिओ कॉल असाच सुरू होतो. कॉलदरम्यान, फक्त त्या कॉलसाठी बदलायला HD वर टॅप करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒவ்வொரு வீடியோ அழைப்பும் இப்படியே தொடங்கும். அழைப்பின்போது, அந்த அழைப்புக்கு மட்டும் மாற்ற HD-ஐத் தட்டுங்கள்."
          }
        }
      }
    },
