    "link_same_code_lead": {
      "comment": "Explanation under Same code on both? {name} is the other device's name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-এ এই কোডটাই দেখাচ্ছে কি না দেখে নিন, তারপর সেখানে অনুমোদন দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe, ob %1$@ diesen Code zeigt, und bestätige dann dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that %1$@ shows this code, then approve there."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarkista, että %1$@ näyttää tämän koodin, ja hyväksy siellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez que %1$@ affiche ce code, puis validez là-bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "देखें कि %1$@ पर यही कोड दिख रहा है, फिर वहाँ मंज़ूरी दें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ഈ കോഡ് തന്നെയാണ് കാണിക്കുന്നതെന്ന് ഉറപ്പാക്കുക, എന്നിട്ട് അവിടെ അംഗീകരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ वर हाच कोड दिसतो आहे का ते तपासा, मग तिथे मंजुरी द्या."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ இந்தக் குறியீட்டைக் காட்டுகிறதா என்று சரிபார்த்து, பிறகு அங்கே அனுமதியுங்கள்."
          }
        }
      }
    },
    "link_same_code_lead_unnamed": {
      "comment": "Explanation under Same code on both? Used when the other device has no name; says your other device.",
