          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जवाब दें"
          }
        }
      }
    },
    "call_answer_with_video": {
      "comment": "Accessibility description of the Video answer button.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit Video annehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer with video"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vastaa videolla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Répondre en vidéo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वीडियो के साथ जवाब दें"
          }
        }
      }
    },
    "call_auto_close": {
      "comment": "Hint on the call-ended screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schließt sich nach 4 Sekunden von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes by itself after 4 seconds."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sulkeutuu itsestään 4 sekunnin kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ferme tout seul après 4 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "4 सेकंड बाद अपने-आप बंद हो जाता है।"
          }
        }
      }
    },
    "call_back_continues": {
      "comment": "Accessibility label of the Back button on the call screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zurück. Der Anruf läuft weiter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back. The call continues"
          }
        },
        "fi": {
          "stringUnit": {
