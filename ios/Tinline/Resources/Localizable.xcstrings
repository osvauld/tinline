            "value": "इस फ़ोन पर कॉल होस्ट करें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫോണിൽ കോളുകൾ ഹോസ്റ്റ് ചെയ്യുക"
