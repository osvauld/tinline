    "people_detail_allow_blocked": {
      "comment": "Contact page: note under Allow calls when the contact is blocked.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ব্লক করা: আনব্লক না করা পর্যন্ত কিছুই আসবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blockiert: Nichts kommt durch, bis du die Blockierung aufhebst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked: nothing gets through until you unblock."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estetty: mitään ei tule perille, ennen kuin poistat eston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqué : rien ne passe tant que vous ne débloquez pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ब्लॉक है: अनब्लॉक करने तक कुछ भी नहीं आएगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ബ്ലോക്ക് ചെയ്തു: നിങ്ങൾ അൺബ്ലോക്ക് ചെയ്യുന്നതുവരെ ഒന്നും എത്തില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ब्लॉक केले आहे: तुम्ही अनब्लॉक करेपर्यंत काहीही येत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தடுக்கப்பட்டுள்ளது: நீங்கள் தடையை நீக்கும் வரை எதுவும் வராது."
          }
        }
      }
    },
    "people_detail_allow_calls": {
