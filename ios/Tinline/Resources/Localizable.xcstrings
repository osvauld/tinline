    "settings_video_hd_auto": {
      "comment": "Subtitle of Sharper video when off.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কানেকশন ভালো হলে নিজে থেকেই HD-তে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wechselt von selbst auf HD, wenn die Verbindung es zulässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes HD by itself when the connection allows."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siirtyy itse HD-laatuun, kun yhteys sallii."
          }
        },
        "fr": {
          "stringUnit": {
