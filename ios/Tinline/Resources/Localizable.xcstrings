    "people_add_why_blocked": {
      "comment": "Preview note when the found person is blocked. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast %1$@ blockiert. Heb die Blockierung unter Privatsphäre auf, bevor du die Person wieder hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You blocked %1$@. Unblock them in Privacy before adding them again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estit henkilön %1$@. Poista esto Yksityisyys-asetuksista ennen kuin lisäät hänet uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez bloqué %1$@. Débloquez cette personne dans Confidentialité avant de l’ajouter à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने %1$@ को ब्लॉक किया है। फिर से जोड़ने से पहले प्राइवेसी में जाकर उन्हें अनब्लॉक करें।"
          }
        }
      }
    },
    "people_add_why_blocked_by": {
      "comment": "Preview note when the person blocked the user. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst %1$@ gerade nicht hinzufügen. Die Person möchte hier keinen Kontakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add %1$@ right now. They’ve chosen not to be in touch here."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et voi lisätä henkilöä %1$@ juuri nyt. Hän on päättänyt olla pitämättä yhteyttä täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne pouvez pas ajouter %1$@ pour le moment. Cette personne a choisi de ne pas être en contact ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप अभी %1$@ को नहीं जोड़ सकते। उन्होंने यहाँ संपर्क में न रहना चुना है।"
          }
        }
      }
    },
    "people_add_why_confirm": {
      "comment": "Preview note before adding. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
