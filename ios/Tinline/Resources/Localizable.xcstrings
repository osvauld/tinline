    "people_add_why_added": {
      "comment": "Preview note after adding. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-এর সঙ্গে আপনার লাইন খোলা। হ্যালো বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Leitung zu %1$@ ist offen. Sag Hallo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your line to %1$@ is open. Say hello."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linjasi henkilöön %1$@ on auki. Sano hei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre ligne avec %1$@ est ouverte. Dites bonjour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ तक आपकी लाइन खुली है। नमस्ते कहें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാളിലേക്കുള്ള നിങ്ങളുടെ ലൈൻ തുറന്നിരിക്കുന്നു. ഒരു ഹലോ പറയൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ पर्यंत तुमची लाइन खुली आहे. नमस्कार म्हणा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களுடனான உங்கள் லைன் திறந்திருக்கிறது. வணக்கம் சொல்லுங்கள்."
          }
        }
      }
    },
    "people_add_why_blocked": {
      "comment": "Preview note when the found person is blocked. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি %1$@-কে ব্লক করেছেন। আবার যোগ করার আগে প্রাইভেসি থেকে আনব্লক করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast %1$@ blockiert. Heb die Blockierung unter Privatsphäre auf, bevor du die Person wieder hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You blocked %1$@. Unblock them in Privacy before adding them again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estit henkilön %1$@. Poista esto Yksityisyys-asetuksista ennen kuin lisäät hänet uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez bloqué %1$@. Débloquez cette personne dans Confidentialité avant de l’ajouter à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने %1$@ को ब्लॉक किया है। फिर से जोड़ने से पहले प्राइवेसी में जाकर उन्हें अनब्लॉक करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ %1$@ എന്നയാളെ ബ്ലോക്ക് ചെയ്തിട്ടുണ്ട്. വീണ്ടും ചേർക്കുന്നതിനു മുമ്പ് സ്വകാര്യതയിൽ ചെന്ന് അൺബ്ലോക്ക് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही %1$@ ला ब्लॉक केले आहे. पुन्हा जोडण्यापूर्वी गोपनीयता मध्ये जाऊन त्यांना अनब्लॉक करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களை நீங்கள் தடுத்துள்ளீர்கள். மீண்டும் சேர்க்கும் முன், தனியுரிமையில் தடையை நீக்குங்கள்."
          }
        }
      }
    },
    "people_add_why_blocked_by": {
      "comment": "Preview note when the person blocked the user. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখন আপনি %1$@-কে যোগ করতে পারবেন না। উনি এখানে যোগাযোগ না রাখার সিদ্ধান্ত নিয়েছেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst %1$@ gerade nicht hinzufügen. Die Person möchte hier keinen Kontakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add %1$@ right now. They’ve chosen not to be in touch here."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et voi lisätä henkilöä %1$@ juuri nyt. Hän on päättänyt olla pitämättä yhteyttä täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne pouvez pas ajouter %1$@ pour le moment. Cette personne a choisi de ne pas être en contact ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप अभी %1$@ को नहीं जोड़ सकते। उन्होंने यहाँ संपर्क में न रहना चुना है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇപ്പോൾ %1$@ എന്നയാളെ ചേർക്കാൻ കഴിയില്ല. ഇവിടെ ബന്ധപ്പെടേണ്ടതില്ലെന്ന് അവർ തീരുമാനിച്ചിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही आत्ता %1$@ ला जोडू शकत नाही. त्यांनी इथे संपर्कात न राहण्याचे ठरवले आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இப்போது %1$@ அவர்களைச் சேர்க்க முடியாது. இங்கே தொடர்பில் இருக்க வேண்டாம் என்று அவர்கள் தேர்ந்தெடுத்துள்ளனர்."
          }
        }
      }
    },
    "people_add_why_confirm": {
      "comment": "Preview note before adding. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ইনিই কি %1$@? নিশ্চিত না হলে আগে ওঁর সঙ্গে কথা বলে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ist das %1$@? Wenn du unsicher bist, frag lieber erst nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is this %1$@? If you’re not sure, check with them first."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onko tämä %1$@? Jos et ole varma, tarkista asia häneltä ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Est-ce bien %1$@ ? Si vous avez un doute, vérifiez d’abord auprès de cette personne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्या ये %1$@ हैं? अगर पक्का नहीं है, तो पहले उनसे पूछ लें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് %1$@ തന്നെയാണോ? ഉറപ്പില്ലെങ്കിൽ, ആദ്യം അവരോട് ചോദിച്ച് ഉറപ്പാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ही व्यक्ती %1$@ आहे का? खात्री नसेल, तर आधी त्यांच्याशी बोलून खात्री करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இவர் %1$@ தானா? உறுதியாகத் தெரியாவிட்டால், முதலில் அவரிடமே கேட்டு உறுதிசெய்யுங்கள்."
          }
        }
      }
    },
