    "onboarding_nickname_hint": {
      "comment": "Hint under the nickname field.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সেটিংসে গিয়ে যেকোনো সময় এটা বদলাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
