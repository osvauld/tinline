    "people_rule_status_long": {
      "comment": "Profile check: the status is too long. {limit} is the byte limit.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "স্ট্যাটাসের জন্য এটা খুব লম্বা: %1$@ বাইট পর্যন্ত চলবে, আর কিছু অক্ষর একাধিক বাইট নেয়।"
