            "value": "এই ছবিটিতে এত খুঁটিনাটি যে সেভ করা যাচ্ছে না। অন্য একটি ছবি দিয়ে দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Bild ist zu detailreich zum Speichern. Versuch ein anderes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That picture is too detailed to save. Try a different one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvassa on liikaa yksityiskohtia tallennettavaksi. Kokeile toista kuvaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette image est trop détaillée pour être enregistrée. Essayez-en une autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह फ़ोटो सहेजने के लिए बहुत भारी है। कोई दूसरी फ़ोटो आज़माएँ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ ഫോട്ടോയിൽ സേവ് ചെയ്യാനാകാത്തത്ര വിശദാംശങ്ങളുണ്ട്. മറ്റൊന്ന് ശ്രമിച്ചുനോക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तो फोटो जतन करण्यासाठी खूप तपशीलवार आहे. दुसरा फोटो वापरून पहा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்தப் படத்தில் சேமிக்க முடியாத அளவுக்கு விவரங்கள் அதிகம். வேறொன்றை முயலுங்கள்."
          }
        }
      }
    },
