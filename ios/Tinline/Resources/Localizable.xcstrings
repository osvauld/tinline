    "chat_viewer_not_text": {
      "comment": "Shown in the file viewer when a file is not text.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা টেক্সট ফাইল বলে মনে হচ্ছে না। অন্য অ্যাপে খুলতে এটা সেভ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das sieht nicht nach einer Textdatei aus. Speichere sie, um sie in einer anderen App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This doesn’t look like a text file. Save it to open it in another app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä ei näytä tekstitiedostolta. Tallenna se avataksesi sen toisella sovelluksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier ne semble pas être un fichier texte. Enregistrez-le pour l’ouvrir dans une autre app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह टेक्स्ट फ़ाइल नहीं लगती। किसी दूसरे ऐप में खोलने के लिए इसे सहेजें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് ഒരു ടെക്സ്റ്റ് ഫയലായി തോന്നുന്നില്ല. മറ്റൊരു ആപ്പിൽ തുറക്കാൻ ഇത് സേവ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ही मजकूर फाइल दिसत नाही. दुसऱ्या ॲपमध्ये उघडण्यासाठी ती जतन करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது உரைக் கோப்பாகத் தெரியவில்லை. வேறு ஆப்பில் திறக்க அதைச் சேமியுங்கள்."
          }
        }
      }
    },
