        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisää joku, jonka kanssa haluat puhua, niin voitte lähettää viestejä ja soittaa toisillenne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez quelqu’un avec qui vous aimeriez parler, et vous pourrez vous écrire et vous appeler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी ऐसे व्यक्ति को जोड़ें जिससे आप बात करना चाहते हैं, फिर आप एक-दूसरे को संदेश और कॉल कर सकेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ സംസാരിക്കാൻ ആഗ്രഹിക്കുന്ന ഒരാളെ ചേർക്കുക, പിന്നെ നിങ്ങൾക്ക് പരസ്പരം സന്ദേശം അയയ്ക്കാനും വിളിക്കാനും കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ज्यांच्याशी बोलायला आवडेल त्यांना जोडा, मग तुम्ही एकमेकांना संदेश आणि कॉल करू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் பேச விரும்பும் ஒருவரைச் சேருங்கள், பிறகு நீங்கள் இருவரும் செய்தி அனுப்பலாம், அழைக்கலாம்."
          }
        }
      }
    },
