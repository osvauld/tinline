    "group_callhosts_this_phone": {
      "comment": "Status line when this phone is the call host.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি যে কল শুরু করেন, এই ফোন সেগুলো চালায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Handy trägt die Anrufe, die du startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone carries the calls you start."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä puhelin välittää aloittamasi puhelut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce téléphone héberge les appels que vous lancez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी शुरू की गई कॉल यह फ़ोन चलाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ആരംഭിക്കുന്ന കോളുകൾ ഈ ഫോൺ വഴിയാണ് നടക്കുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही सुरू केलेले कॉल हा फोन चालवतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் தொடங்கும் அழைப்புகளை இந்த ஃபோன் நடத்தும்."
          }
        }
      }
    },
    "group_callhosts_title": {
      "comment": "Section heading for call hosts on group info.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কল হোস্ট"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anruf-Hosts"
          }
        },
        "en": {
