        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഗ്രൂപ്പിന്റെ ഹോസ്റ്റ് വഴി ചാറ്റ് അഭ്യർത്ഥന അയയ്ക്കുന്നു"
