    "onboarding_choose_lead": {
      "comment": "Explanation under the Use your account here title.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অ্যাকাউন্ট মানেই তার রিকভারি শব্দ, তাই দুইভাবে এটা এই ফোনে আনতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto steckt in seinen Wiederherstellungswörtern, also kannst du es auf zwei Wegen auf dieses Handy holen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is its recovery phrase, so you can bring it to this phone two ways."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi on sen palautussanat, joten voit tuoda sen tälle puhelimelle kahdella tavalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte, ce sont ses mots de récupération : vous pouvez donc le retrouver sur ce téléphone de deux façons."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता उसके रिकवरी शब्दों में है, इसलिए आप इसे इस फ़ोन पर दो तरह से ला सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് എന്നാൽ അതിന്റെ വീണ്ടെടുക്കൽ വാക്കുകളാണ്, അതിനാൽ രണ്ട് വഴികളിൽ ഇത് ഈ ഫോണിലേക്ക് കൊണ്ടുവരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते म्हणजेच त्याचे रिकव्हरी शब्द, त्यामुळे तुम्ही ते या फोनवर दोन प्रकारे आणू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு என்பதே அதன் மீட்பு வார்த்தைகள், எனவே அதை இந்த ஃபோனுக்கு இரண்டு வழிகளில் கொண்டு வரலாம்."
          }
        }
      }
    },
