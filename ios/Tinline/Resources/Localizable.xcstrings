    "chat_sheet_hint": {
      "comment": "Hint at the bottom of the message sheet. {first} is the other person's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পরের বার আপনারা দুজনেই অনলাইনে থাকলে এডিট আর মোছা %1$@-এর ফোনে পৌঁছাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen und Löschungen erreichen das Handy von %1$@, wenn ihr das nächste Mal beide online seid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits and deletes reach %1$@’s phone the next time you’re both online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muokkaukset ja poistot välittyvät henkilön %1$@ puhelimelle, kun olette seuraavan kerran molemmat verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications et suppressions atteignent le téléphone de %1$@ la prochaine fois que vous êtes tous les deux en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बदलाव और मिटाए गए संदेश अगली बार आप दोनों के ऑनलाइन होने पर %1$@ के फ़ोन तक पहुँचते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അടുത്ത തവണ നിങ്ങൾ ഇരുവരും ഓൺലൈനിലാകുമ്പോൾ എഡിറ്റുകളും ഇല്ലാതാക്കലുകളും %1$@ എന്നയാളുടെ ഫോണിൽ എത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पुढच्या वेळी तुम्ही दोघे ऑनलाइन असाल तेव्हा संपादने आणि हटवलेले संदेश %1$@ च्या फोनवर पोहोचतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அடுத்த முறை நீங்கள் இருவரும் ஆன்லைனில் இருக்கும்போது திருத்தங்களும் நீக்கங்களும் %1$@ அவர்களின் ஃபோனைச் சேரும்."
          }
        }
      }
    },
    "chat_sheet_hint_self": {
      "comment": "Hint at the bottom of the message sheet for a saved item.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এডিট আর মোছা আপনার অন্য ডিভাইসগুলোতে পৌঁছায়, যখন সেগুলো অনলাইনে থাকে।"
