    "onboarding_terms1": {
      "comment": "Bold lead of the first point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "বিজ্ঞাপন আর ট্র্যাকিং নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ohne Werbung und Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free of ads and tracking."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei mainoksia eikä seurantaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans publicité ni pistage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "विज्ञापन और ट्रैकिंग से मुक्त।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "പരസ്യങ്ങളും ട്രാക്കിംഗും ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाहिराती आणि ट्रॅकिंग नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "விளம்பரங்களும் கண்காணிப்பும் இல்லை."
          }
        }
      }
    },
    "onboarding_terms1_rest": {
      "comment": "Rest of the first point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline আপনার পরিচিতি, কল বা লোকেশন সংগ্রহ করে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline sammelt weder deine Kontakte noch deine Anrufe oder deinen Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline doesn’t collect your contacts, calls or location."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ei kerää yhteystietojasi, puheluitasi eikä sijaintiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ne collecte pas vos contacts, vos appels ni votre position."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline आपके संपर्क, कॉल या लोकेशन इकट्ठा नहीं करता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline നിങ്ങളുടെ കോൺടാക്റ്റുകളോ കോളുകളോ ലൊക്കേഷനോ ശേഖരിക്കുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline तुमचे संपर्क, कॉल किंवा ठिकाण गोळा करत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline உங்கள் தொடர்புகளையோ அழைப்புகளையோ இருப்பிடத்தையோ சேகரிப்பதில்லை."
          }
        }
      }
    },
    "onboarding_terms2": {
      "comment": "Bold lead of the second point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কল এন্ড-টু-এন্ড এনক্রিপ্টেড।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anrufe sind Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls are end-to-end encrypted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puhelut on salattu päästä päähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les appels sont chiffrés de bout en bout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल एंड-टू-एंड एन्क्रिप्टेड हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കോളുകൾ എൻഡ്-ടു-എൻഡ് എൻക്രിപ്റ്റ് ചെയ്തതാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल एंड-टू-एंड एन्क्रिप्टेड असतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அழைப்புகள் எண்ட்-டு-எண்ட் என்க்ரிப்ட் செய்யப்பட்டவை."
          }
        }
      }
    },
    "onboarding_terms2_rest": {
      "comment": "Rest of the second point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সরাসরি লাইন সম্ভব না হলে, একটি এনক্রিপ্টেড রিলে কলটি পৌঁছে দেয়। রিলে কল শুনতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn keine direkte Leitung möglich ist, gibt ein verschlüsseltes Relay den Anruf weiter. Es kann ihn nicht hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a direct line isn’t possible, an encrypted relay passes the call along. It can’t hear it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun suora linja ei ole mahdollinen, salattu välityspalvelin välittää puhelun. Se ei voi kuulla sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quand une ligne directe n’est pas possible, un relais chiffré transmet l’appel. Il ne peut pas l’entendre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब सीधी लाइन मुमकिन न हो, तो एक एन्क्रिप्टेड रिले कॉल को आगे पहुँचाता है। वह उसे सुन नहीं सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നേരിട്ടുള്ള ലൈൻ സാധ്യമല്ലാത്തപ്പോൾ, എൻക്രിപ്റ്റ് ചെയ്ത ഒരു റിലേ കോൾ കൈമാറുന്നു. അതിന് കോൾ കേൾക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "थेट लाइन शक्य नसेल तेव्हा, एन्क्रिप्टेड रिले कॉल पुढे पोहोचवतो. तो कॉल ऐकू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நேரடி லைன் சாத்தியமில்லாதபோது, என்க்ரிப்ட் செய்யப்பட்ட ரிலே அழைப்பைக் கடத்தும். அதனால் அழைப்பைக் கேட்க முடியாது."
          }
        }
      }
    },
    "onboarding_terms3": {
      "comment": "Bold lead of the third point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অ্যাকাউন্ট আপনারই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto gehört dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is yours."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi on sinun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte vous appartient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता आपका है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് നിങ്ങളുടേതാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते तुमचेच आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு உங்களுடையது."
          }
        }
      }
    },
    "onboarding_terms3_rest": {
      "comment": "Rest of the third point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা থাকে আপনার ডিভাইসগুলোতে, কোনো সার্ভারে নয়। আপনার রিকভারি শব্দই ফিরে আসার পথ, তাই সেগুলো যত্নে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es lebt auf deinen Geräten, nicht auf einem Server. Deine Wiederherstellungswörter sind der Weg zurück, also bewahre sie gut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It lives on your devices, not on a server. Your recovery words are the way back in, so keep them safe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se on laitteillasi, ei palvelimella. Palautussanasi ovat tiesi takaisin, joten pidä ne tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il vit sur vos appareils, pas sur un serveur. Vos mots de récupération sont le moyen d’y revenir, alors gardez-les en lieu sûr."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह आपके डिवाइस पर रहता है, किसी सर्वर पर नहीं। आपके रिकवरी शब्द ही वापस आने का रास्ता हैं, इसलिए उन्हें संभालकर रखें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അത് ഒരു സെർവറിലല്ല, നിങ്ങളുടെ ഉപകരണങ്ങളിലാണ്. നിങ്ങളുടെ വീണ്ടെടുക്കൽ വാക്കുകളാണ് തിരികെ കയറാനുള്ള വഴി, അതിനാൽ അവ സുരക്ഷിതമായി സൂക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते सर्व्हरवर नाही, तर तुमच्या डिव्हाइसवर असते. तुमचे रिकव्हरी शब्द हाच परत येण्याचा मार्ग आहे, म्हणून ते सुरक्षित ठेवा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அது சர்வரில் அல்ல, உங்கள் சாதனங்களில் இருக்கிறது. உங்கள் மீட்பு வார்த்தைகளே திரும்ப உள்ளே வருவதற்கான வழி, எனவே அவற்றைப் பத்திரமாக வையுங்கள்."
          }
        }
      }
    },
    "onboarding_terms_consent": {
      "comment": "Consent line above the I agree button. Markdown links: keep the [text](url) shape, translate only the link text; {terms_url} and {privacy_url} are web addresses.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "চালিয়ে গেলে আপনি [ব্যবহারের শর্তাবলি](%1$@) মেনে নিচ্ছেন এবং [প্রাইভেসি পলিসি](%2$@) পড়েছেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du weitermachst, stimmst du den [Nutzungsbedingungen](%1$@) zu und hast die [Datenschutzerklärung](%2$@) gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing, you agree to the [Terms of Use](%1$@) and have read the [Privacy Policy](%2$@)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jatkamalla hyväksyt [käyttöehdot](%1$@) ja olet lukenut [tietosuojakäytännön](%2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En continuant, vous acceptez les [Conditions d’utilisation](%1$@) et confirmez avoir lu la [Politique de confidentialité](%2$@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आगे बढ़ने का मतलब है कि आप [इस्तेमाल की शर्तों](%1$@) से सहमत हैं और आपने [प्राइवेसी पॉलिसी](%2$@) पढ़ ली है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "തുടരുന്നതിലൂടെ, നിങ്ങൾ [ഉപയോഗ നിബന്ധനകൾ](%1$@) അംഗീകരിക്കുകയും [സ്വകാര്യതാ നയം](%2$@) വായിച്ചിട്ടുണ്ടെന്ന് സ്ഥിരീകരിക്കുകയും ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पुढे जाण्याचा अर्थ असा की तुम्हाला [वापराच्या अटी](%1$@) मान्य आहेत आणि तुम्ही [गोपनीयता धोरण](%2$@) वाचले आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தொடர்வதன் மூலம், [பயன்பாட்டு விதிமுறைகளை](%1$@) ஏற்கிறீர்கள், [தனியுரிமைக் கொள்கையைப்](%2$@) படித்திருக்கிறீர்கள்."
          }
        }
      }
    },
    "onboarding_terms_title": {
