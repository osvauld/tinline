            "state": "translated",
            "value": "Your calls come through again once you’re back online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puhelusi tulevat taas perille, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos appels arrivent à nouveau dès que vous êtes de retour en ligne."
          }
