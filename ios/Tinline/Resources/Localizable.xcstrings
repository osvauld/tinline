    "chat_strip_me_offline": {
      "comment": "Strip above the composer when the user's phone is offline.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি অফলাইনে আছেন। আবার অনলাইনে এলে মেসেজ চলে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist offline. Nachrichten gehen raus, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Messages send when you’re back online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et ole verkossa. Viestit lähtevät, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes hors ligne. Les messages partiront dès que vous serez de retour en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप ऑफ़लाइन हैं। वापस ऑनलाइन आते ही संदेश भेज दिए जाएँगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ഓഫ്‌ലൈനാണ്. വീണ്ടും ഓൺലൈനിൽ വരുമ്പോൾ സന്ദേശങ്ങൾ പോകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही ऑफलाइन आहात. तुम्ही पुन्हा ऑनलाइन आल्यावर संदेश जातील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் ஆஃப்லைனில் இருக்கிறீர்கள். மீண்டும் ஆன்லைனுக்கு வந்ததும் செய்திகள் அனுப்பப்படும்."
          }
        }
      }
    },
    "chat_strip_peer_offline": {
      "comment": "Strip above the composer when the other person is offline. {first} is their first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ অফলাইনে আছেন। আপনারা দুজনেই অনলাইনে থাকলে মেসেজ চলে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ist offline. Nachrichten gehen raus, sobald ihr beide online seid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is offline. Messages send when you’re both online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ei ole verkossa. Viestit lähtevät, kun olette molemmat verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ est hors ligne. Les messages partiront dès que vous serez tous les deux en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ऑफ़लाइन हैं। आप दोनों के ऑनलाइन होने पर संदेश भेज दिए जाएँगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ഓഫ്‌ലൈനാണ്. നിങ്ങൾ ഇരുവരും ഓൺലൈനിലാകുമ്പോൾ സന്ദേശങ്ങൾ പോകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ऑफलाइन आहे. तुम्ही दोघे ऑनलाइन असताना संदेश जातील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ஆஃப்லைனில் இருக்கிறார். நீங்கள் இருவரும் ஆன்லைனில் இருக்கும்போது செய்திகள் அனுப்பப்படும்."
          }
        }
      }
    },
