    "chat_older_body": {
      "comment": "Body of the older-messages banner.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি যবে থেকে এই ফোন ব্যবহার করছেন, তখন থেকে মেসেজগুলো এখানে থাকে। আপনারা দুজনেই অনলাইনে থাকলে আগের দিনগুলো লোড হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Handy hat sie ab dem Tag, an dem du es zu nutzen begonnen hast. Frühere Tage werden geladen, wenn ihr beide online seid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone keeps them from when you started using it. Earlier days load when you’re both online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä puhelin säilyttää ne siitä lähtien, kun aloit käyttää sitä. Aiemmat päivät latautuvat, kun olette molemmat verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce téléphone les garde depuis que vous avez commencé à l’utiliser. Les jours précédents se chargent quand vous êtes tous les deux en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह फ़ोन संदेश तब से रखता है जब से आपने इसे इस्तेमाल करना शुरू किया। पहले के दिन आप दोनों के ऑनलाइन होने पर लोड होंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ഈ ഫോൺ ഉപയോഗിച്ചുതുടങ്ങിയത് മുതലുള്ളവ ഇതിൽ സൂക്ഷിക്കും. നിങ്ങൾ ഇരുവരും ഓൺലൈനിലാകുമ്പോൾ പഴയ ദിവസങ്ങളിലേത് ലോഡ് ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही हा फोन वापरायला सुरुवात केल्यापासूनचे संदेश त्यावर असतात. तुम्ही दोघे ऑनलाइन असताना आधीचे दिवस लोड होतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் இந்த ஃபோனைப் பயன்படுத்தத் தொடங்கியதிலிருந்து உள்ளவை இதில் இருக்கும். நீங்கள் இருவரும் ஆன்லைனில் இருக்கும்போது முந்தைய நாட்களின் செய்திகள் ஏற்றப்படும்."
          }
        }
      }
    },
    "chat_older_title": {
