    },
    "group_callhost_here_sub": {
      "comment": "Sub line under Host calls on this phone.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখানে আপনি যে কল শুরু করেন, সেগুলো চালায়। যে কম্পিউটার সবসময় চালু থাকে, সেটি সবার কল চালাতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trägt die Anrufe, die du hier startest. Ein Computer, der an bleibt, kann die Anrufe aller tragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carries the calls you start here. A computer that stays on can carry everyone’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välittää täältä aloittamasi puhelut. Jatkuvasti päällä oleva tietokone voi välittää kaikkien puhelut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Héberge les appels que vous lancez ici. Un ordinateur qui reste allumé peut héberger ceux de tout le monde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यहाँ से शुरू की गई आपकी कॉल चलाता है। हमेशा चालू रहने वाला कंप्यूटर सबकी कॉल चला सकता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇവിടെ നിങ്ങൾ ആരംഭിക്കുന്ന കോളുകൾ നടത്തും. ഓണായിരിക്കുന്ന ഒരു കമ്പ്യൂട്ടറിന് എല്ലാവരുടെയും കോളുകൾ നടത്താം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही इथे सुरू केलेले कॉल चालवतो. सतत चालू राहणारा कॉम्प्युटर सर्वांचे कॉल चालवू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் இங்கே தொடங்கும் அழைப்புகளை நடத்தும். எப்போதும் இயங்கும் கணினி அனைவரின் அழைப்புகளையும் நடத்தலாம்."
          }
        }
      }
    },
    "group_callhost_stop_device": {
      "comment": "Action row title for this device.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
