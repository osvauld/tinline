{
  "sourceLanguage": "en",
  "strings": {
    "call_about_encrypted_lead": {
      "comment": "Bold first words of the encryption explanation on the call details card.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salattu päästä päähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffré de bout en bout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एंड-टू-एंड एन्क्रिप्टेड।"
          }
        }
      }
    },
    "call_about_encrypted_video": {
      "comment": "Rest of the encryption explanation on a video call. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Stimme und dein Bild werden auf diesem Gerät verschlüsselt und erst auf dem Gerät von %1$@ entschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice and picture are encrypted on this device and only decrypted on %1$@’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Äänesi ja kuvasi salataan tällä laitteella ja puretaan vain henkilön %1$@ laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre voix et votre image sont chiffrées sur cet appareil et déchiffrées uniquement sur celui de %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी आवाज़ और तस्वीर इस डिवाइस पर एन्क्रिप्ट होती हैं और सिर्फ़ %1$@ के डिवाइस पर डिक्रिप्ट होती हैं।"
          }
        }
      }
    },
    "call_about_encrypted_voice": {
      "comment": "Rest of the encryption explanation on a voice call. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Stimme wird auf diesem Gerät verschlüsselt und erst auf dem Gerät von %1$@ entschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice is encrypted on this device and only decrypted on %1$@’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Äänesi salataan tällä laitteella ja puretaan vain henkilön %1$@ laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre voix est chiffrée sur cet appareil et déchiffrée uniquement sur celui de %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी आवाज़ इस डिवाइस पर एन्क्रिप्ट होती है और सिर्फ़ %1$@ के डिवाइस पर डिक्रिप्ट होती है।"
          }
        }
      }
    },
    "call_about_headline_direct": {
      "comment": "Bold headline on the call details card. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal: %1$@ · Direkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signal · Direct"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signaali: %1$@ · Suora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal %1$@ · Direct"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ सिग्नल · सीधी"
          }
        }
      }
    },
    "call_about_headline_reconnecting": {
      "comment": "Bold headline on the call details card while reconnecting.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neu verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistetään uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconnexion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फिर से जुड़ रहा है"
          }
        }
      }
    },
    "call_about_headline_relayed": {
      "comment": "Bold headline on the call details card. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal: %1$@ · Weitergeleitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signal · Relayed"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signaali: %1$@ · Välitetty"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal %1$@ · Relayé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ सिग्नल · रिले से"
          }
        }
      }
    },
    "call_about_line_direct": {
      "comment": "Explanation for a direct connection. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Anruf geht direkt zwischen deinem Gerät und dem von %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your call goes straight between your device and %1$@’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puhelusi kulkee suoraan sinun laitteesi ja henkilön %1$@ laitteen välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre appel passe directement entre votre appareil et celui de %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी कॉल सीधे आपके डिवाइस और %1$@ के डिवाइस के बीच जाती है।"
          }
        }
      }
    },
    "call_about_line_reconnecting": {
      "comment": "Explanation while reconnecting. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung war kurz weg. Tinline sucht einen Weg zurück zu %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped for a moment. Tinline is finding a way back to %1$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteys katkesi hetkeksi. Tinline etsii yhteyttä takaisin henkilöön %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion a été coupée un instant. Tinline cherche à rejoindre %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कनेक्शन एक पल के लिए टूट गया। Tinline %1$@ तक वापस पहुँचने का रास्ता ढूँढ़ रहा है।"
          }
        }
      }
    },
    "call_about_line_relayed_video": {
      "comment": "Explanation for a relayed video call.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eure Geräte erreichen sich gerade nicht direkt, also gibt ein Relay den Anruf weiter. Es kann weder mithören noch zusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices can’t reach each other directly right now, so a relay passes the call along. It can’t listen or watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laitteesi eivät juuri nyt tavoita toisiaan suoraan, joten välityspalvelin välittää puhelun. Se ei voi kuunnella eikä katsoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos appareils ne peuvent pas se joindre directement pour le moment, un relais transmet donc l’appel. Il ne peut ni écouter ni regarder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके डिवाइस अभी सीधे एक-दूसरे तक नहीं पहुँच पा रहे, इसलिए एक रिले कॉल को आगे पहुँचाता है। वह न सुन सकता है, न देख सकता है।"
          }
        }
      }
    },
    "call_about_line_relayed_voice": {
      "comment": "Explanation for a relayed voice call.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eure Geräte erreichen sich gerade nicht direkt, also gibt ein Relay den Anruf weiter. Es kann nicht mithören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices can’t reach each other directly right now, so a relay passes the call along. It can’t listen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laitteesi eivät juuri nyt tavoita toisiaan suoraan, joten välityspalvelin välittää puhelun. Se ei voi kuunnella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos appareils ne peuvent pas se joindre directement pour le moment, un relais transmet donc l’appel. Il ne peut pas écouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके डिवाइस अभी सीधे एक-दूसरे तक नहीं पहुँच पा रहे, इसलिए एक रिले कॉल को आगे पहुँचाता है। वह सुन नहीं सकता।"
          }
        }
      }
    },
    "call_about_line_weak": {
      "comment": "Extra sentence appended when the signal is weak. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Leitung ist schwach, daher kann die Stimme von %1$@ stocken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line is weak, so %1$@’s voice may break up."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linja on heikko, joten henkilön %1$@ ääni voi katkeilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La ligne est faible, la voix de %1$@ peut donc être hachée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लाइन कमज़ोर है, इसलिए %1$@ की आवाज़ टूट सकती है।"
          }
        }
      }
    },
    "call_about_reconnecting": {
      "comment": "Accessibility label of the info button while reconnecting.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Über diesen Anruf. Neu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this call. Reconnecting."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tietoja tästä puhelusta. Yhdistetään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À propos de cet appel. Reconnexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस कॉल के बारे में। फिर से जुड़ रहा है।"
          }
        }
      }
    },
    "call_about_signal_direct": {
      "comment": "Accessibility label of the info button. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
