    "devices_hint_rings": {
      "comment": "Hint above the device list.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এগুলোর সবকটিতে কলের রিং হয়। আপনি যাঁদের কল করেন, তাঁরা কখনও এই নামগুলো দেখেন না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anrufe klingeln auf all diesen Geräten. Leute, die du anrufst, sehen diese Namen nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls ring on all of these. People you call never see these names."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puhelut soivat kaikilla näillä. Ne, joille soitat, eivät koskaan näe näitä nimiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les appels sonnent sur chacun d’eux. Les personnes que vous appelez ne voient jamais ces noms."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इन सभी पर कॉल की घंटी बजती है। जिन्हें आप कॉल करते हैं, उन्हें ये नाम कभी नहीं दिखते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കോളുകൾ ഇവയിലെല്ലാം റിംഗ് ചെയ്യും. നിങ്ങൾ വിളിക്കുന്നവർക്ക് ഈ പേരുകൾ ഒരിക്കലും കാണാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या सर्वांवर कॉल रिंग होतात. तुम्ही ज्यांना कॉल करता त्यांना ही नावे कधीच दिसत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இவை அனைத்திலும் அழைப்புகள் ஒலிக்கும். நீங்கள் அழைப்பவர்கள் இந்தப் பெயர்களை ஒருபோதும் பார்க்க மாட்டார்கள்."
          }
        }
      }
    },
