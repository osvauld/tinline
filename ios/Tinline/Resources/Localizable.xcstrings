    "security_pass_intro": {
      "comment": "Intro on the add-passphrase page.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto lebt nur auf diesem Handy. Eine Passphrase verschlüsselt es, sodass niemand, der dein Handy in der Hand hat, es kopieren kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account lives only on this phone. A passphrase encrypts it, so nobody holding your phone can copy it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi on vain tällä puhelimella. Salalause salaa sen, joten kukaan, jolla puhelimesi on käsissään, ei voi kopioida sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte vit uniquement sur ce téléphone. Une phrase secrète le chiffre, pour que personne ne puisse le copier en ayant votre téléphone en main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता सिर्फ़ इसी फ़ोन पर है। पासफ़्रेज़ इसे एन्क्रिप्ट करता है, ताकि आपका फ़ोन हाथ में होने पर भी कोई इसे कॉपी न कर सके।"
          }
        }
      }
    },
    "security_pass_notice": {
      "comment": "Notice on the add-passphrase page.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschlüsselt dein Konto auf diesem Handy. Dein Handy merkt sie sich, sodass Anrufe auch nach einem Neustart klingeln. Wenn du sie vergisst, kannst du mit deinen Wiederherstellungswörtern eine neue festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypts your account on this phone. Your phone remembers it, so calls still ring after a restart. If you forget it, your recovery words let you set a new one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salaa tilisi tällä puhelimella. Puhelimesi muistaa sen, joten puhelut soivat myös uudelleenkäynnistyksen jälkeen. Jos unohdat sen, palautussanoilla voit asettaa uuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffre votre compte sur ce téléphone. Votre téléphone s’en souvient, donc les appels sonnent toujours après un redémarrage. Si vous l’oubliez, vos mots de récupération vous permettent d’en choisir une nouvelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर आपके खाते को एन्क्रिप्ट करता है। आपका फ़ोन इसे याद रखता है, इसलिए रीस्टार्ट के बाद भी कॉल की घंटी बजती है। अगर आप इसे भूल जाएँ, तो रिकवरी शब्दों से नया रख सकते हैं।"
          }
        }
      }
    },
    "security_recovery_failed": {
