    "people_profile_availability_note": {
      "comment": "Note under the availability section.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kontakte sehen das, und es ist auf all deinen Geräten gleich. Es bestimmt, ob Anrufe dich erreichen, und ist getrennt davon, ob du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts can see this, and it’s the same on all your devices. It affects whether calls reach you, and it’s separate from whether you’re online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteystietosi näkevät tämän, ja se on sama kaikilla laitteillasi. Se vaikuttaa siihen, tulevatko puhelut perille, eikä se riipu siitä, oletko verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts peuvent voir ceci, et c’est pareil sur tous vos appareils. Cela détermine si les appels vous parviennent, indépendamment du fait d’être en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह आपके संपर्कों को दिखता है और आपके सभी डिवाइस पर एक जैसा रहता है। इससे तय होता है कि कॉल आप तक पहुँचें या नहीं, और यह आपके ऑनलाइन होने से अलग है।"
          }
        }
      }
    },
