        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकार करने पर उन्हें सिर्फ़ संदेशों के लिए संपर्क में जोड़ा जाएगा। कॉल की अनुमति आप बाद में दे सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സ്വീകരിച്ചാൽ അവർ സന്ദേശങ്ങൾക്ക് മാത്രമുള്ള കോൺടാക്റ്റായി ചേരും. കോളുകൾ പിന്നീട് അനുവദിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकारल्यावर त्यांना फक्त संदेशांसाठी संपर्क म्हणून जोडले जाईल. कॉलची परवानगी तुम्ही नंतर देऊ शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஏற்றுக்கொண்டால், அவர் செய்திகளுக்கு மட்டுமான தொடர்பாகச் சேர்க்கப்படுவார். அழைப்புகளைப் பிறகு அனுமதிக்கலாம்."
          }
