      }
    },
    "unlock_switch_body": {
      "comment": "Body of the switch-account confirmation; {name} is the current account's name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে %1$@ অফলাইন হয়ে যাবে। আপনি আবার ফিরে না আসা পর্যন্ত %1$@-এ কল এলে শুধু আপনার অন্য লিঙ্ক করা ডিভাইসগুলোতে রিং হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ geht auf diesem Handy offline. Anrufe an %1$@ klingeln nur auf deinen anderen verknüpften Geräten, bis du zurückwechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ goes offline on this phone. Calls to %1$@ will ring only on your other linked devices until you switch back."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ siirtyy pois verkosta tällä puhelimella. Puhelut tilille %1$@ soivat vain muilla linkitetyillä laitteillasi, kunnes vaihdat takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ passe hors ligne sur ce téléphone. Les appels vers %1$@ sonneront seulement sur vos autres appareils associés jusqu’à ce que vous reveniez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर %1$@ ऑफ़लाइन हो जाएगा। जब तक आप वापस इस खाते पर न आएँ, %1$@ की कॉल सिर्फ़ आपके दूसरे लिंक किए गए डिवाइस पर बजेंगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫോണിൽ %1$@ ഓഫ്‌ലൈനാകും. നിങ്ങൾ ഈ അക്കൗണ്ടിലേക്ക് തിരികെ മാറുന്നതുവരെ, %1$@ എന്ന അക്കൗണ്ടിലേക്കുള്ള കോളുകൾ നിങ്ങളുടെ ലിങ്ക് ചെയ്ത മറ്റ് ഉപകരണങ്ങളിൽ മാത്രം റിംഗ് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या फोनवर %1$@ ऑफलाइन होईल. तुम्ही परत या खात्यावर येईपर्यंत %1$@ चे कॉल फक्त तुमच्या इतर लिंक केलेल्या डिव्हाइसवर रिंग होतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த ஃபோனில் %1$@ ஆஃப்லைன் ஆகும். நீங்கள் மீண்டும் இந்தக் கணக்குக்கு மாறும் வரை, %1$@ கணக்குக்கான அழைப்புகள் உங்கள் மற்ற இணைக்கப்பட்ட சாதனங்களில் மட்டுமே ஒலிக்கும்."
          }
        }
      }
    },
