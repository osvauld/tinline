        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tervetuloa takaisin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
