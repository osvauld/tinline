        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute"
          }
        }
      }
    },
    "call_control_muted": {
      "comment": "Caption of the mute button while the microphone is muted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted"
          }
        }
      }
    },
    "call_decline": {
      "comment": "Button and accessibility label that declines an incoming call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        }
      }
    },
    "call_dismiss": {
      "comment": "Accessibility label of the button that closes the group call announcement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        }
      }
    },
    "call_ended_title": {
      "comment": "Title of the screen shown after a call ends, and the default end reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call ended"
          }
        }
      }
    },
    "call_got_it": {
      "comment": "Button that closes the call details card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        }
      }
    },
    "call_group_about_carries": {
      "comment": "Continues the bold host name on the group call details card, e.g. \"Arjun’s device carries this call...\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "carries this call. Everyone in the call connects to it, and it passes the audio on and chooses who is heard when several people speak."
          }
        }
      }
    },
    "call_group_about_carrying": {
      "comment": "Continues the bold host name when this phone is the host: \"This phone is carrying this call...\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "is carrying this call. Everyone in the call connects to it, and it passes the audio on and chooses who is heard when several people speak."
          }
        }
      }
    },
    "call_group_about_trust": {
      "comment": "Paragraph on the group call details card about trusting the call host.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your connection to the call host is encrypted, but the call host itself receives the audio, so it can hear this call. You trust it for the call the way you trust a chat host with posts."
          }
        }
      }
    },
    "call_group_about_who": {
      "comment": "Paragraph on the group call details card about who can be a call host.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A call host is a device a group admin chose and that agreed to it. It is separate from chat hosting. Admins can change call hosts in Group info."
          }
        }
      }
    },
    "call_group_already_in_call": {
      "comment": "Error when starting or joining a group call while another call is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re already in a call."
          }
        }
      }
    },
    "call_group_announce_ringing": {
      "comment": "Group call announcement. {name} is the member's first name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is calling the group"
          }
        }
      }
    },
    "call_group_announce_ringing_label": {
      "comment": "Accessibility label of the group call announcement while ringing. {name} is the member, {group} the group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is calling the group %2$@"
          }
        }
      }
    },
    "call_group_announce_started": {
      "comment": "Group call announcement. {name} is the member who started the call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ started a call"
          }
        }
      }
    },
    "call_group_announce_started_label": {
      "comment": "Accessibility label of the group call announcement. {name} is the member, {group} the group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ started a call in %2$@"
          }
        }
      }
    },
    "call_group_battery_limited": {
      "comment": "Note on the group call screen when this phone is the call host and its battery is low.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery under 15 %. Hosting is limited: only one person is heard at a time, and no one new can join."
          }
        }
      }
    },
    "call_group_call_name": {
      "comment": "Fallback title of a group call when the group has no name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group call"
          }
        }
      }
    },
    "call_group_connect_failed": {
      "comment": "Group call start failure, generic.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect"
          }
        }
      }
    },
    "call_group_ended": {
      "comment": "Reason shown when a group call ends.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call ended"
          }
        }
      }
    },
