    "call_privacy_active": {
      "comment": "Call card line once the call is connected. {name} is the contact's first or full name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এন্ড-টু-এন্ড এনক্রিপ্টেড। আপনার কণ্ঠস্বর এই ডিভাইসে এনক্রিপ্ট হয়, আর শুধু %1$@-এর ডিভাইসেই ডিক্রিপ্ট হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ende-zu-Ende-verschlüsselt. Deine Stimme wird auf diesem Gerät verschlüsselt und erst auf dem Gerät von %1$@ entschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted. Your voice is encrypted on this device and only decrypted on %1$@’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salattu päästä päähän. Äänesi salataan tällä laitteella ja puretaan vain henkilön %1$@ laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffré de bout en bout. Votre voix est chiffrée sur cet appareil et déchiffrée uniquement sur celui de %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एंड-टू-एंड एन्क्रिप्टेड। आपकी आवाज़ इस डिवाइस पर एन्क्रिप्ट होती है और सिर्फ़ %1$@ के डिवाइस पर डिक्रिप्ट होती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "എൻഡ്-ടു-എൻഡ് എൻക്രിപ്റ്റ് ചെയ്തത്. നിങ്ങളുടെ ശബ്ദം ഈ ഉപകരണത്തിൽ എൻക്രിപ്റ്റ് ചെയ്യുന്നു, %1$@ എന്നയാളുടെ ഉപകരണത്തിൽ മാത്രമേ ഡീക്രിപ്റ്റ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एंड-टू-एंड एन्क्रिप्टेड. तुमचा आवाज या डिव्हाइसवर एन्क्रिप्ट होतो आणि फक्त %1$@ च्या डिव्हाइसवर डिक्रिप्ट होतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "எண்ட்-டு-எண்ட் என்க்ரிப்ட் செய்யப்பட்டது. உங்கள் குரல் இந்தச் சாதனத்தில் என்க்ரிப்ட் செய்யப்பட்டு, %1$@ அவர்களின் சாதனத்தில் மட்டுமே டிக்ரிப்ட் செய்யப்படுகிறது."
          }
        }
      }
    },
    "call_privacy_connecting": {
      "comment": "Call card line while connecting; no encryption claim yet. {name} is the contact's name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-এর সঙ্গে কানেক্ট হচ্ছে। কল কানেক্ট হলেই সেটি এন্ড-টু-এন্ড এনক্রিপ্টেড।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindung mit %1$@ wird aufgebaut. Sobald der Anruf verbunden ist, ist er Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to %1$@. Once the call is connected, it is end-to-end encrypted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistetään: %1$@. Kun puhelu on yhdistetty, se on salattu päästä päähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connexion à %1$@. Une fois l’appel connecté, il est chiffré de bout en bout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ से जुड़ रहा है। कॉल जुड़ते ही यह एंड-टू-एंड एन्क्रिप्टेड होगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാളുമായി കണക്റ്റ് ചെയ്യുന്നു. കോൾ കണക്റ്റ് ആയിക്കഴിഞ്ഞാൽ അത് എൻഡ്-ടു-എൻഡ് എൻക്രിപ്റ്റ് ചെയ്തതായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ शी कनेक्ट करत आहे. कॉल कनेक्ट झाल्यावर तो एंड-टू-एंड एन्क्रिप्टेड असतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களுடன் இணைக்கிறது. அழைப்பு இணைந்ததும், அது எண்ட்-டு-எண்ட் என்க்ரிப்ட் செய்யப்படும்."
          }
        }
      }
    },
