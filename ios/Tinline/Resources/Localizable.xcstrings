    "group_request_accept_note": {
      "comment": "Chat request card note. {name} is their first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du annimmst, wird %1$@ als Kontakt nur für Nachrichten hinzugefügt. Anrufe kannst du später erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting adds %1$@ as a contact for messages only. You can allow calls later."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksyminen lisää henkilön %1$@ yhteystiedoksi vain viestejä varten. Voit sallia puhelut myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accepter ajoute %1$@ comme contact pour les messages uniquement. Vous pourrez autoriser les appels plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकार करने पर %1$@ को सिर्फ़ संदेशों के लिए संपर्क में जोड़ा जाएगा। कॉल की अनुमति आप बाद में दे सकते हैं।"
          }
        }
      }
    },
