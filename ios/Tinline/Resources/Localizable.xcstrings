    "link_diff_code": {
      "comment": "Warning under the big code.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোড আলাদা, বা আপনি এটা শুরু করেননি? বাতিল করুন। হয়তো অন্য কেউ QR-টি স্ক্যান করেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anderer Code, oder du hast das nicht gestartet? Brich ab. Vielleicht hat jemand anderes den QR-Code gescannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different code, or you didn’t start this? Cancel. Someone else may have scanned the QR."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eri koodi, tai et aloittanut tätä? Peruuta. Joku muu on ehkä skannannut QR-koodin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Code différent, ou ce n’est pas vous qui avez lancé ceci ? Annulez. Quelqu’un d’autre a peut-être scanné le QR code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड अलग है, या यह आपने शुरू नहीं किया? रद्द करें। हो सकता है किसी और ने QR स्कैन किया हो।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കോഡ് വ്യത്യസ്തമാണോ, അല്ലെങ്കിൽ നിങ്ങളല്ലേ ഇത് തുടങ്ങിയത്? റദ്ദാക്കുക. മറ്റാരെങ്കിലും QR സ്കാൻ ചെയ്തിരിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड वेगळा आहे, किंवा हे तुम्ही सुरू केले नाही? रद्द करा. दुसऱ्या कोणीतरी QR स्कॅन केला असू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குறியீடு வேறாக உள்ளதா, அல்லது இதை நீங்கள் தொடங்கவில்லையா? ரத்துசெய்யுங்கள். வேறு யாராவது QR-ஐ ஸ்கேன் செய்திருக்கலாம்."
          }
        }
      }
    },
    "link_done": {
