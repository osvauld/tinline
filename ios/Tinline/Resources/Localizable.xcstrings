    "onboarding_welcome_lead": {
      "comment": "Explanation on the first screen; the line break is intended.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline verbindet dein Handy direkt mit ihrem.\nDu brauchst nur einen Spitznamen. Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline connects your phone straight to theirs.\nYou just need a nickname. Encrypted end to end."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline yhdistää puhelimesi suoraan heidän puhelimeensa.\nTarvitset vain kutsumanimen. Päästä päähän salattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline relie votre téléphone directement à celui de vos proches.\nIl vous suffit d’un pseudo. Chiffré de bout en bout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline आपके फ़ोन को सीधे उनके फ़ोन से जोड़ता है।\nबस एक निकनेम चाहिए। एंड-टू-एंड एन्क्रिप्टेड।"
          }
        }
      }
    },
