    "group_done_request_sent": {
      "comment": "Toast after asking a member for a private chat. {name} is that member's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-কে অনুরোধ পাঠানো হয়েছে। উনি উত্তর না দেওয়া পর্যন্ত এটা চ্যাটে অপেক্ষা করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anfrage an %1$@ gesendet. Sie wartet unter Chats, bis eine Antwort kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request sent to %1$@. It waits in Chats until they answer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyyntö lähetetty: %1$@. Se odottaa Keskusteluissa, kunnes hän vastaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demande envoyée à %1$@. Elle attend dans Discussions jusqu’à sa réponse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ को अनुरोध भेज दिया। उनके जवाब तक यह चैट में इंतज़ार करेगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാൾക്ക് അഭ്യർത്ഥന അയച്ചു. അവർ മറുപടി നൽകുന്നതുവരെ അത് ചാറ്റുകളിൽ കാത്തിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला विनंती पाठवली. त्यांनी उत्तर देईपर्यंत ती चॅटमध्ये थांबून राहते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களுக்குக் கோரிக்கை அனுப்பப்பட்டது. அவர் பதிலளிக்கும் வரை அது அரட்டைகளில் காத்திருக்கும்."
          }
        }
      }
    },
