          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കാത്തിരിക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रतीक्षेत"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "காத்திருக்கிறது"
          }
        }
