          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तो फोटो तयार करता आला नाही. दुसरा फोटो वापरून पहा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்தப் படத்தைத் தயார் செய்ய முடியவில்லை. வேறொன்றை முயலுங்கள்."
          }
        }
      }
    },
    "people_crop_help": {
      "comment": "Help text under the crop area.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ছবি সরাতে টেনে আনুন। জুম করতে স্লাইডার ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
