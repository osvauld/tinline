      }
    },
    "unlock_lost_lead": {
      "comment": "Explanation under the lost-key title.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অ্যাকাউন্ট খোলার চাবিটি আর এই ফোনে নেই। স্ক্রিন লক রিসেট করলে বা ব্যাকআপ থেকে ফিরিয়ে আনলে এমন হয়। অ্যাকাউন্ট ফিরিয়ে আনলেই আপনার কল আবার আসবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Handy hat den Schlüssel nicht mehr, der dein Konto öffnet. Das passiert nach dem Zurücksetzen der Displaysperre oder nach einem wiederhergestellten Backup. Sobald du wiederherstellst, kommen deine Anrufe wieder durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone no longer has the key that opens your account. That happens after a screen-lock reset or a restored backup. Once you restore, your calls come through again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tällä puhelimella ei enää ole avainta, joka avaa tilisi. Näin käy näytön lukituksen nollauksen tai varmuuskopion palautuksen jälkeen. Kun palautat tilin, puhelusi tulevat taas perille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce téléphone n’a plus la clé qui ouvre votre compte. Cela arrive après une réinitialisation du verrouillage de l’écran ou la restauration d’une sauvegarde. Dès que vous restaurez, vos appels arrivent à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन में अब वह कुंजी नहीं है जिससे आपका खाता खुलता है। ऐसा स्क्रीन लॉक रीसेट होने या बैकअप वापस लाने के बाद होता है। खाता वापस लाते ही आपकी कॉल फिर से आने लगेंगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് തുറക്കുന്ന കീ ഇപ്പോൾ ഈ ഫോണിൽ ഇല്ല. സ്ക്രീൻ ലോക്ക് റീസെറ്റ് ചെയ്തതിനു ശേഷമോ ഒരു ബാക്കപ്പ് പുനഃസ്ഥാപിച്ചതിനു ശേഷമോ ഇങ്ങനെ സംഭവിക്കാം. അക്കൗണ്ട് പുനഃസ്ഥാപിച്ചുകഴിഞ്ഞാൽ നിങ്ങളുടെ കോളുകൾ വീണ്ടും എത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते उघडणारी की आता या फोनवर नाही. स्क्रीन लॉक रीसेट केल्यावर किंवा बॅकअपमधून फोन परत आणल्यावर असे होते. खाते परत मिळवल्यावर तुमचे कॉल पुन्हा येऊ लागतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கைத் திறக்கும் விசை இப்போது இந்த ஃபோனில் இல்லை. திரைப் பூட்டை மீட்டமைத்த பிறகோ காப்புப்பிரதியை மீட்டெடுத்த பிறகோ இப்படி நடக்கும். மீட்டெடுத்ததும் உங்கள் அழைப்புகள் மீண்டும் வரும்."
          }
        }
      }
    },
    "unlock_lost_notice": {
      "comment": "Warning on the lost-key screen.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি কোনো পাসফ্রেজ সেট করেননি, তাই %1$@টি রিকভারি শব্দই ফিরে আসার একমাত্র উপায়। আপনার পরিচিতিরা থেকে যাবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast keine Passphrase festgelegt, also sind die %1$@ Wiederherstellungswörter der einzige Weg zurück. Deine Kontakte bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn’t set a passphrase, so the %1$@-word recovery phrase is the only way back. Your contacts stay."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et asettanut salalausetta, joten %1$@ palautussanaa on ainoa tie takaisin. Yhteystietosi säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous n’avez pas défini de phrase secrète, donc vos %1$@ mots de récupération sont le seul moyen de récupérer votre compte. Vos contacts sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने पासफ़्रेज़ नहीं रखा था, इसलिए %1$@ रिकवरी शब्द ही वापसी का एकमात्र तरीका हैं। आपके संपर्क बने रहेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ പാസ്‌ഫ്രേസ് സജ്ജീകരിച്ചിട്ടില്ലാത്തതിനാൽ, %1$@ വീണ്ടെടുക്കൽ വാക്കുകളാണ് തിരികെ കയറാനുള്ള ഒരേയൊരു വഴി. നിങ്ങളുടെ കോൺടാക്റ്റുകൾ നഷ്ടപ്പെടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही पासफ्रेज सेट केला नव्हता, त्यामुळे %1$@ रिकव्हरी शब्द हाच परत येण्याचा एकमेव मार्ग आहे. तुमचे संपर्क तसेच राहतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் கடவுச்சொற்றொடர் அமைக்கவில்லை, எனவே %1$@ மீட்பு வார்த்தைகள் மட்டுமே திரும்பி வருவதற்கான வழி. உங்கள் தொடர்புகள் அப்படியே இருக்கும்."
          }
        }
      }
    },
    "unlock_lost_title": {
      "comment": "Title when this phone lost the key to the account.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অ্যাকাউন্ট খোলা যাচ্ছে না"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto lässt sich nicht öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t open your account"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiliäsi ei voi avata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’ouvrir votre compte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता नहीं खुल पा रहा"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് തുറക്കാൻ കഴിയുന്നില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते उघडता येत नाही"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கைத் திறக்க முடியவில்லை"
          }
        }
      }
    },
