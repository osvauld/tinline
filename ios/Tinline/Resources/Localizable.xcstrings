    "settings_notif_messages_sub": {
      "comment": "Subtitle of the Messages notification row.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "মানুষের কাছ থেকে, গ্রুপ থেকে নয়"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von Personen, nicht aus Gruppen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From people, not groups"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihmisiltä, ei ryhmistä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Des personnes, pas des groupes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लोगों से, ग्रुप से नहीं"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആളുകളിൽ നിന്ന്, ഗ്രൂപ്പുകളിൽ നിന്നല്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लोकांकडून, ग्रुपमधून नाही"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நபர்களிடமிருந்து, குழுக்களிலிருந்து அல்ல"
          }
        }
      }
    },
    "settings_notif_note": {
      "comment": "Note under the notification switches.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "মিউট করা চ্যাট কখনও আপনাকে জানায় না, এখানে যা-ই চালু থাকুক। একজনের কাছ থেকে আসা মিসড কল একটি বিজ্ঞপ্তিতে একসঙ্গে দেখায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein stummgeschalteter Chat benachrichtigt dich nie, egal was hier eingeschaltet ist. Verpasste Anrufe von einer Person werden zu einer Benachrichtigung zusammengefasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A muted chat never alerts you, whatever is switched on here. Missed calls from one person fold into one notification."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mykistetty keskustelu ei koskaan ilmoita sinulle, riippumatta siitä, mitä täällä on päällä. Saman henkilön vastaamattomat puhelut kootaan yhteen ilmoitukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une discussion en sourdine ne vous prévient jamais, quels que soient les réglages ici. Les appels manqués d’une même personne sont regroupés en une notification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "म्यूट की गई चैट आपको कभी सूचना नहीं देती, चाहे यहाँ कुछ भी चालू हो। एक व्यक्ति की मिस्ड कॉल एक ही सूचना में जुड़ जाती हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇവിടെ എന്ത് ഓണാക്കിയാലും, മ്യൂട്ട് ചെയ്ത ചാറ്റ് നിങ്ങളെ അറിയിക്കില്ല. ഒരാളിൽ നിന്നുള്ള മിസ്‌ഡ് കോളുകൾ ഒരൊറ്റ അറിയിപ്പായി ചേരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इथे काहीही सुरू असले तरी म्यूट केलेली चॅट तुम्हाला कधीच सूचना देत नाही. एकाच व्यक्तीचे मिस्ड कॉल एकाच सूचनेत एकत्र येतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இங்கே எது ஆன் செய்யப்பட்டிருந்தாலும், ஒலியடக்கப்பட்ட அரட்டை உங்களுக்கு ஒருபோதும் தெரிவிக்காது. ஒருவரிடமிருந்து வந்த தவறிய அழைப்புகள் ஒரே அறிவிப்பாகச் சேர்க்கப்படும்."
          }
        }
      }
    },
