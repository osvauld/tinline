    },
    "onboarding_tip_devices": {
      "comment": "Tip title on the account-ready screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একের চেয়ে দুটো ডিভাইস ভালো"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwei Geräte sind besser als eins"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two devices are better than one"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaksi laitetta on parempi kuin yksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deux appareils valent mieux qu’un"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक से भले दो डिवाइस"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഒന്നിനേക്കാൾ നല്ലത് രണ്ട് ഉപകരണങ്ങൾ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एकापेक्षा दोन डिव्हाइस बरे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒன்றை விட இரண்டு சாதனங்கள் நல்லது"
          }
        }
      }
    },
    "onboarding_tip_devices_body": {
      "comment": "Tip body.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সুযোগ পেলে আরেকটি ডিভাইস লিঙ্ক করুন, যাতে একটি হারালেও কখনও আটকে না যান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verknüpfe ein weiteres Gerät, sobald es geht. Dann sperrt dich ein verlorenes Gerät nie aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link another device when you can, so losing one never locks you out."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkitä toinen laite, kun ehdit, niin pääset tilillesi, vaikka yksi laite katoaisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Associez un autre appareil quand vous pouvez : si vous en perdez un, vous gardez l’accès à votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब हो सके, एक और डिवाइस लिंक करें, ताकि एक खो जाने पर भी आप अपने खाते से बाहर न हों।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കഴിയുമ്പോൾ മറ്റൊരു ഉപകരണം ലിങ്ക് ചെയ്യുക, ഒന്ന് നഷ്ടപ്പെട്ടാലും നിങ്ങൾ പുറത്താകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जमेल तेव्हा दुसरे डिव्हाइस लिंक करा, म्हणजे एक हरवले तरी तुम्ही खात्याबाहेर अडकणार नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "முடிந்தபோது இன்னொரு சாதனத்தை இணையுங்கள்; அப்போது ஒன்று தொலைந்தாலும் உங்கள் கணக்கு உங்களிடமே இருக்கும்."
          }
        }
      }
    },
    "onboarding_tip_groups": {
      "comment": "Tip title on the account-ready screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রুপ হোস্ট হয় কম্পিউটারে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gruppen werden auf einem Computer gehostet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups are hosted on a computer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ryhmiä isännöidään tietokoneella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les groupes sont hébergés sur un ordinateur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप कंप्यूटर पर होस्ट होते हैं"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഗ്രൂപ്പുകൾ ഹോസ്റ്റ് ചെയ്യുന്നത് കമ്പ്യൂട്ടറിലാണ്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप कॉम्प्युटरवर होस्ट होतात"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குழுக்கள் கணினியில் ஹோஸ்ட் செய்யப்படும்"
          }
        }
      }
    },
    "onboarding_tip_groups_body": {
      "comment": "Tip body.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রুপ শুরু করতে, এমন একটি কম্পিউটারেও Tinline ইনস্টল করুন, যেটি চালু থাকতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um eine Gruppe zu starten, richte Tinline auf einem Computer ein, der an bleiben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To start a group, add Tinline on a computer that can stay on."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jos haluat aloittaa ryhmän, asenna Tinline tietokoneelle, joka voi olla jatkuvasti päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour créer un groupe, installez Tinline sur un ordinateur qui peut rester allumé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप शुरू करने के लिए ऐसे कंप्यूटर पर भी Tinline इंस्टॉल करें जो चालू रह सके।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഒരു ഗ്രൂപ്പ് തുടങ്ങാൻ, ഓണായിരിക്കാൻ കഴിയുന്ന ഒരു കമ്പ്യൂട്ടറിൽ Tinline ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप सुरू करण्यासाठी, सतत चालू राहू शकणाऱ्या कॉम्प्युटरवरही Tinline इंस्टॉल करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குழுவைத் தொடங்க, எப்போதும் இயங்கக்கூடிய கணினியில் Tinline-ஐ நிறுவுங்கள்."
          }
        }
      }
    },
