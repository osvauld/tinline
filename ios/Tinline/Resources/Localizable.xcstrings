    "group_add_no_contacts": {
      "comment": "Hint when there is nobody to add.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যোগ করার মতো কোনো পরিচিতি নেই। আপনি যাঁদের ব্লক করেছেন, বা যাঁরা আপনাকে ব্লক করেছেন, তাঁরা তালিকায় নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Kontakte zum Hinzufügen. Leute, die du blockierst oder die dich blockieren, stehen nicht in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contacts to add. People you block, or who block you, aren’t listed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei lisättäviä yhteystietoja. Estämäsi ja sinut estäneet eivät näy listalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun contact à ajouter. Les personnes que vous bloquez, ou qui vous bloquent, n’apparaissent pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जोड़ने के लिए कोई संपर्क नहीं है। जिन्हें आपने ब्लॉक किया है या जिन्होंने आपको ब्लॉक किया है, वे यहाँ नहीं दिखते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ചേർക്കാൻ കോൺടാക്റ്റുകളൊന്നുമില്ല. നിങ്ങൾ ബ്ലോക്ക് ചെയ്തവരെയും നിങ്ങളെ ബ്ലോക്ക് ചെയ്തവരെയും ഇവിടെ കാണിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जोडण्यासाठी कोणताही संपर्क नाही. तुम्ही ब्लॉक केलेले किंवा ज्यांनी तुम्हाला ब्लॉक केले आहे ते लोक यादीत दिसत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சேர்க்கத் தொடர்புகள் இல்லை. நீங்கள் தடுத்தவர்களும் உங்களைத் தடுத்தவர்களும் பட்டியலில் இருக்க மாட்டார்கள்."
          }
        }
      }
    },
