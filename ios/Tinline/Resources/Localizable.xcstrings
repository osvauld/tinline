    "link_match_body": {
      "comment": "Body when comparing codes. The new device's name is bold (markdown stars, keep them around the name); {name} is that name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**%1$@** möchte deinem Konto beitreten. Es sollte dieselben sechs Ziffern zeigen wie unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**%1$@** wants to join your account. It should be showing the same six digits as below."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**%1$@** haluaa liittyä tiliisi. Sen pitäisi näyttää samat kuusi numeroa kuin alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**%1$@** veut rejoindre votre compte. Cet appareil devrait afficher les six mêmes chiffres que ci-dessous."
          }
