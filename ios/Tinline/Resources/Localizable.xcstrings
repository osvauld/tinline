    "settings_storage_note": {
      "comment": "Note under the Clear cache row.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আরও জায়গা খালি করতে, চ্যাট থেকে ছবি বা ফাইল সরান।"
