    "group_error_timeout": {
      "comment": "Error when no host answered.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সময়মতো কোনো হোস্ট উত্তর দেয়নি। কোনো হোস্ট অনলাইনে এলে আবার চেষ্টা করুন।"
