    "onboarding_perm_mic_why": {
      "comment": "Why Tinline asks for the microphone.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit man dich hören kann. Nur während eines Anrufs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So they can hear you. Used only during a call."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta sinut kuullaan. Käytössä vain puhelun aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour qu’on puisse vous entendre. Utilisé uniquement pendant un appel."
          }
        },
