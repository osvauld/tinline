          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അംഗീകരിക്കുമ്പോൾ നിങ്ങളുടെ **വീണ്ടെടുക്കൽ വാക്കുകൾ** പുതിയ ഉപകരണത്തിലേക്ക് അയയ്ക്കും. അത് നിങ്ങളുടെ പൂർണ്ണമായ ഒരു പകർപ്പാകും: അതിന് നിങ്ങളുടെ ചാറ്റുകൾ വായിക്കാനും നിങ്ങളുടെ പേരിൽ പ്രവർത്തിക്കാനും കഴിയും. നിങ്ങളുടെ കൈയിലുള്ള ഒരു ഉപകരണം മാത്രം അംഗീകരിക്കുക."
          }
