        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സ്കാൻ ചെയ്യൽ ഇതുവരെ ലഭ്യമല്ല. പകരം ലിങ്ക് പേസ്റ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्कॅन करणे अजून उपलब्ध नाही. त्याऐवजी लिंक पेस्ट करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஸ்கேன் செய்யும் வசதி இன்னும் கிடைக்கவில்லை. பதிலாக இணைப்பை ஒட்டுங்கள்."
