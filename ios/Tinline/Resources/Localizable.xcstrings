    "settings_clear_cache_sub": {
      "comment": "Subtitle of Clear cache; {size} is a size such as 12 MB.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার খোলা ছবি আর ফাইল মিলিয়ে %1$@। আবার খুললে সেগুলো নতুন করে তৈরি হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ an Bildern und Dateien, die du geöffnet hast. Sie werden neu vorbereitet, wenn du sie öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of pictures and files you’ve opened. They’re prepared again when you open them."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ avaamiasi kuvia ja tiedostoja. Ne valmistellaan uudelleen, kun avaat ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ d’images et de fichiers que vous avez ouverts. Ils sont préparés à nouveau quand vous les ouvrez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी खोली गई फ़ोटो और फ़ाइलें, %1$@। खोलने पर ये फिर से तैयार हो जाती हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ തുറന്ന ഫോട്ടോകളും ഫയലുകളും: %1$@. വീണ്ടും തുറക്കുമ്പോൾ അവ വീണ്ടും തയ്യാറാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही उघडलेले फोटो आणि फाइल: %1$@. पुन्हा उघडल्यावर त्या परत तयार होतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் திறந்த படங்களும் கோப்புகளும்: %1$@. மீண்டும் திறக்கும்போது அவை மறுபடி தயார் செய்யப்படும்."
          }
        }
      }
    },
