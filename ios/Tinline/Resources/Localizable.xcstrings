    "unlock_not_in_call": {
      "comment": "Hint on the switch-account confirmation.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি এখন কলে নেই। থাকলে, বদলালে কলটি শেষ হয়ে যেত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du telefonierst gerade nicht. Sonst würde der Wechsel den Anruf beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re not on a call. If you were, switching would end it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et ole puhelussa. Jos olisit, vaihto lopettaisi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous n’êtes pas en appel. Si vous l’étiez, changer de compte y mettrait fin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी कोई कॉल नहीं चल रही। अगर चल रही होती, तो खाता बदलने से वह कट जाती।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇപ്പോൾ കോളൊന്നും നടക്കുന്നില്ല. നടക്കുന്നുണ്ടായിരുന്നെങ്കിൽ, അക്കൗണ്ട് മാറുമ്പോൾ അത് അവസാനിക്കുമായിരുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आत्ता कोणताही कॉल सुरू नाही. सुरू असता, तर खाते बदलल्याने तो संपला असता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இப்போது அழைப்பு எதுவும் நடக்கவில்லை. நடந்திருந்தால், கணக்கை மாற்றும்போது அது முடிந்துவிடும்."
          }
        }
      }
    },
    "unlock_one_online": {
      "comment": "Hint at the bottom of the account picker. Only the open account keeps its connection; another account can be woken by a content-free push (a wake-up) so its calls and messages still come through. iOS cannot wake them yet, so their calls ring on the person's other devices.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে শুধু যে অ্যাকাউন্টটি আপনি খুলেছেন সেটিই অনলাইনে থাকে। আপনার অন্য অ্যাকাউন্টগুলোতে কল এলে, সেগুলোতে না বদলানো পর্যন্ত, আপনার অন্য ডিভাইসগুলোতে রিং হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur das Konto, das du öffnest, ist auf diesem Handy online. Anrufe an deine anderen Konten klingeln auf deinen anderen Geräten, bis du zu ihnen wechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the account you open is online on this phone. Calls to your other accounts ring on your other devices until you switch to them."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain avaamasi tili on verkossa tällä puhelimella. Muille tileillesi tulevat puhelut soivat muilla laitteillasi, kunnes vaihdat niihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seul le compte que vous ouvrez est en ligne sur ce téléphone. Les appels vers vos autres comptes sonnent sur vos autres appareils jusqu’à ce que vous les ouvriez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर सिर्फ़ वही खाता ऑनलाइन रहता है जो आपने खोला है। आपके दूसरे खातों की कॉल, जब तक आप उन पर न बदलें, आपके दूसरे डिवाइस पर बजती हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ തുറക്കുന്ന അക്കൗണ്ട് മാത്രമേ ഈ ഫോണിൽ ഓൺലൈനിലുണ്ടാകൂ. നിങ്ങളുടെ മറ്റ് അക്കൗണ്ടുകളിലേക്കുള്ള കോളുകൾ, നിങ്ങൾ അവയിലേക്ക് മാറുന്നതുവരെ നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിൽ റിംഗ് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या फोनवर तुम्ही उघडलेले खातेच ऑनलाइन असते. तुमच्या इतर खात्यांचे कॉल, तुम्ही त्यांच्यावर स्विच करेपर्यंत, तुमच्या इतर डिव्हाइसवर रिंग होतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் திறக்கும் கணக்கு மட்டுமே இந்த ஃபோனில் ஆன்லைனில் இருக்கும். உங்கள் மற்றக் கணக்குகளுக்கான அழைப்புகள், நீங்கள் அவற்றுக்கு மாறும் வரை உங்கள் மற்றச் சாதனங்களில் ஒலிக்கும்."
          }
        }
      }
    },
