    "settings_video_hd_on": {
      "comment": "Subtitle of Sharper video when on.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সবসময় HD-তে শুরু হয়। ডেটা আর ব্যাটারি বেশি লাগে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Startet immer in HD. Braucht mehr Daten und Akku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always starts in HD. Uses more data and battery."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alkaa aina HD-laatuisena. Kuluttaa enemmän dataa ja akkua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Démarre toujours en HD. Consomme plus de données et de batterie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हमेशा HD में शुरू होता है। ज़्यादा डेटा और बैटरी लगती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "എപ്പോഴും HD-യിൽ തുടങ്ങും. കൂടുതൽ ഡാറ്റയും ബാറ്ററിയും ഉപയോഗിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नेहमी HD मध्ये सुरू होतो. जास्त डेटा आणि बॅटरी वापरतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "எப்போதும் HD-யில் தொடங்கும். அதிக டேட்டாவையும் பேட்டரியையும் பயன்படுத்தும்."
          }
        }
      }
    },
