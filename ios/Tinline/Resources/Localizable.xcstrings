    "onboarding_sync_keep": {
      "comment": "Hint while syncing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lass beide Geräte online. Der Abgleich läuft im Hintergrund weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both devices online. Sync keeps going in the background."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pidä molemmat laitteet verkossa. Synkronointi jatkuu taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gardez les deux appareils en ligne. La synchronisation continue en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दोनों डिवाइस ऑनलाइन रखें। सिंक बैकग्राउंड में चलता रहता है।"
          }
        }
      }
    },
    "onboarding_sync_slow": {
      "comment": "Hint when sync is slow to start.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch nichts. Das andere Gerät ist vielleicht offline: Es macht dort weiter, wo es aufgehört hat, sobald beide wieder online sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. The other device may be offline: it picks up where it left off the next time both are online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei vielä mitään. Toinen laite ei ehkä ole verkossa: se jatkaa siitä, mihin jäi, kun molemmat ovat seuraavan kerran verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien pour l’instant. L’autre appareil est peut-être hors ligne : il reprendra là où il s’était arrêté la prochaine fois que les deux seront en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी कुछ नहीं आया। हो सकता है दूसरा डिवाइस ऑफ़लाइन हो: अगली बार दोनों के ऑनलाइन होने पर वह वहीं से आगे बढ़ेगा।"
          }
        }
      }
    },
    "onboarding_sync_waiting": {
      "comment": "Sync progress value while nothing arrived yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wartet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odottaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En attente"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इंतज़ार"
          }
        }
      }
    },
    "onboarding_terms1": {
      "comment": "Bold lead of the first point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ohne Werbung und Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free of ads and tracking."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei mainoksia eikä seurantaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans publicité ni pistage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "विज्ञापन और ट्रैकिंग से मुक्त।"
          }
        }
      }
    },
    "onboarding_terms1_rest": {
      "comment": "Rest of the first point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline sammelt weder deine Kontakte noch deine Anrufe oder deinen Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline doesn’t collect your contacts, calls or location."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ei kerää yhteystietojasi, puheluitasi eikä sijaintiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ne collecte pas vos contacts, vos appels ni votre position."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline आपके संपर्क, कॉल या लोकेशन इकट्ठा नहीं करता।"
          }
        }
      }
    },
    "onboarding_terms2": {
      "comment": "Bold lead of the second point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anrufe sind Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls are end-to-end encrypted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puhelut on salattu päästä päähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les appels sont chiffrés de bout en bout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल एंड-टू-एंड एन्क्रिप्टेड हैं।"
          }
        }
      }
    },
    "onboarding_terms2_rest": {
      "comment": "Rest of the second point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn keine direkte Leitung möglich ist, gibt ein verschlüsseltes Relay den Anruf weiter. Es kann ihn nicht hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a direct line isn’t possible, an encrypted relay passes the call along. It can’t hear it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun suora linja ei ole mahdollinen, salattu välityspalvelin välittää puhelun. Se ei voi kuulla sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quand une ligne directe n’est pas possible, un relais chiffré transmet l’appel. Il ne peut pas l’entendre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब सीधी लाइन मुमकिन न हो, तो एक एन्क्रिप्टेड रिले कॉल को आगे पहुँचाता है। वह उसे सुन नहीं सकता।"
          }
        }
      }
    },
    "onboarding_terms3": {
      "comment": "Bold lead of the third point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto gehört dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is yours."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi on sinun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte vous appartient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता आपका है।"
          }
        }
      }
    },
    "onboarding_terms3_rest": {
      "comment": "Rest of the third point on the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es lebt auf deinen Geräten, nicht auf einem Server. Deine Wiederherstellungswörter sind der Weg zurück, also bewahre sie gut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It lives on your devices, not on a server. Your recovery words are the way back in, so keep them safe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se on laitteillasi, ei palvelimella. Palautussanasi ovat tiesi takaisin, joten pidä ne tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il vit sur vos appareils, pas sur un serveur. Vos mots de récupération sont le moyen d’y revenir, alors gardez-les en lieu sûr."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह आपके डिवाइस पर रहता है, किसी सर्वर पर नहीं। आपके रिकवरी शब्द ही वापस आने का रास्ता हैं, इसलिए उन्हें संभालकर रखें।"
          }
        }
      }
    },
    "onboarding_terms_consent": {
      "comment": "Consent line above the I agree button. Markdown links: keep the [text](url) shape, translate only the link text; {terms_url} and {privacy_url} are web addresses.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du weitermachst, stimmst du den [Nutzungsbedingungen](%1$@) zu und hast die [Datenschutzerklärung](%2$@) gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing, you agree to the [Terms of Use](%1$@) and have read the [Privacy Policy](%2$@)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jatkamalla hyväksyt [käyttöehdot](%1$@) ja olet lukenut [tietosuojakäytännön](%2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En continuant, vous acceptez les [Conditions d’utilisation](%1$@) et confirmez avoir lu la [Politique de confidentialité](%2$@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आगे बढ़ने का मतलब है कि आप [इस्तेमाल की शर्तों](%1$@) से सहमत हैं और आपने [प्राइवेसी पॉलिसी](%2$@) पढ़ ली है।"
          }
        }
      }
    },
    "onboarding_terms_title": {
      "comment": "Title of the terms screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bevor es losgeht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you start"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ennen kuin aloitat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avant de commencer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शुरू करने से पहले"
          }
        }
      }
    },
    "onboarding_tip_devices": {
      "comment": "Tip title on the account-ready screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwei Geräte sind besser als eins"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two devices are better than one"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaksi laitetta on parempi kuin yksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deux appareils valent mieux qu’un"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक से भले दो डिवाइस"
          }
        }
      }
    },
    "onboarding_tip_devices_body": {
      "comment": "Tip body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verknüpfe ein weiteres Gerät, sobald es geht. Dann sperrt dich ein verlorenes Gerät nie aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link another device when you can, so losing one never locks you out."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkitä toinen laite, kun ehdit, niin pääset tilillesi, vaikka yksi laite katoaisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Associez un autre appareil quand vous pouvez : si vous en perdez un, vous gardez l’accès à votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब हो सके, एक और डिवाइस लिंक करें, ताकि एक खो जाने पर भी आप अपने खाते से बाहर न हों।"
          }
        }
      }
    },
    "onboarding_tip_groups": {
      "comment": "Tip title on the account-ready screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gruppen werden auf einem Computer gehostet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups are hosted on a computer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ryhmiä isännöidään tietokoneella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les groupes sont hébergés sur un ordinateur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप कंप्यूटर पर होस्ट होते हैं"
          }
        }
      }
    },
    "onboarding_tip_groups_body": {
      "comment": "Tip body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um eine Gruppe zu starten, richte Tinline auf einem Computer ein, der an bleiben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To start a group, add Tinline on a computer that can stay on."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jos haluat aloittaa ryhmän, asenna Tinline tietokoneelle, joka voi olla jatkuvasti päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour créer un groupe, installez Tinline sur un ordinateur qui peut rester allumé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप शुरू करने के लिए ऐसे कंप्यूटर पर भी Tinline इंस्टॉल करें जो चालू रह सके।"
          }
        }
      }
    },
    "onboarding_try_again": {
      "comment": "Button that retries saving the account.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nochmal versuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yritä uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réessayer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फिर से कोशिश करें"
          }
        }
      }
    },
    "onboarding_trying": {
      "comment": "Button text while retrying.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neuer Versuch…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trying…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yritetään…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nouvel essai…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोशिश जारी है…"
