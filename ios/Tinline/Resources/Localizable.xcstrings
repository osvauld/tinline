    "settings_reads_note": {
      "comment": "Note under the read receipts switch.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পৌঁছানোর টিক তবুও যায়, আর অন্যরা আপনার মেসেজ পড়লে আপনি তা দেখতে পান। এটা বন্ধ থাকার সময় যে মেসেজ পড়েন, সেগুলোর পড়া নিশ্চিত করা হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zustellhäkchen gehen trotzdem raus, und du siehst weiterhin, wenn andere deine lesen. Nachrichten, die du liest, während das aus ist, bleiben unbestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivered ticks still go out either way, and you still see when others read yours. Messages you read while this is off stay unconfirmed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toimituskuittaukset lähtevät joka tapauksessa, ja näet yhä, kun muut lukevat viestisi. Viestit, jotka luet tämän ollessa pois päältä, jäävät vahvistamatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les coches de distribution partent dans tous les cas, et vous voyez toujours quand les autres lisent les vôtres. Les messages lus pendant que c’est désactivé restent sans confirmation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पहुँचने के टिक हर हाल में जाते हैं, और दूसरों ने आपके संदेश कब पढ़े यह आपको दिखता रहेगा। इसके बंद रहते पढ़े गए संदेशों की पुष्टि नहीं भेजी जाएगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "എത്തി എന്ന ടിക്കുകൾ എന്തായാലും അയയ്ക്കും, മറ്റുള്ളവർ നിങ്ങളുടേത് വായിക്കുമ്പോൾ നിങ്ങൾക്ക് കാണാനും കഴിയും. ഇത് ഓഫായിരിക്കുമ്പോൾ നിങ്ങൾ വായിക്കുന്ന സന്ദേശങ്ങൾക്ക് സ്ഥിരീകരണം അയയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पोहोचल्याच्या खुणा तरीही पाठवल्या जातात, आणि इतरांनी तुमचे संदेश वाचले हे तुम्हाला तरीही दिसते. हे बंद असताना तुम्ही वाचलेल्या संदेशांची पुष्टी पाठवली जात नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "எப்படியிருந்தாலும் சேர்ந்த டிக்குகள் அனுப்பப்படும், உங்கள் செய்திகளை மற்றவர்கள் படிக்கும்போது நீங்கள் பார்க்கலாம். இது முடக்கத்தில் இருக்கும்போது நீங்கள் படிக்கும் செய்திகள் உறுதிப்படுத்தப்படாமலே இருக்கும்."
          }
        }
      }
    },
