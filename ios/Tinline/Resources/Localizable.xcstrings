            "value": "Poistu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quitter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "छोड़ें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "പുറത്തുകടക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बाहेर पडा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "வெளியேறு"
          }
        }
      }
    },
    "group_leave_admin": {
      "comment": "Extra line in the leave dialog for admins.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি একজন অ্যাডমিন। মালিক ও অন্য অ্যাডমিনরা থেকে যাবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist Admin. Der Eigentümer und die anderen Admins bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re an admin. The owner and the other admins stay."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olet ylläpitäjä. Omistaja ja muut ylläpitäjät jäävät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes admin. Le propriétaire et les autres admins restent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप एडमिन हैं। मालिक और बाकी एडमिन बने रहेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ഒരു അഡ്മിനാണ്. ഉടമയും മറ്റ് അഡ്മിൻമാരും തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही ॲडमिन आहात. मालक आणि इतर ॲडमिन ग्रुपमध्ये राहतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் ஒரு நிர்வாகி. உரிமையாளரும் மற்ற நிர்வாகிகளும் தொடர்ந்து இருப்பார்கள்."
          }
        }
      }
    },
    "group_leave_text": {
      "comment": "Body of the leave dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি আর পোস্ট পাবেন না। এই ডিভাইসে যা আছে তা থেকে যাবে, পড়তেও পারবেন। ফিরে আসতে হলে গ্রুপের কাউকে আবার আপনাকে আমন্ত্রণ জানাতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bekommst keine Beiträge mehr. Was schon auf diesem Gerät ist, bleibt, und du kannst es lesen. Um zurückzukommen, muss dich jemand aus der Gruppe neu einladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll stop getting posts. What’s already on this device stays, and you can read it. To come back, someone in the group has to invite you again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et saa enää viestejä. Se, mikä on jo tällä laitteella, säilyy, ja voit lukea sitä. Palataksesi tarvitset uuden kutsun joltakulta ryhmän jäseneltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne recevrez plus les publications. Ce qui est déjà sur cet appareil reste, et vous pouvez le lire. Pour revenir, quelqu’un du groupe doit vous inviter à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपको नई पोस्ट मिलनी बंद हो जाएँगी। जो पहले से इस डिवाइस पर है, वह यहीं रहेगा और आप उसे पढ़ सकेंगे। वापस आने के लिए ग्रुप के किसी सदस्य को आपको फिर से आमंत्रित करना होगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾക്ക് ഇനി പോസ്റ്റുകൾ ലഭിക്കില്ല. ഈ ഉപകരണത്തിൽ ഇപ്പോഴുള്ളവ നിലനിൽക്കും, അവ വായിക്കാം. തിരികെ വരാൻ, ഗ്രൂപ്പിലെ ആരെങ്കിലും നിങ്ങളെ വീണ്ടും ക്ഷണിക്കണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्हाला पोस्ट मिळणे बंद होईल. या डिव्हाइसवर आधीपासून असलेले तसेच राहील आणि तुम्ही ते वाचू शकता. परत येण्यासाठी ग्रुपमधील कोणालातरी तुम्हाला पुन्हा आमंत्रित करावे लागेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இனி இடுகைகள் வராது. இந்தச் சாதனத்தில் ஏற்கெனவே உள்ளவை இருக்கும், அவற்றைப் படிக்கலாம். மீண்டும் சேர, குழுவில் உள்ள யாராவது உங்களை மீண்டும் அழைக்க வேண்டும்."
          }
        }
      }
    },
    "group_leave_title": {
      "comment": "Title of the leave dialog. {group} is the group’s name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ছেড়ে দেবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ verlassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave %1$@?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poistutko ryhmästä %1$@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quitter %1$@ ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ छोड़ें?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ഗ്രൂപ്പിൽ നിന്ന് പുറത്തുകടക്കണോ?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ सोडायचा?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ குழுவிலிருந்து வெளியேறவா?"
          }
        }
      }
    },
    "group_left_footer": {
      "comment": "Footer of a group chat after the user left.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি এই গ্রুপ ছেড়ে দিয়েছেন। এর মেসেজগুলো এখানে থাকবে, শুধু পড়ার জন্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast diese Gruppe verlassen. Die Nachrichten bleiben hier, nur zum Lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left this group. Its messages stay here, read-only."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poistuit tästä ryhmästä. Sen viestit jäävät tänne luettaviksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez quitté ce groupe. Ses messages restent ici, en lecture seule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने यह ग्रुप छोड़ दिया है। इसके संदेश यहाँ रहेंगे, सिर्फ़ पढ़ने के लिए।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ഈ ഗ്രൂപ്പിൽ നിന്ന് പുറത്തുകടന്നു. ഇതിലെ സന്ദേശങ്ങൾ ഇവിടെത്തന്നെയുണ്ടാകും, വായിക്കാൻ മാത്രം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही हा ग्रुप सोडला. त्याचे संदेश इथे राहतात, फक्त वाचण्यासाठी."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் இந்தக் குழுவிலிருந்து வெளியேறிவிட்டீர்கள். அதன் செய்திகள் இங்கேயே இருக்கும், படிக்க மட்டும்."
          }
        }
      }
    },
    "group_link_hint": {
      "comment": "Hint above the group invite link QR. {group} is the group's name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই লিঙ্ক বা QR যাঁর কাছে আছে, তিনিই 7 দিন ধরে %1$@-এ যোগ দিতে পারবেন। ভরসার কোনো অ্যাপে শেয়ার করুন; কে যোগ দিলেন তা আপনি দেখতে পাবেন, আর ফ্ল্যাগ করে সরাতে পারবেন। পরিচিতিদের সরাসরি আমন্ত্রণ জানাতে “সদস্য যোগ করুন” ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle mit diesem Link oder QR-Code können %1$@ 7 Tage lang beitreten. Teile ihn über eine App, der du vertraust; du siehst, wer beigetreten ist, und kannst Leute per Markierung entfernen. Um deine Kontakte direkt einzuladen, nutze „Mitglieder hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this link or QR can join %1$@ for 7 days. Share it over an app you trust; you see who joined and can flag them out. To invite your contacts directly, use Add members."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuka tahansa, jolla on tämä linkki tai QR-koodi, voi liittyä ryhmään %1$@ 7 päivän ajan. Jaa se sovelluksella, johon luotat; näet, kuka liittyi, ja voit merkitä hänet poistettavaksi. Jos haluat kutsua yhteystietojasi suoraan, käytä kohtaa Lisää jäseniä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne qui a ce lien ou ce QR code peut rejoindre %1$@ pendant 7 jours. Partagez-le via une app de confiance ; vous voyez qui a rejoint et pouvez les signaler pour retrait. Pour inviter directement vos contacts, utilisez Ajouter des membres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस लिंक या QR वाला कोई भी 7 दिन तक %1$@ से जुड़ सकता है। इसे किसी भरोसेमंद ऐप से शेयर करें; कौन जुड़ा यह आपको दिखेगा और आप उन्हें फ़्लैग करके हटा सकते हैं। अपने संपर्कों को सीधे आमंत्रित करने के लिए “सदस्य जोड़ें” का इस्तेमाल करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ലിങ്കോ QR-ഓ ഉള്ള ആർക്കും 7 ദിവസത്തേക്ക് %1$@ ഗ്രൂപ്പിൽ ചേരാം. നിങ്ങൾ വിശ്വസിക്കുന്ന ഒരു ആപ്പ് വഴി ഇത് പങ്കിടുക; ആരൊക്കെ ചേർന്നുവെന്ന് നിങ്ങൾക്ക് കാണാം, അവരെ ഫ്ലാഗ് ചെയ്ത് പുറത്താക്കാനും കഴിയും. നിങ്ങളുടെ കോൺടാക്റ്റുകളെ നേരിട്ട് ക്ഷണിക്കാൻ, അംഗങ്ങളെ ചേർക്കുക ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ही लिंक किंवा QR असलेले कोणीही 7 दिवसांपर्यंत %1$@ मध्ये सामील होऊ शकतात. तुमच्या विश्वासाच्या ॲपमधून ती शेअर करा; कोण सामील झाले ते तुम्हाला दिसते आणि तुम्ही त्यांना फ्लॅग करून काढू शकता. तुमच्या संपर्कांना थेट आमंत्रित करण्यासाठी \"सदस्य जोडा\" वापरा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த இணைப்பு அல்லது QR உள்ள எவரும் 7 நாட்களுக்கு %1$@ குழுவில் சேரலாம். நீங்கள் நம்பும் ஆப் மூலம் அதைப் பகிருங்கள்; யார் சேர்ந்தார்கள் என்பதைப் பார்க்கலாம், கொடியிட்டு அவர்களை நீக்கலாம். உங்கள் தொடர்புகளை நேரடியாக அழைக்க, உறுப்பினர்களைச் சேர் என்பதைப் பயன்படுத்துங்கள்."
          }
        }
      }
    },
    "group_link_hint_unnamed": {
      "comment": "Hint above the group invite link QR when the group's name is not known.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই লিঙ্ক বা QR যাঁর কাছে আছে, তিনিই 7 দিন ধরে এই গ্রুপে যোগ দিতে পারবেন। ভরসার কোনো অ্যাপে শেয়ার করুন; কে যোগ দিলেন তা আপনি দেখতে পাবেন, আর ফ্ল্যাগ করে সরাতে পারবেন। পরিচিতিদের সরাসরি আমন্ত্রণ জানাতে “সদস্য যোগ করুন” ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle mit diesem Link oder QR-Code können dieser Gruppe 7 Tage lang beitreten. Teile ihn über eine App, der du vertraust; du siehst, wer beigetreten ist, und kannst Leute per Markierung entfernen. Um deine Kontakte direkt einzuladen, nutze „Mitglieder hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this link or QR can join this group for 7 days. Share it over an app you trust; you see who joined and can flag them out. To invite your contacts directly, use Add members."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuka tahansa, jolla on tämä linkki tai QR-koodi, voi liittyä tähän ryhmään 7 päivän ajan. Jaa se sovelluksella, johon luotat; näet, kuka liittyi, ja voit merkitä hänet poistettavaksi. Jos haluat kutsua yhteystietojasi suoraan, käytä kohtaa Lisää jäseniä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne qui a ce lien ou ce QR code peut rejoindre ce groupe pendant 7 jours. Partagez-le via une app de confiance ; vous voyez qui a rejoint et pouvez les signaler pour retrait. Pour inviter directement vos contacts, utilisez Ajouter des membres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस लिंक या QR वाला कोई भी 7 दिन तक इस ग्रुप से जुड़ सकता है। इसे किसी भरोसेमंद ऐप से शेयर करें; कौन जुड़ा यह आपको दिखेगा और आप उन्हें फ़्लैग करके हटा सकते हैं। अपने संपर्कों को सीधे आमंत्रित करने के लिए “सदस्य जोड़ें” का इस्तेमाल करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ലിങ്കോ QR-ഓ ഉള്ള ആർക്കും 7 ദിവസത്തേക്ക് ഈ ഗ്രൂപ്പിൽ ചേരാം. നിങ്ങൾ വിശ്വസിക്കുന്ന ഒരു ആപ്പ് വഴി ഇത് പങ്കിടുക; ആരൊക്കെ ചേർന്നുവെന്ന് നിങ്ങൾക്ക് കാണാം, അവരെ ഫ്ലാഗ് ചെയ്ത് പുറത്താക്കാനും കഴിയും. നിങ്ങളുടെ കോൺടാക്റ്റുകളെ നേരിട്ട് ക്ഷണിക്കാൻ, അംഗങ്ങളെ ചേർക്കുക ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ही लिंक किंवा QR असलेले कोणीही 7 दिवसांपर्यंत या ग्रुपमध्ये सामील होऊ शकतात. तुमच्या विश्वासाच्या ॲपमधून ती शेअर करा; कोण सामील झाले ते तुम्हाला दिसते आणि तुम्ही त्यांना फ्लॅग करून काढू शकता. तुमच्या संपर्कांना थेट आमंत्रित करण्यासाठी \"सदस्य जोडा\" वापरा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த இணைப்பு அல்லது QR உள்ள எவரும் 7 நாட்களுக்கு இந்தக் குழுவில் சேரலாம். நீங்கள் நம்பும் ஆப் மூலம் அதைப் பகிருங்கள்; யார் சேர்ந்தார்கள் என்பதைப் பார்க்கலாம், கொடியிட்டு அவர்களை நீக்கலாம். உங்கள் தொடர்புகளை நேரடியாக அழைக்க, உறுப்பினர்களைச் சேர் என்பதைப் பயன்படுத்துங்கள்."
          }
        }
      }
    },
