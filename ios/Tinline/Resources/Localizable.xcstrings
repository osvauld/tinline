          "stringUnit": {
            "state": "needs_review",
            "value": "വീണ്ടെടുക്കൽ വാക്കുകൾ ഉപയോഗിച്ച് പുനഃസ്ഥാപിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिकव्हरी शब्दांनी परत मिळवा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மீட்பு வார்த்தைகளால் மீட்டெடு"
          }
        }
      }
    },
    "unlock_slow_hint": {
      "comment": "Hint under the passphrase field after a wrong try.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাচাই করতে এক সেকেন্ড লাগে। আন্দাজে চেষ্টা আটকাতে এটা ইচ্ছে করেই ধীর।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Prüfen dauert eine Sekunde. Es ist absichtlich langsam, damit niemand raten kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking takes a second. It’s deliberately slow to stop guessing."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarkistus kestää hetken. Se on tarkoituksella hidas, jotta arvaaminen olisi vaikeaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vérification prend une seconde. Elle est lente exprès pour empêcher les essais au hasard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँच में एक पल लगता है। अंदाज़ा लगाने से रोकने के लिए यह जान-बूझकर धीमा है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "പരിശോധിക്കാൻ ഒരു നിമിഷം എടുക്കും. ഊഹിച്ചെടുക്കൽ തടയാൻ മനഃപൂർവം വേഗത കുറച്ചിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपासायला एक सेकंद लागतो. अंदाजाने प्रयत्न करणे थांबवण्यासाठी हे मुद्दाम हळू केले आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சரிபார்க்க ஒரு வினாடி ஆகும். ஊகித்துத் திறப்பதைத் தடுக்கவே இது வேண்டுமென்றே மெதுவாக உள்ளது."
          }
        }
      }
    },
    "unlock_switch": {
      "comment": "Button on the lost-key screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
