      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flags can’t be taken back, and removal is final. The same admin can flag more than once; each flag counts."
          }
        }
      }
    },
    "group_flag_text2": {
      "comment": "Second paragraph of the flag confirmation. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagging is a decision for the group. It is separate from blocking, which only affects you. %1$@ sees each flag: who made it and when."
