    "settings_accounts_note": {
      "comment": "Explanation under the account list.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে শুধু বেছে নেওয়া অ্যাকাউন্টটিই অনলাইনে থাকে। বদলালে অন্যটি থেমে যায়: আবার বেছে না নেওয়া পর্যন্ত সেটিতে কোনো কল আসে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur das ausgewählte Konto ist auf diesem Handy online. Ein Wechsel pausiert das andere: Es bekommt keine Anrufe, bis du es wieder auswählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the selected account is online on this phone. Switching pauses the other one: it receives no calls until you select it again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain valittu tili on verkossa tällä puhelimella. Vaihtaminen laittaa toisen tauolle: se ei vastaanota puheluita, ennen kuin valitset sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seul le compte sélectionné est en ligne sur ce téléphone. Changer met l’autre en pause : il ne reçoit aucun appel jusqu’à ce que vous le sélectionniez à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर सिर्फ़ चुना हुआ खाता ऑनलाइन रहता है। खाता बदलने पर दूसरा रुक जाता है: जब तक आप उसे फिर से न चुनें, उस पर कॉल नहीं आतीं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "തിരഞ്ഞെടുത്ത അക്കൗണ്ട് മാത്രമേ ഈ ഫോണിൽ ഓൺലൈനിലുണ്ടാകൂ. മാറുമ്പോൾ മറ്റേത് താൽക്കാലികമായി നിർത്തും: നിങ്ങൾ വീണ്ടും തിരഞ്ഞെടുക്കുന്നതുവരെ അതിന് കോളുകൾ ലഭിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या फोनवर फक्त निवडलेले खाते ऑनलाइन असते. खाते बदलल्यावर दुसरे थांबते: तुम्ही ते पुन्हा निवडेपर्यंत त्याला कॉल येत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தேர்ந்தெடுத்த கணக்கு மட்டுமே இந்த ஃபோனில் ஆன்லைனில் இருக்கும். மாறினால் மற்றது இடைநிறுத்தப்படும்: மீண்டும் அதைத் தேர்ந்தெடுக்கும் வரை அதற்கு அழைப்புகள் வராது."
          }
        }
      }
    },
