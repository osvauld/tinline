    "people_blocked_empty": {
      "comment": "Blocked people screen when nobody is blocked.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কেউ ব্লক করা নেই। কাউকে ব্লক করতে তাঁর পরিচিতির পেজ খুলে “ব্লক করুন”-এ ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niemand ist blockiert. Um jemanden zu blockieren, öffne die Kontaktseite der Person und tippe auf Blockieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is blocked. To block someone, open their contact page and tap Block."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ketään ei ole estetty. Jos haluat estää jonkun, avaa hänen yhteystietosivunsa ja napauta Estä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personne n’est bloqué. Pour bloquer quelqu’un, ouvrez sa page de contact et touchez Bloquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी को ब्लॉक नहीं किया गया है। किसी को ब्लॉक करने के लिए उनका संपर्क पेज खोलें और ब्लॉक करें पर टैप करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആരെയും ബ്ലോക്ക് ചെയ്തിട്ടില്ല. ഒരാളെ ബ്ലോക്ക് ചെയ്യാൻ, അവരുടെ കോൺടാക്റ്റ് പേജ് തുറന്ന് ബ്ലോക്ക് ചെയ്യുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोणीही ब्लॉक केलेले नाही. एखाद्याला ब्लॉक करण्यासाठी, त्यांचे संपर्क पेज उघडा आणि \"ब्लॉक करा\" वर टॅप करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "யாரும் தடுக்கப்படவில்லை. ஒருவரைத் தடுக்க, அவரது தொடர்புப் பக்கத்தைத் திறந்து தடு என்பதைத் தட்டுங்கள்."
          }
        }
      }
    },
    "people_blocked_list_note": {
      "comment": "Note at the top of the Blocked people screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার সব ডিভাইসে একটিই তালিকা: অন্য ডিভাইসে কাউকে ব্লক করলে তা এখানেও দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Liste für all deine Geräte: Eine Blockierung auf einem anderen Gerät erscheint auch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One list across all your devices: a block made on another device shows here too."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksi lista kaikilla laitteillasi: toisella laitteella tehty esto näkyy myös täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une seule liste sur tous vos appareils : un blocage fait sur un autre appareil apparaît aussi ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके सभी डिवाइस पर एक ही सूची: दूसरे डिवाइस पर किया गया ब्लॉक भी यहाँ दिखता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഒരേ ലിസ്റ്റ്: മറ്റൊരു ഉപകരണത്തിൽ ബ്ലോക്ക് ചെയ്തതും ഇവിടെ കാണിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या सर्व डिव्हाइसवर एकच यादी: दुसऱ्या डिव्हाइसवरून केलेला ब्लॉकही इथे दिसतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் எல்லாச் சாதனங்களுக்கும் ஒரே பட்டியல்: வேறு சாதனத்தில் செய்த தடுப்பும் இங்கே தெரியும்."
          }
        }
      }
    },
