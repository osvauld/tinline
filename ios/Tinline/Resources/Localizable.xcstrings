    "devices_unlink_warn": {
      "comment": "Warning card in the unlink dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লিঙ্ক সরালেও এখান থেকে ওটা লক করা যায় না। যিনি ওটা আনলক করতে পারেন, তিনি তবুও আপনার অ্যাকাউন্ট ব্যবহার করতে পারবেন। পুরোপুরি আলাদা হওয়ার একমাত্র উপায় একটি নতুন অ্যাকাউন্ট।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trennen kann es von hier aus nicht sperren. Wer es entsperren kann, kann dein Konto weiter nutzen. Ganz aussperren kannst du es nur mit einem neuen Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlinking can’t lock it from here. Anyone who can unlock it can still use your account. The only full cut-off is a new account."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkityksen poisto ei voi lukita sitä täältä. Kuka tahansa, joka saa sen auki, voi yhä käyttää tiliäsi. Ainoa tapa katkaista kaikki kokonaan on uusi tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dissociation ne peut pas le verrouiller à distance. Toute personne capable de le déverrouiller peut encore utiliser votre compte. La seule coupure complète, c’est un nouveau compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लिंक हटाने से वह डिवाइस यहाँ से लॉक नहीं होता। जो भी उसे अनलॉक कर सकता है, वह अब भी आपका खाता इस्तेमाल कर सकता है। पूरी तरह अलग होने का एक ही तरीका है: नया खाता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ലിങ്ക് ഒഴിവാക്കിയാലും ഇവിടെ നിന്ന് അത് ലോക്ക് ചെയ്യാൻ കഴിയില്ല. അത് അൺലോക്ക് ചെയ്യാൻ കഴിയുന്ന ആർക്കും നിങ്ങളുടെ അക്കൗണ്ട് തുടർന്നും ഉപയോഗിക്കാം. പൂർണ്ണമായി ബന്ധം മുറിക്കാനുള്ള ഒരേയൊരു വഴി പുതിയൊരു അക്കൗണ്ടാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लिंक काढल्याने ते डिव्हाइस इथून लॉक करता येत नाही. ते अनलॉक करू शकणारे कोणीही तरीही तुमचे खाते वापरू शकतात. पूर्णपणे संबंध तोडण्याचा एकमेव मार्ग म्हणजे नवीन खाते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இணைப்பை நீக்குவதால் அதை இங்கிருந்து பூட்ட முடியாது. அதைத் திறக்கக்கூடிய எவரும் உங்கள் கணக்கை இன்னும் பயன்படுத்தலாம். முழுமையாகத் துண்டிக்க ஒரே வழி புதிய கணக்குதான்."
          }
        }
      }
    },
