    "shell_mic_body": {
      "comment": "Explains microphone permission when denied.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা ছাড়া ওঁরা আপনার কথা শুনতে পাবেন না। Tinline শুধু কলের সময় শোনে — ব্যাকগ্রাউন্ডে কখনও নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ohne Mikrofon hört man dich nicht. Tinline hört nur während Anrufen zu – nie im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, they won’t hear you. Tinline only listens during calls — never in the background."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ilman sitä sinua ei kuulla. Tinline kuuntelee vain puheluiden aikana — ei koskaan taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans lui, on ne vous entendra pas. Tinline n’écoute que pendant les appels — jamais en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसके बिना वे आपको नहीं सुन पाएँगे। Tinline सिर्फ़ कॉल के दौरान सुनता है — बैकग्राउंड में कभी नहीं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അതില്ലാതെ അവർക്ക് നിങ്ങളെ കേൾക്കാനാകില്ല. Tinline കോളുകൾക്കിടയിൽ മാത്രമേ കേൾക്കൂ — ഒരിക്കലും പശ്ചാത്തലത്തിൽ കേൾക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्याशिवाय त्यांना तुमचा आवाज ऐकू येणार नाही. Tinline फक्त कॉलदरम्यान ऐकते — बॅकग्राउंडमध्ये कधीच नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அது இல்லாமல், அவர்களுக்கு உங்கள் குரல் கேட்காது. Tinline அழைப்புகளின்போது மட்டுமே மைக்ரோஃபோனைப் பயன்படுத்தும் — பின்னணியில் ஒருபோதும் இல்லை."
          }
        }
      }
    },
    "shell_mic_hint": {
      "comment": "Hint with the path to the microphone permission in iOS Settings.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "তারপর সেটিংস › Tinline › মাইক্রোফোন-এ গিয়ে অনুমতি দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geh dann zu Einstellungen › Tinline › Mikrofon und erlaube es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then go to Settings › Tinline › Microphone and allow it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siirry sitten kohtaan Asetukset › Tinline › Mikrofoni ja salli se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allez ensuite dans Réglages › Tinline › Micro et autorisez-le."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फिर सेटिंग › Tinline › माइक्रोफ़ोन में जाकर इसकी अनुमति दें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "തുടർന്ന് ക്രമീകരണം › Tinline › മൈക്രോഫോൺ എന്നതിൽ ചെന്ന് അത് അനുവദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मग सेटिंग्ज › Tinline › मायक्रोफोन येथे जाऊन परवानगी द्या."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பிறகு அமைப்புகள் › Tinline › மைக்ரோஃபோன் என்பதற்குச் சென்று அதை அனுமதியுங்கள்."
          }
        }
      }
    },
