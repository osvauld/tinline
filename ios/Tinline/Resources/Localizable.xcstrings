    "call_group_battery_limited": {
      "comment": "Note on the group call screen when this phone is the call host and its battery is low. {percent} is the battery level below which hosting is limited.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akku unter %1$@ %%. Das Hosten ist eingeschränkt: Es ist immer nur eine Person zu hören, und niemand Neues kann beitreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery under %1$@ %%. Hosting is limited: only one person is heard at a time, and no one new can join."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun varaus on alle %1$@ %%. Isännöintiä on rajoitettu: vain yksi henkilö kuuluu kerrallaan, eikä kukaan uusi voi liittyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Batterie sous %1$@ %%. L’hébergement est limité : une seule personne est entendue à la fois, et aucun nouveau participant ne peut rejoindre l’appel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बैटरी %1$@ %% से कम। होस्टिंग सीमित है: एक समय में एक ही व्यक्ति सुनाई देगा, और कोई नया नहीं जुड़ सकता।"
          }
        }
      }
    },
