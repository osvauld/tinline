        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salattu päästä päähän. Äänesi salataan tällä laitteella ja puretaan vain henkilön %1$@ laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffré de bout en bout. Votre voix est chiffrée sur cet appareil et déchiffrée uniquement sur celui de %1$@."
