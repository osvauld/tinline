    "link_done_body": {
      "comment": "Body when linking finished.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "দুটো ডিভাইস একসঙ্গে অনলাইনে থাকলে সিঙ্ক হয়। যে পরিচিতিদের আপনি ব্লক করেননি, তাঁরা পরের বার অনলাইনে এলে আপনার ডিভাইসের নতুন তালিকা পাবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es gleicht sich ab, wenn beide Geräte gleichzeitig online sind. Kontakte, die du nicht blockiert hast, bekommen deine neue Geräteliste, wenn sie das nächste Mal online sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It syncs when both devices are online at the same time. Contacts you haven’t blocked get your updated device list when they’re next online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se synkronoituu, kun molemmat laitteet ovat verkossa yhtä aikaa. Yhteystiedot, joita et ole estänyt, saavat päivitetyn laitelistasi, kun ovat seuraavan kerran verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il se synchronise quand les deux appareils sont en ligne en même temps. Les contacts que vous n’avez pas bloqués reçoivent votre liste d’appareils à jour lors de leur prochaine connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब दोनों डिवाइस एक साथ ऑनलाइन होते हैं, तब यह सिंक होता है। जिन संपर्कों को आपने ब्लॉक नहीं किया है, उन्हें अगली बार ऑनलाइन आने पर आपके डिवाइस की नई सूची मिल जाएगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "രണ്ട് ഉപകരണങ്ങളും ഒരേസമയം ഓൺലൈനിലാകുമ്പോൾ ഇത് സിങ്ക് ചെയ്യും. നിങ്ങൾ ബ്ലോക്ക് ചെയ്യാത്ത കോൺടാക്റ്റുകൾക്ക് അടുത്ത തവണ ഓൺലൈനിൽ വരുമ്പോൾ നിങ്ങളുടെ പുതുക്കിയ ഉപകരണ ലിസ്റ്റ് ലഭിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दोन्ही डिव्हाइस एकाच वेळी ऑनलाइन असताना ते सिंक होते. तुम्ही ब्लॉक न केलेल्या संपर्कांना ते पुढच्या वेळी ऑनलाइन आल्यावर तुमच्या डिव्हाइसची नवीन यादी मिळते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இரண்டு சாதனங்களும் ஒரே நேரத்தில் ஆன்லைனில் இருக்கும்போது இது ஒத்திசைக்கும். நீங்கள் தடுக்காத தொடர்புகள் அடுத்த முறை ஆன்லைனுக்கு வரும்போது உங்கள் புதுப்பிக்கப்பட்ட சாதனப் பட்டியலைப் பெறுவார்கள்."
          }
        }
      }
    },
