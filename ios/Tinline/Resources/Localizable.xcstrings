    "onboarding_restore_warn": {
      "comment": "Notice on the restore screen during sign-up.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এরপর আপনি এই অ্যাকাউন্টের জন্য একটি পাসফ্রেজ বেছে নেবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als Nächstes wählst du eine Passphrase für dieses Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, you’ll choose a passphrase for this account."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seuraavaksi valitset tälle tilille salalauseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ensuite, vous choisirez une phrase secrète pour ce compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसके बाद आप इस खाते के लिए पासफ़्रेज़ चुनेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അടുത്തതായി, ഈ അക്കൗണ്ടിനുള്ള പാസ്‌ഫ്രേസ് നിങ്ങൾ തിരഞ്ഞെടുക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पुढे तुम्ही या खात्यासाठी पासफ्रेज निवडाल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அடுத்து, இந்தக் கணக்குக்கு ஒரு கடவுச்சொற்றொடரைத் தேர்ந்தெடுப்பீர்கள்."
          }
        }
      }
    },
    "onboarding_restore_warn_forgot": {
      "comment": "Notice on the restore screen after I forgot my passphrase.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফিরিয়ে আনলে একই পরিচয় থাকে: এই অ্যাকাউন্টের রিকভারি শব্দই ব্যবহার করুন। আপনি একটি নতুন পাসফ্রেজ সেট করবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Wiederherstellen bleibt die Identität gleich: Nutze die Wiederherstellungswörter dieses Kontos. Du legst eine neue Passphrase fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring keeps the same identity: use the recovery phrase of this account. You’ll set a new passphrase."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palautus säilyttää saman identiteetin: käytä tämän tilin palautussanoja. Asetat uuden salalauseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurer garde la même identité : utilisez les mots de récupération de ce compte. Vous choisirez une nouvelle phrase secrète."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वापस लाने पर पहचान वही रहती है: इस खाते के रिकवरी शब्द इस्तेमाल करें। आप नया पासफ़्रेज़ रखेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "പുനഃസ്ഥാപിക്കുമ്പോൾ ഐഡന്റിറ്റി അതുതന്നെയായിരിക്കും: ഈ അക്കൗണ്ടിന്റെ വീണ്ടെടുക്കൽ വാക്കുകൾ ഉപയോഗിക്കുക. നിങ്ങൾ പുതിയൊരു പാസ്‌ഫ്രേസ് സജ്ജീകരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "खाते परत मिळवल्याने ओळख तीच राहते: या खात्याचे रिकव्हरी शब्द वापरा. तुम्ही नवीन पासफ्रेज सेट कराल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மீட்டெடுத்தால் அதே அடையாளம் தொடரும்: இந்தக் கணக்கின் மீட்பு வார்த்தைகளைப் பயன்படுத்துங்கள். நீங்கள் புதிய கடவுச்சொற்றொடரை அமைப்பீர்கள்."
          }
        }
      }
    },
