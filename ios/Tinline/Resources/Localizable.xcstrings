    "group_notice_request_accepted": {
      "comment": "Notice when your private chat request was accepted. {name} is the other member's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ আপনার অনুরোধ গ্রহণ করেছেন। এখন আপনারা একে অপরকে মেসেজ করতে পারবেন; আপনাদের কেউ একজন অনুমতি না দেওয়া পর্যন্ত কল বন্ধ থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ hat deine Anfrage angenommen. Ihr könnt euch jetzt schreiben; Anrufe bleiben aus, bis einer von euch sie erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ accepted your request. You can message each other now; calls stay off until one of you allows them."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ hyväksyi pyyntösi. Voitte nyt lähettää viestejä toisillenne; puhelut pysyvät pois päältä, kunnes jompikumpi teistä sallii ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ a accepté votre demande. Vous pouvez maintenant vous écrire ; les appels restent désactivés jusqu’à ce que l’un de vous les autorise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने आपका अनुरोध स्वीकार कर लिया। अब आप एक-दूसरे को संदेश भेज सकते हैं; जब तक आप में से कोई अनुमति न दे, कॉल बंद रहेंगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ നിങ്ങളുടെ അഭ്യർത്ഥന സ്വീകരിച്ചു. ഇപ്പോൾ നിങ്ങൾക്ക് പരസ്പരം സന്ദേശം അയയ്ക്കാം; നിങ്ങളിലൊരാൾ അനുവദിക്കുന്നതുവരെ കോളുകൾ ഓഫായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने तुमची विनंती स्वीकारली. आता तुम्ही एकमेकांना संदेश पाठवू शकता; तुमच्यापैकी कोणीतरी परवानगी देईपर्यंत कॉल बंद राहतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ உங்கள் கோரிக்கையை ஏற்றுக்கொண்டார். இப்போது நீங்கள் இருவரும் செய்தி அனுப்பலாம்; உங்களில் ஒருவர் அனுமதிக்கும் வரை அழைப்புகள் முடக்கத்தில் இருக்கும்."
          }
        }
      }
    },
    "group_notice_request_accepted_unnamed": {
      "comment": "Notice when your private chat request was accepted by someone whose name is not known.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
