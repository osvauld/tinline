    "people_crop_failed": {
      "comment": "Error when the crop could not be made.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ছবিটা তৈরি করা গেল না। অন্য একটি ছবি দিয়ে দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
