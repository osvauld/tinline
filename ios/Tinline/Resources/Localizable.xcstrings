    "group_done_decline_invite": {
      "comment": "Toast after declining an invitation. {name} is the person who invited you.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফিরিয়ে দেওয়া হয়েছে। %1$@ দেখতে পাবেন যে আপনি ফিরিয়ে দিয়েছেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abgelehnt. %1$@ sieht, dass du abgelehnt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined. %1$@ sees that you declined."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hylätty. %1$@ näkee, että hylkäsit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Refusé. %1$@ voit que vous avez refusé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अस्वीकार किया। %1$@ को दिखेगा कि आपने अस्वीकार किया।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിരസിച്ചു. നിങ്ങൾ നിരസിച്ചുവെന്ന് %1$@ കാണും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नाकारले. तुम्ही नाकारल्याचे %1$@ ला दिसते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நிராகரிக்கப்பட்டது. நீங்கள் நிராகரித்ததை %1$@ பார்ப்பார்."
          }
        }
      }
    },
