    "link_code_once": {
      "comment": "Hint under the camera view.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোডটি একবারই কাজ করে, আর 5 মিনিটে মেয়াদ শেষ হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Code funktioniert einmal und läuft nach 5 Minuten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code works once and expires in 5 minutes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koodi toimii kerran ja vanhenee 5 minuutissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le code fonctionne une fois et expire au bout de 5 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड एक बार काम करता है और 5 मिनट में खत्म हो जाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കോഡ് ഒരു തവണ മാത്രം പ്രവർത്തിക്കും, 5 മിനിറ്റിനുള്ളിൽ കാലാവധി തീരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड एकदाच चालतो आणि 5 मिनिटांत त्याची मुदत संपते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குறியீடு ஒருமுறை மட்டுமே செயல்படும், 5 நிமிடங்களில் காலாவதியாகும்."
          }
        }
      }
    },
