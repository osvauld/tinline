    },
    "link_approve_body": {
      "comment": "Warning on the approval step. The words **recovery phrase** are bold (markdown stars, keep them around the same words); {name} is the new device's name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du bestätigst, gehen deine **Wiederherstellungswörter** an %1$@. Es wird eine vollständige Kopie von dir: Es kann deine Chats lesen und als du auftreten. Bestätige nur ein Gerät, das du in der Hand hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving sends your **recovery phrase** to %1$@. It becomes a full copy of you: it can read your chats and act as you. Approve only a device you hold."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksyminen lähettää **palautussanasi** laitteelle %1$@. Siitä tulee täysi kopio sinusta: se voi lukea keskustelusi ja toimia sinuna. Hyväksy vain laite, joka on itselläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valider envoie vos **mots de récupération** à %1$@. Cet appareil devient une copie complète de votre compte : il peut lire vos discussions et agir en votre nom. Ne validez qu’un appareil que vous avez en main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मंज़ूरी देने पर आपके **रिकवरी शब्द** %1$@ को भेजे जाएँगे। वह पूरी तरह आपकी कॉपी बन जाता है: वह आपकी चैट पढ़ सकता है और आपके नाम से काम कर सकता है। सिर्फ़ उसी डिवाइस को मंज़ूरी दें जो आपके हाथ में है।"
          }
        }
      }
    },
    "link_approve_body_unnamed": {
      "comment": "Warning on the approval step when the new device has no name. The words **recovery phrase** are bold (markdown stars, keep them around the same words).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du bestätigst, gehen deine **Wiederherstellungswörter** an das neue Gerät. Es wird eine vollständige Kopie von dir: Es kann deine Chats lesen und als du auftreten. Bestätige nur ein Gerät, das du in der Hand hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving sends your **recovery phrase** to the new device. It becomes a full copy of you: it can read your chats and act as you. Approve only a device you hold."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksyminen lähettää **palautussanasi** uudelle laitteelle. Siitä tulee täysi kopio sinusta: se voi lukea keskustelusi ja toimia sinuna. Hyväksy vain laite, joka on itselläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valider envoie vos **mots de récupération** au nouvel appareil. Il devient une copie complète de votre compte : il peut lire vos discussions et agir en votre nom. Ne validez qu’un appareil que vous avez en main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मंज़ूरी देने पर आपके **रिकवरी शब्द** नए डिवाइस को भेजे जाएँगे। वह पूरी तरह आपकी कॉपी बन जाता है: वह आपकी चैट पढ़ सकता है और आपके नाम से काम कर सकता है। सिर्फ़ उसी डिवाइस को मंज़ूरी दें जो आपके हाथ में है।"
          }
        }
      }
    },
