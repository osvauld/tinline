        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोटो खिसकाने के लिए खींचें। ज़ूम के लिए स्लाइडर इस्तेमाल करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫോട്ടോ നീക്കാൻ വലിച്ചിടുക. സൂം ചെയ്യാൻ സ്ലൈഡർ ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फोटो हलवण्यासाठी ड्रॅग करा. झूम करण्यासाठी स्लायडर वापरा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "படத்தை நகர்த்த இழுங்கள். பெரிதாக்க ஸ்லைடரைப் பயன்படுத்துங்கள்."
          }
