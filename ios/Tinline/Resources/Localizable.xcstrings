      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours will be flag %1$@ of %2$@. %3$@ is removed right away: hosts refuse their new messages and they see they were removed."
          }
        }
      }
    },
    "group_flag_meter_desc": {
      "comment": "Spoken label of the flag meter. {next} is which flag this would be, {total} flags that remove.",
