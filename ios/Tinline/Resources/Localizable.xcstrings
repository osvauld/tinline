    "group_info_leave": {
      "comment": "Row on group info that opens the leave dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রুপ ছেড়ে দিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gruppe verlassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave group"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poistu ryhmästä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quitter le groupe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप छोड़ें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഗ്രൂപ്പിൽ നിന്ന് പുറത്തുകടക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुप सोडा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குழுவிலிருந்து வெளியேறு"
          }
        }
      }
    },
    "group_info_left_note": {
      "comment": "Note on the info page after the user left the group.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ডিভাইসে পোস্টগুলো এখনও পড়তে পারবেন। ফিরে আসতে হলে গ্রুপের কাউকে আবার আপনাকে আমন্ত্রণ জানাতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Beiträge kannst du auf diesem Gerät weiter lesen. Um zurückzukommen, muss dich jemand aus der Gruppe neu einladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still read the posts on this device. To come back, someone in the group has to invite you again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voit yhä lukea viestit tällä laitteella. Palataksesi tarvitset uuden kutsun joltakulta ryhmän jäseneltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez toujours lire les publications sur cet appareil. Pour revenir, quelqu’un du groupe doit vous inviter à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस डिवाइस पर आप पोस्ट अब भी पढ़ सकते हैं। वापस आने के लिए ग्रुप के किसी सदस्य को आपको फिर से आमंत्रित करना होगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഉപകരണത്തിലുള്ള പോസ്റ്റുകൾ ഇപ്പോഴും വായിക്കാം. തിരികെ വരാൻ, ഗ്രൂപ്പിലെ ആരെങ്കിലും നിങ്ങളെ വീണ്ടും ക്ഷണിക്കണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या डिव्हाइसवरील पोस्ट तुम्ही अजूनही वाचू शकता. परत येण्यासाठी ग्रुपमधील कोणालातरी तुम्हाला पुन्हा आमंत्रित करावे लागेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்தச் சாதனத்தில் உள்ள இடுகைகளை இன்னும் படிக்கலாம். மீண்டும் சேர, குழுவில் உள்ள யாராவது உங்களை மீண்டும் அழைக்க வேண்டும்."
          }
        }
      }
    },
    "group_info_owner_cant_leave": {
