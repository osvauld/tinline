    "group_notice_request_accepted": {
      "comment": "Notice when your private chat request was accepted. {name} is the other member's first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ hat deine Anfrage angenommen. Ihr könnt euch jetzt schreiben; Anrufe bleiben aus, bis einer von euch sie erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ accepted your request. You can message each other now; calls stay off until one of you allows them."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ hyväksyi pyyntösi. Voitte nyt lähettää viestejä toisillenne; puhelut pysyvät pois päältä, kunnes jompikumpi teistä sallii ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ a accepté votre demande. Vous pouvez maintenant vous écrire ; les appels restent désactivés jusqu’à ce que l’un de vous les autorise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने आपका अनुरोध स्वीकार कर लिया। अब आप एक-दूसरे को संदेश भेज सकते हैं; जब तक आप में से कोई अनुमति न दे, कॉल बंद रहेंगी।"
          }
        }
      }
    },
    "group_notice_request_accepted_unnamed": {
      "comment": "Notice when your private chat request was accepted by someone whose name is not known.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Anfrage wurde angenommen. Ihr könnt euch jetzt schreiben; Anrufe bleiben aus, bis einer von euch sie erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request was accepted. You can message each other now; calls stay off until one of you allows them."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyyntösi hyväksyttiin. Voitte nyt lähettää viestejä toisillenne; puhelut pysyvät pois päältä, kunnes jompikumpi teistä sallii ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre demande a été acceptée. Vous pouvez maintenant vous écrire ; les appels restent désactivés jusqu’à ce que l’un de vous les autorise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका अनुरोध स्वीकार कर लिया गया। अब आप एक-दूसरे को संदेश भेज सकते हैं; जब तक आप में से कोई अनुमति न दे, कॉल बंद रहेंगी।"
