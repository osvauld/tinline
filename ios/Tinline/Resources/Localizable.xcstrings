    "people_detail_rename_note": {
      "comment": "Rename dialog note. {name} is the contact’s own chosen name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা শুধু আপনি দেখেন। উনি নিজেকে এখনও “%1$@” বলেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur du siehst das. Die Person nennt sich weiter „%1$@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you see this. They still call themselves “%1$@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain sinä näet tämän. Hän kutsuu itseään yhä nimellä ”%1$@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous seul le voyez. Cette personne se fait toujours appeler « %1$@ »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह सिर्फ़ आपको दिखता है। उनका अपना चुना नाम अब भी “%1$@” है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് നിങ്ങൾക്ക് മാത്രമേ കാണാനാകൂ. അവർ സ്വയം വിളിക്കുന്നത് ഇപ്പോഴും “%1$@” എന്നാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हे फक्त तुम्हाला दिसते. ते स्वतःला अजूनही “%1$@” म्हणतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இதை நீங்கள் மட்டுமே பார்ப்பீர்கள். அவர் தன்னை இன்னும் “%1$@” என்றே அழைத்துக்கொள்கிறார்."
          }
        }
      }
    },
