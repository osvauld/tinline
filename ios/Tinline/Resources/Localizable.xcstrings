    "call_route_relayed_hint": {
      "comment": "Hint in the audio route sheet when the call goes through a relay.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weitergeleitet: In diesem Netz war keine direkte Leitung möglich, also gibt ein verschlüsseltes Relay den Anruf weiter. Es kann dich nicht hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayed: a direct line wasn’t possible on this network, so an encrypted relay is passing the call along. It can’t hear you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välitetty: suora linja ei ollut mahdollinen tässä verkossa, joten salattu välityspalvelin välittää puhelun. Se ei voi kuulla sinua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relayé : une ligne directe n’était pas possible sur ce réseau, un relais chiffré transmet donc l’appel. Il ne peut pas vous entendre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिले से: इस नेटवर्क पर सीधी लाइन मुमकिन नहीं थी, इसलिए एक एन्क्रिप्टेड रिले कॉल को आगे पहुँचा रहा है। वह आपको सुन नहीं सकता।"
          }
        }
      }
    },
