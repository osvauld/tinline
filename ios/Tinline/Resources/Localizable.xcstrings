        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിരസിച്ചു. ഈ ഫോണിൽ നിന്ന് മറുപടിയൊന്നും അഡ്മിൻമാർ കാണില്ല."
