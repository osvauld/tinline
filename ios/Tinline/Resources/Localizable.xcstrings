        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या फोनने ग्रुप होस्ट करणे थांबवले."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த ஃபோன் குழுவை ஹோஸ்ட் செய்வதை நிறுத்தியது."
          }
        }
      }
    },
    "group_done_invite_many": {
