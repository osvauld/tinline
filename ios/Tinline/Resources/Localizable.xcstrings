    "group_member_blocked_sub": {
      "comment": "Sub line under You blocked.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "উনি গ্রুপেই থাকবেন। চ্যাট করতে পরিচিতি থেকে ওঁকে আনব্লক করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Person bleibt in der Gruppe. Heb die Blockierung unter Kontakte auf, um zu chatten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They stay in the group. Unblock them in Contacts to chat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hän pysyy ryhmässä. Voit poistaa eston yhteystiedoissa, jos haluat keskustella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette personne reste dans le groupe. Débloquez-la dans Contacts pour discuter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वे ग्रुप में बने रहेंगे। चैट करने के लिए संपर्क में जाकर उन्हें अनब्लॉक करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അവർ ഗ്രൂപ്പിൽ തുടരും. ചാറ്റ് ചെയ്യാൻ കോൺടാക്റ്റുകളിൽ അവരെ അൺബ്ലോക്ക് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते ग्रुपमध्ये राहतात. चॅट करण्यासाठी संपर्कांमध्ये जाऊन त्यांना अनब्लॉक करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அவர்கள் குழுவில் தொடர்ந்து இருப்பார்கள். அரட்டையடிக்க, தொடர்புகளில் தடையை நீக்குங்கள்."
          }
        }
      }
    },
