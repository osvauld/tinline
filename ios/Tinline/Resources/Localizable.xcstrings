    "group_call_no_host": {
      "comment": "Message when the user taps call but the group has no call host.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখনও কোনো কল হোস্ট নেই: গ্রুপের তথ্য থেকে একজন অ্যাডমিন কাউকে বেছে নিতে পারেন"
