          }
        }
      }
    },
    "chat_viewer_pdf_locked": {
      "comment": "Shown in the file viewer when a PDF needs a password.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
