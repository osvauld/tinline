            "value": "Choisissez une nouvelle phrase secrète"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नया पासफ़्रेज़ चुनें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "പുതിയൊരു പാസ്‌ഫ്രേസ് തിരഞ്ഞെടുക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नवीन पासफ्रेज निवडा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "புதிய கடவுச்சொற்றொடரைத் தேர்ந்தெடுங்கள்"
          }
        }
      }
    },
