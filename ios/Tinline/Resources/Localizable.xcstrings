    "onboarding_perm_mic_why": {
      "comment": "Why Tinline asks for the microphone.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাতে ওঁরা আপনার কথা শুনতে পান। শুধু কলের সময় ব্যবহার হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit man dich hören kann. Nur während eines Anrufs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So they can hear you. Used only during a call."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta sinut kuullaan. Käytössä vain puhelun aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour qu’on puisse vous entendre. Utilisé uniquement pendant un appel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ताकि वे आपको सुन सकें। सिर्फ़ कॉल के दौरान इस्तेमाल होता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അവർക്ക് നിങ്ങളെ കേൾക്കാൻ. കോളിനിടയിൽ മാത്രം ഉപയോഗിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "म्हणजे त्यांना तुमचा आवाज ऐकू येईल. फक्त कॉलदरम्यान वापरला जातो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அவர்கள் உங்கள் குரலைக் கேட்க. அழைப்பின்போது மட்டுமே பயன்படும்."
          }
        }
      }
    },
    "onboarding_perm_notif": {
