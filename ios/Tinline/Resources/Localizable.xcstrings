    "chat_attach_hint": {
      "comment": "Hint in the attach sheet.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফাইল এন্ড-টু-এন্ড এনক্রিপ্টেড। প্রতিটি 2 GB পর্যন্ত। পাঠানোর সময় আপনাদের দুজনকেই অনলাইনে থাকতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dateien sind Ende-zu-Ende-verschlüsselt. Bis zu 2 GB pro Datei. Ihr müsst beide online sein, solange sie übertragen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are end-to-end encrypted. Up to 2 GB each. Both of you need to be online while it transfers."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiedostot on salattu päästä päähän. Enintään 2 Gt kukin. Teidän molempien täytyy olla verkossa siirron aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fichiers sont chiffrés de bout en bout. Jusqu’à 2 Go chacun. Vous devez être en ligne tous les deux pendant le transfert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ाइलें एंड-टू-एंड एन्क्रिप्टेड हैं। हर फ़ाइल 2 GB तक। भेजते समय आप दोनों का ऑनलाइन होना ज़रूरी है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫയലുകൾ എൻഡ്-ടു-എൻഡ് എൻക്രിപ്റ്റ് ചെയ്തതാണ്. ഓരോന്നിനും 2 GB വരെ. കൈമാറുന്ന സമയത്ത് നിങ്ങൾ ഇരുവരും ഓൺലൈനിലുണ്ടാകണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फाइल एंड-टू-एंड एन्क्रिप्टेड असतात. प्रत्येकी जास्तीत जास्त 2 GB. फाइल जात असताना तुम्ही दोघेही ऑनलाइन असायला हवे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோப்புகள் எண்ட்-டு-எண்ட் என்க்ரிப்ட் செய்யப்பட்டவை. ஒவ்வொன்றும் 2 GB வரை. அனுப்பப்படும்போது நீங்கள் இருவரும் ஆன்லைனில் இருக்க வேண்டும்."
          }
        }
      }
    },
    "chat_attach_hint_self": {
      "comment": "Hint in the attach sheet of the saved-items chat.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফাইলগুলো আপনার ডিভাইসে এনক্রিপ্টেড থাকে, আর অন্যগুলো অনলাইনে এলে সেখানে কপি হয়। প্রতিটি 2 GB পর্যন্ত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dateien bleiben auf deinen Geräten verschlüsselt und werden auf die anderen kopiert, wenn sie online sind. Bis zu 2 GB pro Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files stay encrypted on your devices and copy to the others when they’re online. Up to 2 GB each."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiedostot pysyvät salattuina laitteillasi ja kopioituvat muille, kun ne ovat verkossa. Enintään 2 Gt kukin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fichiers restent chiffrés sur vos appareils et sont copiés sur les autres quand ils sont en ligne. Jusqu’à 2 Go chacun."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ाइलें आपके डिवाइस पर एन्क्रिप्टेड रहती हैं और ऑनलाइन होने पर दूसरे डिवाइस में कॉपी हो जाती हैं। हर फ़ाइल 2 GB तक।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫയലുകൾ നിങ്ങളുടെ ഉപകരണങ്ങളിൽ എൻക്രിപ്റ്റ് ചെയ്ത നിലയിൽ നിൽക്കും, മറ്റുള്ളവ ഓൺലൈനിലാകുമ്പോൾ അവയിലേക്കും പകർത്തും. ഓരോന്നിനും 2 GB വരെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फाइल तुमच्या डिव्हाइसवर एन्क्रिप्टेड राहतात आणि इतर डिव्हाइस ऑनलाइन आल्यावर तिथे कॉपी होतात. प्रत्येकी जास्तीत जास्त 2 GB."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோப்புகள் உங்கள் சாதனங்களில் என்க்ரிப்ட் செய்யப்பட்டே இருக்கும், மற்றவை ஆன்லைனில் இருக்கும்போது அவற்றுக்கு நகலெடுக்கப்படும். ஒவ்வொன்றும் 2 GB வரை."
          }
        }
      }
    },
