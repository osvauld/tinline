    "call_answer": {
      "comment": "Button and accessibility label that answers an incoming call.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
