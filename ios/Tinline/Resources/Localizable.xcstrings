    "onboarding_welcome_lead": {
      "comment": "Explanation on the first screen; the line break is intended.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline আপনার ফোনকে সরাসরি ওঁদের ফোনের সঙ্গে জুড়ে দেয়।\nশুধু একটি ডাকনাম লাগবে। এন্ড-টু-এন্ড এনক্রিপ্টেড।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline verbindet dein Handy direkt mit ihrem.\nDu brauchst nur einen Spitznamen. Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline connects your phone straight to theirs.\nYou just need a nickname. Encrypted end to end."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline yhdistää puhelimesi suoraan heidän puhelimeensa.\nTarvitset vain kutsumanimen. Päästä päähän salattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline relie votre téléphone directement à celui de vos proches.\nIl vous suffit d’un pseudo. Chiffré de bout en bout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline आपके फ़ोन को सीधे उनके फ़ोन से जोड़ता है।\nबस एक निकनेम चाहिए। एंड-टू-एंड एन्क्रिप्टेड।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline നിങ്ങളുടെ ഫോണിനെ അവരുടെ ഫോണുമായി നേരിട്ട് ബന്ധിപ്പിക്കുന്നു.\nഒരു വിളിപ്പേര് മാത്രം മതി. എൻഡ്-ടു-എൻഡ് എൻക്രിപ്റ്റ് ചെയ്തത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline तुमचा फोन थेट त्यांच्या फोनशी जोडते.\nफक्त एक टोपणनाव लागते. एंड-टू-एंड एन्क्रिप्टेड."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline உங்கள் ஃபோனை அவர்களின் ஃபோனுடன் நேரடியாக இணைக்கிறது.\nஒரு புனைப்பெயர் போதும். எண்ட்-டு-எண்ட் என்க்ரிப்ட் செய்யப்பட்டது."
          }
        }
      }
    },
    "onboarding_welcome_title": {
      "comment": "Title of the first screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার আপনজনদের কাছে সরাসরি লাইন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine direkte Leitung zu deinen Leuten"
          }
        },
        "en": {
