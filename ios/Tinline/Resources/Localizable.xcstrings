        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही ते सेटिंग्जमध्ये कधीही बदलू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இதை எப்போது வேண்டுமானாலும் அமைப்புகளில் மாற்றலாம்."
          }
        }
      }
    },
    "onboarding_nosave_lead": {
      "comment": "Explanation when the phone's key store failed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অ্যাকাউন্ট খোলার চাবি Tinline এই ফোনে রাখতে পারেনি, তাই আপনার অ্যাকাউন্ট এখনও সেভ হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline konnte den Schlüssel, der dein Konto öffnet, auf diesem Handy nicht ablegen, also ist dein Konto noch nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline couldn’t store the key that opens your account on this phone, so your account has not been saved yet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ei voinut tallentaa tilisi avaavaa avainta tälle puhelimelle, joten tiliäsi ei ole vielä tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline n’a pas pu stocker la clé qui ouvre votre compte sur ce téléphone, votre compte n’est donc pas encore enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline इस फ़ोन पर वह कुंजी नहीं रख पाया जिससे आपका खाता खुलता है, इसलिए आपका खाता अभी सहेजा नहीं गया है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് തുറക്കുന്ന കീ ഈ ഫോണിൽ സൂക്ഷിക്കാൻ Tinline-ന് കഴിഞ്ഞില്ല, അതിനാൽ നിങ്ങളുടെ അക്കൗണ്ട് ഇതുവരെ സേവ് ചെയ്തിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते उघडणारी की Tinline ला या फोनवर साठवता आली नाही, त्यामुळे तुमचे खाते अजून जतन झालेले नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கைத் திறக்கும் விசையை Tinline-ஆல் இந்த ஃபோனில் சேமிக்க முடியவில்லை, எனவே உங்கள் கணக்கு இன்னும் சேமிக்கப்படவில்லை."
          }
        }
      }
    },
    "onboarding_nosave_notice": {
      "comment": "Notice when the phone's key store failed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে এখনও কিছু রাখা হয়নি, তাই হারানোর কিছু নেই। আবার চেষ্টা করুন, অথবা ফোনের নিজের চাবির বদলে একটি পাসফ্রেজ দিয়ে অ্যাকাউন্টটি সুরক্ষিত রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf diesem Handy wurde noch nichts abgelegt, also kann nichts verloren gehen. Versuch es nochmal oder schütze das Konto mit einer Passphrase statt mit dem eigenen Schlüssel des Handys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was kept on this phone yet, so there is nothing to lose. Try again, or protect the account with a passphrase instead of the phone’s own key."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tälle puhelimelle ei ole vielä tallennettu mitään, joten mitään ei menetetä. Yritä uudelleen tai suojaa tili salalauseella puhelimen oman avaimen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien n’a encore été gardé sur ce téléphone, il n’y a donc rien à perdre. Réessayez, ou protégez le compte avec une phrase secrète plutôt qu’avec la clé du téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर अभी कुछ रखा नहीं गया था, इसलिए कुछ खोने का डर नहीं। फिर से कोशिश करें, या फ़ोन की अपनी कुंजी के बजाय पासफ़्रेज़ से खाते को सुरक्षित करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫോണിൽ ഇതുവരെ ഒന്നും സൂക്ഷിച്ചിട്ടില്ല, അതിനാൽ ഒന്നും നഷ്ടപ്പെടാനില്ല. വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ ഫോണിന്റെ സ്വന്തം കീയ്ക്ക് പകരം ഒരു പാസ്‌ഫ്രേസ് ഉപയോഗിച്ച് അക്കൗണ്ട് സംരക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या फोनवर अजून काहीही ठेवलेले नाही, त्यामुळे काहीही गमावण्यासारखे नाही. पुन्हा प्रयत्न करा, किंवा फोनच्या स्वतःच्या कीऐवजी पासफ्रेजने खाते सुरक्षित करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த ஃபோனில் இன்னும் எதுவும் வைக்கப்படவில்லை, எனவே இழப்பதற்கு எதுவும் இல்லை. மீண்டும் முயலுங்கள், அல்லது ஃபோனின் சொந்த விசைக்குப் பதிலாகக் கடவுச்சொற்றொடரால் கணக்கைப் பாதுகாருங்கள்."
          }
        }
      }
    },
