        }
      }
    },
    "settings_perm_notif_body": {
      "comment": "Body of the notifications-off warning.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline আপনাকে মেসেজ বা কলের খবর জানাতে পারছে না। সেগুলো তবুও আসে; অ্যাপ খুললেই দেখতে পাবেন। সিস্টেম সেটিংসে বিজ্ঞপ্তি চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline kann dich nicht auf Nachrichten oder Anrufe hinweisen. Sie kommen trotzdem an; du siehst sie, wenn du die App öffnest. Schalte Benachrichtigungen in den Systemeinstellungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline can’t alert you to messages or calls. They still arrive; you’ll see them when you open the app. Turn notifications on in system settings."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ei voi ilmoittaa viesteistä tai puheluista. Ne saapuvat silti; näet ne, kun avaat sovelluksen. Ota ilmoitukset käyttöön järjestelmän asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ne peut pas vous prévenir des messages ou des appels. Ils arrivent quand même ; vous les verrez en ouvrant l’app. Activez les notifications dans les réglages du système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline आपको संदेशों या कॉल के बारे में नहीं बता सकता। वे फिर भी आते हैं; ऐप खोलने पर आपको दिखेंगे। सिस्टम सेटिंग में सूचनाएँ चालू करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സന്ദേശങ്ങളെക്കുറിച്ചോ കോളുകളെക്കുറിച്ചോ Tinline-ന് നിങ്ങളെ അറിയിക്കാൻ കഴിയില്ല. അവ എന്തായാലും എത്തും; ആപ്പ് തുറക്കുമ്പോൾ കാണാം. സിസ്റ്റം ക്രമീകരണത്തിൽ അറിയിപ്പുകൾ ഓണാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline तुम्हाला संदेश किंवा कॉलची सूचना देऊ शकत नाही. ते तरीही येतात; ॲप उघडल्यावर ते तुम्हाला दिसतील. सिस्टम सेटिंग्जमध्ये सूचना सुरू करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "செய்திகள் அல்லது அழைப்புகள் பற்றி Tinline-ஆல் உங்களுக்குத் தெரிவிக்க முடியாது. அவை வந்துகொண்டுதான் இருக்கும்; ஆப்பைத் திறக்கும்போது பார்ப்பீர்கள். சிஸ்டம் அமைப்புகளில் அறிவிப்புகளை ஆன் செய்யுங்கள்."
          }
        }
      }
    },
