    "people_add_hint_empty_clipboard": {
      "comment": "Hint when Paste is pressed with an empty clipboard.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ক্লিপবোর্ড এখন খালি। ওঁর কোড এলে কপি করে এখানে পেস্ট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Zwischenablage ist gerade leer. Wenn ihr Code ankommt, kopiere ihn und füge ihn hier ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clipboard is empty right now. When their code arrives, copy it and paste it here."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leikepöytäsi on nyt tyhjä. Kun hänen koodinsa saapuu, kopioi se ja liitä tähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre presse-papiers est vide pour le moment. Quand son code arrivera, copiez-le et collez-le ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका क्लिपबोर्ड अभी खाली है। जब उनका कोड आए, तो उसे कॉपी करके यहाँ पेस्ट करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇപ്പോൾ നിങ്ങളുടെ ക്ലിപ്പ്ബോർഡ് ശൂന്യമാണ്. അവരുടെ കോഡ് വരുമ്പോൾ, അത് പകർത്തി ഇവിടെ പേസ്റ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा क्लिपबोर्ड आत्ता रिकामा आहे. त्यांचा कोड आल्यावर तो कॉपी करून इथे पेस्ट करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கிளிப்போர்டு இப்போது காலியாக உள்ளது. அவர்களின் குறியீடு வந்ததும், அதை நகலெடுத்து இங்கே ஒட்டுங்கள்."
          }
        }
      }
    },
    "people_add_hint_expired": {
      "comment": "Hint when the pasted code has expired. {name} is the person who made it.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-এর দেওয়া কোডটির মেয়াদ শেষ হয়ে গেছে। ওঁর কাছে নতুন একটা চেয়ে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Code von %1$@ ist abgelaufen. Frag nach einem neuen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code from %1$@ has expired. Ask them for a fresh one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henkilön %1$@ koodi on vanhentunut. Pyydä häneltä uusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce code de %1$@ a expiré. Demandez-en un nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ के उस कोड की समय-सीमा खत्म हो गई है। उनसे नया कोड माँगें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ നൽകിയ ആ കോഡിന്റെ കാലാവധി കഴിഞ്ഞു. പുതിയൊരെണ്ണം അവരോട് ചോദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ कडून आलेल्या त्या कोडची मुदत संपली आहे. त्यांच्याकडे नवीन कोड मागा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அனுப்பிய அந்தக் குறியீடு காலாவதியாகிவிட்டது. புதியதைக் கேளுங்கள்."
          }
        }
      }
    },
    "people_add_hint_many_qr": {
      "comment": "Hint when the picked image has several QR codes.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একাধিক QR আছে। যেটা চান, শুধু সেটুকু রেখে ক্রপ করুন।"
          }
