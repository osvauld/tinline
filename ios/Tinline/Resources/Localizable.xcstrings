        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "জরুরি পরিষেবায় যোগাযোগ করতে আপনার ফোনের ডায়ালার ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nutze die Telefon-App deines Handys, um den Notruf zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your phone’s dialer to reach emergency services."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soita hätänumeroon puhelimesi omalla puhelusovelluksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez l’application Téléphone pour joindre les services d’urgence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इमरजेंसी सेवाओं तक पहुँचने के लिए अपने फ़ोन का डायलर इस्तेमाल करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അടിയന്തര സേവനങ്ങളെ വിളിക്കാൻ നിങ്ങളുടെ ഫോണിന്റെ ഡയലർ ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपत्कालीन सेवांशी संपर्क करण्यासाठी तुमच्या फोनचा डायलर वापरा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அவசர சேவைகளைத் தொடர்புகொள்ள உங்கள் ஃபோனின் டயலரைப் பயன்படுத்துங்கள்."
          }
        }
      }
    },
