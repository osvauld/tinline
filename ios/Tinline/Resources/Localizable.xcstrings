    "settings_sound_triad_sub": {
      "comment": "Description of the Triad knock ringtone.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ওপরে ওঠা তিনটি সুর, দরজায় টোকার মতো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drei steigende Töne, wie ein Klopfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three rising notes, like a knock."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolme nousevaa säveltä, kuin koputus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trois notes montantes, comme on frappe à la porte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऊपर चढ़ते तीन सुर, दस्तक की तरह।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "വാതിലിൽ മുട്ടുന്നതുപോലെ ഉയർന്നുപോകുന്ന മൂന്ന് സ്വരങ്ങൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दारावर थाप दिल्यासारखे तीन चढते सूर."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஏறும் மூன்று ஸ்வரங்கள், கதவைத் தட்டுவது போல."
          }
        }
      }
    },
    "settings_sounds_note": {
      "comment": "Note under the sound previews.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শুনতে কোনো সাউন্ডে ট্যাপ করুন। পরের কল থেকে এটা কাজ করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe auf einen Ton, um ihn zu hören. Die Wahl gilt ab dem nächsten Anruf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a sound to hear it. The choice applies to the next call."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napauta ääntä kuullaksesi sen. Valinta koskee seuraavaa puhelua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez un son pour l’écouter. Le choix s’applique au prochain appel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुनने के लिए किसी आवाज़ पर टैप करें। आपकी पसंद अगली कॉल से लागू होगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഒരു ശബ്ദം കേൾക്കാൻ അതിൽ ടാപ്പ് ചെയ്യുക. തിരഞ്ഞെടുക്കുന്നത് അടുത്ത കോൾ മുതൽ ബാധകമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐकण्यासाठी आवाजावर टॅप करा. निवड पुढच्या कॉलपासून लागू होईल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கேட்க ஒரு ஒலியைத் தட்டுங்கள். உங்கள் தேர்வு அடுத்த அழைப்பிலிருந்து பொருந்தும்."
          }
        }
      }
    },
    "settings_sounds_note_quiet": {
      "comment": "Note under the sound previews when quiet mode is on.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“নিঃশব্দ” চালু আছে, তাই প্রিভিউতে কোনো শব্দ হবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lautlos ist an, also sind die Vorschauen stumm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet is on, so previews are silent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiljainen tila on päällä, joten esikuuntelut ovat äänettömiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mode Silence est activé, les aperçus sont donc muets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“शांत” चालू है, इसलिए प्रीव्यू में आवाज़ नहीं आएगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിശ്ശബ്ദം ഓണാണ്, അതിനാൽ പ്രിവ്യൂകൾക്ക് ശബ്ദമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"शांत\" सुरू आहे, त्यामुळे प्रिव्ह्यू ऐकू येणार नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அமைதி ஆன் செய்யப்பட்டுள்ளதால், முன்னோட்டங்கள் ஒலிக்காது."
          }
        }
      }
    },
