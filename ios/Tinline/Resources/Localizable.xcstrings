{
  "sourceLanguage": "en",
  "strings": {
    "call_about_encrypted_lead": {
      "comment": "Bold first words of the encryption explanation on the call details card.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এন্ড-টু-এন্ড এনক্রিপ্টেড।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salattu päästä päähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffré de bout en bout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एंड-टू-एंड एन्क्रिप्टेड।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "എൻഡ്-ടു-എൻഡ് എൻക്രിപ്റ്റ് ചെയ്തത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एंड-टू-एंड एन्क्रिप्टेड."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "எண்ட்-டு-எண்ட் என்க்ரிப்ட் செய்யப்பட்டது."
          }
        }
      }
    },
    "call_about_encrypted_video": {
      "comment": "Rest of the encryption explanation on a video call. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার কণ্ঠস্বর আর ছবি এই ডিভাইসে এনক্রিপ্ট হয়, আর শুধু %1$@-এর ডিভাইসেই ডিক্রিপ্ট হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Stimme und dein Bild werden auf diesem Gerät verschlüsselt und erst auf dem Gerät von %1$@ entschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice and picture are encrypted on this device and only decrypted on %1$@’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Äänesi ja kuvasi salataan tällä laitteella ja puretaan vain henkilön %1$@ laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre voix et votre image sont chiffrées sur cet appareil et déchiffrées uniquement sur celui de %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी आवाज़ और तस्वीर इस डिवाइस पर एन्क्रिप्ट होती हैं और सिर्फ़ %1$@ के डिवाइस पर डिक्रिप्ट होती हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ ശബ്ദവും ദൃശ്യവും ഈ ഉപകരണത്തിൽ എൻക്രിപ്റ്റ് ചെയ്യുന്നു, %1$@ എന്നയാളുടെ ഉപകരണത്തിൽ മാത്രമേ ഡീക്രിപ്റ്റ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा आवाज आणि व्हिडिओ या डिव्हाइसवर एन्क्रिप्ट होतात आणि फक्त %1$@ च्या डिव्हाइसवर डिक्रिप्ट होतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் குரலும் காட்சியும் இந்தச் சாதனத்தில் என்க்ரிப்ட் செய்யப்பட்டு, %1$@ அவர்களின் சாதனத்தில் மட்டுமே டிக்ரிப்ட் செய்யப்படுகின்றன."
          }
        }
      }
    },
    "call_about_encrypted_voice": {
      "comment": "Rest of the encryption explanation on a voice call. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার কণ্ঠস্বর এই ডিভাইসে এনক্রিপ্ট হয়, আর শুধু %1$@-এর ডিভাইসেই ডিক্রিপ্ট হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Stimme wird auf diesem Gerät verschlüsselt und erst auf dem Gerät von %1$@ entschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice is encrypted on this device and only decrypted on %1$@’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Äänesi salataan tällä laitteella ja puretaan vain henkilön %1$@ laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre voix est chiffrée sur cet appareil et déchiffrée uniquement sur celui de %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी आवाज़ इस डिवाइस पर एन्क्रिप्ट होती है और सिर्फ़ %1$@ के डिवाइस पर डिक्रिप्ट होती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ ശബ്ദം ഈ ഉപകരണത്തിൽ എൻക്രിപ്റ്റ് ചെയ്യുന്നു, %1$@ എന്നയാളുടെ ഉപകരണത്തിൽ മാത്രമേ ഡീക്രിപ്റ്റ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा आवाज या डिव्हाइसवर एन्क्रिप्ट होतो आणि फक्त %1$@ च्या डिव्हाइसवर डिक्रिप्ट होतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் குரல் இந்தச் சாதனத்தில் என்க்ரிப்ட் செய்யப்பட்டு, %1$@ அவர்களின் சாதனத்தில் மட்டுமே டிக்ரிப்ட் செய்யப்படுகிறது."
          }
        }
      }
    },
    "call_about_headline_direct": {
      "comment": "Bold headline on the call details card. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ সিগন্যাল · সরাসরি"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal: %1$@ · Direkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signal · Direct"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signaali: %1$@ · Suora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal %1$@ · Direct"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ सिग्नल · सीधी"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സിഗ്നൽ: %1$@ · നേരിട്ട്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ सिग्नल · थेट"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ சிக்னல் · நேரடி"
          }
        }
      }
    },
    "call_about_headline_reconnecting": {
      "comment": "Bold headline on the call details card while reconnecting.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আবার কানেক্ট হচ্ছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neu verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistetään uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconnexion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फिर से जुड़ रहा है"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "വീണ്ടും കണക്റ്റ് ചെയ്യുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पुन्हा कनेक्ट होत आहे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மீண்டும் இணைக்கிறது"
          }
        }
      }
    },
    "call_about_headline_relayed": {
      "comment": "Bold headline on the call details card. {word} is a signal strength word such as Weak or Strong.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ সিগন্যাল · রিলে হয়ে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal: %1$@ · Weitergeleitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signal · Relayed"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signaali: %1$@ · Välitetty"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signal %1$@ · Relayé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ सिग्नल · रिले से"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സിഗ്നൽ: %1$@ · റിലേ വഴി"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ सिग्नल · रिलेमार्फत"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ சிக்னல் · ரிலே வழியாக"
          }
        }
      }
    },
    "call_about_line_direct": {
      "comment": "Explanation for a direct connection. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার কল সরাসরি আপনার ডিভাইস আর %1$@-এর ডিভাইসের মধ্যে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Anruf geht direkt zwischen deinem Gerät und dem von %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your call goes straight between your device and %1$@’s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puhelusi kulkee suoraan sinun laitteesi ja henkilön %1$@ laitteen välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre appel passe directement entre votre appareil et celui de %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी कॉल सीधे आपके डिवाइस और %1$@ के डिवाइस के बीच जाती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ കോൾ നിങ്ങളുടെ ഉപകരണത്തിനും %1$@ എന്നയാളുടെ ഉപകരണത്തിനും ഇടയിൽ നേരിട്ടാണ് പോകുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा कॉल तुमच्या डिव्हाइसवरून थेट %1$@ च्या डिव्हाइसवर जातो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் அழைப்பு உங்கள் சாதனத்துக்கும் %1$@ அவர்களின் சாதனத்துக்கும் இடையே நேரடியாகச் செல்கிறது."
          }
        }
      }
    },
    "call_about_line_reconnecting": {
      "comment": "Explanation while reconnecting. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কানেকশন কিছুক্ষণের জন্য কেটে গেছে। Tinline %1$@-এর কাছে ফেরার পথ খুঁজছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung war kurz weg. Tinline sucht einen Weg zurück zu %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped for a moment. Tinline is finding a way back to %1$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteys katkesi hetkeksi. Tinline etsii yhteyttä takaisin henkilöön %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion a été coupée un instant. Tinline cherche à rejoindre %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कनेक्शन एक पल के लिए टूट गया। Tinline %1$@ तक वापस पहुँचने का रास्ता ढूँढ़ रहा है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കണക്ഷൻ ഒരു നിമിഷം മുറിഞ്ഞു. %1$@ എന്നയാളിലേക്ക് തിരികെയെത്താനുള്ള വഴി Tinline കണ്ടെത്തുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कनेक्शन क्षणभर तुटले. Tinline %1$@ पर्यंत परत पोहोचण्याचा मार्ग शोधत आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இணைப்பு சிறிது நேரம் துண்டிக்கப்பட்டது. %1$@ அவர்களுடன் மீண்டும் இணைய Tinline வழி தேடுகிறது."
          }
        }
      }
    },
    "call_about_line_relayed_video": {
      "comment": "Explanation for a relayed video call.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ডিভাইসগুলো এখন সরাসরি একে অপরের কাছে পৌঁছাতে পারছে না, তাই একটি রিলে কলটি পৌঁছে দিচ্ছে। রিলে শুনতে বা দেখতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eure Geräte erreichen sich gerade nicht direkt, also gibt ein Relay den Anruf weiter. Es kann weder mithören noch zusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices can’t reach each other directly right now, so a relay passes the call along. It can’t listen or watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laitteesi eivät juuri nyt tavoita toisiaan suoraan, joten välityspalvelin välittää puhelun. Se ei voi kuunnella eikä katsoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos appareils ne peuvent pas se joindre directement pour le moment, un relais transmet donc l’appel. Il ne peut ni écouter ni regarder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके डिवाइस अभी सीधे एक-दूसरे तक नहीं पहुँच पा रहे, इसलिए एक रिले कॉल को आगे पहुँचाता है। वह न सुन सकता है, न देख सकता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇപ്പോൾ നിങ്ങളുടെ ഉപകരണങ്ങൾക്ക് പരസ്പരം നേരിട്ട് എത്താൻ കഴിയുന്നില്ല, അതിനാൽ ഒരു റിലേ കോൾ കൈമാറുന്നു. അതിന് കേൾക്കാനോ കാണാനോ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमची डिव्हाइस सध्या एकमेकांपर्यंत थेट पोहोचू शकत नाहीत, त्यामुळे रिले कॉल पुढे पोहोचवतो. तो ऐकू किंवा पाहू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் சாதனங்கள் இப்போது ஒன்றையொன்று நேரடியாக அடைய முடியவில்லை, எனவே ஒரு ரிலே அழைப்பைக் கடத்துகிறது. அதனால் கேட்கவோ பார்க்கவோ முடியாது."
          }
        }
      }
    },
    "call_about_line_relayed_voice": {
      "comment": "Explanation for a relayed voice call.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ডিভাইসগুলো এখন সরাসরি একে অপরের কাছে পৌঁছাতে পারছে না, তাই একটি রিলে কলটি পৌঁছে দিচ্ছে। রিলে শুনতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eure Geräte erreichen sich gerade nicht direkt, also gibt ein Relay den Anruf weiter. Es kann nicht mithören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices can’t reach each other directly right now, so a relay passes the call along. It can’t listen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laitteesi eivät juuri nyt tavoita toisiaan suoraan, joten välityspalvelin välittää puhelun. Se ei voi kuunnella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos appareils ne peuvent pas se joindre directement pour le moment, un relais transmet donc l’appel. Il ne peut pas écouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके डिवाइस अभी सीधे एक-दूसरे तक नहीं पहुँच पा रहे, इसलिए एक रिले कॉल को आगे पहुँचाता है। वह सुन नहीं सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇപ്പോൾ നിങ്ങളുടെ ഉപകരണങ്ങൾക്ക് പരസ്പരം നേരിട്ട് എത്താൻ കഴിയുന്നില്ല, അതിനാൽ ഒരു റിലേ കോൾ കൈമാറുന്നു. അതിന് കേൾക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमची डिव्हाइस सध्या एकमेकांपर्यंत थेट पोहोचू शकत नाहीत, त्यामुळे रिले कॉल पुढे पोहोचवतो. तो ऐकू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் சாதனங்கள் இப்போது ஒன்றையொன்று நேரடியாக அடைய முடியவில்லை, எனவே ஒரு ரிலே அழைப்பைக் கடத்துகிறது. அதனால் கேட்க முடியாது."
          }
        }
      }
    },
    "call_about_line_weak": {
      "comment": "Extra sentence appended when the signal is weak. {name} is the contact's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লাইন দুর্বল, তাই %1$@-এর কথা কেটে কেটে আসতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Leitung ist schwach, daher kann die Stimme von %1$@ stocken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line is weak, so %1$@’s voice may break up."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linja on heikko, joten henkilön %1$@ ääni voi katkeilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La ligne est faible, la voix de %1$@ peut donc être hachée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लाइन कमज़ोर है, इसलिए %1$@ की आवाज़ टूट सकती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ലൈൻ ദുർബലമാണ്, അതിനാൽ %1$@ എന്നയാളുടെ ശബ്ദം ഇടയ്ക്ക് മുറിഞ്ഞേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लाइन कमकुवत आहे, त्यामुळे %1$@ चा आवाज तुटक येऊ शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "லைன் பலவீனமாக உள்ளது, எனவே %1$@ அவர்களின் குரல் விட்டுவிட்டுக் கேட்கலாம்."
          }
        }
      }
    },
    "call_about_reconnecting": {
      "comment": "Accessibility label of the info button while reconnecting.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই কল সম্পর্কে। আবার কানেক্ট হচ্ছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Über diesen Anruf. Neu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this call. Reconnecting."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tietoja tästä puhelusta. Yhdistetään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À propos de cet appel. Reconnexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस कॉल के बारे में। फिर से जुड़ रहा है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ കോളിനെക്കുറിച്ച്. വീണ്ടും കണക്റ്റ് ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या कॉलबद्दल. पुन्हा कनेक्ट होत आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த அழைப்பு பற்றி. மீண்டும் இணைக்கிறது."
          }
        }
      }
    },
    "call_about_signal_direct": {
      "comment": "Accessibility label of the info button. {word} is a signal strength word such as Weak or Strong.",
