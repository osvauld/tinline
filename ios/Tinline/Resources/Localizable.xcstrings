    "group_callhosts_unavailable": {
      "comment": "Status line when no call host is available.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখন কোনো কল হোস্ট পাওয়া যাচ্ছে না। কেউ ফিরে এলে আবার কল শুরু করা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gerade ist kein Anruf-Host erreichbar. Ein Anruf startet, sobald einer zurück ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No call host is available right now. A call can’t start until one is back."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksikään puheluisäntä ei ole juuri nyt saatavilla. Puhelu voi alkaa, kun jokin palaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun hôte d’appel n’est disponible pour le moment. Un appel pourra démarrer dès que l’un d’eux sera de retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी कोई कॉल होस्ट उपलब्ध नहीं है। किसी के वापस आते ही कॉल शुरू हो सकेगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇപ്പോൾ കോൾ ഹോസ്റ്റുകളൊന്നും ലഭ്യമല്ല. ഒരെണ്ണം തിരികെ വരുമ്പോൾ കോൾ ആരംഭിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आत्ता कोणताही कॉल होस्ट उपलब्ध नाही. एखादा परत आल्यावर कॉल सुरू करता येईल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இப்போது எந்த அழைப்பு ஹோஸ்ட்டும் கிடைக்கவில்லை. ஒன்று திரும்பி வந்ததும் அழைப்பைத் தொடங்கலாம்."
          }
        }
      }
    },
