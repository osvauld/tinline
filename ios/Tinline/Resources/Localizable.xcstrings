    "security_pass_intro": {
      "comment": "Intro on the add-passphrase page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অ্যাকাউন্ট শুধু এই ফোনেই আছে। পাসফ্রেজ এটাকে এনক্রিপ্ট করে, তাই আপনার ফোন হাতে পেলেও কেউ এটা কপি করতে পারবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto lebt nur auf diesem Handy. Eine Passphrase verschlüsselt es, sodass niemand, der dein Handy in der Hand hat, es kopieren kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account lives only on this phone. A passphrase encrypts it, so nobody holding your phone can copy it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi on vain tällä puhelimella. Salalause salaa sen, joten kukaan, jolla puhelimesi on käsissään, ei voi kopioida sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte vit uniquement sur ce téléphone. Une phrase secrète le chiffre, pour que personne ne puisse le copier en ayant votre téléphone en main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता सिर्फ़ इसी फ़ोन पर है। पासफ़्रेज़ इसे एन्क्रिप्ट करता है, ताकि आपका फ़ोन हाथ में होने पर भी कोई इसे कॉपी न कर सके।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് ഈ ഫോണിൽ മാത്രമാണുള്ളത്. ഒരു പാസ്‌ഫ്രേസ് അത് എൻക്രിപ്റ്റ് ചെയ്യുന്നു, അതിനാൽ നിങ്ങളുടെ ഫോൺ കൈയിൽ കിട്ടുന്ന ആർക്കും അത് പകർത്താൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते फक्त या फोनवर असते. पासफ्रेज ते एन्क्रिप्ट करतो, त्यामुळे तुमचा फोन हातात असलेले कोणीही ते कॉपी करू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு இந்த ஃபோனில் மட்டுமே உள்ளது. கடவுச்சொற்றொடர் அதை என்க்ரிப்ட் செய்யும், எனவே உங்கள் ஃபோனைக் கையில் வைத்திருக்கும் யாராலும் அதை நகலெடுக்க முடியாது."
          }
        }
      }
    },
    "security_pass_notice": {
      "comment": "Notice on the add-passphrase page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে আপনার অ্যাকাউন্ট এনক্রিপ্ট করে। আপনার ফোন এটা মনে রাখে, তাই Tinline প্রতিবার না জিজ্ঞেস করেই খোলে। ভুলে গেলে রিকভারি শব্দ দিয়ে নতুন একটি সেট করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschlüsselt dein Konto auf diesem Handy. Dein Handy merkt sie sich, sodass Tinline ohne Nachfrage öffnet. Wenn du sie vergisst, kannst du mit deinen Wiederherstellungswörtern eine neue festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypts your account on this phone. Your phone remembers it, so Tinline opens without asking each time. If you forget it, your recovery words let you set a new one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salaa tilisi tällä puhelimella. Puhelimesi muistaa salalauseen, joten Tinline aukeaa ilman kysymistä joka kerta. Jos unohdat sen, palautussanasi antavat sinun asettaa uuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffre votre compte sur ce téléphone. Votre téléphone s’en souvient, donc Tinline s’ouvre sans rien demander à chaque fois. Si vous l’oubliez, vos mots de récupération vous permettent d’en définir une nouvelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर आपके खाते को एन्क्रिप्ट करता है। आपका फ़ोन इसे याद रखता है, इसलिए Tinline हर बार पूछे बिना खुल जाता है। अगर आप इसे भूल जाएँ, तो रिकवरी शब्दों से नया रख सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫോണിൽ നിങ്ങളുടെ അക്കൗണ്ട് എൻക്രിപ്റ്റ് ചെയ്യുന്നു. ഫോൺ ഇത് ഓർത്തുവയ്ക്കും, അതിനാൽ ഓരോ തവണയും ചോദിക്കാതെ Tinline തുറക്കും. ഇത് മറന്നുപോയാൽ, വീണ്ടെടുക്കൽ വാക്കുകൾ ഉപയോഗിച്ച് പുതിയൊരെണ്ണം സജ്ജീകരിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या फोनवर तुमचे खाते एन्क्रिप्ट करते. तुमचा फोन तो लक्षात ठेवतो, त्यामुळे Tinline प्रत्येक वेळी न विचारता उघडते. तो विसरलात, तर तुमच्या रिकव्हरी शब्दांनी नवीन सेट करता येतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த ஃபோனில் உங்கள் கணக்கை என்க்ரிப்ட் செய்யும். உங்கள் ஃபோன் இதை நினைவில் வைத்திருக்கும், எனவே ஒவ்வொரு முறையும் கேட்காமலே Tinline திறக்கும். இதை மறந்துவிட்டால், உங்கள் மீட்பு வார்த்தைகள் மூலம் புதியதை அமைக்கலாம்."
          }
        }
      }
    },
    "security_recovery_failed": {
      "comment": "Error when the recovery data could not be read.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রিকভারি খোলা গেল না। ফিরে গিয়ে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Wiederherstellung ließ sich nicht öffnen. Geh zurück und versuch es nochmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open recovery. Go back and try again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palautusta ei voitu avata. Palaa takaisin ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’ouvrir la récupération. Revenez en arrière et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिकवरी नहीं खुल पाई। वापस जाकर फिर से कोशिश करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "വീണ്ടെടുക്കൽ തുറക്കാൻ കഴിഞ്ഞില്ല. തിരികെ പോയി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिकव्हरी उघडता आली नाही. मागे जाऊन पुन्हा प्रयत्न करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மீட்பைத் திறக்க முடியவில்லை. பின்செல்லுங்கள், மீண்டும் முயலுங்கள்."
          }
        }
      }
    },
