        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला पाठवलेली कॉल होस्ट विनंती रद्द करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ சாதனத்துக்கான அழைப்பு ஹோஸ்ட் கோரிக்கையை ரத்துசெய்"
