    "settings_sound_classic_sub": {
      "comment": "Description of the Classic chime ringtone.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "চার সুরের ঝলমলে টুংটাং।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein heller Gong aus vier Tönen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bright four-note chime."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirkas neljän sävelen kilahdus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un carillon clair de quatre notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चार सुरों की चमकीली झंकार।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നാല് സ്വരങ്ങളുള്ള തെളിഞ്ഞ മണിനാദം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चार सुरांची प्रसन्न किणकिण."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பிரகாசமான நான்கு ஸ்வர மணியொலி."
          }
        }
      }
    },
    "settings_sound_slack": {
      "comment": "Ringtone choice name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ঢিলে → টানটান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Locker → straff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack → taut"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löysä → kireä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lâche → tendu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ढीली → कसी"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അയഞ്ഞത് → മുറുകിയത്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सैल → ताठ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தளர்வு → இறுக்கம்"
          }
        }
      }
    },
    "settings_sound_slack_sub": {
      "comment": "Description of the Slack → taut ringtone.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কাছাকাছি দুটি সুর ঢিলে তারের মতো দোলে, তারপর একটি টানটান হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwei nahe Töne schweben wie eine lockere Saite, dann spannt sich einer straff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two close notes beat like a loose string, then one pulls tight."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaksi lähekkäistä säveltä huojuu kuin löysä kieli, sitten yksi kiristyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deux notes proches battent comme une corde lâche, puis l’une se tend."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पास-पास के दो सुर ढीली डोरी की तरह थरथराते हैं, फिर एक कसकर खिंच जाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അയഞ്ഞ ചരട് പോലെ അടുത്തടുത്ത രണ്ട് സ്വരങ്ങൾ മിടിക്കുന്നു, പിന്നെ ഒന്ന് മുറുകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दोन जवळचे सूर सैल तारेसारखे थरथरतात, मग एक सूर तार ताणतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நெருக்கமான இரண்டு ஸ்வரங்கள் தளர்ந்த கம்பி போல அதிர்கின்றன, பிறகு ஒன்று இறுக்கமாக இழுக்கிறது."
          }
        }
      }
    },
