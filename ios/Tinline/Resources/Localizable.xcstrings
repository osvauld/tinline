            "value": "Poista tili tältä puhelimelta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retirer le compte de ce téléphone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन से खाता हटाएँ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫോണിൽ നിന്ന് അക്കൗണ്ട് നീക്കം ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या फोनवरून खाते काढा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த ஃபோனிலிருந்து கணக்கை அகற்று"
          }
        }
      }
    },
    "devices_remove_body": {
      "comment": "Body of the remove-account dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে সিঙ্ক আর রিং বন্ধ হয়ে যাবে, আর আপনার অ্যাকাউন্ট, পরিচিতি, চ্যাট ও কলের ইতিহাস এখান থেকে মুছে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Handy hört auf abzugleichen und zu klingeln, und dein Konto, deine Kontakte, Chats und Anrufliste werden davon gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone stops syncing and ringing, and your account, contacts, chats and call history are deleted from it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä puhelin lopettaa synkronoinnin ja soimisen, ja tilisi, yhteystietosi, keskustelusi ja puheluhistoriasi poistetaan siltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce téléphone cesse de se synchroniser et de sonner, et votre compte, vos contacts, vos discussions et votre historique d’appels en sont supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह फ़ोन सिंक होना और घंटी बजना बंद कर देगा, और आपका खाता, संपर्क, चैट और कॉल हिस्ट्री इससे मिटा दिए जाएँगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫോൺ സിങ്ക് ചെയ്യുന്നതും റിംഗ് ചെയ്യുന്നതും നിർത്തും, നിങ്ങളുടെ അക്കൗണ്ട്, കോൺടാക്റ്റുകൾ, ചാറ്റുകൾ, കോൾ ചരിത്രം എന്നിവ ഇതിൽ നിന്ന് ഇല്ലാതാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हा फोन सिंक होणे आणि रिंग होणे थांबवतो, आणि तुमचे खाते, संपर्क, चॅट आणि कॉल इतिहास त्यावरून हटवले जातात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த ஃபோன் ஒத்திசைப்பதையும் ஒலிப்பதையும் நிறுத்தும், உங்கள் கணக்கு, தொடர்புகள், அரட்டைகள், அழைப்பு வரலாறு ஆகியவை இதிலிருந்து நீக்கப்படும்."
          }
        }
      }
    },
