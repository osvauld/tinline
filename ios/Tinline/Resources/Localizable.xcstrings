    "link_scan_step1": {
      "comment": "Step 1 on the scan page. The button name **Link to a device** is bold (markdown stars, keep them around the button name); it must match the button's label on the new device. Shown as the first of two lines; the number is not part of the text.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নতুন ডিভাইসে Tinline খুলে **একটি ডিভাইসে লিঙ্ক করুন** বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne auf dem neuen Gerät Tinline und wähle **Mit einem Gerät verknüpfen**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the new device, open Tinline and choose **Link to a device**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa Tinline uudella laitteella ja valitse **Linkitä laitteeseen**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur le nouvel appareil, ouvrez Tinline et choisissez **Associer à un appareil**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नए डिवाइस पर Tinline खोलें और **किसी डिवाइस से लिंक करें** चुनें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "പുതിയ ഉപകരണത്തിൽ Tinline തുറന്ന് **ഒരു ഉപകരണവുമായി ലിങ്ക് ചെയ്യുക** തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नवीन डिव्हाइसवर Tinline उघडा आणि **डिव्हाइसशी लिंक करा** निवडा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "புதிய சாதனத்தில் Tinline-ஐத் திறந்து **ஒரு சாதனத்துடன் இணை** என்பதைத் தேர்ந்தெடுங்கள்."
          }
        }
      }
    },
    "link_scan_step2": {
      "comment": "Step 2 on the scan page. Shown as the second of two lines; the number is not part of the text.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এতে একটি QR কোড আর একটি ছোট কোড দেখাবে। এগুলো 5 মিনিট, একবারই কাজ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es zeigt einen QR-Code und einen kurzen Code. Sie gelten 5 Minuten und funktionieren einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It shows a QR code and a short code. They work for 5 minutes, once."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se näyttää QR-koodin ja lyhyen koodin. Ne ovat voimassa 5 minuuttia ja toimivat kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il affiche un QR code et un code court. Ils fonctionnent une fois et expirent au bout de 5 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उस पर एक QR कोड और एक छोटा कोड दिखेगा। ये 5 मिनट तक, एक बार काम करते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അത് ഒരു QR കോഡും ഒരു ചെറിയ കോഡും കാണിക്കും. അവ 5 മിനിറ്റ് നേരം, ഒരു തവണ മാത്രം പ്രവർത്തിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यावर एक QR कोड आणि एक छोटा कोड दिसतो. ते 5 मिनिटांसाठी, एकदाच चालतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அது ஒரு QR குறியீட்டையும் ஒரு சிறிய குறியீட்டையும் காட்டும். அவை 5 நிமிடங்களுக்கு, ஒருமுறை மட்டுமே செயல்படும்."
          }
        }
      }
    },
