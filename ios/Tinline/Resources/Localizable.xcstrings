    "group_flag_button": {
      "comment": "Button that flags a member. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-কে ফ্ল্যাগ করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flag %1$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitse %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signaler %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ को फ़्लैग करें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാളെ ഫ്ലാഗ് ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला फ्लॅग करा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ மீது கொடியிடு"
          }
        }
      }
    },
    "group_flag_copy": {
      "comment": "Flag dialog sentence for a flag that does not remove yet. {yours} is which flag it is, {total} flags remove, {name} the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনারটি হবে %2$@টির মধ্যে %1$@ নম্বর ফ্ল্যাগ। যেকোনো অ্যাডমিনের ফ্ল্যাগ গোনা হয়, আপনার পরের ফ্ল্যাগও। %2$@টি ফ্ল্যাগ হলেই %3$@-কে সঙ্গে সঙ্গে সরানো হবে, আর উনি দেখতে পাবেন যে ওঁকে সরানো হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das wird Markierung %1$@ von %2$@. Markierungen aller Admins zählen, auch weitere von dir. Bei %2$@ Markierungen wird %3$@ sofort entfernt und sieht das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours will be flag %1$@ of %2$@. Any admin’s flags count, yours again too. At %2$@ flags %3$@ is removed right away and sees they were removed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinun merkintäsi on %1$@/%2$@. Kaikkien ylläpitäjien merkinnät lasketaan, myös sinun uudet merkintäsi. Kun merkintöjä on %2$@, %3$@ poistetaan heti, ja hän näkee tulleensa poistetuksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce sera le signalement %1$@ sur %2$@. Les signalements de tous les admins comptent, y compris un nouveau de votre part. À %2$@ signalements, le retrait de %3$@ est immédiat et cette personne voit qu’elle a été retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका फ़्लैग %2$@ में से %1$@ होगा। किसी भी एडमिन के फ़्लैग गिने जाते हैं, आपके दोबारा लगाए फ़्लैग भी। %2$@ फ़्लैग होते ही %3$@ को तुरंत हटा दिया जाएगा और उन्हें दिखेगा कि उन्हें हटा दिया गया।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടേത് ഫ്ലാഗ് %1$@ / %2$@ ആയിരിക്കും. ഏത് അഡ്മിന്റെ ഫ്ലാഗും എണ്ണപ്പെടും, നിങ്ങളുടേത് വീണ്ടും ആയാലും. %2$@ ഫ്ലാഗുകൾ ആകുമ്പോൾ %3$@ ഉടൻ നീക്കം ചെയ്യപ്പെടും, അത് അവർ കാണുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा फ्लॅग %2$@ पैकी क्रमांक %1$@ असेल. कोणत्याही ॲडमिनचे फ्लॅग मोजले जातात, तुमचे पुढचे फ्लॅगही. %2$@ फ्लॅग झाल्यावर %3$@ ला लगेच काढले जाईल आणि त्यांना ते दिसेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்களுடையது %2$@-இல் %1$@-ஆவது கொடியாக இருக்கும். எந்த நிர்வாகியின் கொடிகளும் கணக்கில் சேரும், உங்களுடையது மீண்டும் இட்டாலும் சேரும். %2$@ கொடிகள் ஆனதும் %3$@ உடனே நீக்கப்படுவார், தாம் நீக்கப்பட்டதையும் பார்ப்பார்."
          }
        }
      }
    },
    "group_flag_copy_final": {
      "comment": "Flag dialog sentence for the flag that removes the member. {yours} is which flag it is, {total} flags remove, {name} the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনারটি হবে %2$@টির মধ্যে %1$@ নম্বর ফ্ল্যাগ। %3$@-কে সঙ্গে সঙ্গে সরানো হবে: হোস্টরা ওঁর নতুন মেসেজ আর নেবে না, আর উনি দেখতে পাবেন যে ওঁকে সরানো হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das wird Markierung %1$@ von %2$@. %3$@ wird sofort entfernt: Hosts nehmen keine neuen Nachrichten mehr an, und die Person sieht, dass sie entfernt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours will be flag %1$@ of %2$@. %3$@ is removed right away: hosts refuse their new messages and they see they were removed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinun merkintäsi on %1$@/%2$@. %3$@ poistetaan heti: isäntälaitteet hylkäävät hänen uudet viestinsä, ja hän näkee tulleensa poistetuksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce sera le signalement %1$@ sur %2$@. Le retrait de %3$@ est immédiat : les hôtes refusent ses nouveaux messages et cette personne voit qu’elle a été retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका फ़्लैग %2$@ में से %1$@ होगा। %3$@ को तुरंत हटा दिया जाएगा: होस्ट उनके नए संदेश स्वीकार नहीं करेंगे और उन्हें दिखेगा कि उन्हें हटा दिया गया।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടേത് ഫ്ലാഗ് %1$@ / %2$@ ആയിരിക്കും. %3$@ ഉടൻ നീക്കം ചെയ്യപ്പെടും: ഹോസ്റ്റുകൾ അവരുടെ പുതിയ സന്ദേശങ്ങൾ സ്വീകരിക്കില്ല, തങ്ങളെ നീക്കം ചെയ്തുവെന്ന് അവർ കാണും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा फ्लॅग %2$@ पैकी क्रमांक %1$@ असेल. %3$@ ला लगेच काढले जाईल: होस्ट त्यांचे नवीन संदेश नाकारतील आणि त्यांना काढल्याचे त्यांना दिसेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்களுடையது %2$@-இல் %1$@-ஆவது கொடியாக இருக்கும். %3$@ உடனே நீக்கப்படுவார்: ஹோஸ்ட்கள் அவர்களின் புதிய செய்திகளை ஏற்காது, தாம் நீக்கப்பட்டதை அவர் பார்ப்பார்."
          }
        }
      }
    },
    "group_flag_meter_desc": {
      "comment": "Spoken label of the flag meter. {next} is which flag this would be, {total} flags that remove.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@টির মধ্যে %1$@ নম্বর ফ্ল্যাগ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markierung %1$@ von %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flag %1$@ of %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkintä %1$@/%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signalement %1$@ sur %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ में से फ़्लैग %1$@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫ്ലാഗ് %1$@ / %2$@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ पैकी फ्लॅग %1$@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@-இல் %1$@-ஆவது கொடி"
          }
        }
      }
    },
    "group_flag_text1": {
      "comment": "First paragraph of the flag confirmation.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফ্ল্যাগ ফিরিয়ে নেওয়া যায় না, আর সরানোটা চূড়ান্ত। একই অ্যাডমিন একাধিকবার ফ্ল্যাগ করতে পারেন; প্রতিটি ফ্ল্যাগ গোনা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markierungen lassen sich nicht zurücknehmen, und die Entfernung ist endgültig. Derselbe Admin kann mehrmals markieren; jede Markierung zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flags can’t be taken back, and removal is final. The same admin can flag more than once; each flag counts."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkintöjä ei voi perua, ja poisto on lopullinen. Sama ylläpitäjä voi merkitä useammin kuin kerran; jokainen merkintä lasketaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un signalement ne peut pas être annulé, et le retrait est définitif. Un même admin peut signaler plusieurs fois ; chaque signalement compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़्लैग वापस नहीं लिए जा सकते, और ग्रुप से हटाना स्थायी है। एक ही एडमिन एक से ज़्यादा बार फ़्लैग कर सकते हैं; हर फ़्लैग गिना जाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫ്ലാഗുകൾ പിൻവലിക്കാൻ കഴിയില്ല, ഗ്രൂപ്പിൽ നിന്നുള്ള നീക്കം ചെയ്യൽ സ്ഥിരമാണ്. ഒരേ അഡ്മിന് ഒന്നിലധികം തവണ ഫ്ലാഗ് ചെയ്യാം; ഓരോ ഫ്ലാഗും എണ്ണപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ्लॅग मागे घेता येत नाहीत, आणि ग्रुपमधून काढणे कायमचे असते. एकाच ॲडमिनने एकापेक्षा जास्त वेळा फ्लॅग केले तरी प्रत्येक फ्लॅग मोजला जातो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கொடிகளைத் திரும்பப் பெற முடியாது, நீக்கம் நிரந்தரமானது. ஒரே நிர்வாகி ஒன்றுக்கு மேற்பட்ட முறை கொடியிடலாம்; ஒவ்வொரு கொடியும் கணக்கில் சேரும்."
          }
        }
      }
    },
    "group_flag_text2": {
      "comment": "Second paragraph of the flag confirmation. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফ্ল্যাগ করা গ্রুপের সিদ্ধান্ত। এটা ব্লক করা থেকে আলাদা, যা শুধু আপনাকেই প্রভাবিত করে। %1$@ প্রতিটি ফ্ল্যাগ দেখতে পান: কে দিয়েছেন আর কখন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markieren ist eine Entscheidung der Gruppe. Es ist getrennt vom Blockieren, das nur dich betrifft. %1$@ sieht jede Markierung: wer sie gesetzt hat und wann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagging is a decision for the group. It is separate from blocking, which only affects you. %1$@ sees each flag: who made it and when."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitseminen on ryhmän päätös. Se on eri asia kuin estäminen, joka koskee vain sinua. %1$@ näkee jokaisen merkinnän: kuka sen teki ja milloin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le signalement est une décision collective. Il est distinct du blocage, qui ne concerne que vous. %1$@ voit chaque signalement : qui l’a fait et quand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़्लैग करना ग्रुप का फ़ैसला है। यह ब्लॉक करने से अलग है, जिसका असर सिर्फ़ आप पर होता है। %1$@ हर फ़्लैग देख सकते हैं: किसने लगाया और कब।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫ്ലാഗ് ചെയ്യുന്നത് ഗ്രൂപ്പിന്റെ തീരുമാനമാണ്. ഇത് ബ്ലോക്ക് ചെയ്യുന്നതിൽ നിന്ന് വ്യത്യസ്തമാണ്, അത് നിങ്ങളെ മാത്രമേ ബാധിക്കൂ. ഓരോ ഫ്ലാഗും %1$@ കാണും: ആര് ചെയ്തു, എപ്പോൾ എന്ന്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ्लॅग करणे हा ग्रुपचा निर्णय असतो. तो ब्लॉक करण्यापेक्षा वेगळा आहे; ब्लॉक करणे फक्त तुमच्यापुरते असते. %1$@ ला प्रत्येक फ्लॅग दिसतो: तो कोणी आणि केव्हा केला."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கொடியிடுவது குழுவின் முடிவு. இது தடுப்பதிலிருந்து தனி; தடுப்பது உங்களை மட்டுமே பாதிக்கும். ஒவ்வொரு கொடியையும் யார் எப்போது இட்டார் என்பதை %1$@ பார்ப்பார்."
          }
        }
      }
    },
    "group_flag_title": {
