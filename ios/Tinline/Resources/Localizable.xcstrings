    "group_new_dialog_text": {
      "comment": "Body of the new group dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি মালিক হবেন। এই ডিভাইসটি গ্রুপের প্রথম হোস্ট, তাই এটি গ্রুপটি রাখে এবং পোস্ট পৌঁছে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du wirst Eigentümer. Dieses Gerät ist der erste Host der Gruppe, es speichert die Gruppe und gibt Beiträge weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be the owner. This device is the group’s first host, so it stores the group and passes posts on."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinusta tulee omistaja. Tämä laite on ryhmän ensimmäinen isäntälaite, joten se tallentaa ryhmän ja välittää viestit eteenpäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous en serez propriétaire. Cet appareil est le premier hôte du groupe : il conserve le groupe et transmet les publications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह ग्रुप आपका होगा। यह डिवाइस ग्रुप का पहला होस्ट है, इसलिए यह ग्रुप को सहेजता है और पोस्ट आगे पहुँचाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളായിരിക്കും ഉടമ. ഈ ഉപകരണമാണ് ഗ്രൂപ്പിന്റെ ആദ്യ ഹോസ്റ്റ്, അതിനാൽ ഇത് ഗ്രൂപ്പ് സൂക്ഷിക്കുകയും പോസ്റ്റുകൾ കൈമാറുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही मालक असाल. हे डिव्हाइस ग्रुपचे पहिले होस्ट आहे, म्हणून ते ग्रुप साठवते आणि पोस्ट पुढे पाठवते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள்தான் உரிமையாளர். இந்தச் சாதனமே குழுவின் முதல் ஹோஸ்ட், எனவே இது குழுவைச் சேமித்து இடுகைகளைக் கடத்தும்."
          }
        }
      }
    },
    "group_new_info": {
      "comment": "Info card on the new group page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শুরুতে এই ফোনটিই গ্রুপ হোস্ট করবে: গ্রুপটি রাখবে আর মেসেজ পৌঁছে দেবে। যে কম্পিউটার সবসময় চালু থাকে, সেটি ভালো হোস্ট — সেটি যোগ দিলে গ্রুপের তথ্য থেকে সেটিকে হোস্ট হিসেবে নিযুক্ত করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Handy hostet die Gruppe vorerst: Es hält die Gruppe und gibt Nachrichten weiter. Ein Computer, der an bleibt, ist ein besserer Host – leg ihn in der Gruppeninfo fest, sobald er beigetreten ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone hosts the group at first: it keeps the group and passes messages on. A computer that stays on is a better host — appoint one from Group info once it has joined."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä puhelin isännöi ryhmää aluksi: se säilyttää ryhmän ja välittää viestit eteenpäin. Jatkuvasti päällä oleva tietokone on parempi isäntälaite — nimeä sellainen ryhmän tiedoista, kun se on liittynyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce téléphone héberge le groupe au début : il le conserve et transmet les messages. Un ordinateur qui reste allumé est un meilleur hôte — désignez-en un depuis Infos du groupe une fois qu’il a rejoint."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शुरुआत में यह फ़ोन ग्रुप को होस्ट करता है: यह ग्रुप को रखता है और संदेश आगे पहुँचाता है। हमेशा चालू रहने वाला कंप्यूटर बेहतर होस्ट है — उसके जुड़ जाने पर ग्रुप की जानकारी से उसे नियुक्त करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "തുടക്കത്തിൽ ഈ ഫോണാണ് ഗ്രൂപ്പ് ഹോസ്റ്റ് ചെയ്യുന്നത്: ഇത് ഗ്രൂപ്പ് സൂക്ഷിക്കുകയും സന്ദേശങ്ങൾ കൈമാറുകയും ചെയ്യുന്നു. ഓണായിരിക്കുന്ന ഒരു കമ്പ്യൂട്ടറാണ് കൂടുതൽ നല്ല ഹോസ്റ്റ് — അത് ഗ്രൂപ്പിൽ ചേർന്നുകഴിഞ്ഞാൽ ഗ്രൂപ്പ് വിവരങ്ങളിൽ നിന്ന് നിയമിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुरुवातीला हा फोन ग्रुप होस्ट करतो: तो ग्रुप जपून ठेवतो आणि संदेश पुढे पाठवतो. सतत चालू राहणारा कॉम्प्युटर अधिक चांगला होस्ट असतो — तो ग्रुपमध्ये सामील झाल्यावर ग्रुपच्या माहितीमधून त्याला होस्ट म्हणून नेमा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தொடக்கத்தில் இந்த ஃபோன் குழுவை ஹோஸ்ட் செய்யும்: அது குழுவை வைத்திருந்து செய்திகளைக் கடத்தும். எப்போதும் இயங்கும் கணினி சிறந்த ஹோஸ்ட் — அது சேர்ந்ததும் குழுத் தகவலிலிருந்து அதை நியமியுங்கள்."
          }
        }
      }
    },
    "group_new_owner_hint": {
      "comment": "Hint on the new group page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রুপের মালিক হবেন আপনি। গ্রুপের তথ্য থেকে লোকজনকে আমন্ত্রণ জানান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Gruppe gehört dir. Lade Leute über die Gruppeninfo ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll own the group. Invite people from Group info."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ryhmä on sinun. Kutsu ihmisiä ryhmän tiedoista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous serez propriétaire du groupe. Invitez des personnes depuis Infos du groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह ग्रुप आपका होगा। ग्रुप की जानकारी से लोगों को आमंत्रित करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഗ്രൂപ്പിന്റെ ഉടമ നിങ്ങളായിരിക്കും. ഗ്രൂപ്പ് വിവരങ്ങളിൽ നിന്ന് ആളുകളെ ക്ഷണിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्रुपचे मालक तुम्ही असाल. ग्रुपच्या माहितीमधून लोकांना आमंत्रित करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குழு உங்களுடையதாக இருக்கும். குழுத் தகவலிலிருந்து மக்களை அழையுங்கள்."
          }
        }
      }
    },
