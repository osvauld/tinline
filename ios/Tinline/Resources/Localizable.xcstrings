    },
    "group_join_field": {
      "comment": "Label of the invite link field.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আমন্ত্রণ লিঙ্ক বা কোড"
          }
        },
        "de": {
          "stringUnit": {
