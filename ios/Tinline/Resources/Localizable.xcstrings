    "group_list_empty": {
      "comment": "Shown when the user has no groups.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখনও কোনো গ্রুপ নেই। একটি তৈরি করুন, অথবা কোনো আমন্ত্রণ গ্রহণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Gruppen. Erstelle eine oder nimm eine Einladung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No groups yet. Create one, or accept an invitation."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei vielä ryhmiä. Luo ryhmä tai hyväksy kutsu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas encore de groupe. Créez-en un, ou acceptez une invitation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी कोई ग्रुप नहीं है। नया ग्रुप बनाएँ या कोई आमंत्रण स्वीकार करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇതുവരെ ഗ്രൂപ്പുകളൊന്നുമില്ല. ഒന്ന് സൃഷ്ടിക്കാം, അല്ലെങ്കിൽ ഒരു ക്ഷണം സ്വീകരിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अजून कोणताही ग्रुप नाही. नवीन ग्रुप तयार करा किंवा आमंत्रण स्वीकारा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இன்னும் குழுக்கள் இல்லை. ஒன்றை உருவாக்குங்கள், அல்லது ஓர் அழைப்பிதழை ஏற்றுக்கொள்ளுங்கள்."
          }
        }
      }
    },
