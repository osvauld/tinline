    "people_add_why_refused": {
      "comment": "Preview note when their code is no longer valid. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-এর কোডটি আর কাজ করে না। হয়তো উনি নতুন একটা তৈরি করেছেন, তাই %1$@-এর কাছে সবচেয়ে নতুন কোডটি চেয়ে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Code von %1$@ gilt nicht mehr. Vielleicht gibt es einen neuen, also frag %1$@ nach dem neuesten Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@’s code isn’t valid any more. They may have made a new one, so ask %1$@ for their newest code."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henkilön %1$@ koodi ei ole enää voimassa. Hän on ehkä luonut uuden, joten pyydä henkilöltä %1$@ hänen uusin koodinsa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le code de %1$@ n’est plus valable. Un nouveau a peut-être été créé : demandez à %1$@ son code le plus récent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ का कोड अब मान्य नहीं है। हो सकता है उन्होंने नया कोड बनाया हो, इसलिए %1$@ से उनका सबसे नया कोड माँगें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാളുടെ കോഡ് ഇപ്പോൾ സാധുവല്ല. അവർ പുതിയൊരെണ്ണം ഉണ്ടാക്കിയിരിക്കാം, അതിനാൽ ഏറ്റവും പുതിയ കോഡ് %1$@ എന്നയാളോട് ചോദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ चा कोड आता वैध नाही. त्यांनी कदाचित नवीन कोड बनवला असेल, म्हणून %1$@ कडे त्यांचा सर्वात नवीन कोड मागा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களின் குறியீடு இனி செல்லாது. அவர்கள் புதியதை உருவாக்கியிருக்கலாம், எனவே %1$@ அவர்களிடம் சமீபத்திய குறியீட்டைக் கேளுங்கள்."
          }
        }
      }
    },
    "people_add_why_requested": {
      "comment": "Preview note after the request was sent. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অনুরোধ পাঠানো হয়েছে। %1$@ গ্রহণ করলেই আপনার লাইন খুলে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anfrage gesendet. Deine Leitung öffnet sich, wenn %1$@ annimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request sent. Your line opens when %1$@ accepts."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyyntö lähetetty. Linjasi aukeaa, kun %1$@ hyväksyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demande envoyée. Votre ligne s’ouvre quand %1$@ accepte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अनुरोध भेज दिया। %1$@ के स्वीकार करते ही आपकी लाइन खुल जाएगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അഭ്യർത്ഥന അയച്ചു. %1$@ സ്വീകരിക്കുമ്പോൾ നിങ്ങളുടെ ലൈൻ തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "विनंती पाठवली. %1$@ ने स्वीकारल्यावर तुमची लाइन खुली होईल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோரிக்கை அனுப்பப்பட்டது. %1$@ ஏற்றுக்கொண்டதும் உங்கள் லைன் திறக்கும்."
          }
        }
      }
    },
    "people_add_why_slow": {
      "comment": "Preview note while adding takes long. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখনও চেষ্টা চলছে। এর জন্য %1$@-এর Tinline খোলা আর অনলাইনে থাকা দরকার।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird noch versucht. Tinline muss dafür bei %1$@ offen und online sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still trying. %1$@’s Tinline needs to be open and online for this."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yritetään yhä. Henkilön %1$@ Tinlinen täytyy olla auki ja verkossa tätä varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nouvel essai en cours. Le Tinline de %1$@ doit être ouvert et en ligne pour cela."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोशिश जारी है। इसके लिए %1$@ का Tinline खुला और ऑनलाइन होना चाहिए।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇപ്പോഴും ശ്രമിക്കുന്നു. ഇതിനായി %1$@ എന്നയാളുടെ Tinline തുറന്ന് ഓൺലൈനിലായിരിക്കണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अजून प्रयत्न सुरू आहे. यासाठी %1$@ चे Tinline उघडे आणि ऑनलाइन असायला हवे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இன்னும் முயல்கிறது. இதற்கு %1$@ அவர்களின் Tinline திறந்து ஆன்லைனில் இருக்க வேண்டும்."
          }
        }
      }
    },
    "people_add_why_timeout": {
      "comment": "Preview note when the person could not be reached. {name} is their name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-এর Tinline-এ পৌঁছানো গেল না। এটা খোলা আর অনলাইনে থাকা দরকার, তাই %1$@ কাছাকাছি থাকলে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline bei %1$@ war nicht erreichbar. Es muss offen und online sein, versuch es also nochmal, wenn %1$@ da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach %1$@’s Tinline. It needs to be open and online, so try again when %1$@’s around."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henkilön %1$@ Tinlinea ei tavoitettu. Sen täytyy olla auki ja verkossa, joten yritä uudelleen, kun %1$@ on paikalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre le Tinline de %1$@. Il doit être ouvert et en ligne, alors réessayez quand %1$@ sera disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ के Tinline से संपर्क नहीं हो पाया। उसका खुला और ऑनलाइन होना ज़रूरी है, इसलिए जब %1$@ आसपास हों तब फिर से कोशिश करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാളുടെ Tinline-ലേക്ക് എത്താൻ കഴിഞ്ഞില്ല. അത് തുറന്ന് ഓൺലൈനിലായിരിക്കണം, അതിനാൽ %1$@ ലഭ്യമാകുമ്പോൾ വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ च्या Tinline पर्यंत पोहोचता आले नाही. ते उघडे आणि ऑनलाइन असायला हवे, म्हणून %1$@ उपलब्ध असताना पुन्हा प्रयत्न करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களின் Tinline-ஐ அடைய முடியவில்லை. அது திறந்து ஆன்லைனில் இருக்க வேண்டும், எனவே %1$@ இருக்கும்போது மீண்டும் முயலுங்கள்."
          }
        }
      }
    },
