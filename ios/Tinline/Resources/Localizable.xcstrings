          "stringUnit": {
            "state": "needs_review",
            "value": "Es gleicht sich ab, wenn beide Geräte gleichzeitig online sind. Kontakte, die du nicht blockiert hast, bekommen deine neue Geräteliste, wenn sie das nächste Mal online sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It syncs when both devices are online at the same time. Contacts you haven’t blocked get your updated device list when they’re next online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se synkronoituu, kun molemmat laitteet ovat verkossa yhtä aikaa. Yhteystiedot, joita et ole estänyt, saavat päivitetyn laitelistasi, kun ovat seuraavan kerran verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il se synchronise quand les deux appareils sont en ligne en même temps. Les contacts que vous n’avez pas bloqués reçoivent votre liste d’appareils à jour lors de leur prochaine connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब दोनों डिवाइस एक साथ ऑनलाइन होते हैं, तब यह सिंक होता है। जिन संपर्कों को आपने ब्लॉक नहीं किया है, उन्हें अगली बार ऑनलाइन आने पर आपके डिवाइस की नई सूची मिल जाएगी।"
          }
        }
      }
    },
