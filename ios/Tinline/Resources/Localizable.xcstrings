        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksi muista laitteistasi poisti tältä puhelimelta tilin %1$@. Sen yhteystiedot, keskustelut ja puhelut on poistettu täältä. Muihin laitteisiisi tämä ei vaikuta."
          }
        },
        "fr": {
          "stringUnit": {
