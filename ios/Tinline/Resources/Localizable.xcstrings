    "onboarding_pass_lead": {
      "comment": "Explanation on the passphrase screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optional. Ein Schloss, damit nur du Tinline auf diesem Handy öffnen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. A lock, so only you can open Tinline on this phone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valinnainen. Lukko, jotta vain sinä voit avata Tinlinen tällä puhelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Facultatif. Un verrou, pour que vous seul puissiez ouvrir Tinline sur ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ज़रूरी नहीं। एक ताला, ताकि इस फ़ोन पर Tinline सिर्फ़ आप खोल सकें।"
          }
        }
      }
    },
    "onboarding_pass_notice": {
      "comment": "Notice on the passphrase screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschlüsselt dein Konto auf diesem Handy. Dein Handy merkt sie sich, sodass Anrufe auch nach einem Neustart klingeln. Wenn du sie vergisst, kannst du mit deinen Wiederherstellungswörtern eine neue festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypts your account on this phone. Your phone remembers it, so calls still ring after a restart. If you forget it, your recovery words let you set a new one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salaa tilisi tällä puhelimella. Puhelimesi muistaa sen, joten puhelut soivat myös uudelleenkäynnistyksen jälkeen. Jos unohdat sen, palautussanoilla voit asettaa uuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffre votre compte sur ce téléphone. Votre téléphone s’en souvient, donc les appels sonnent toujours après un redémarrage. Si vous l’oubliez, vos mots de récupération vous permettent d’en choisir une nouvelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर आपके खाते को एन्क्रिप्ट करता है। आपका फ़ोन इसे याद रखता है, इसलिए रीस्टार्ट के बाद भी कॉल की घंटी बजती है। अगर आप इसे भूल जाएँ, तो रिकवरी शब्दों से नया रख सकते हैं।"
          }
        }
      }
    },
    "onboarding_pass_title": {
