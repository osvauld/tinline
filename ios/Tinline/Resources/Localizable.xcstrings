    "shell_pass_strength_empty": {
      "comment": "Passphrase hint while the field is empty.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যেকোনো দৈর্ঘ্য চলবে। এলোমেলো কয়েকটি শব্দ মনে রাখা সহজ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Länge geht. Ein paar zufällige Wörter kann man sich gut merken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any length works. A few random words are easy to remember."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikä tahansa pituus käy. Muutama satunnainen sana on helppo muistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toutes les longueurs conviennent. Quelques mots au hasard sont faciles à retenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई भी लंबाई चलेगी। कुछ बेतरतीब शब्द याद रखना आसान होता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "എത്ര നീളവുമാകാം. ക്രമമില്ലാത്ത കുറച്ച് വാക്കുകൾ ഓർക്കാൻ എളുപ്പമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कितीही लांबीचा चालतो. एकमेकांशी संबंध नसलेले काही शब्द लक्षात ठेवायला सोपे असतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "எந்த நீளமும் சரி. சில சீரற்ற வார்த்தைகள் நினைவில் வைக்க எளிது."
          }
        }
      }
    },
