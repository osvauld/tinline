    "group_invite_none": {
      "comment": "Shown on the invite sheet when there is nobody left to invite.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার পরিচিতির সবাই হয় এই গ্রুপে আছেন, নয়তো তাঁদের জন্য আমন্ত্রণ অপেক্ষা করছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle deine Kontakte sind schon in dieser Gruppe oder haben eine offene Einladung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone in your contacts is already in this group or has an invite waiting."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaikki yhteystietosi ovat jo tässä ryhmässä tai heillä on odottava kutsu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous vos contacts sont déjà dans ce groupe ou ont une invitation en attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके सभी संपर्क या तो पहले से इस ग्रुप में हैं या उनका आमंत्रण इंतज़ार में है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ കോൺടാക്റ്റുകളിലെ എല്ലാവരും ഇതിനകം ഈ ഗ്രൂപ്പിലുണ്ട്, അല്ലെങ്കിൽ അവർക്കായി ഒരു ക്ഷണം കാത്തിരിക്കുന്നുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या संपर्कांमधील सर्व जण आधीच या ग्रुपमध्ये आहेत किंवा त्यांना आमंत्रण पाठवलेले आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் தொடர்புகள் அனைவரும் ஏற்கெனவே இந்தக் குழுவில் உள்ளனர், அல்லது அவர்களுக்கு அழைப்பிதழ் காத்திருக்கிறது."
          }
        }
      }
    },
