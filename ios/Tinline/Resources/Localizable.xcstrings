    "group_done_flag": {
      "comment": "Confirmation after flagging a member.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফ্ল্যাগ দেওয়া হয়েছে। এতে আপনার স্বাক্ষর আছে, আর ওই সদস্য এটা দেখতে পাবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markierung gespeichert. Sie ist von dir signiert, und das Mitglied kann sie sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flag recorded. It is signed by you and the member can see it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkintä tallennettu. Allekirjoitit sen, ja jäsen näkee sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signalement enregistré. Il est signé par vous et le membre peut le voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़्लैग दर्ज हो गया। इस पर आपके हस्ताक्षर हैं और सदस्य इसे देख सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫ്ലാഗ് രേഖപ്പെടുത്തി. ഇത് നിങ്ങൾ ഒപ്പിട്ടതാണ്, അംഗത്തിന് ഇത് കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ्लॅग नोंदवला. त्यावर तुमची स्वाक्षरी आहे आणि सदस्याला तो दिसू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கொடி பதிவானது. அதில் உங்கள் கையொப்பம் உள்ளது, அந்த உறுப்பினர் அதைப் பார்க்க முடியும்."
          }
        }
      }
    },
    "group_done_host_accepted": {
      "comment": "Confirmation after this phone agreed to host.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোন হোস্ট করতে রাজি হয়েছে। কোনো অ্যাডমিন নিযুক্ত করলেই হোস্ট করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Handy hat dem Hosten zugestimmt. Es hostet, sobald ein Admin es festgelegt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone agreed to host. It hosts as soon as an admin has appointed it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä puhelin suostui isännöimään. Se alkaa isännöidä heti, kun ylläpitäjä on nimennyt sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce téléphone a accepté d’héberger. Il héberge dès qu’un admin l’a désigné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह फ़ोन होस्ट करने के लिए मान गया। किसी एडमिन के नियुक्त करते ही यह होस्ट करेगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഹോസ്റ്റ് ചെയ്യാൻ ഈ ഫോൺ സമ്മതിച്ചു. ഒരു അഡ്മിൻ നിയമിച്ചാലുടൻ ഇത് ഹോസ്റ്റ് ചെയ്തുതുടങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हा फोन होस्ट करण्यास तयार आहे. ॲडमिनने नेमल्यावर तो लगेच होस्ट करेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த ஃபோன் ஹோஸ்ட் செய்ய ஒப்புக்கொண்டது. ஒரு நிர்வாகி நியமித்தவுடன் ஹோஸ்ட் செய்யும்."
          }
        }
      }
    },
    "group_done_host_declined": {
      "comment": "Confirmation after declining a host request.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফিরিয়ে দেওয়া হয়েছে। অ্যাডমিনরা এই ফোন থেকে কোনো উত্তর দেখবেন না।"
