    "group_removed_card_text": {
      "comment": "Notice card text. {names} is who flagged the user.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ফ্ল্যাগ করেছেন। আগে যা পেয়েছেন তা এখনও পড়তে পারবেন; নতুন কিছু আর আসবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markiert von %1$@. Was du vorher bekommen hast, kannst du weiter lesen; Neues kommt nicht mehr an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagged by %1$@. You can still read what you received before; nothing new will arrive."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitsijät: %1$@. Voit yhä lukea aiemmin saamasi viestit, mutta uusia ei enää tule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signalé par %1$@. Vous pouvez toujours lire ce que vous avez reçu avant ; rien de nouveau n’arrivera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने फ़्लैग किया। पहले मिले संदेश आप अब भी पढ़ सकते हैं; अब कुछ नया नहीं आएगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഫ്ലാഗ് ചെയ്തവർ: %1$@. മുമ്പ് ലഭിച്ചവ ഇപ്പോഴും വായിക്കാം; പുതിയതൊന്നും വരില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ यांनी फ्लॅग केले. आधी मिळालेले तुम्ही अजूनही वाचू शकता; नवीन काही येणार नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கொடியிட்டவர்கள்: %1$@. முன்பு பெற்றவற்றை இன்னும் படிக்கலாம்; புதிதாக எதுவும் வராது."
          }
        }
      }
    },
