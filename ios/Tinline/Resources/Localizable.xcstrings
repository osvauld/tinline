          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä on liian pitkä tilaksi: enintään %1$@ tavua, ja jotkin merkit vievät enemmän kuin yhden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C’est trop long pour un statut : %1$@ octets au maximum, et certains caractères en prennent plus d’un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टेटस के लिए यह बहुत लंबा है: %1$@ बाइट तक, और कुछ वर्ण एक से ज़्यादा बाइट लेते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സ്റ്റാറ്റസിന് ഇത് വളരെ നീളമുള്ളതാണ്: പരമാവധി %1$@ ബൈറ്റ്, ചില അക്ഷരങ്ങൾക്ക് ഒന്നിലധികം ബൈറ്റ് വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टेटससाठी हे खूप मोठे आहे: जास्तीत जास्त %1$@ बाइट, आणि काही अक्षरांना एकापेक्षा जास्त बाइट लागतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நிலைக்கு இது மிக நீளம்: %1$@ பைட்டுகள் வரை இருக்கலாம், சில எழுத்துகள் ஒன்றுக்கு மேற்பட்ட பைட்டுகளை எடுக்கும்."
          }
        }
      }
    },
    "people_rule_too_many": {
      "comment": "Profile check: too many information items. {max} is the most pieces of information allowed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@টি তথ্যের সীমা পূর্ণ হয়ে গেছে। আরেকটি যোগ করতে একটি সরান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast %1$@ Angaben erreicht. Entferne eine, um eine neue hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve reached %1$@ pieces of information. Remove one to add another."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinulla on jo %1$@ tietoa. Poista yksi, jos haluat lisätä uuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez atteint %1$@ informations. Retirez-en une pour en ajouter une autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ जानकारियों की सीमा पूरी हो गई है। नई जोड़ने के लिए एक हटाएँ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ %1$@ വിവരങ്ങൾ എന്ന പരിധിയിലെത്തി. മറ്റൊന്ന് ചേർക്കാൻ ഒരെണ്ണം നീക്കം ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही माहितीच्या %1$@ नोंदींच्या मर्यादेपर्यंत पोहोचलात. दुसरी जोडण्यासाठी एक काढा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ தகவல்களை எட்டிவிட்டீர்கள். இன்னொன்றைச் சேர்க்க, ஒன்றை அகற்றுங்கள்."
          }
        }
      }
    },
    "people_rule_value_long": {
      "comment": "Profile check: a value is too long. {limit} is the size limit with its unit, such as 16 KiB.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা খুব লম্বা। প্রতিটি তথ্য %1$@ পর্যন্ত হতে পারে।"
          }
