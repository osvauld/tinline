    "people_remove_picture_failed": {
      "comment": "Profile picture could not be removed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ছবি সরানো গেল না। ছবি যেমন ছিল তেমনই আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Bild ließ sich nicht entfernen. Es bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t remove your picture. It is unchanged."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvaasi ei voitu poistaa. Se on ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de retirer votre photo. Elle n’a pas changé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी फ़ोटो हटाई नहीं जा सकी। वह पहले जैसी है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ ഫോട്ടോ നീക്കം ചെയ്യാൻ കഴിഞ്ഞില്ല. അതിന് മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा फोटो काढता आला नाही. तो जसा होता तसाच आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் படத்தை அகற்ற முடியவில்லை. அது மாறவில்லை."
          }
        }
      }
    },
    "people_rule_about_control": {
      "comment": "Profile check: the about text has control characters.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“নিজের সম্পর্কে”-তে কন্ট্রোল বা লেখার দিক বদলানোর অক্ষর রাখা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Über mich“ darf keine Steuer- oder Textrichtungszeichen enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About can’t contain control or text-direction characters."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tietoja-kentässä ei voi olla ohjaus- tai tekstisuuntamerkkejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La section À propos ne peut pas contenir de caractères de contrôle ou de sens d’écriture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिचय में कंट्रोल या टेक्स्ट-दिशा वाले वर्ण नहीं हो सकते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“എന്നെക്കുറിച്ച്” എന്നതിൽ കൺട്രോൾ അക്ഷരങ്ങളോ ടെക്സ്റ്റ് ദിശാ അക്ഷരങ്ങളോ പാടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिचयात कंट्रोल किंवा मजकुराची दिशा बदलणारी अक्षरे असू शकत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அறிமுகத்தில் கட்டுப்பாட்டு எழுத்துகளோ உரை-திசை எழுத்துகளோ இருக்கக் கூடாது."
          }
        }
      }
    },
    "people_rule_about_long": {
      "comment": "Profile check: the about text is too long. {limit} is the byte limit.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“নিজের সম্পর্কে”-র জন্য এটা খুব লম্বা: %1$@ বাইট পর্যন্ত চলবে, আর কিছু অক্ষর একাধিক বাইট নেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist zu lang für „Über mich“: bis zu %1$@ Bytes, und manche Zeichen brauchen mehr als eins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is too long for about: up to %1$@ bytes, and some characters take more than one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä on liian pitkä Tietoja-kenttään: enintään %1$@ tavua, ja jotkin merkit vievät enemmän kuin yhden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C’est trop long pour la section À propos : %1$@ octets au maximum, et certains caractères en prennent plus d’un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिचय के लिए यह बहुत लंबा है: %1$@ बाइट तक, और कुछ वर्ण एक से ज़्यादा बाइट लेते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“എന്നെക്കുറിച്ച്” എന്നതിന് ഇത് വളരെ നീളമുള്ളതാണ്: പരമാവധി %1$@ ബൈറ്റ്, ചില അക്ഷരങ്ങൾക്ക് ഒന്നിലധികം ബൈറ്റ് വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिचयासाठी हे खूप मोठे आहे: जास्तीत जास्त %1$@ बाइट, आणि काही अक्षरांना एकापेक्षा जास्त बाइट लागतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அறிமுகத்துக்கு இது மிக நீளம்: %1$@ பைட்டுகள் வரை இருக்கலாம், சில எழுத்துகள் ஒன்றுக்கு மேற்பட்ட பைட்டுகளை எடுக்கும்."
          }
        }
      }
    },
    "people_rule_availability": {
      "comment": "Profile check: availability cannot be removed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফ্রি/ব্যস্ত বদলানো যায়, কিন্তু সরানো যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Erreichbarkeit kann geändert, aber nicht entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Availability can be changed but not removed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tavoitettavuutta voi muuttaa, mutta sitä ei voi poistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La disponibilité peut être modifiée mais pas retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उपलब्धता बदली जा सकती है, पर हटाई नहीं जा सकती।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ലഭ്യത മാറ്റാം, പക്ഷേ നീക്കം ചെയ്യാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उपलब्धता बदलता येते, पण काढता येत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கிடைக்கும் நிலையை மாற்றலாம், ஆனால் அகற்ற முடியாது."
          }
        }
      }
    },
    "people_rule_full": {
      "comment": "Profile check: the whole profile is too big.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার প্রোফাইল ভরে গেছে। আরও যোগ করতে কিছু তথ্য সরান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Profil ist voll. Entferne einige Angaben, um mehr hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is full. Remove some information to add more."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiilisi on täynnä. Poista tietoja lisätäksesi uusia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre profil est plein. Retirez des informations pour en ajouter d’autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी प्रोफ़ाइल भर गई है। और जोड़ने के लिए कुछ जानकारी हटाएँ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ പ്രൊഫൈൽ നിറഞ്ഞു. കൂടുതൽ ചേർക്കാൻ ചില വിവരങ്ങൾ നീക്കം ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे प्रोफाइल भरले आहे. आणखी जोडण्यासाठी काही माहिती काढा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் சுயவிவரம் நிரம்பிவிட்டது. மேலும் சேர்க்க, சில தகவல்களை அகற்றுங்கள்."
          }
        }
      }
    },
    "people_rule_key_bad": {
      "comment": "Profile check: the name of a custom information item is not allowed.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই নামটি ব্যবহার করা যাবে না। ছোট রাখুন, কন্ট্রোল অক্ষর ছাড়া।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Name geht nicht. Halte ihn kurz, ohne Steuerzeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name can’t be used. Keep it short, without control characters."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tätä nimeä ei voi käyttää. Pidä se lyhyenä ja ilman ohjausmerkkejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce nom ne peut pas être utilisé. Gardez-le court, sans caractères de contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह नाम नहीं चल सकता। इसे छोटा रखें, बिना कंट्रोल वर्णों के।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ പേര് ഉപയോഗിക്കാൻ കഴിയില്ല. കൺട്രോൾ അക്ഷരങ്ങളില്ലാതെ ചെറുതായി നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते नाव वापरता येत नाही. ते लहान ठेवा, कंट्रोल अक्षरांशिवाय."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்தப் பெயரைப் பயன்படுத்த முடியாது. கட்டுப்பாட்டு எழுத்துகள் இல்லாமல் சுருக்கமாக வையுங்கள்."
          }
        }
      }
    },
    "people_rule_key_empty": {
      "comment": "Profile check: a custom information item has no name.",
      "extractionState": "manual",
      "localizations": {
