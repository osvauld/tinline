      }
    },
    "shell_empty_request_waiting": {
      "comment": "Home hero line after the user sent a contact request. {name} is the first name of the person asked.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-কে পাঠানো আপনার অনুরোধ অপেক্ষায় আছে। উনি গ্রহণ করলেই আপনার লাইন খুলে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Anfrage an %1$@ wartet. Deine Leitung öffnet sich, wenn die Person annimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request to %1$@ is waiting. Your line opens when they accept."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyyntösi henkilölle %1$@ odottaa. Linjasi aukeaa, kun hän hyväksyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre demande à %1$@ est en attente. Votre ligne s’ouvre quand cette personne accepte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ को भेजा आपका अनुरोध इंतज़ार में है। उनके स्वीकार करते ही आपकी लाइन खुल जाएगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാൾക്കുള്ള നിങ്ങളുടെ അഭ്യർത്ഥന കാത്തിരിക്കുകയാണ്. അവർ സ്വീകരിക്കുമ്പോൾ നിങ്ങളുടെ ലൈൻ തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला पाठवलेली तुमची विनंती प्रतीक्षेत आहे. त्यांनी स्वीकारल्यावर तुमची लाइन खुली होईल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ அவர்களுக்கான உங்கள் கோரிக்கை காத்திருக்கிறது. அவர் ஏற்றுக்கொண்டதும் உங்கள் லைன் திறக்கும்."
          }
        }
      }
    },
