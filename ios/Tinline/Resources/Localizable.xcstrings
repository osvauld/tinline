    "onboarding_done_lead": {
      "comment": "Explanation when the account is ready.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ওঁর কোড স্ক্যান করুন বা আপনারটা শেয়ার করুন, তাহলেই একে অপরকে কল করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanne ihren Code oder teile deinen, dann könnt ihr euch anrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan their code or share yours, and you can call each other."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skannaa heidän koodinsa tai jaa omasi, niin voitte soittaa toisillenne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez leur code ou partagez le vôtre, et vous pourrez vous appeler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उनका कोड स्कैन करें या अपना शेयर करें, फिर आप एक-दूसरे को कॉल कर सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അവരുടെ കോഡ് സ്കാൻ ചെയ്യുക, അല്ലെങ്കിൽ നിങ്ങളുടേത് പങ്കിടുക, പിന്നെ നിങ്ങൾക്ക് പരസ്പരം വിളിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यांचा कोड स्कॅन करा किंवा तुमचा शेअर करा, मग तुम्ही एकमेकांना कॉल करू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அவர்களின் குறியீட்டை ஸ்கேன் செய்யுங்கள் அல்லது உங்களுடையதைப் பகிருங்கள், பிறகு நீங்கள் ஒருவரையொருவர் அழைக்கலாம்."
          }
        }
      }
    },
