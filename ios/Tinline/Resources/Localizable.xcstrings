    "group_done_left": {
      "comment": "Confirmation after leaving a group.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি গ্রুপ ছেড়ে দিয়েছেন। এর মেসেজগুলো এখানে থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast die Gruppe verlassen. Die Nachrichten bleiben hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the group. Its messages stay here."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poistuit ryhmästä. Sen viestit jäävät tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez quitté le groupe. Ses messages restent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने ग्रुप छोड़ दिया। इसके संदेश यहाँ रहेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ഗ്രൂപ്പിൽ നിന്ന് പുറത്തുകടന്നു. ഇതിലെ സന്ദേശങ്ങൾ ഇവിടെത്തന്നെയുണ്ടാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही ग्रुप सोडला. त्याचे संदेश इथे राहतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் குழுவிலிருந்து வெளியேறிவிட்டீர்கள். அதன் செய்திகள் இங்கேயே இருக்கும்."
          }
        }
      }
    },
    "group_done_request_accepted": {
      "comment": "Toast after accepting a private chat request. {name} is the requester's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রহণ করা হয়েছে। %1$@-কে শুধু মেসেজের জন্য যোগ করা হয়েছে, ওঁর ডিভাইস কানেক্ট হলেই চ্যাটে দেখা যাবে; আপনি অনুমতি না দেওয়া পর্যন্ত কল বন্ধ থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angenommen. %1$@ ist nur für Nachrichten hinzugefügt und erscheint unter Chats, sobald das Gerät verbunden ist; Anrufe bleiben aus, bis du sie erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted. %1$@ is added for messages only and shows in Chats once their device connects; calls stay off until you allow them."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksytty. %1$@ lisättiin vain viestejä varten ja näkyy Keskusteluissa, kun hänen laitteensa saa yhteyden; puhelut pysyvät pois päältä, kunnes sallit ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accepté. %1$@ fait maintenant partie de vos contacts pour les messages uniquement et apparaît dans Discussions dès que son appareil se connecte ; les appels restent désactivés jusqu’à ce que vous les autorisiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकार किया। %1$@ सिर्फ़ संदेशों के लिए जोड़े गए हैं और उनका डिवाइस जुड़ते ही चैट में दिखेंगे; जब तक आप अनुमति न दें, कॉल बंद रहेंगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സ്വീകരിച്ചു. %1$@ സന്ദേശങ്ങൾക്ക് മാത്രമായി ചേർക്കപ്പെട്ടു, അവരുടെ ഉപകരണം കണക്റ്റ് ചെയ്യുമ്പോൾ ചാറ്റുകളിൽ കാണാം; നിങ്ങൾ അനുവദിക്കുന്നതുവരെ കോളുകൾ ഓഫായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकारले. %1$@ ला फक्त संदेशांसाठी जोडले आहे, आणि त्यांचे डिव्हाइस कनेक्ट झाल्यावर ते चॅटमध्ये दिसतील; तुम्ही परवानगी देईपर्यंत कॉल बंद राहतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஏற்றுக்கொள்ளப்பட்டது. %1$@ செய்திகளுக்கு மட்டும் சேர்க்கப்பட்டார், அவரது சாதனம் இணைந்ததும் அரட்டைகளில் தெரிவார்; நீங்கள் அனுமதிக்கும் வரை அழைப்புகள் முடக்கத்தில் இருக்கும்."
          }
        }
      }
    },
    "group_done_request_accepted_unnamed": {
      "comment": "Toast after accepting a private chat request from someone whose name is not known.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
