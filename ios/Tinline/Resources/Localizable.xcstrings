            "value": "कनेक्शन अच्छा हो तो अपने-आप HD हो जाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കണക്ഷൻ അനുവദിക്കുമ്പോൾ തനിയെ HD ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कनेक्शन चांगले असेल तेव्हा आपोआप HD होतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இணைப்பு அனுமதிக்கும்போது தானாகவே HD-க்கு மாறும்."
          }
