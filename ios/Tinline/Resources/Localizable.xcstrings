    "group_leave_admin": {
      "comment": "Extra line in the leave dialog for admins.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist Admin. Der Eigentümer und die anderen Admins bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re an admin. The owner and the other admins stay."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olet ylläpitäjä. Omistaja ja muut ylläpitäjät jäävät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes admin. Le propriétaire et les autres admins restent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप एडमिन हैं। मालिक और बाकी एडमिन बने रहेंगे।"
          }
        }
      }
    },
    "group_leave_text": {
      "comment": "Body of the leave dialog.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bekommst keine Beiträge mehr. Was schon auf diesem Gerät ist, bleibt, und du kannst es lesen. Um zurückzukommen, muss dich jemand aus der Gruppe neu einladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll stop getting posts. What’s already on this device stays, and you can read it. To come back, someone in the group has to invite you again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et saa enää viestejä. Se, mikä on jo tällä laitteella, säilyy, ja voit lukea sitä. Palataksesi tarvitset uuden kutsun joltakulta ryhmän jäseneltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne recevrez plus les publications. Ce qui est déjà sur cet appareil reste, et vous pouvez le lire. Pour revenir, quelqu’un du groupe doit vous inviter à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपको नई पोस्ट मिलनी बंद हो जाएँगी। जो पहले से इस डिवाइस पर है, वह यहीं रहेगा और आप उसे पढ़ सकेंगे। वापस आने के लिए ग्रुप के किसी सदस्य को आपको फिर से आमंत्रित करना होगा।"
          }
        }
      }
    },
    "group_leave_title": {
      "comment": "Title of the leave dialog. {group} is the group’s name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ verlassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave %1$@?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poistutko ryhmästä %1$@?"
          }
        },
        "fr": {
          "stringUnit": {
