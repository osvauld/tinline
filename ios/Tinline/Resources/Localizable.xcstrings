    "people_add_why_offline": {
      "comment": "Preview note when the user is offline while adding.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি অফলাইনে আছেন। কানেক্ট হলে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist offline. Sobald du verbunden bist, versuch es nochmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Once you’re connected, try again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et ole verkossa. Yritä uudelleen, kun olet yhteydessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes hors ligne. Une fois connecté, réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप ऑफ़लाइन हैं। कनेक्ट होने के बाद फिर से कोशिश करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ഓഫ്‌ലൈനാണ്. കണക്റ്റ് ആയിക്കഴിഞ്ഞാൽ വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही ऑफलाइन आहात. कनेक्ट झाल्यावर पुन्हा प्रयत्न करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் ஆஃப்லைனில் இருக்கிறீர்கள். இணைந்ததும் மீண்டும் முயலுங்கள்."
          }
        }
      }
    },
    "people_add_why_reaching": {
