    "people_rule_name_long": {
      "comment": "Profile check: the name is too long. {limit} is the byte limit.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নামটি খুব লম্বা। %1$@ বাইট পর্যন্ত চলবে; কিছু অক্ষর একাধিক বাইট নেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Name ist zu lang. Bis zu %1$@ Bytes; manche Zeichen brauchen mehr als eins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is too long. Up to %1$@ bytes; some characters take more than one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nimi on liian pitkä. Enintään %1$@ tavua; jotkin merkit vievät enemmän kuin yhden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce nom est trop long. %1$@ octets au maximum ; certains caractères en prennent plus d’un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह नाम बहुत लंबा है। %1$@ बाइट तक; कुछ वर्ण एक से ज़्यादा बाइट लेते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ പേര് വളരെ നീളമുള്ളതാണ്. പരമാവധി %1$@ ബൈറ്റ്; ചില അക്ഷരങ്ങൾക്ക് ഒന്നിലധികം ബൈറ്റ് വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते नाव खूप मोठे आहे. जास्तीत जास्त %1$@ बाइट; काही अक्षरांना एकापेक्षा जास्त बाइट लागतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்தப் பெயர் மிக நீளமாக உள்ளது. %1$@ பைட்டுகள் வரை இருக்கலாம்; சில எழுத்துகள் ஒன்றுக்கு மேற்பட்ட பைட்டுகளை எடுக்கும்."
          }
        }
      }
    },
