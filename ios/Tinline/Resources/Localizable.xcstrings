    "people_ui_remove_note": {
      "comment": "Note in the remove field question.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি আপনার প্রোফাইল থেকে চলে যাবে। আগের সংস্করণ সিঙ্ক করা ইতিহাসে থেকে যেতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Angabe verschwindet aus deinem Profil. Frühere Versionen können im synchronisierten Verlauf bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It disappears from your profile. Earlier versions can remain in synced history."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se katoaa profiilistasi. Aiemmat versiot voivat jäädä synkronoituun historiaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce champ disparaît de votre profil. Des versions précédentes peuvent rester dans l’historique synchronisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह आपकी प्रोफ़ाइल से हट जाएगा। पुराने संस्करण सिंक किए गए इतिहास में रह सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് നിങ്ങളുടെ പ്രൊഫൈലിൽ നിന്ന് മാറും. മുമ്പത്തെ പതിപ്പുകൾ സിങ്ക് ചെയ്ത ചരിത്രത്തിൽ ശേഷിച്ചേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते तुमच्या प्रोफाइलवरून दिसेनासे होईल. आधीच्या आवृत्त्या सिंक झालेल्या इतिहासात राहू शकतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது உங்கள் சுயவிவரத்திலிருந்து மறையும். முந்தைய பதிப்புகள் ஒத்திசைக்கப்பட்ட வரலாற்றில் இருக்கக்கூடும்."
          }
        }
      }
    },
