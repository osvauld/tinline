        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वे ब्लॉक हैं और अब और अनुरोध नहीं भेज सकते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അവരെ ബ്ലോക്ക് ചെയ്തു, ഇനി അഭ്യർത്ഥനകൾ അയയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यांना ब्लॉक केले आहे, आता ते आणखी विनंत्या पाठवू शकत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அவர் தடுக்கப்பட்டார், இனி கோரிக்கைகளை அனுப்ப முடியாது."
          }
        }
      }
    },
    "group_done_request_declined": {
      "comment": "Toast after declining a private chat request. {name} is the requester's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফিরিয়ে দেওয়া হয়েছে। %1$@-কে জানানো হবে “ফিরিয়ে দেওয়া হয়েছে”।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abgelehnt. %1$@ erfährt „abgelehnt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined. %1$@ is told “declined”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hylätty. %1$@ saa tiedon ”hylätty”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Refusé. %1$@ verra « refusé »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अस्वीकार कर दिया। %1$@ को बताया गया है कि अनुरोध अस्वीकार हुआ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിരസിച്ചു. “നിരസിച്ചു” എന്ന് %1$@ അറിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नाकारले. %1$@ ला “नाकारले” असे कळवले जाते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நிராகரிக்கப்பட்டது. %1$@ அவர்களுக்கு “நிராகரிக்கப்பட்டது” எனத் தெரிவிக்கப்படும்."
          }
        }
      }
    },
