    "group_join_hint": {
      "comment": "Hint on the join page.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Beitreten verbindet sich dieses Handy mit den Hosts der Gruppe. Mitglieder sehen deinen Namen; nur Hosts erfahren, wie sie dieses Handy erreichen. Das kann bis zu einer Minute dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining connects this phone to the group’s hosts. Members see your name; only hosts learn how to reach this phone. It can take up to a minute."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liittyminen yhdistää tämän puhelimen ryhmän isäntälaitteisiin. Jäsenet näkevät nimesi; vain isäntälaitteet saavat tietää, miten tämän puhelimen tavoittaa. Tämä voi kestää minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejoindre connecte ce téléphone aux hôtes du groupe. Les membres voient votre nom ; seuls les hôtes savent comment joindre ce téléphone. Cela peut prendre jusqu’à une minute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जुड़ने पर यह फ़ोन ग्रुप के होस्ट से जुड़ता है। सदस्यों को आपका नाम दिखता है; इस फ़ोन तक पहुँचने का तरीका सिर्फ़ होस्ट जानते हैं। इसमें एक मिनट तक लग सकता है।"
          }
        }
      }
    },
