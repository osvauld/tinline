    "settings_perms_note": {
      "comment": "Note under the permission rows.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese legt dein System fest, nicht Tinline. Tinline fragt nur, wenn es eine braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are set by your system, not by Tinline. Tinline asks only when it needs one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nämä asettaa järjestelmäsi, ei Tinline. Tinline kysyy vain, kun tarvitsee jotain niistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces autorisations sont gérées par votre système, pas par Tinline. Tinline ne les demande que lorsqu’il en a besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ये आपके सिस्टम में सेट होते हैं, Tinline में नहीं। Tinline तभी पूछता है जब उसे इनमें से किसी की ज़रूरत हो।"
          }
        }
      }
    },
    "settings_privacy_note": {
      "comment": "Note under the privacy rows.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kontakte sehen deinen Namen, dein Bild und dein Profil. Tinline verbirgt nicht, mit wem du sprichst, und jedes Gerät, das mit deinem Konto verknüpft ist, kann deine Chats lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts see your name, picture and profile. Tinline doesn’t hide who you talk to, and every device linked to your account can read your chats."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteystietosi näkevät nimesi, kuvasi ja profiilisi. Tinline ei piilota, kenen kanssa puhut, ja jokainen tiliisi linkitetty laite voi lukea keskustelusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts voient votre nom, votre photo et votre profil. Tinline ne cache pas avec qui vous parlez, et chaque appareil associé à votre compte peut lire vos discussions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके संपर्क आपका नाम, फ़ोटो और प्रोफ़ाइल देखते हैं। Tinline यह नहीं छिपाता कि आप किससे बात करते हैं, और आपके खाते से लिंक किया हर डिवाइस आपकी चैट पढ़ सकता है।"
          }
        }
      }
    },
