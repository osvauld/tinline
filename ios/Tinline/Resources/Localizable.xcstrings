    "group_add_hint": {
      "comment": "Hint under the contact picker.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রত্যেকে আপনার সঙ্গে 1:1 চ্যাটে আমন্ত্রণটি পাবেন, আর গ্রহণ করলেই যোগ দেবেন। এটি 7 দিন কাজ করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Person bekommt die Einladung in eurem 1:1-Chat und tritt bei, wenn sie annimmt. Sie gilt 7 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person gets the invitation in your 1:1 chat, and joins when they accept. It is valid for 7 days."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokainen saa kutsun teidän kahdenkeskisessä keskustelussanne ja liittyy, kun hyväksyy sen. Kutsu on voimassa 7 päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque personne reçoit l’invitation dans votre discussion privée, et rejoint quand elle accepte. Elle est valable 7 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर व्यक्ति को आमंत्रण आपकी 1:1 चैट में मिलता है, और स्वीकार करने पर वे जुड़ जाते हैं। यह 7 दिन तक मान्य है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഓരോരുത്തർക്കും നിങ്ങളുമായുള്ള സ്വകാര്യ ചാറ്റിൽ ക്ഷണം ലഭിക്കും, സ്വീകരിക്കുമ്പോൾ അവർ ചേരും. ക്ഷണത്തിന് 7 ദിവസം സാധുതയുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रत्येकाला तुमच्या 1:1 चॅटमध्ये आमंत्रण मिळते, आणि ते स्वीकारल्यावर ती व्यक्ती सामील होते. आमंत्रण 7 दिवस वैध असते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒவ்வொருவருக்கும் உங்கள் தனி அரட்டையில் அழைப்பிதழ் செல்லும், அவர்கள் ஏற்றதும் சேர்வார்கள். அது 7 நாட்களுக்குச் செல்லும்."
          }
        }
      }
    },
