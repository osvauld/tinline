      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-এর অপেক্ষায় · %2$@-এর মাধ্যমে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wartet auf %1$@ · über %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for %1$@ · via %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odotetaan: %1$@ · ryhmän %2$@ kautta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En attente de %1$@ · via %2$@"
          }
        },
