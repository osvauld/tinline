            "value": "ग्रुपमध्ये सामील व्हा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குழுவில் சேர்"
          }
        }
      }
    },
    "group_joined_toast": {
