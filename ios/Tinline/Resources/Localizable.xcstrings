        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन ने ग्रुप को होस्ट करना बंद कर दिया।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫോൺ ഗ്രൂപ്പ് ഹോസ്റ്റ് ചെയ്യുന്നത് നിർത്തി."
