    "people_detail_allow_off": {
      "comment": "Contact page: note under Allow calls when off. {name} is the contact’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "বন্ধ। %1$@ আপনাকে মেসেজ করতে পারেন; ওঁর কলে রিং হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus. %1$@ kann dir schreiben; Anrufe klingeln nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. %1$@ can message you; their calls don’t ring."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pois päältä. %1$@ voi lähettää sinulle viestejä; hänen puhelunsa eivät soi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé. %1$@ peut vous écrire ; ses appels ne sonnent pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बंद। %1$@ आपको संदेश भेज सकते हैं; उनकी कॉल की घंटी नहीं बजती।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഓഫ്. %1$@ എന്നയാൾക്ക് നിങ്ങളെ സന്ദേശത്തിലൂടെ ബന്ധപ്പെടാം; അവരുടെ കോളുകൾ റിംഗ് ചെയ്യില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बंद. %1$@ तुम्हाला संदेश पाठवू शकतात; त्यांचे कॉल रिंग होत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "முடக்கத்தில். %1$@ உங்களுக்குச் செய்தி அனுப்பலாம்; அவர்களின் அழைப்புகள் ஒலிக்காது."
          }
        }
      }
    },
    "people_detail_allow_on": {
      "comment": "Contact page: note under Allow calls when on. {name} is the contact’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ এই ফোনে আর আপনার অন্য ডিভাইসগুলোতে রিং করাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ kann dieses Handy und deine anderen Geräte anrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can ring this phone and your other devices."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ voi soittaa tähän puhelimeen ja muihin laitteisiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ peut faire sonner ce téléphone et vos autres appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ इस फ़ोन और आपके दूसरे डिवाइस पर कॉल कर सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ വിളിച്ചാൽ ഈ ഫോണിലും നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിലും റിംഗ് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ या फोनवर आणि तुमच्या इतर डिव्हाइसवर कॉल करू शकतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ இந்த ஃபோனிலும் உங்கள் மற்ற சாதனங்களிலும் அழைக்கலாம்."
          }
        }
      }
    },
