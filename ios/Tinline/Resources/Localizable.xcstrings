    "group_host_device_sub": {
      "comment": "Sub line under Host on this device.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একজন অ্যাডমিনকেও এটি নিযুক্ত করতে হবে। যে কম্পিউটার সবসময় চালু থাকে, সেটি ভালো হোস্ট।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Admin muss es auch festlegen. Ein Computer, der an bleibt, ist ein besserer Host."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An admin has to appoint it too. A computer that stays on is a better host."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Myös ylläpitäjän täytyy nimetä se. Jatkuvasti päällä oleva tietokone on parempi isäntälaite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un admin doit aussi le désigner. Un ordinateur qui reste allumé est un meilleur hôte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी एडमिन को भी इसे नियुक्त करना होगा। हमेशा चालू रहने वाला कंप्यूटर बेहतर होस्ट है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഒരു അഡ്മിനും ഇത് നിയമിക്കണം. ഓണായിരിക്കുന്ന ഒരു കമ്പ്യൂട്ടറാണ് കൂടുതൽ നല്ല ഹോസ്റ്റ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ॲडमिनलाही ते नेमावे लागेल. सतत चालू राहणारा कॉम्प्युटर अधिक चांगला होस्ट असतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒரு நிர்வாகியும் இதை நியமிக்க வேண்டும். எப்போதும் இயங்கும் கணினி சிறந்த ஹோஸ்ட்."
          }
        }
      }
    },
