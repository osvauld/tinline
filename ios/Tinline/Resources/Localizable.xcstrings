            "state": "needs_review",
            "value": "आपके दूसरे डिवाइस पर सब कुछ बना रहेगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിൽ എല്ലാം അതേപടി ഉണ്ടാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या इतर डिव्हाइसवर सर्व काही राहते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் மற்ற சாதனங்களில் அனைத்தும் அப்படியே இருக்கும்."
          }
        }
      }
    },
