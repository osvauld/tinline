      }
    },
    "unlock_one_online": {
      "comment": "Hint at the bottom of the account picker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist immer nur ein Konto online. Anrufe an ein gesperrtes Konto klingeln nur auf deinen anderen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One account is online at a time. Calls to a locked account ring only on your other devices."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksi tili on kerrallaan verkossa. Puhelut lukittuun tiliin soivat vain muilla laitteillasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un seul compte est en ligne à la fois. Les appels vers un compte verrouillé ne sonnent que sur vos autres appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक समय में एक खाता ऑनलाइन रहता है। लॉक खाते की कॉल सिर्फ़ आपके दूसरे डिवाइस पर बजती हैं।"
