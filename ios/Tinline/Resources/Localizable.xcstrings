    "people_add_send": {
      "comment": "Explains the user’s code when it has no expiry.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাঁর সঙ্গে কথা বলতে চান, যেকোনো অ্যাপে তাঁকে এটা পাঠান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schick ihn an alle, mit denen du reden möchtest, über jede App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send it to anyone you’d like to talk to, in any app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lähetä se kenelle tahansa, jonka kanssa haluat puhua, millä tahansa sovelluksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyez-le à qui vous voulez, dans n’importe quelle app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे किसी भी ऐप में उस व्यक्ति को भेजें जिससे आप बात करना चाहते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ സംസാരിക്കാൻ ആഗ്രഹിക്കുന്ന ആർക്കും ഏത് ആപ്പിലും ഇത് അയയ്ക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्हाला ज्यांच्याशी बोलायचे आहे त्यांना कोणत्याही ॲपमधून हा पाठवा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் பேச விரும்பும் எவருக்கும், எந்த ஆப்பிலும் இதை அனுப்புங்கள்."
          }
        }
      }
    },
    "people_add_send_until": {
      "comment": "Explains the user’s code. {date} is a short date like “Mon 19 Oct”.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাঁর সঙ্গে কথা বলতে চান, যেকোনো অ্যাপে তাঁকে এটা পাঠান। এটা %1$@ পর্যন্ত কাজ করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schick ihn an alle, mit denen du reden möchtest, über jede App. Er funktioniert bis %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send it to anyone you’d like to talk to, in any app. It works until %1$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lähetä se kenelle tahansa, jonka kanssa haluat puhua, millä tahansa sovelluksella. Se toimii %1$@ asti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyez-le à qui vous voulez, dans n’importe quelle app. Il fonctionne jusqu’au %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे किसी भी ऐप में उस व्यक्ति को भेजें जिससे आप बात करना चाहते हैं। यह %1$@ तक काम करता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ സംസാരിക്കാൻ ആഗ്രഹിക്കുന്ന ആർക്കും ഏത് ആപ്പിലും ഇത് അയയ്ക്കാം. %1$@ വരെ ഇത് പ്രവർത്തിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्हाला ज्यांच्याशी बोलायचे आहे त्यांना कोणत्याही ॲपमधून हा पाठवा. तो %1$@ पर्यंत चालतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் பேச விரும்பும் எவருக்கும், எந்த ஆப்பிலும் இதை அனுப்புங்கள். இது %1$@ வரை செயல்படும்."
          }
        }
      }
    },
