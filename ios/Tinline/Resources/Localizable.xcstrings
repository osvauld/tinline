    "group_flags_left": {
      "comment": "Note under the flag meter. {count} is how many more flags remove the user.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "যেকোনো অ্যাডমিনের আর %1$lldটি ফ্ল্যাগ পড়লে আপনাকে গ্রুপ থেকে সরানো হবে। ফ্ল্যাগ ফিরিয়ে নেওয়া যায় না। ততক্ষণ পর্যন্ত আপনি পড়তে ও পোস্ট করতে পারবেন।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "যেকোনো অ্যাডমিনের আর %1$lldটি ফ্ল্যাগ পড়লে আপনাকে গ্রুপ থেকে সরানো হবে। ফ্ল্যাগ ফিরিয়ে নেওয়া যায় না। ততক্ষণ পর্যন্ত আপনি পড়তে ও পোস্ট করতে পারবেন।"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Noch eine Markierung von einem Admin entfernt dich aus der Gruppe. Markierungen lassen sich nicht zurücknehmen. Bis dahin kannst du weiter lesen und posten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Noch %1$lld Markierungen von Admins entfernen dich aus der Gruppe. Markierungen lassen sich nicht zurücknehmen. Bis dahin kannst du weiter lesen und posten."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One more flag from any admin removes you from the group. Flags can’t be taken back. You can still read and post until then."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld more flags from any admin remove you from the group. Flags can’t be taken back. You can still read and post until then."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Vielä yksi merkintä keneltä tahansa ylläpitäjältä poistaa sinut ryhmästä. Merkintöjä ei voi perua. Voit lukea ja kirjoittaa siihen asti."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Vielä %1$lld merkintää keneltä tahansa ylläpitäjältä poistaa sinut ryhmästä. Merkintöjä ei voi perua. Voit lukea ja kirjoittaa siihen asti."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Encore %1$lld signalements de n’importe quel admin et vous serez retiré du groupe. Un signalement ne peut pas être annulé. D’ici là, vous pouvez toujours lire et publier."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Encore %1$lld signalement de n’importe quel admin et vous serez retiré du groupe. Un signalement ne peut pas être annulé. D’ici là, vous pouvez toujours lire et publier."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Encore %1$lld signalements de n’importe quel admin et vous serez retiré du groupe. Un signalement ne peut pas être annulé. D’ici là, vous pouvez toujours lire et publier."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "किसी भी एडमिन का %1$lld और फ़्लैग आपको ग्रुप से हटा देगा। फ़्लैग वापस नहीं लिए जा सकते। तब तक आप पढ़ और पोस्ट कर सकते हैं।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "किसी भी एडमिन के %1$lld और फ़्लैग आपको ग्रुप से हटा देंगे। फ़्लैग वापस नहीं लिए जा सकते। तब तक आप पढ़ और पोस्ट कर सकते हैं।"
                }
              }
            }
          }
        },
        "ml": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "ഏതെങ്കിലും അഡ്മിനിൽ നിന്ന് ഒരു ഫ്ലാഗ് കൂടി വന്നാൽ നിങ്ങളെ ഗ്രൂപ്പിൽ നിന്ന് നീക്കം ചെയ്യും. ഫ്ലാഗുകൾ പിൻവലിക്കാൻ കഴിയില്ല. അതുവരെ നിങ്ങൾക്ക് വായിക്കാനും പോസ്റ്റ് ചെയ്യാനും കഴിയും."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "ഏതെങ്കിലും അഡ്മിനിൽ നിന്ന് %1$lld ഫ്ലാഗുകൾ കൂടി വന്നാൽ നിങ്ങളെ ഗ്രൂപ്പിൽ നിന്ന് നീക്കം ചെയ്യും. ഫ്ലാഗുകൾ പിൻവലിക്കാൻ കഴിയില്ല. അതുവരെ നിങ്ങൾക്ക് വായിക്കാനും പോസ്റ്റ് ചെയ്യാനും കഴിയും."
                }
              }
            }
          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "कोणत्याही ॲडमिनचा आणखी एक फ्लॅग तुम्हाला ग्रुपमधून काढून टाकेल. फ्लॅग मागे घेता येत नाहीत. तोपर्यंत तुम्ही वाचू आणि पोस्ट करू शकता."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "कोणत्याही ॲडमिनचे आणखी %1$lld फ्लॅग तुम्हाला ग्रुपमधून काढून टाकतील. फ्लॅग मागे घेता येत नाहीत. तोपर्यंत तुम्ही वाचू आणि पोस्ट करू शकता."
                }
              }
            }
          }
        },
        "ta": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "எந்த நிர்வாகியிடமிருந்தும் இன்னும் ஒரு கொடி வந்தால், நீங்கள் குழுவிலிருந்து நீக்கப்படுவீர்கள். கொடிகளைத் திரும்பப் பெற முடியாது. அதுவரை நீங்கள் படிக்கவும் இடுகையிடவும் முடியும்."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "எந்த நிர்வாகியிடமிருந்தும் இன்னும் %1$lld கொடிகள் வந்தால், நீங்கள் குழுவிலிருந்து நீக்கப்படுவீர்கள். கொடிகளைத் திரும்பப் பெற முடியாது. அதுவரை நீங்கள் படிக்கவும் இடுகையிடவும் முடியும்."
                }
              }
            }
          }
        }
      }
    },
