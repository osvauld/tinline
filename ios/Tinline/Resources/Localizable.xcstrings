          }
        }
      }
    },
    "people_add_inc_wants": {
      "comment": "Request note. {name} is who wants to add the user.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ আপনাকে পরিচিতি হিসেবে যোগ করতে চান। গ্রহণ করলে আপনারা একে অপরকে মেসেজ আর কল করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ möchte dich als Kontakt hinzufügen. Wenn du annimmst, könnt ihr euch schreiben und anrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wants to add you as a contact. Accepting lets you message and call each other."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ haluaa lisätä sinut yhteystiedoksi. Hyväksymällä voitte lähettää viestejä ja soittaa toisillenne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ veut vous ajouter comme contact. Accepter vous permet de vous écrire et de vous appeler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ आपको संपर्क के रूप में जोड़ना चाहते हैं। स्वीकार करने पर आप एक-दूसरे को संदेश और कॉल कर सकेंगे।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ നിങ്ങളെ കോൺടാക്റ്റായി ചേർക്കാൻ ആഗ്രഹിക്കുന്നു. സ്വീകരിച്ചാൽ നിങ്ങൾക്ക് പരസ്പരം സന്ദേശം അയയ്ക്കാനും വിളിക്കാനും കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला तुम्हाला संपर्क म्हणून जोडायचे आहे. स्वीकारल्यावर तुम्ही एकमेकांना संदेश आणि कॉल करू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ உங்களைத் தொடர்பாகச் சேர்க்க விரும்புகிறார். ஏற்றுக்கொண்டால் நீங்கள் இருவரும் ஒருவருக்கொருவர் செய்தி அனுப்பலாம், அழைக்கலாம்."
          }
        }
      }
    },
    "people_add_let_scan": {
      "comment": "Hint under the user’s own QR code.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ওঁকে Tinline দিয়ে এটা স্ক্যান করতে বলুন।"
          }
