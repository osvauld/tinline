    "devices_sync_hint": {
      "comment": "Hint explaining device sync.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যখনই দুটি ডিভাইস একসঙ্গে অনলাইনে থাকে, তারা সরাসরি একে অপরের সঙ্গে সিঙ্ক করে। কোনো সার্ভারে কোনো কপি থাকে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geräte gleichen sich direkt miteinander ab, sobald zwei gleichzeitig online sind. Es gibt keine Kopie auf einem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices sync directly with each other whenever two are online at once. There is no copy on any server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laitteet synkronoituvat suoraan keskenään aina, kun kaksi on verkossa yhtä aikaa. Millään palvelimella ei ole kopiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les appareils se synchronisent directement entre eux dès que deux sont en ligne en même temps. Il n’y a de copie sur aucun serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब भी दो डिवाइस एक साथ ऑनलाइन होते हैं, वे सीधे आपस में सिंक करते हैं। किसी सर्वर पर कोई कॉपी नहीं होती।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "രണ്ട് ഉപകരണങ്ങൾ ഒരേസമയം ഓൺലൈനിലാകുമ്പോഴെല്ലാം അവ നേരിട്ട് സിങ്ക് ചെയ്യും. ഒരു സെർവറിലും പകർപ്പില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दोन डिव्हाइस एकाच वेळी ऑनलाइन असली की ती थेट एकमेकांशी सिंक होतात. कोणत्याही सर्व्हरवर प्रत नसते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இரண்டு சாதனங்கள் ஒரே நேரத்தில் ஆன்லைனில் இருக்கும்போதெல்லாம் அவை நேரடியாக ஒன்றுக்கொன்று ஒத்திசைக்கின்றன. எந்தச் சர்வரிலும் நகல் இல்லை."
          }
        }
      }
    },
