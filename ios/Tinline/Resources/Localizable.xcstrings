    "call_unreachable_body": {
      "comment": "Explanation when a call could not connect. {name} is the contact.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ist vielleicht offline, ohne Empfang oder nimmt gerade keine Anrufe an. Tinline kann keine Nachrichten hinterlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ may be offline, out of signal, or not taking calls right now. Tinline can’t leave messages."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ei ehkä ole verkossa tai kuuluvuusalueella, tai hän ei ota puheluita vastaan juuri nyt. Tinline ei voi jättää viestejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ est peut-être hors ligne, sans réseau, ou ne prend pas d’appels en ce moment. Tinline ne peut pas laisser de message."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हो सकता है %1$@ ऑफ़लाइन हों, सिग्नल न हो, या अभी कॉल न ले रहे हों। Tinline में संदेश छोड़ने की सुविधा नहीं है।"
          }
        }
      }
    },
    "call_unreachable_body_blank": {
      "comment": "Explanation when a call could not connect and the contact has no name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Person ist vielleicht offline, ohne Empfang oder nimmt gerade keine Anrufe an. Tinline kann keine Nachrichten hinterlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They may be offline, out of signal, or not taking calls right now. Tinline can’t leave messages."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hän ei ehkä ole verkossa tai kuuluvuusalueella, tai hän ei ota puheluita vastaan juuri nyt. Tinline ei voi jättää viestejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette personne est peut-être hors ligne, sans réseau, ou ne prend pas d’appels en ce moment. Tinline ne peut pas laisser de message."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हो सकता है वे ऑफ़लाइन हों, सिग्नल न हो, या अभी कॉल न ले रहे हों। Tinline में संदेश छोड़ने की सुविधा नहीं है।"
          }
        }
      }
    },
