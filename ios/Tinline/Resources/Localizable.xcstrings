    "group_error_they_block": {
      "comment": "Error when the other person blocked the user.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "উনি আপনাকে ব্লক করেছেন, তাই ওঁকে চ্যাটের অনুরোধ পাঠানো যাবে না।"
