    "security_wrong_pass": {
      "comment": "Error under the passphrase field when the passphrase is wrong.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "মিলল না। আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das hat nicht gepasst. Versuch es nochmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t match. Try again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ei täsmännyt. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela ne correspond pas. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह मेल नहीं खाया। फिर से कोशिश करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അത് പൊരുത്തപ്പെട്ടില്ല. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते जुळले नाही. पुन्हा प्रयत्न करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அது பொருந்தவில்லை. மீண்டும் முயலுங்கள்."
          }
        }
      }
    },
