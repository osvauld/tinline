    "chat_card_once": {
      "comment": "Hint under the contact card QR code.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "7 দিন কাজ করে, আপনি যাঁদের দেবেন তাঁদের সবার জন্য। যোগ দেওয়ার আগে প্রত্যেকের ব্যাপারে আপনাকে জিজ্ঞেস করা হবে। নতুন কোড তৈরি করলে এটি বাতিল হয়ে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gilt 7 Tage lang für alle, denen du ihn gibst. Jede Person fragt zuerst bei dir an. Ein neuer Code macht diesen ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works for 7 days, for anyone you give it to. Each one asks you first. Making a new code cancels this one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toimii 7 päivää kaikille, joille sen annat. Jokainen kysyy ensin sinulta. Uuden koodin luominen mitätöi tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valable 7 jours, pour toute personne à qui vous le donnez. Chacune vous demande d’abord. Créer un nouveau code annule celui-ci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "7 दिन चलता है, जिस-जिसे आप देंगे उसके लिए। जुड़ने से पहले हर किसी के बारे में आपसे पूछा जाएगा। नया कोड बनाने पर यह वाला रद्द हो जाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "7 ദിവസത്തേക്ക് പ്രവർത്തിക്കും, നിങ്ങൾ ആർക്ക് കൊടുത്താലും. ഓരോരുത്തരും ആദ്യം നിങ്ങളോട് ചോദിക്കും. പുതിയ കോഡ് ഉണ്ടാക്കിയാൽ ഇത് റദ്ദാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "7 दिवस चालतो, तुम्ही ज्याला द्याल त्या प्रत्येकासाठी. जोडण्याआधी प्रत्येकाबद्दल तुम्हाला विचारले जाते. नवीन कोड तयार केल्यावर हा रद्द होतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "7 நாட்களுக்குச் செல்லும், நீங்கள் யாருக்குக் கொடுத்தாலும். ஒவ்வொருவரும் முதலில் உங்களிடம் கேட்பார்கள். புதிய குறியீடு உருவாக்கினால் இது செல்லாததாகிவிடும்."
          }
        }
      }
    },
