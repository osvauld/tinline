    "group_cancel_callhost_request_desc": {
      "comment": "Spoken label of the Cancel button on a pending call host request. {device} is the host’s name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-কে পাঠানো কল হোস্টের অনুরোধ বাতিল করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anruf-Host-Anfrage an %1$@ zurückziehen"
