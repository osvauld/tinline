    "group_flag_copy": {
      "comment": "Flag dialog sentence for a flag that does not remove yet. {yours} is which flag it is, {total} flags remove, {name} the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours will be flag %1$@ of %2$@. Any admin’s flags count, yours again too. At %2$@ flags %3$@ is removed right away and sees they were removed."
          }
        }
      }
    },
    "group_flag_copy_final": {
      "comment": "Flag dialog sentence for the flag that removes the member. {yours} is which flag it is, {total} flags remove, {name} the member’s first name.",
