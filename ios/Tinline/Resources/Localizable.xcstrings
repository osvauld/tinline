          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങൾ ഓൺലൈനിലാകുമ്പോൾ എഡിറ്റുകളും ഇല്ലാതാക്കലുകളും അവയിൽ എത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमची इतर डिव्हाइस ऑनलाइन आल्यावर संपादने आणि हटवलेले संदेश तिथे पोहोचतात."
          }
        },
        "ta": {
