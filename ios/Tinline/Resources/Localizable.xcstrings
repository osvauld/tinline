    "group_status_waiting": {
      "comment": "Group header sub line. {members} is the member count text.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · হোস্টের অপেক্ষায়"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · wartet auf einen Host"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · waiting for a host"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · odottaa isäntälaitetta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · en attente d’un hôte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · होस्ट का इंतज़ार"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · ഹോസ്റ്റിനായി കാത്തിരിക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · होस्टची वाट पाहत आहे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · ஹோஸ்ட்டுக்காகக் காத்திருக்கிறது"
          }
        }
      }
    },
    "group_strip_waiting": {
      "comment": "Strip above the composer when no host is online.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "হোস্টের অপেক্ষায়। গ্রুপের কোনো হোস্ট এখন অনলাইনে নেই; আপনার পোস্ট সেভ করা আছে, হোস্ট এলেই পাঠানো হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wartet auf einen Host. Gerade ist kein Gruppen-Host online; deine Beiträge sind gespeichert und gehen raus, sobald einer da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a host. No group host is online; your posts are saved and send when one is."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odotetaan isäntälaitetta. Yksikään ryhmän isäntälaite ei ole verkossa; viestisi ovat tallessa ja lähtevät, kun jokin tulee verkkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En attente d’un hôte. Aucun hôte du groupe n’est en ligne ; vos publications sont gardées et partiront dès qu’il y en aura un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "होस्ट का इंतज़ार है। अभी कोई ग्रुप होस्ट ऑनलाइन नहीं है; आपकी पोस्ट सहेजी गई हैं और होस्ट के आते ही भेज दी जाएँगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഹോസ്റ്റിനായി കാത്തിരിക്കുന്നു. ഗ്രൂപ്പ് ഹോസ്റ്റുകളൊന്നും ഓൺലൈനിലില്ല; നിങ്ങളുടെ പോസ്റ്റുകൾ സേവ് ചെയ്തിട്ടുണ്ട്, ഒരു ഹോസ്റ്റ് ഓൺലൈനിൽ വരുമ്പോൾ അവ അയയ്ക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "होस्टची वाट पाहत आहे. ग्रुपचा कोणताही होस्ट ऑनलाइन नाही; तुमच्या पोस्ट जतन केल्या आहेत आणि होस्ट ऑनलाइन आल्यावर पाठवल्या जातील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஹோஸ்ட்டுக்காகக் காத்திருக்கிறது. குழு ஹோஸ்ட் யாரும் ஆன்லைனில் இல்லை; உங்கள் இடுகைகள் சேமிக்கப்பட்டுள்ளன, ஒருவர் வந்ததும் அனுப்பப்படும்."
          }
        }
      }
    },
