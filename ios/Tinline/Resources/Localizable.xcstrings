            "value": "Autorisation du micro nécessaire pour passer un appel"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल करने के लिए माइक्रोफ़ोन की अनुमति चाहिए"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കോൾ ചെയ്യാൻ മൈക്രോഫോൺ അനുമതി വേണം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल करण्यासाठी मायक्रोफोनची परवानगी हवी"
