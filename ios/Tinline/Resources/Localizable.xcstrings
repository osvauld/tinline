        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यांनी तुम्हाला ब्लॉक केले आहे, त्यामुळे तुम्ही त्यांना चॅटसाठी विचारू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அவர்கள் உங்களைத் தடுத்துள்ளதால், அவர்களிடம் அரட்டைக்குக் கேட்க முடியாது."
          }
