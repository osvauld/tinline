        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या दुसऱ्या डिव्हाइसवर हाच कोड दिसतो आहे का ते तपासा, मग तिथे मंजुरी द्या."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் மற்றொரு சாதனம் இந்தக் குறியீட்டைக் காட்டுகிறதா என்று சரிபார்த்து, பிறகு அங்கே அனுமதியுங்கள்."
