    "onboarding_name_lead": {
      "comment": "Explanation on the nickname screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শুধু আপনি যাঁদের যোগ করবেন, তাঁরাই এটা দেখবেন।"
          }
