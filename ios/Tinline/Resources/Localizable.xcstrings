    "onboarding_restore_warn_forgot": {
      "comment": "Notice on the restore screen after I forgot my passphrase.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Wiederherstellen bleibt die Identität gleich: Nutze die Wiederherstellungswörter dieses Kontos. Du legst eine neue Passphrase fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring keeps the same identity: use the recovery phrase of this account. You’ll set a new passphrase."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palautus säilyttää saman identiteetin: käytä tämän tilin palautussanoja. Asetat uuden salalauseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurer garde la même identité : utilisez les mots de récupération de ce compte. Vous choisirez une nouvelle phrase secrète."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वापस लाने पर पहचान वही रहती है: इस खाते के रिकवरी शब्द इस्तेमाल करें। आप नया पासफ़्रेज़ रखेंगे।"
          }
        }
      }
    },
