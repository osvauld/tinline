    "devices_unlink_warn": {
      "comment": "Warning card in the unlink dialog.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trennen kann es von hier aus nicht sperren. Wer es entsperren kann, kann dein Konto weiter nutzen. Ganz aussperren kannst du es nur mit einem neuen Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlinking can’t lock it from here. Anyone who can unlock it can still use your account. The only full cut-off is a new account."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkityksen poisto ei voi lukita sitä täältä. Kuka tahansa, joka saa sen auki, voi yhä käyttää tiliäsi. Ainoa tapa katkaista kaikki kokonaan on uusi tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dissociation ne peut pas le verrouiller à distance. Toute personne capable de le déverrouiller peut encore utiliser votre compte. La seule coupure complète, c’est un nouveau compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लिंक हटाने से वह डिवाइस यहाँ से लॉक नहीं होता। जो भी उसे अनलॉक कर सकता है, वह अब भी आपका खाता इस्तेमाल कर सकता है। पूरी तरह अलग होने का एक ही तरीका है: नया खाता।"
          }
        }
      }
    },
