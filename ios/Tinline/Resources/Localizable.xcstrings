          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ का इंतज़ार · %2$@ के ज़रिए"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാൾക്കായി കാത്തിരിക്കുന്നു · %2$@ വഴി"
