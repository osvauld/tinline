    "group_done_appointed": {
      "comment": "Confirmation after appointing a host.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নিযুক্ত করা হয়েছে। ডিভাইসটি রাজি হলেই হোস্ট করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Festgelegt. Das Gerät hostet, sobald es zustimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appointed. The device hosts once it agrees."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nimetty. Laite alkaa isännöidä, kun se suostuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désigné. L’appareil héberge dès qu’il accepte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नियुक्त कर दिया। डिवाइस के मानते ही वह होस्ट करेगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിയമിച്ചു. ഉപകരണം സമ്മതിക്കുമ്പോൾ അത് ഹോസ്റ്റ് ചെയ്തുതുടങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नेमले. डिव्हाइसने मान्य केल्यावर ते होस्ट करेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நியமிக்கப்பட்டது. சாதனம் ஒப்புக்கொண்டதும் ஹோஸ்ட் செய்யும்."
          }
        }
      }
    },
    "group_done_callhost_accepted": {
      "comment": "Confirmation after this device agreed to host calls.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ডিভাইস এখন গ্রুপের কল হোস্ট করছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Gerät hostet jetzt die Anrufe der Gruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device now hosts the group’s calls."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä laite isännöi nyt ryhmän puheluita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet appareil héberge maintenant les appels du groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अब यह डिवाइस ग्रुप की कॉल होस्ट करता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഉപകരണം ഇപ്പോൾ ഗ്രൂപ്പിന്റെ കോളുകൾ ഹോസ്റ്റ് ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हे डिव्हाइस आता ग्रुपचे कॉल होस्ट करते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்தச் சாதனம் இப்போது குழுவின் அழைப்புகளை ஹோஸ்ட் செய்கிறது."
          }
        }
      }
    },
    "group_done_callhost_asked": {
      "comment": "Confirmation after asking a device to host calls.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অনুরোধ পাঠানো হয়েছে। ডিভাইসটি গ্রহণ করলেই কল চালাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gefragt. Das Gerät trägt Anrufe, sobald es zustimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked. The device carries calls once it accepts."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyydetty. Laite välittää puhelut, kun se hyväksyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demande envoyée. L’appareil héberge les appels dès qu’il accepte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पूछ लिया। डिवाइस के स्वीकार करते ही वह कॉल चलाएगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആവശ്യപ്പെട്ടു. ഉപകരണം സ്വീകരിക്കുമ്പോൾ അത് കോളുകൾ നടത്തിത്തുടങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
