      }
    },
    "onboarding_perm_notif_why": {
      "comment": "Why Tinline asks for notifications.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাতে আসা কল আর মেসেজ দেখতে পান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit du eingehende Anrufe und Nachrichten siehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you see incoming calls and messages."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta näet saapuvat puhelut ja viestit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour voir les appels et messages entrants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ताकि आपको आने वाली कॉल और संदेश दिखें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "വരുന്ന കോളുകളും സന്ദേശങ്ങളും നിങ്ങൾക്ക് കാണാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "म्हणजे येणारे कॉल आणि संदेश तुम्हाला दिसतील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உள்வரும் அழைப்புகளையும் செய்திகளையும் நீங்கள் பார்க்க."
          }
        }
      }
    },
    "onboarding_perms_lead": {
      "comment": "Explanation on the permissions screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline হলো আপনার যোগ করা মানুষদের কাছে পৌঁছানোর আপনার লাইন। এগুলোর প্রতিটিই ঐচ্ছিক, আর পরে বদলাতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ist deine Leitung zu den Menschen, die du hinzufügst. Jede dieser Berechtigungen ist optional, und du kannst sie später ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline is your line to the people you add. Each of these is optional, and you can change them later."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline on linjasi lisäämiisi ihmisiin. Jokainen näistä on valinnainen, ja voit muuttaa niitä myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline est votre ligne vers les personnes que vous ajoutez. Chacune de ces autorisations est facultative, et vous pouvez les modifier plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline आपकी लाइन है उन लोगों तक, जिन्हें आप जोड़ते हैं। इनमें से कोई भी ज़रूरी नहीं है, और आप इन्हें बाद में बदल सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ ചേർക്കുന്ന ആളുകളിലേക്കുള്ള നിങ്ങളുടെ ലൈനാണ് Tinline. ഇവ ഓരോന്നും ഐച്ഛികമാണ്, പിന്നീട് മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ही तुम्ही जोडलेल्या लोकांपर्यंत जाणारी तुमची लाइन आहे. यातील प्रत्येक गोष्ट ऐच्छिक आहे, आणि तुम्ही ती नंतर बदलू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline என்பது நீங்கள் சேர்க்கும் மனிதர்களுடனான உங்கள் லைன். இவை ஒவ்வொன்றும் விருப்பத்தேர்வு, பிறகு மாற்றலாம்."
          }
        }
      }
    },
    "onboarding_perms_title": {
      "comment": "Title of the permissions screen.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাতে কল আপনার কাছে পৌঁছায়"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit Anrufe dich erreichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So calls can reach you"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta puhelut tavoittavat sinut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour que les appels vous parviennent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ताकि कॉल आप तक पहुँच सकें"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കോളുകൾ നിങ്ങളിലേക്ക് എത്താൻ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉल तुमच्यापर्यंत पोहोचावेत म्हणून"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அழைப்புகள் உங்களை அடைய"
          }
        }
      }
    },
    "onboarding_rec_lead_key": {
      "comment": "Explanation when showing the recovery key; the line break is intended.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার রিকভারি কী আপনার %1$@টি শব্দেরই আরেক রূপ, এক লাইনে।\nকোনো নিরাপদ জায়গায় পেস্ট করে রাখুন। পাসওয়ার্ড ম্যানেজার দারুণ কাজ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Wiederherstellungsschlüssel entspricht deinen %1$@ Wörtern, nur in einer Zeile.\nFüg ihn an einem sicheren Ort ein. Ein Passwortmanager eignet sich gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery key is the same as your %1$@ words, as one line.\nPaste it somewhere safe. A password manager works great."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palautusavaimesi on sama kuin %1$@ sanaasi, yhtenä rivinä.\nLiitä se johonkin turvalliseen paikkaan. Salasanojen hallintasovellus sopii hyvin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre clé de récupération équivaut à vos %1$@ mots, en une seule ligne.\nCollez-la dans un endroit sûr. Un gestionnaire de mots de passe convient très bien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी रिकवरी कुंजी आपके %1$@ शब्द ही हैं, एक लाइन में।\nइसे किसी सुरक्षित जगह पेस्ट करें। पासवर्ड मैनेजर बढ़िया रहता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ വീണ്ടെടുക്കൽ കീ എന്നത് നിങ്ങളുടെ %1$@ വാക്കുകൾ തന്നെയാണ്, ഒറ്റ വരിയായി.\nസുരക്ഷിതമായ ഒരിടത്ത് ഇത് പേസ്റ്റ് ചെയ്ത് വയ്ക്കുക. ഒരു പാസ്‌വേഡ് മാനേജർ നന്നായി ചേരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमची रिकव्हरी की म्हणजे तुमचेच %1$@ शब्द, एका ओळीत.\nती कुठेतरी सुरक्षित ठिकाणी पेस्ट करा. पासवर्ड मॅनेजर उत्तम काम करतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் மீட்பு விசை என்பது உங்கள் %1$@ வார்த்தைகளே, ஒரே வரியாக.\nபாதுகாப்பான இடத்தில் ஒட்டி வையுங்கள். கடவுச்சொல் நிர்வாகி இதற்கு மிகவும் ஏற்றது."
          }
        }
      }
    },
    "onboarding_rec_lead_words": {
      "comment": "Explanation when showing the recovery words; the line break is intended.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কখনও ডিভাইস বদলালে, এই %1$@টি শব্দ আপনার অ্যাকাউন্ট সঙ্গে নিয়ে আসবে।\nকোনো নিরাপদ জায়গায় একটি কপি রাখুন। কাগজে লিখে রাখাও দারুণ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du mal das Gerät wechselst, bringen diese %1$@ Wörter dein Konto mit.\nSpeichere eine Kopie an einem sicheren Ort. Papier eignet sich gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you ever switch devices, these %1$@ words bring your account along.\nSave a copy somewhere safe. Paper works great."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jos joskus vaihdat laitetta, nämä %1$@ sanaa tuovat tilisi mukaan.\nTallenna kopio turvalliseen paikkaan. Paperi toimii hyvin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si vous changez un jour d’appareil, ces %1$@ mots emportent votre compte avec vous.\nGardez-en une copie en lieu sûr. Le papier, c’est très bien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर आप कभी डिवाइस बदलें, तो ये %1$@ शब्द आपका खाता साथ ले आते हैं।\nइनकी एक कॉपी किसी सुरक्षित जगह रखें। कागज़ बढ़िया रहता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "എപ്പോഴെങ്കിലും ഉപകരണം മാറിയാൽ, ഈ %1$@ വാക്കുകൾ നിങ്ങളുടെ അക്കൗണ്ട് ഒപ്പം കൊണ്ടുവരും.\nസുരക്ഷിതമായ ഒരിടത്ത് ഒരു പകർപ്പ് സൂക്ഷിക്കുക. കടലാസിൽ എഴുതിവയ്ക്കുന്നത് നല്ലതാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही कधी डिव्हाइस बदलले, तर हे %1$@ शब्द तुमचे खाते सोबत आणतात.\nएक प्रत सुरक्षित ठिकाणी जतन करा. कागदही छान चालतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் எப்போதாவது சாதனம் மாறினால், இந்த %1$@ வார்த்தைகள் உங்கள் கணக்கைக் கூடவே கொண்டு வரும்.\nபாதுகாப்பான இடத்தில் ஒரு நகலைச் சேமியுங்கள். காகிதமே மிகவும் நல்லது."
          }
        }
      }
    },
