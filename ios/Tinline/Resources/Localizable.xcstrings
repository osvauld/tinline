    "onboarding_pass_instead": {
      "comment": "Button that protects the account with a passphrase instead.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "বরং একটি পাসফ্রেজ যোগ করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lieber eine Passphrase festlegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a passphrase instead"
          }
        },
        "fi": {
          "stringUnit": {
