        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी फ़ोटो सहेजी नहीं जा सकी। आपकी मौजूदा फ़ोटो पहले जैसी है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ ഫോട്ടോ സേവ് ചെയ്യാൻ കഴിഞ്ഞില്ല. നിലവിലെ ഫോട്ടോയ്ക്ക് മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा फोटो जतन करता आला नाही. तुमचा सध्याचा फोटो बदललेला नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் படத்தைச் சேமிக்க முடியவில்லை. உங்கள் தற்போதைய படம் மாறவில்லை."
          }
        }
      }
