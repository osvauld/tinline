      }
    },
    "link_qr_lead": {
      "comment": "Explanation above the QR code on the new device.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যে ডিভাইসে আপনার অ্যাকাউন্ট আগে থেকেই আছে, সেখানে সেটিংস › ডিভাইস লিঙ্ক করুন খুলে এটা স্ক্যান করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne auf einem Gerät, das dein Konto schon hat, Einstellungen › Gerät verknüpfen und scanne das hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a device that already has your account, open Settings › Link a device and scan this."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa laitteella, jolla tilisi jo on, Asetukset › Linkitä laite ja skannaa tämä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur un appareil qui a déjà votre compte, ouvrez Réglages › Associer un appareil et scannez ceci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जिस डिवाइस पर आपका खाता पहले से है, उस पर सेटिंग › डिवाइस लिंक करें खोलें और इसे स्कैन करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് ഇതിനകമുള്ള ഒരു ഉപകരണത്തിൽ ക്രമീകരണം › ഒരു ഉപകരണം ലിങ്ക് ചെയ്യുക തുറന്ന് ഇത് സ്കാൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते आधीपासून असलेल्या डिव्हाइसवर सेटिंग्ज › डिव्हाइस लिंक करा उघडा आणि हा कोड स्कॅन करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு ஏற்கெனவே உள்ள சாதனத்தில், அமைப்புகள் › சாதனத்தை இணை என்பதைத் திறந்து இதை ஸ்கேன் செய்யுங்கள்."
          }
        }
      }
    },
    "link_qr_warn": {
      "comment": "Warning under the QR code.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আগামী কয়েক মিনিটে যে কেউ এই কোড দেখতে পেলে সেটা ব্যবহারের চেষ্টা করতে পারে। শুধু নিজের ডিভাইসকেই দেখান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wer diesen Code in den nächsten Minuten sieht, könnte versuchen, ihn zu nutzen. Zeig ihn nur deinem eigenen Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who can see this code in the next few minutes could try to use it. Show it only to your own device."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuka tahansa, joka näkee tämän koodin seuraavien minuuttien aikana, voisi yrittää käyttää sitä. Näytä se vain omalle laitteellesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne qui voit ce code dans les prochaines minutes pourrait essayer de l’utiliser. Ne le montrez qu’à votre propre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगले कुछ मिनट में जो भी यह कोड देख सके, वह इसे इस्तेमाल करने की कोशिश कर सकता है। इसे सिर्फ़ अपने डिवाइस को दिखाएँ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അടുത്ത കുറച്ച് മിനിറ്റുകൾക്കുള്ളിൽ ഈ കോഡ് കാണുന്ന ആർക്കും ഇത് ഉപയോഗിക്കാൻ ശ്രമിക്കാം. നിങ്ങളുടെ സ്വന്തം ഉപകരണത്തിന് മാത്രം കാണിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पुढच्या काही मिनिटांत हा कोड ज्याला दिसेल ती व्यक्ती तो वापरण्याचा प्रयत्न करू शकते. तो फक्त तुमच्या स्वतःच्या डिव्हाइसला दाखवा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அடுத்த சில நிமிடங்களில் இந்தக் குறியீட்டைப் பார்க்கக்கூடிய எவரும் அதைப் பயன்படுத்த முயலலாம். உங்கள் சொந்தச் சாதனத்துக்கு மட்டுமே காட்டுங்கள்."
          }
        }
      }
    },
