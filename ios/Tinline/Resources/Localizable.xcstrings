        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts et discussions arrivent depuis votre autre appareil et resteront synchronisés sur les deux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके संपर्क और चैट आपके दूसरे डिवाइस से आ रहे हैं और दोनों पर एक जैसे बने रहेंगे।"
