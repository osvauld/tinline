    "shell_mic_body": {
      "comment": "Explains microphone permission when denied.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ohne Mikrofon hört man dich nicht. Tinline hört nur während Anrufen zu – nie im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, they won’t hear you. Tinline only listens during calls — never in the background."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ilman sitä sinua ei kuulla. Tinline kuuntelee vain puheluiden aikana — ei koskaan taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans lui, on ne vous entendra pas. Tinline n’écoute que pendant les appels — jamais en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसके बिना वे आपको नहीं सुन पाएँगे। Tinline सिर्फ़ कॉल के दौरान सुनता है — बैकग्राउंड में कभी नहीं।"
          }
        }
      }
    },
