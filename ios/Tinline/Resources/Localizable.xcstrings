    "onboarding_back_added_lead": {
      "comment": "Explanation after adding another account; {name} is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একবারে শুধু বেছে নেওয়া অ্যাকাউন্টটিই অনলাইনে থাকে, তাই এখন %1$@ অনলাইনে আর আপনার অন্য অ্যাকাউন্টটি থেমে আছে। সেটিংস থেকে বদলাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist immer nur das ausgewählte Konto online, also ist %1$@ jetzt online und dein anderes Konto pausiert. Wechseln kannst du in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the account you select is online at a time, so %1$@ is online now and your other account is paused. You can switch in Settings."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain valitsemasi tili on kerrallaan verkossa, joten %1$@ on nyt verkossa ja toinen tilisi on tauolla. Voit vaihtaa asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seul le compte sélectionné est en ligne à la fois : %1$@ est donc en ligne et votre autre compte est en pause. Vous pouvez changer dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक समय में सिर्फ़ चुना हुआ खाता ऑनलाइन रहता है, इसलिए अभी %1$@ ऑनलाइन है और आपका दूसरा खाता रुका हुआ है। आप सेटिंग में खाता बदल सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "തിരഞ്ഞെടുക്കുന്ന അക്കൗണ്ട് മാത്രമേ ഒരു സമയം ഓൺലൈനിലുണ്ടാകൂ, അതിനാൽ ഇപ്പോൾ %1$@ ഓൺലൈനിലാണ്, നിങ്ങളുടെ മറ്റേ അക്കൗണ്ട് താൽക്കാലികമായി നിർത്തിയിരിക്കുന്നു. ക്രമീകരണത്തിൽ നിന്ന് മാറാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एका वेळी फक्त तुम्ही निवडलेले खाते ऑनलाइन असते, त्यामुळे आता %1$@ ऑनलाइन आहे आणि तुमचे दुसरे खाते थांबवले आहे. तुम्ही सेटिंग्जमध्ये खाते बदलू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் தேர்ந்தெடுக்கும் கணக்கு மட்டுமே ஒரே நேரத்தில் ஆன்லைனில் இருக்கும், எனவே இப்போது %1$@ ஆன்லைனில் உள்ளது, உங்கள் மற்றொரு கணக்கு இடைநிறுத்தப்பட்டுள்ளது. அமைப்புகளில் மாறலாம்."
          }
        }
      }
    },
    "onboarding_back_added_lead_unnamed": {
      "comment": "Explanation after adding another account that has no name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একবারে শুধু বেছে নেওয়া অ্যাকাউন্টটিই অনলাইনে থাকে, তাই এখন এই অ্যাকাউন্টটি অনলাইনে আর আপনার অন্য অ্যাকাউন্টটি থেমে আছে। সেটিংস থেকে বদলাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist immer nur das ausgewählte Konto online, also ist dieses Konto jetzt online und dein anderes Konto pausiert. Wechseln kannst du in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the account you select is online at a time, so this account is online now and your other account is paused. You can switch in Settings."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain valitsemasi tili on kerrallaan verkossa, joten tämä tili on nyt verkossa ja toinen tilisi on tauolla. Voit vaihtaa asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seul le compte sélectionné est en ligne à la fois : ce compte est donc en ligne et votre autre compte est en pause. Vous pouvez changer dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक समय में सिर्फ़ चुना हुआ खाता ऑनलाइन रहता है, इसलिए अभी यह खाता ऑनलाइन है और आपका दूसरा खाता रुका हुआ है। आप सेटिंग में खाता बदल सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "തിരഞ്ഞെടുക്കുന്ന അക്കൗണ്ട് മാത്രമേ ഒരു സമയം ഓൺലൈനിലുണ്ടാകൂ, അതിനാൽ ഇപ്പോൾ ഈ അക്കൗണ്ട് ഓൺലൈനിലാണ്, നിങ്ങളുടെ മറ്റേ അക്കൗണ്ട് താൽക്കാലികമായി നിർത്തിയിരിക്കുന്നു. ക്രമീകരണത്തിൽ നിന്ന് മാറാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एका वेळी फक्त तुम्ही निवडलेले खाते ऑनलाइन असते, त्यामुळे आता हे खाते ऑनलाइन आहे आणि तुमचे दुसरे खाते थांबवले आहे. तुम्ही सेटिंग्जमध्ये खाते बदलू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் தேர்ந்தெடுக்கும் கணக்கு மட்டுமே ஒரே நேரத்தில் ஆன்லைனில் இருக்கும், எனவே இப்போது இந்தக் கணக்கு ஆன்லைனில் உள்ளது, உங்கள் மற்றொரு கணக்கு இடைநிறுத்தப்பட்டுள்ளது. அமைப்புகளில் மாறலாம்."
          }
        }
      }
    },
    "onboarding_back_added_unnamed": {
      "comment": "Title after adding another account that has no name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে আপনার অ্যাকাউন্ট যোগ করা হয়েছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto wurde diesem Handy hinzugefügt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added your account to this phone"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi lisättiin tälle puhelimelle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte est maintenant sur ce téléphone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता इस फ़ोन में जुड़ गया"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് ഈ ഫോണിൽ ചേർത്തു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते या फोनवर जोडले"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு இந்த ஃபோனில் சேர்க்கப்பட்டது"
          }
        }
      }
    },
    "onboarding_back_lead": {
      "comment": "Explanation after restoring an account.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অ্যাকাউন্ট এই ফোনে ফিরে এসেছে। আপনার পরিচিতি, চ্যাট আর কলের ইতিহাস আপনার অন্য ডিভাইসগুলোতে থাকে, কোনো সার্ভারে নয়। এই ফোনে পরিচিতির তালিকা খালি থেকে শুরু হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto ist wieder auf diesem Handy. Deine Kontakte, Chats und Anrufliste liegen auf deinen anderen Geräten, nicht auf einem Server. Dieses Handy startet mit einer leeren Kontaktliste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is back on this phone. Your contacts, chats and call history are kept on your other devices, not on a server. This phone starts with an empty contact list."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilisi on taas tällä puhelimella. Yhteystietosi, keskustelusi ja puheluhistoriasi säilyvät muilla laitteillasi, eivät palvelimella. Tämä puhelin aloittaa tyhjällä yhteystietolistalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte est de retour sur ce téléphone. Vos contacts, discussions et historique d’appels sont gardés sur vos autres appareils, pas sur un serveur. Ce téléphone démarre avec une liste de contacts vide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता इस फ़ोन पर वापस आ गया है। आपके संपर्क, चैट और कॉल हिस्ट्री आपके दूसरे डिवाइस पर रहते हैं, किसी सर्वर पर नहीं। यह फ़ोन खाली संपर्क सूची से शुरू होगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് ഈ ഫോണിൽ തിരിച്ചെത്തി. നിങ്ങളുടെ കോൺടാക്റ്റുകളും ചാറ്റുകളും കോൾ ചരിത്രവും സൂക്ഷിച്ചിരിക്കുന്നത് ഒരു സെർവറിലല്ല, നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിലാണ്. ഈ ഫോൺ ഒഴിഞ്ഞ കോൺടാക്റ്റ് ലിസ്റ്റോടെയാണ് തുടങ്ങുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचे खाते या फोनवर परत आले आहे. तुमचे संपर्क, चॅट आणि कॉल इतिहास सर्व्हरवर नाही, तर तुमच्या इतर डिव्हाइसवर ठेवलेले असतात. हा फोन रिकाम्या संपर्क यादीने सुरू होतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கணக்கு இந்த ஃபோனுக்குத் திரும்பிவிட்டது. உங்கள் தொடர்புகள், அரட்டைகள், அழைப்பு வரலாறு ஆகியவை சர்வரில் அல்ல, உங்கள் மற்ற சாதனங்களில் வைக்கப்பட்டுள்ளன. இந்த ஃபோன் காலியான தொடர்புப் பட்டியலுடன் தொடங்கும்."
          }
        }
      }
    },
    "onboarding_back_title": {
      "comment": "Title after restoring an account.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আবার স্বাগতম"
