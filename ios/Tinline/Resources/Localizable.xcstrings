            "value": "Piilota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masquer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "छिपाएँ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "മറയ്ക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लपवा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மறை"
          }
        }
      }
    },
    "security_hint_hides": {
      "comment": "Hint on the recovery backup page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 সেকেন্ড পরে লুকিয়ে যায়। অ্যাপ থেকে বেরোলে লক হয়ে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschwindet nach 30 Sekunden. Sperrt sich, wenn du die App verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides after 30 seconds. Locks when you leave the app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piiloutuu 30 sekunnin kuluttua. Lukittuu, kun poistut sovelluksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se masque après 30 secondes. Se verrouille quand vous quittez l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 सेकंड बाद छिप जाता है। ऐप से बाहर जाने पर लॉक हो जाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 സെക്കൻഡിനു ശേഷം മറയും. ആപ്പിൽ നിന്ന് പുറത്തുപോകുമ്പോൾ ലോക്ക് ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 सेकंदांनी लपते. तुम्ही ॲपमधून बाहेर गेल्यावर लॉक होते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 வினாடிகளில் மறையும். ஆப்பை விட்டு வெளியேறும்போது பூட்டப்படும்."
          }
        }
      }
    },
    "security_hint_same": {
      "comment": "Hint on the recovery backup page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রিকভারি কী বা শব্দ, দুটো দিয়েই একই অ্যাকাউন্ট ফিরিয়ে আনা যায়। যেকোনোটা গোপন, নিরাপদ জায়গায় রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlüssel und Wörter stellen dasselbe Konto wieder her. Bewahre eins davon an einem privaten, sicheren Ort auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key or words restore the same account. Keep either in a private, safe place."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avain ja sanat palauttavat saman tilin. Säilytä kumpi tahansa yksityisessä, turvallisessa paikassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé ou les mots restaurent le même compte. Gardez-les dans un endroit privé et sûr."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुंजी हो या शब्द, दोनों से वही खाता वापस आता है। इनमें से किसी को भी निजी, सुरक्षित जगह रखें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കീയും വാക്കുകളും ഒരേ അക്കൗണ്ട് തന്നെയാണ് പുനഃസ്ഥാപിക്കുന്നത്. ഏതെങ്കിലും ഒന്ന് സ്വകാര്യവും സുരക്ഷിതവുമായ ഒരിടത്ത് സൂക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "की किंवा शब्द, दोन्हीने तेच खाते परत मिळते. यापैकी कोणतेही खाजगी, सुरक्षित ठिकाणी ठेवा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "விசையோ வார்த்தைகளோ அதே கணக்கை மீட்டெடுக்கும். ஏதாவது ஒன்றைத் தனிப்பட்ட, பாதுகாப்பான இடத்தில் வையுங்கள்."
          }
        }
      }
    },
    "security_keep_private": {
      "comment": "Warning on the recovery backup page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটা গোপন রাখুন। এটা যার কাছে থাকবে, সে আপনার হয়ে সব করতে পারবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte das privat. Wer es hat, kann als du auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this private. Anyone with it can act as you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pidä tämä omana tietonasi. Kuka tahansa, jolla se on, voi toimia sinuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gardez-la privée. Toute personne qui l’a peut agir en votre nom."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे निजी रखें। जिसके पास यह है, वह आपके नाम से काम कर सकता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് സ്വകാര്യമായി സൂക്ഷിക്കുക. ഇത് കൈവശമുള്ള ആർക്കും നിങ്ങളുടെ പേരിൽ പ്രവർത്തിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हे खाजगी ठेवा. हे ज्याच्याकडे असेल ती व्यक्ती तुम्ही म्हणून वावरू शकते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இதைத் தனிப்பட்டதாக வையுங்கள். இது உள்ள எவரும் நீங்களாகச் செயல்பட முடியும்."
          }
        }
      }
    },
    "security_key_failed": {
      "comment": "Hint when the recovery key could not be made.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রিকভারি কী তৈরি করা গেল না। তার বদলে আপনার %1$@টি শব্দ ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Schlüssel ließ sich nicht vorbereiten. Nutze stattdessen deine %1$@ Wörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t prepare the key. Use your %1$@ words instead."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avainta ei voitu valmistella. Käytä sen sijaan %1$@ sanaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de préparer la clé. Utilisez plutôt vos %1$@ mots."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुंजी तैयार नहीं हो पाई। इसके बजाय अपने %1$@ शब्द इस्तेमाल करें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "കീ തയ്യാറാക്കാൻ കഴിഞ്ഞില്ല. പകരം നിങ്ങളുടെ %1$@ വാക്കുകൾ ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "की तयार करता आली नाही. त्याऐवजी तुमचे %1$@ शब्द वापरा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "விசையைத் தயார் செய்ய முடியவில்லை. பதிலாக உங்கள் %1$@ வார்த்தைகளைப் பயன்படுத்துங்கள்."
          }
        }
      }
    },
    "security_need_lock": {
      "comment": "Error when the phone has no screen lock and no app passphrase is set.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ব্যাকআপ খুলতে একটি স্ক্রিন লক বা অ্যাপের পাসফ্রেজ যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richte eine Displaysperre oder eine App-Passphrase ein, um dein Backup zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a screen lock or an app passphrase to open your backup."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisää näytön lukitus tai sovelluksen salalause avataksesi varmuuskopiosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez un verrouillage d’écran ou une phrase secrète d’app pour ouvrir votre sauvegarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपना बैकअप खोलने के लिए स्क्रीन लॉक या ऐप पासफ़्रेज़ जोड़ें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ബാക്കപ്പ് തുറക്കാൻ ഒരു സ്ക്രീൻ ലോക്കോ ആപ്പ് പാസ്‌ഫ്രേസോ ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा बॅकअप उघडण्यासाठी स्क्रीन लॉक किंवा ॲप पासफ्रेज जोडा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் காப்புப்பிரதியைத் திறக்க, திரைப் பூட்டையோ ஆப் கடவுச்சொற்றொடரையோ சேருங்கள்."
          }
        }
      }
    },
