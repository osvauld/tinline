          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह फ़ोटो %1$@ × %2$@ पिक्सेल की है। Tinline हर तरफ़ %3$@ पिक्सेल तक लेता है।"
          }
        }
      }
    },
    "people_pic_unreadable": {
      "comment": "Picture refused: it could not be decoded.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Datei ließ sich nicht als Bild lesen. Vielleicht ist sie beschädigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file couldn’t be read as a picture. It may be damaged."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiedostoa ei voitu lukea kuvana. Se voi olla vioittunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier n’a pas pu être lu comme une image. Il est peut-être endommagé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह फ़ाइल फ़ोटो के रूप में पढ़ी नहीं जा सकी। हो सकता है वह खराब हो।"
          }
        }
      }
    },
    "people_picture_help": {
      "comment": "Explains what removing or replacing the profile picture can and cannot do.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du dein Bild ersetzt oder entfernst, wird beim nächsten Abgleich darum gebeten, die vorher zwischengespeicherte Kopie auf deinen verknüpften Geräten und bei deinen Kontakten zu löschen. Screenshots, Backups und Kopien, die veränderte Apps behalten, kann die App nicht löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacing or removing your picture requests deletion of the previous cached copy on your linked devices and contacts when they sync. Screenshots, backups, and copies retained by modified clients cannot be erased by the app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvan vaihtaminen tai poistaminen pyytää linkitettyjä laitteitasi ja yhteystietojasi poistamaan aiemman välimuistikopion, kun ne synkronoituvat. Sovellus ei voi poistaa kuvakaappauksia, varmuuskopioita eikä muokattujen sovellusten säilyttämiä kopioita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remplacer ou retirer votre photo demande la suppression de l’ancienne copie en cache sur vos appareils associés et chez vos contacts lors de leur synchronisation. Les captures d’écran, les sauvegardes et les copies conservées par des clients modifiés ne peuvent pas être effacées par l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोटो बदलने या हटाने पर, आपके लिंक किए गए डिवाइस और संपर्कों से सिंक होते समय पिछली सहेजी कॉपी मिटाने का अनुरोध जाता है। स्क्रीनशॉट, बैकअप और बदले हुए ऐप में रखी गई कॉपी यह ऐप नहीं मिटा सकता।"
          }
        }
      }
    },
