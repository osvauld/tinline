    "call_group_battery_limited": {
      "comment": "Note on the group call screen when this phone is the call host and its battery is low. {percent} is the battery level below which hosting is limited.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ব্যাটারি %1$@ %%-এর নিচে। হোস্টিং সীমিত: একবারে শুধু একজনের কথা শোনা যাবে, আর নতুন কেউ যোগ দিতে পারবেন না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akku unter %1$@ %%. Das Hosten ist eingeschränkt: Es ist immer nur eine Person zu hören, und niemand Neues kann beitreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery under %1$@ %%. Hosting is limited: only one person is heard at a time, and no one new can join."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun varaus on alle %1$@ %%. Isännöintiä on rajoitettu: vain yksi henkilö kuuluu kerrallaan, eikä kukaan uusi voi liittyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Batterie sous %1$@ %%. L’hébergement est limité : une seule personne est entendue à la fois, et aucun nouveau participant ne peut rejoindre l’appel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बैटरी %1$@ %% से कम। होस्टिंग सीमित है: एक समय में एक ही व्यक्ति सुनाई देगा, और कोई नया नहीं जुड़ सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ബാറ്ററി %1$@ %%-ൽ താഴെ. ഹോസ്റ്റിംഗ് പരിമിതമാണ്: ഒരു സമയം ഒരാളെ മാത്രമേ കേൾക്കൂ, പുതിയ ആർക്കും ചേരാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बॅटरी %1$@ %% पेक्षा कमी. होस्टिंग मर्यादित आहे: एका वेळी एकाच व्यक्तीचा आवाज ऐकू येतो, आणि कोणीही नवीन सामील होऊ शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பேட்டரி %1$@ %%-க்குக் கீழ் உள்ளது. ஹோஸ்டிங் வரம்புக்குட்பட்டது: ஒரே நேரத்தில் ஒருவர் மட்டுமே கேட்கப்படுவார், புதிதாக யாரும் சேர முடியாது."
          }
        }
      }
    },
