    "people_profile_other_note": {
      "comment": "Note when the profile has information this app does not know.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কিছু তথ্য অন্য ডিভাইস বা অ্যাপের অন্য সংস্করণ থেকে এসেছে। এগুলো যেমন সেভ করা আছে তেমনই দেখানো হয়, আর আপনি অন্য কিছু এডিট করলেও থেকে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einige Angaben kommen von einem anderen Gerät oder einer anderen App-Version. Sie werden so gezeigt, wie sie gespeichert sind, und bleiben erhalten, wenn du etwas anderes bearbeitest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some information came from another device or app version. It’s shown as stored and kept when you edit anything else."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osa tiedoista tuli toiselta laitteelta tai sovellusversiolta. Ne näytetään sellaisinaan ja säilyvät, kun muokkaat muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certaines informations viennent d’un autre appareil ou d’une autre version de l’app. Elles sont affichées telles qu’enregistrées et conservées quand vous modifiez autre chose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुछ जानकारी किसी दूसरे डिवाइस या ऐप संस्करण से आई है। यह जैसी सहेजी गई है वैसी दिखती है, और कुछ और बदलने पर भी बनी रहती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ചില വിവരങ്ങൾ മറ്റൊരു ഉപകരണത്തിൽ നിന്നോ ആപ്പ് പതിപ്പിൽ നിന്നോ വന്നതാണ്. അവ സൂക്ഷിച്ചിരിക്കുന്നതുപോലെ കാണിക്കും, നിങ്ങൾ മറ്റെന്തെങ്കിലും എഡിറ്റ് ചെയ്യുമ്പോഴും അവ നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "काही माहिती दुसऱ्या डिव्हाइसवरून किंवा ॲपच्या दुसऱ्या आवृत्तीतून आली आहे. ती साठवल्याप्रमाणे दाखवली जाते, आणि तुम्ही दुसरे काही संपादित केल्यावरही तशीच ठेवली जाते."
          }
        },
        "ta": {
