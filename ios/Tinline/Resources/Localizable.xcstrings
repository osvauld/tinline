    "restore_lead_words": {
      "comment": "Intro on the restore screen before a key is pasted.  {words} is the number of recovery words (24).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tipp deine %1$@ Wörter der Reihe nach ein, oder füge sie oder deinen Wiederherstellungsschlüssel ins erste Feld ein. Sie bleiben auf diesem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your %1$@ words in order, or paste them, or your recovery key, into the first box. They stay on this phone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirjoita %1$@ sanaasi järjestyksessä tai liitä ne tai palautusavaimesi ensimmäiseen kenttään. Ne pysyvät tällä puhelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez vos %1$@ mots dans l’ordre, ou collez-les, ou votre clé de récupération, dans la première case. Ils restent sur ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने %1$@ शब्द क्रम से टाइप करें, या पहले बॉक्स में शब्द या अपनी रिकवरी कुंजी पेस्ट करें। ये इसी फ़ोन पर रहते हैं।"
          }
        }
      }
    },
