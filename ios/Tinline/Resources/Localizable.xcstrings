    "group_removal_checked": {
      "comment": "Note on the removal page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রতিটি ফ্ল্যাগ গ্রুপের একজন অ্যাডমিনের দেওয়া, আর এটা দেখানোর আগে এই ডিভাইস সেগুলো যাচাই করেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Markierung kam von einem Admin der Gruppe, und dieses Gerät hat sie geprüft, bevor es dies anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each flag was made by an admin of the group, and this device checked them before showing this."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokaisen merkinnän teki ryhmän ylläpitäjä, ja tämä laite tarkisti ne ennen tämän näyttämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque signalement vient d’un admin du groupe, et cet appareil les a vérifiés avant de les afficher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर फ़्लैग ग्रुप के किसी एडमिन ने लगाया था, और यह दिखाने से पहले इस डिवाइस ने उनकी जाँच की है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഓരോ ഫ്ലാഗും ഗ്രൂപ്പിലെ ഒരു അഡ്മിൻ ചെയ്തതാണ്, ഇത് കാണിക്കുന്നതിന് മുമ്പ് ഈ ഉപകരണം അവ പരിശോധിച്ചു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रत्येक फ्लॅग ग्रुपच्या ॲडमिनने केला आहे, आणि हे दाखवण्यापूर्वी या डिव्हाइसने ते तपासले आहेत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒவ்வொரு கொடியும் குழுவின் ஒரு நிர்வாகியால் இடப்பட்டது; இதைக் காட்டும் முன் இந்தச் சாதனம் அவற்றைச் சரிபார்த்தது."
          }
        }
      }
    },
