    "shell_empty_add_someone": {
      "comment": "Home hero line when the user has no contacts.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাঁর সঙ্গে কথা বলতে চান তাঁকে যোগ করুন, তাহলে আপনারা একে অপরকে মেসেজ আর কল করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge jemanden hinzu, mit dem du reden möchtest, dann könnt ihr euch schreiben und anrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add someone you’d like to talk to, and you can message and call each other."
