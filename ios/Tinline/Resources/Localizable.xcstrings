        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accepté. Cette personne fait maintenant partie de vos contacts pour les messages uniquement et apparaît dans Discussions dès que son appareil se connecte ; les appels restent désactivés jusqu’à ce que vous les autorisiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकार किया। वे सिर्फ़ संदेशों के लिए जोड़े गए हैं और उनका डिवाइस जुड़ते ही चैट में दिखेंगे; जब तक आप अनुमति न दें, कॉल बंद रहेंगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "സ്വീകരിച്ചു. അവർ സന്ദേശങ്ങൾക്ക് മാത്രമായി ചേർക്കപ്പെട്ടു, അവരുടെ ഉപകരണം കണക്റ്റ് ചെയ്യുമ്പോൾ ചാറ്റുകളിൽ കാണാം; നിങ്ങൾ അനുവദിക്കുന്നതുവരെ കോളുകൾ ഓഫായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वीकारले. त्यांना फक्त संदेशांसाठी जोडले आहे, आणि त्यांचे डिव्हाइस कनेक्ट झाल्यावर ते चॅटमध्ये दिसतील; तुम्ही परवानगी देईपर्यंत कॉल बंद राहतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஏற்றுக்கொள்ளப்பட்டது. அவர் செய்திகளுக்கு மட்டும் சேர்க்கப்பட்டார், அவரது சாதனம் இணைந்ததும் அரட்டைகளில் தெரிவார்; நீங்கள் அனுமதிக்கும் வரை அழைப்புகள் முடக்கத்தில் இருக்கும்."
          }
        }
      }
    },
    "group_done_request_blocked": {
      "comment": "Toast after blocking a requester. {name} is the requester's first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-কে ব্লক করা হয়েছে, উনি আর অনুরোধ পাঠাতে পারবেন না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ist blockiert und kann keine weiteren Anfragen senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is blocked and can’t send more requests."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ on estetty eikä voi lähettää enempää pyyntöjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez bloqué %1$@, qui ne peut plus envoyer de demandes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ब्लॉक हैं और अब और अनुरोध नहीं भेज सकते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ എന്നയാളെ ബ്ലോക്ക് ചെയ്തു, ഇനി അഭ്യർത്ഥനകൾ അയയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला ब्लॉक केले आहे, आता ते आणखी विनंत्या पाठवू शकत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ தடுக்கப்பட்டார், இனி கோரிக்கைகளை அனுப்ப முடியாது."
          }
        }
      }
    },
    "group_done_request_blocked_unnamed": {
      "comment": "Toast after blocking a requester whose name is not known.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
