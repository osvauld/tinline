    "settings_calls_note": {
      "comment": "Note under the contacts list on Who can call me.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাঁকে অনুমতি দিয়েছেন তিনি আপনাকে কল করতে পারেন; যিনি শুধু মেসেজে আছেন তিনি তবুও লিখতে পারেন। আপনি যাঁদের ব্লক করেছেন, তাঁরা কোনোটাই পারেন না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wen du erlaubt hast, kann dich anrufen; wer nur Nachrichten darf, kann dir weiter schreiben. Leute, die du blockiert hast, können beides nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone you allowed can ring you; someone on messages only can still write. People you blocked can do neither."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sallimasi henkilöt voivat soittaa sinulle; ne, joilla on vain viestit, voivat silti kirjoittaa. Estämäsi henkilöt eivät voi kumpaakaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une personne autorisée peut vous appeler ; une personne en messages uniquement peut toujours écrire. Les personnes bloquées ne peuvent faire ni l’un ni l’autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जिन्हें आपने अनुमति दी है वे कॉल कर सकते हैं; जो सिर्फ़ संदेश पर हैं वे लिख सकते हैं। जिन्हें आपने ब्लॉक किया है, वे दोनों में से कुछ नहीं कर सकते।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ അനുവദിച്ചവർക്ക് നിങ്ങളെ വിളിക്കാം; സന്ദേശങ്ങൾ മാത്രം അനുവദിച്ചവർക്ക് എഴുതാം. നിങ്ങൾ ബ്ലോക്ക് ചെയ്തവർക്ക് ഇവ രണ്ടും കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही परवानगी दिलेले लोक तुम्हाला कॉल करू शकतात; \"फक्त संदेश\" असलेले लोक तरीही संदेश लिहू शकतात. तुम्ही ब्लॉक केलेले लोक यापैकी काहीच करू शकत नाहीत."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் அனுமதித்தவர் உங்களை அழைக்கலாம்; செய்திகள் மட்டும் உள்ளவர் எழுதலாம். நீங்கள் தடுத்தவர்களால் இரண்டும் முடியாது."
          }
        }
      }
    },
