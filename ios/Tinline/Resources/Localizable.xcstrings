    "group_invite_text": {
      "comment": "Body of the invite sheet.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রত্যেকে একটি ব্যক্তিগত আমন্ত্রণ পাবেন, যা 7 দিন কাজ করবে। আপনি যাঁদের আমন্ত্রণ জানান, তাঁরা যোগ দিলেই গ্রুপের পোস্ট পড়তে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Person bekommt eine private Einladung, die 7 Tage gilt. Wen du einlädst, kann nach dem Beitritt die Beiträge der Gruppe lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person gets a private invite that works for 7 days. Anyone you invite can read the group’s posts once they join."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokainen saa yksityisen kutsun, joka on voimassa 7 päivää. Kuka tahansa kutsumasi voi lukea ryhmän viestit liityttyään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque personne reçoit une invitation privée valable 7 jours. Toute personne invitée peut lire les publications du groupe une fois qu’elle l’a rejoint."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर व्यक्ति को एक निजी आमंत्रण मिलता है जो 7 दिन तक काम करता है। जिन्हें आप आमंत्रित करते हैं, वे जुड़ने के बाद ग्रुप की पोस्ट पढ़ सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഓരോരുത്തർക്കും 7 ദിവസം സാധുതയുള്ള ഒരു സ്വകാര്യ ക്ഷണം ലഭിക്കും. നിങ്ങൾ ക്ഷണിക്കുന്ന ആർക്കും ചേർന്നുകഴിഞ്ഞാൽ ഗ്രൂപ്പിന്റെ പോസ്റ്റുകൾ വായിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रत्येकाला 7 दिवस चालणारे खाजगी आमंत्रण मिळते. तुम्ही आमंत्रित केलेले कोणीही सामील झाल्यावर ग्रुपच्या पोस्ट वाचू शकतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒவ்வொருவருக்கும் 7 நாட்கள் செல்லும் தனிப்பட்ட அழைப்பிதழ் கிடைக்கும். நீங்கள் அழைக்கும் எவரும் சேர்ந்ததும் குழுவின் இடுகைகளைப் படிக்க முடியும்."
          }
        }
      }
    },
