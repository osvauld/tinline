    "group_flag_button": {
      "comment": "Button that flags a member. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flag %1$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitse %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signaler %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ को फ़्लैग करें"
          }
        }
      }
    },
    "group_flag_copy": {
      "comment": "Flag dialog sentence for a flag that does not remove yet. {yours} is which flag it is, {total} flags remove, {name} the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das wird Markierung %1$@ von %2$@. Markierungen aller Admins zählen, auch weitere von dir. Bei %2$@ Markierungen wird %3$@ sofort entfernt und sieht das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours will be flag %1$@ of %2$@. Any admin’s flags count, yours again too. At %2$@ flags %3$@ is removed right away and sees they were removed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinun merkintäsi on %1$@/%2$@. Kaikkien ylläpitäjien merkinnät lasketaan, myös sinun uudet merkintäsi. Kun merkintöjä on %2$@, %3$@ poistetaan heti, ja hän näkee tulleensa poistetuksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce sera le signalement %1$@ sur %2$@. Les signalements de tous les admins comptent, y compris un nouveau de votre part. À %2$@ signalements, le retrait de %3$@ est immédiat et cette personne voit qu’elle a été retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका फ़्लैग %2$@ में से %1$@ होगा। किसी भी एडमिन के फ़्लैग गिने जाते हैं, आपके दोबारा लगाए फ़्लैग भी। %2$@ फ़्लैग होते ही %3$@ को तुरंत हटा दिया जाएगा और उन्हें दिखेगा कि उन्हें हटा दिया गया।"
          }
        }
      }
    },
    "group_flag_copy_final": {
      "comment": "Flag dialog sentence for the flag that removes the member. {yours} is which flag it is, {total} flags remove, {name} the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das wird Markierung %1$@ von %2$@. %3$@ wird sofort entfernt: Hosts nehmen keine neuen Nachrichten mehr an, und die Person sieht, dass sie entfernt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours will be flag %1$@ of %2$@. %3$@ is removed right away: hosts refuse their new messages and they see they were removed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinun merkintäsi on %1$@/%2$@. %3$@ poistetaan heti: isäntälaitteet hylkäävät hänen uudet viestinsä, ja hän näkee tulleensa poistetuksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce sera le signalement %1$@ sur %2$@. Le retrait de %3$@ est immédiat : les hôtes refusent ses nouveaux messages et cette personne voit qu’elle a été retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका फ़्लैग %2$@ में से %1$@ होगा। %3$@ को तुरंत हटा दिया जाएगा: होस्ट उनके नए संदेश स्वीकार नहीं करेंगे और उन्हें दिखेगा कि उन्हें हटा दिया गया।"
          }
        }
      }
    },
    "group_flag_meter_desc": {
      "comment": "Spoken label of the flag meter. {next} is which flag this would be, {total} flags that remove.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markierung %1$@ von %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flag %1$@ of %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkintä %1$@/%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signalement %1$@ sur %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ में से फ़्लैग %1$@"
          }
        }
      }
    },
    "group_flag_text1": {
      "comment": "First paragraph of the flag confirmation.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markierungen lassen sich nicht zurücknehmen, und die Entfernung ist endgültig. Derselbe Admin kann mehrmals markieren; jede Markierung zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flags can’t be taken back, and removal is final. The same admin can flag more than once; each flag counts."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkintöjä ei voi perua, ja poisto on lopullinen. Sama ylläpitäjä voi merkitä useammin kuin kerran; jokainen merkintä lasketaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un signalement ne peut pas être annulé, et le retrait est définitif. Un même admin peut signaler plusieurs fois ; chaque signalement compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़्लैग वापस नहीं लिए जा सकते, और ग्रुप से हटाना स्थायी है। एक ही एडमिन एक से ज़्यादा बार फ़्लैग कर सकते हैं; हर फ़्लैग गिना जाता है।"
          }
        }
      }
    },
    "group_flag_text2": {
      "comment": "Second paragraph of the flag confirmation. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markieren ist eine Entscheidung der Gruppe. Es ist getrennt vom Blockieren, das nur dich betrifft. %1$@ sieht jede Markierung: wer sie gesetzt hat und wann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagging is a decision for the group. It is separate from blocking, which only affects you. %1$@ sees each flag: who made it and when."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitseminen on ryhmän päätös. Se on eri asia kuin estäminen, joka koskee vain sinua. %1$@ näkee jokaisen merkinnän: kuka sen teki ja milloin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le signalement est une décision collective. Il est distinct du blocage, qui ne concerne que vous. %1$@ voit chaque signalement : qui l’a fait et quand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़्लैग करना ग्रुप का फ़ैसला है। यह ब्लॉक करने से अलग है, जिसका असर सिर्फ़ आप पर होता है। %1$@ हर फ़्लैग देख सकते हैं: किसने लगाया और कब।"
          }
        }
      }
    },
