    "call_hd_label_paused": {
      "comment": "Accessibility label of the HD chip when HD is paused.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আরও ঝকঝকে ভিডিও চালু, কানেকশন দুর্বল থাকায় থেমে আছে"
