    "group_removed_card_text": {
      "comment": "Notice card text. {names} is who flagged the user.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markiert von %1$@. Was du vorher bekommen hast, kannst du weiter lesen; Neues kommt nicht mehr an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagged by %1$@. You can still read what you received before; nothing new will arrive."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitsijät: %1$@. Voit yhä lukea aiemmin saamasi viestit, mutta uusia ei enää tule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signalé par %1$@. Vous pouvez toujours lire ce que vous avez reçu avant ; rien de nouveau n’arrivera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने फ़्लैग किया। पहले मिले संदेश आप अब भी पढ़ सकते हैं; अब कुछ नया नहीं आएगा।"
          }
        }
      }
    },
    "group_removed_card_title": {
      "comment": "Notice card in the chat after removal. {count} is the number of flags.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
