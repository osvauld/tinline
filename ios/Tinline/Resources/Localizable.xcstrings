    "chat_viewer_pdf_damaged": {
      "comment": "Shown in the file viewer when a PDF cannot be read.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline এই PDF পড়তে পারছে না। হয়তো এটা নষ্ট হয়ে গেছে। তবুও আপনি এটা সেভ করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline kann dieses PDF nicht lesen. Vielleicht ist es beschädigt. Speichern kannst du es trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline can’t read this PDF. It may be damaged. You can still save it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ei voi lukea tätä PDF-tiedostoa. Se voi olla vioittunut. Voit silti tallentaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline ne peut pas lire ce PDF. Il est peut-être endommagé. Vous pouvez quand même l’enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline यह PDF नहीं पढ़ सकता। हो सकता है यह खराब हो। आप इसे फिर भी सहेज सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-ന് ഈ PDF വായിക്കാൻ കഴിയുന്നില്ല. ഇത് കേടായിരിക്കാം. എങ്കിലും ഇത് സേവ് ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline हा PDF वाचू शकत नाही. तो खराब झालेला असू शकतो. तरीही तुम्ही तो जतन करू शकता."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-ஆல் இந்த PDF-ஐப் படிக்க முடியவில்லை. அது சேதமடைந்திருக்கலாம். இருந்தாலும் அதைச் சேமிக்கலாம்."
          }
        }
      }
    },
    "chat_viewer_pdf_locked": {
      "comment": "Shown in the file viewer when a PDF needs a password.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই PDF পাসওয়ার্ড দিয়ে সুরক্ষিত, তাই Tinline এটা দেখাতে পারছে না। অন্য অ্যাপে খুলতে এটা সেভ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses PDF ist passwortgeschützt, deshalb kann Tinline es nicht zeigen. Speichere es, um es in einer anderen App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF is password-protected, so Tinline can’t show it. Save it to open it in another app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä PDF on suojattu salasanalla, joten Tinline ei voi näyttää sitä. Tallenna se avataksesi sen toisella sovelluksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce PDF est protégé par un mot de passe, Tinline ne peut donc pas l’afficher. Enregistrez-le pour l’ouvrir dans une autre app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह PDF पासवर्ड से सुरक्षित है, इसलिए Tinline इसे नहीं दिखा सकता। किसी दूसरे ऐप में खोलने के लिए इसे सहेजें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ PDF പാസ്‌വേഡ് ഉപയോഗിച്ച് സംരക്ഷിച്ചതാണ്, അതിനാൽ Tinline-ന് ഇത് കാണിക്കാൻ കഴിയില്ല. മറ്റൊരു ആപ്പിൽ തുറക്കാൻ ഇത് സേവ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हा PDF पासवर्डने सुरक्षित आहे, त्यामुळे Tinline तो दाखवू शकत नाही. दुसऱ्या ॲपमध्ये उघडण्यासाठी तो जतन करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த PDF கடவுச்சொல்லால் பாதுகாக்கப்பட்டுள்ளதால் Tinline-ஆல் அதைக் காட்ட முடியாது. வேறு ஆப்பில் திறக்க அதைச் சேமியுங்கள்."
          }
        }
      }
    },
    "chat_viewer_photo_hint": {
      "comment": "Hint at the bottom of the photo viewer. The quoted words match the \"Save to phone\" label.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-এর ভেতরে এনক্রিপ্টেড অবস্থায় রাখা আছে। “ফোনে সেভ করুন” এটাকে আপনার ছবির লাইব্রেরিতে কপি করে, যেখানে অন্য অ্যাপও এটা দেখতে পায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bleibt verschlüsselt in Tinline. „Aufs Handy speichern“ kopiert es in deine Fotos, wo andere Apps es sehen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept encrypted inside Tinline. “Save to phone” copies it to your photos, where other apps can see it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Säilytetään salattuna Tinlinessa. ”Tallenna puhelimeen” kopioi sen kuviisi, joissa muut sovellukset näkevät sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conservé chiffré dans Tinline. « Enregistrer sur le téléphone » le copie dans vos photos, où d’autres apps peuvent le voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline के अंदर एन्क्रिप्टेड रखा गया है। “फ़ोन में सहेजें” इसे आपकी फ़ोटो में कॉपी करता है, जहाँ दूसरे ऐप इसे देख सकते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-നുള്ളിൽ എൻക്രിപ്റ്റ് ചെയ്ത നിലയിൽ സൂക്ഷിക്കുന്നു. “ഫോണിൽ സേവ് ചെയ്യുക” ഇത് നിങ്ങളുടെ ഫോട്ടോകളിലേക്ക് പകർത്തും, അവിടെ മറ്റ് ആപ്പുകൾക്ക് ഇത് കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline मध्ये एन्क्रिप्टेड ठेवले आहे. “फोनवर जतन करा” ते तुमच्या फोटोंमध्ये कॉपी करते, जिथे इतर ॲप ते पाहू शकतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-க்குள் என்க்ரிப்ட் செய்யப்பட்டு வைக்கப்பட்டுள்ளது. “ஃபோனில் சேமி” இதை உங்கள் படங்களுக்கு நகலெடுக்கும், அங்கே மற்ற ஆப்கள் பார்க்க முடியும்."
          }
        }
      }
    },
    "chat_viewer_too_big": {
      "comment": "Shown in the file viewer when a text file is too large.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফাইলটি এখানে দেখানোর পক্ষে খুব বড়। অন্য অ্যাপে খুলতে এটা সেভ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Datei ist zu groß, um sie hier zu zeigen. Speichere sie, um sie in einer anderen App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is too big to show here. Save it to open it in another app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiedosto on liian suuri näytettäväksi täällä. Tallenna se avataksesi sen toisella sovelluksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier est trop volumineux pour être affiché ici. Enregistrez-le pour l’ouvrir dans une autre app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह फ़ाइल यहाँ दिखाने के लिए बहुत बड़ी है। किसी दूसरे ऐप में खोलने के लिए इसे सहेजें।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഫയൽ ഇവിടെ കാണിക്കാൻ വളരെ വലുതാണ്. മറ്റൊരു ആപ്പിൽ തുറക്കാൻ ഇത് സേവ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ही फाइल इथे दाखवण्यासाठी खूप मोठी आहे. दुसऱ्या ॲपमध्ये उघडण्यासाठी ती जतन करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்தக் கோப்பு இங்கே காட்ட முடியாத அளவுக்குப் பெரியது. வேறு ஆப்பில் திறக்க அதைச் சேமியுங்கள்."
          }
        }
      }
    },
    "chat_voice_discard": {
      "comment": "Accessibility label of the trash button while a voice message is being recorded hands-free.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রেকর্ডিং বাদ দিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aufnahme verwerfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard recording"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hylkää tallenne"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer l’enregistrement"
          }
        },
        "hi": {
          "stringUnit": {
