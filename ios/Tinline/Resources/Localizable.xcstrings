    "link_unlinked_lead": {
      "comment": "Explanation after this phone was unlinked by another device; {name} is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eines deiner anderen Geräte hat %1$@ von diesem Handy entfernt. Kontakte, Chats und Anrufe des Kontos wurden hier gelöscht. Deine anderen Geräte sind nicht betroffen."
          }
