    "group_hosts_none": {
      "comment": "Status line when the group has no host.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই গ্রুপের কোনো হোস্ট নেই। হোস্ট নিযুক্ত না হওয়া পর্যন্ত পোস্টগুলো অপেক্ষা করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Gruppe hat keinen Host. Beiträge warten, bis ein Host festgelegt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group has no host. Posts wait until a host is appointed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tällä ryhmällä ei ole isäntälaitetta. Viestit odottavat, kunnes sellainen nimetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce groupe n’a pas d’hôte. Les publications attendent qu’un hôte soit désigné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस ग्रुप का कोई होस्ट नहीं है। होस्ट नियुक्त होने तक पोस्ट रुकी रहेंगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഈ ഗ്രൂപ്പിന് ഹോസ്റ്റ് ഇല്ല. ഒരു ഹോസ്റ്റിനെ നിയമിക്കുന്നതുവരെ പോസ്റ്റുകൾ കാത്തിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "या ग्रुपला होस्ट नाही. होस्ट नेमला जाईपर्यंत पोस्ट थांबून राहतात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்தக் குழுவுக்கு ஹோஸ்ட் இல்லை. ஒரு ஹோஸ்ட் நியமிக்கப்படும் வரை இடுகைகள் காத்திருக்கும்."
          }
        }
      }
    },
    "group_hosts_note_admin": {
      "comment": "Explanation under the host list, for admins (replaces the plain one).",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অন্যরা অফলাইনে থাকলে হোস্টরা গ্রুপটি রাখে আর পোস্ট পৌঁছে দেয়। তাঁরা আপনার ভরসার সদস্য: একজন হোস্ট এই গ্রুপে পোস্ট করা সবকিছু পড়তে পারেন। কোনো সদস্যের মেনু থেকে হোস্ট নিযুক্ত করুন; তাঁকে গ্রহণ করতে হবে। কোনো হোস্টকে সরালে 2 দিনের মধ্যে গ্রুপের ঠিকানা বদলে যায়, তাই সেই ডিভাইস আর গ্রুপে পৌঁছাতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hosts speichern die Gruppe und geben Beiträge weiter, wenn andere offline sind. Es sind Mitglieder, denen du vertraust: Ein Host kann alles lesen, was in dieser Gruppe gepostet wird. Lege einen Host über das Menü eines Mitglieds fest; die Person muss zustimmen. Wenn du einen Host entfernst, ändert sich die Adresse der Gruppe innerhalb von 2 Tagen, sodass dieses Gerät sie nicht mehr erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts store the group and pass posts on when others are offline. They are members you trust: a host can read everything posted in this group. Appoint a host from a member’s menu; they have to accept. Removing a host changes the group’s address within 2 days, so that device can no longer reach it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isäntälaitteet tallentavat ryhmän ja välittävät viestit eteenpäin, kun muut eivät ole verkossa. Ne ovat jäseniä, joihin luotat: isäntälaite voi lukea kaiken tähän ryhmään kirjoitetun. Nimeä isäntälaite jäsenen valikosta; hänen täytyy hyväksyä. Isäntälaitteen poistaminen vaihtaa ryhmän osoitteen 2 päivän kuluessa, joten se laite ei enää tavoita ryhmää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les hôtes conservent le groupe et transmettent les publications quand les autres sont hors ligne. Ce sont des membres de confiance : un hôte peut lire tout ce qui est publié dans ce groupe. Désignez un hôte depuis le menu d’un membre ; il doit accepter. Retirer un hôte change l’adresse du groupe sous 2 jours, pour que cet appareil ne puisse plus le joindre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "होस्ट ग्रुप को सहेजते हैं और दूसरों के ऑफ़लाइन होने पर पोस्ट आगे पहुँचाते हैं। ये वे सदस्य हैं जिन पर आप भरोसा करते हैं: होस्ट इस ग्रुप में पोस्ट की गई हर चीज़ पढ़ सकता है। किसी सदस्य के मेनू से होस्ट नियुक्त करें; उन्हें स्वीकार करना होगा। होस्ट हटाने पर 2 दिन के अंदर ग्रुप का पता बदल जाता है, ताकि वह डिवाइस फिर उस तक न पहुँच सके।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഹോസ്റ്റുകൾ ഗ്രൂപ്പ് സൂക്ഷിക്കുകയും മറ്റുള്ളവർ ഓഫ്‌ലൈനായിരിക്കുമ്പോൾ പോസ്റ്റുകൾ കൈമാറുകയും ചെയ്യുന്നു. അവർ നിങ്ങൾ വിശ്വസിക്കുന്ന അംഗങ്ങളാണ്: ഈ ഗ്രൂപ്പിൽ പോസ്റ്റ് ചെയ്യുന്നതെല്ലാം ഒരു ഹോസ്റ്റിന് വായിക്കാം. ഒരു അംഗത്തിന്റെ മെനുവിൽ നിന്ന് ഹോസ്റ്റിനെ നിയമിക്കാം; അവർ അത് സ്വീകരിക്കണം. ഒരു ഹോസ്റ്റിനെ നീക്കം ചെയ്താൽ 2 ദിവസത്തിനുള്ളിൽ ഗ്രൂപ്പിന്റെ വിലാസം മാറും, അതോടെ ആ ഉപകരണത്തിന് ഗ്രൂപ്പിലേക്ക് എത്താൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "होस्ट ग्रुप साठवतात आणि इतर ऑफलाइन असताना पोस्ट पुढे पाठवतात. ते तुमच्या विश्वासातले सदस्य असतात: होस्ट या ग्रुपमध्ये पोस्ट केलेले सर्व काही वाचू शकतो. सदस्याच्या मेनूमधून होस्ट नेमा; त्यांना ते स्वीकारावे लागेल. होस्ट काढल्यावर 2 दिवसांत ग्रुपचा पत्ता बदलतो, त्यामुळे ते डिव्हाइस ग्रुपपर्यंत पोहोचू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மற்றவர்கள் ஆஃப்லைனில் இருக்கும்போது, ஹோஸ்ட்கள் குழுவைச் சேமித்து இடுகைகளைக் கடத்தும். அவர்கள் நீங்கள் நம்பும் உறுப்பினர்கள்: இந்தக் குழுவில் இடப்படும் அனைத்தையும் ஒரு ஹோஸ்ட் படிக்க முடியும். உறுப்பினரின் மெனுவிலிருந்து ஒரு ஹோஸ்ட்டை நியமியுங்கள்; அவர் ஏற்க வேண்டும். ஒரு ஹோஸ்ட்டை அகற்றினால், 2 நாட்களுக்குள் குழுவின் முகவரி மாறும், அதனால் அந்தச் சாதனம் இனி குழுவை அடைய முடியாது."
          }
        }
      }
    },
    "group_hosts_note_base": {
      "comment": "Explanation under the host list.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অন্যরা অফলাইনে থাকলে হোস্টরা গ্রুপটি রাখে আর পোস্ট পৌঁছে দেয়। তাঁরা আপনার ভরসার সদস্য: একজন হোস্ট এই গ্রুপে পোস্ট করা সবকিছু পড়তে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hosts speichern die Gruppe und geben Beiträge weiter, wenn andere offline sind. Es sind Mitglieder, denen du vertraust: Ein Host kann alles lesen, was in dieser Gruppe gepostet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts store the group and pass posts on when others are offline. They are members you trust: a host can read everything posted in this group."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isäntälaitteet tallentavat ryhmän ja välittävät viestit eteenpäin, kun muut eivät ole verkossa. Ne ovat jäseniä, joihin luotat: isäntälaite voi lukea kaiken tähän ryhmään kirjoitetun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les hôtes conservent le groupe et transmettent les publications quand les autres sont hors ligne. Ce sont des membres de confiance : un hôte peut lire tout ce qui est publié dans ce groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "होस्ट ग्रुप को सहेजते हैं और दूसरों के ऑफ़लाइन होने पर पोस्ट आगे पहुँचाते हैं। ये वे सदस्य हैं जिन पर आप भरोसा करते हैं: होस्ट इस ग्रुप में पोस्ट की गई हर चीज़ पढ़ सकता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഹോസ്റ്റുകൾ ഗ്രൂപ്പ് സൂക്ഷിക്കുകയും മറ്റുള്ളവർ ഓഫ്‌ലൈനായിരിക്കുമ്പോൾ പോസ്റ്റുകൾ കൈമാറുകയും ചെയ്യുന്നു. അവർ നിങ്ങൾ വിശ്വസിക്കുന്ന അംഗങ്ങളാണ്: ഈ ഗ്രൂപ്പിൽ പോസ്റ്റ് ചെയ്യുന്നതെല്ലാം ഒരു ഹോസ്റ്റിന് വായിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "होस्ट ग्रुप साठवतात आणि इतर ऑफलाइन असताना पोस्ट पुढे पाठवतात. ते तुमच्या विश्वासातले सदस्य असतात: होस्ट या ग्रुपमध्ये पोस्ट केलेले सर्व काही वाचू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மற்றவர்கள் ஆஃப்லைனில் இருக்கும்போது, ஹோஸ்ட்கள் குழுவைச் சேமித்து இடுகைகளைக் கடத்தும். அவர்கள் நீங்கள் நம்பும் உறுப்பினர்கள்: இந்தக் குழுவில் இடப்படும் அனைத்தையும் ஒரு ஹோஸ்ட் படிக்க முடியும்."
          }
        }
      }
    },
    "group_hosts_offline": {
      "comment": "Status line when no host is online.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোনো হোস্ট অনলাইনে নেই। আপনার পোস্ট সেভ করা আছে, হোস্ট এলেই পাঠানো হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Host ist online. Deine Beiträge sind gespeichert und gehen raus, sobald einer da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No host is online. Your posts are saved and send when one is."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksikään isäntälaite ei ole verkossa. Viestisi ovat tallessa ja lähtevät, kun jokin tulee verkkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun hôte n’est en ligne. Vos publications sont gardées et partiront dès qu’il y en aura un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई होस्ट ऑनलाइन नहीं है। आपकी पोस्ट सहेजी गई हैं और होस्ट के आते ही भेज दी जाएँगी।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഹോസ്റ്റുകളൊന്നും ഓൺലൈനിലില്ല. നിങ്ങളുടെ പോസ്റ്റുകൾ സേവ് ചെയ്തിട്ടുണ്ട്, ഒരു ഹോസ്റ്റ് ഓൺലൈനിൽ വരുമ്പോൾ അവ അയയ്ക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोणताही होस्ट ऑनलाइन नाही. तुमच्या पोस्ट जतन केल्या आहेत आणि होस्ट ऑनलाइन आल्यावर पाठवल्या जातील."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "எந்த ஹோஸ்ட்டும் ஆன்லைனில் இல்லை. உங்கள் இடுகைகள் சேமிக்கப்பட்டுள்ளன, ஒன்று வந்ததும் அனுப்பப்படும்."
          }
        }
      }
    },
