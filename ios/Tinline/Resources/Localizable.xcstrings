    "call_route_relayed_hint": {
      "comment": "Hint in the audio route sheet when the call goes through a relay.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রিলে হয়ে: এই নেটওয়ার্কে সরাসরি লাইন সম্ভব হয়নি, তাই একটি এনক্রিপ্টেড রিলে কলটি পৌঁছে দিচ্ছে। রিলে আপনার কথা শুনতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weitergeleitet: In diesem Netz war keine direkte Leitung möglich, also gibt ein verschlüsseltes Relay den Anruf weiter. Es kann dich nicht hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayed: a direct line wasn’t possible on this network, so an encrypted relay is passing the call along. It can’t hear you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välitetty: suora linja ei ollut mahdollinen tässä verkossa, joten salattu välityspalvelin välittää puhelun. Se ei voi kuulla sinua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relayé : une ligne directe n’était pas possible sur ce réseau, un relais chiffré transmet donc l’appel. Il ne peut pas vous entendre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिले से: इस नेटवर्क पर सीधी लाइन मुमकिन नहीं थी, इसलिए एक एन्क्रिप्टेड रिले कॉल को आगे पहुँचा रहा है। वह आपको सुन नहीं सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "റിലേ വഴി: ഈ നെറ്റ്‌വർക്കിൽ നേരിട്ടുള്ള ലൈൻ സാധ്യമായില്ല, അതിനാൽ എൻക്രിപ്റ്റ് ചെയ്ത ഒരു റിലേ കോൾ കൈമാറുന്നു. അതിന് നിങ്ങളെ കേൾക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिलेमार्फत: या नेटवर्कवर थेट लाइन शक्य नव्हती, त्यामुळे एन्क्रिप्टेड रिले कॉल पुढे पोहोचवत आहे. तो तुमचे बोलणे ऐकू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ரிலே வழியாக: இந்த நெட்வொர்க்கில் நேரடி லைன் சாத்தியமில்லை, எனவே என்க்ரிப்ட் செய்யப்பட்ட ரிலே அழைப்பைக் கடத்துகிறது. அதனால் உங்கள் குரலைக் கேட்க முடியாது."
          }
        }
      }
    },
