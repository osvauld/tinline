    "group_member_make_callhost_sub": {
      "comment": "Sub line. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-কে গ্রুপ কল চালাতে বলে। তাঁকে গ্রহণ করতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bittet %1$@, Gruppenanrufe zu tragen. Die Person muss zustimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks %1$@ to carry group calls. They have to accept."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyytää henkilöä %1$@ välittämään ryhmäpuhelut. Hänen täytyy hyväksyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demande à %1$@ d’héberger les appels de groupe. Il faut son accord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ से ग्रुप कॉल चलाने के लिए कहता है। उन्हें स्वीकार करना होगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഗ്രൂപ്പ് കോളുകൾ നടത്താൻ %1$@ എന്നയാളോട് ആവശ്യപ്പെടുന്നു. അവർ സ്വീകരിക്കണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला ग्रुप कॉल चालवण्यास सांगते. त्यांना ते स्वीकारावे लागेल."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குழு அழைப்புகளை நடத்தும்படி %1$@ அவர்களிடம் கேட்கும். அவர் ஏற்க வேண்டும்."
          }
        }
      }
    },
