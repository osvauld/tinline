          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lien ou code d’invitation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आमंत्रण लिंक या कोड"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ക്ഷണ ലിങ്ക് അല്ലെങ്കിൽ കോഡ്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आमंत्रण लिंक किंवा कोड"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அழைப்பிதழ் இணைப்பு அல்லது குறியீடு"
          }
        }
      }
    },
    "group_join_hint": {
      "comment": "Hint on the join page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যোগ দিলে এই ফোন গ্রুপের হোস্টদের সঙ্গে কানেক্ট হবে। সদস্যরা আপনার নাম দেখবেন; এই ফোনে কীভাবে পৌঁছাতে হয় তা শুধু হোস্টরা জানবে। এতে এক মিনিট পর্যন্ত লাগতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Beitreten verbindet sich dieses Handy mit den Hosts der Gruppe. Mitglieder sehen deinen Namen; nur Hosts erfahren, wie sie dieses Handy erreichen. Das kann bis zu einer Minute dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining connects this phone to the group’s hosts. Members see your name; only hosts learn how to reach this phone. It can take up to a minute."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liittyminen yhdistää tämän puhelimen ryhmän isäntälaitteisiin. Jäsenet näkevät nimesi; vain isäntälaitteet saavat tietää, miten tämän puhelimen tavoittaa. Tämä voi kestää minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejoindre connecte ce téléphone aux hôtes du groupe. Les membres voient votre nom ; seuls les hôtes savent comment joindre ce téléphone. Cela peut prendre jusqu’à une minute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जुड़ने पर यह फ़ोन ग्रुप के होस्ट से जुड़ता है। सदस्यों को आपका नाम दिखता है; इस फ़ोन तक पहुँचने का तरीका सिर्फ़ होस्ट जानते हैं। इसमें एक मिनट तक लग सकता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ചേരുമ്പോൾ ഈ ഫോൺ ഗ്രൂപ്പിന്റെ ഹോസ്റ്റുകളുമായി കണക്റ്റ് ചെയ്യും. അംഗങ്ങൾക്ക് നിങ്ങളുടെ പേര് കാണാം; ഈ ഫോണിലേക്ക് എങ്ങനെ എത്താമെന്ന് ഹോസ്റ്റുകൾക്ക് മാത്രമേ അറിയൂ. ഇതിന് ഒരു മിനിറ്റ് വരെ എടുത്തേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सामील झाल्यावर हा फोन ग्रुपच्या होस्टशी जोडला जातो. सदस्यांना तुमचे नाव दिसते; या फोनपर्यंत कसे पोहोचायचे हे फक्त होस्टना कळते. याला एक मिनिटापर्यंत वेळ लागू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சேர்ந்தால், இந்த ஃபோன் குழுவின் ஹோஸ்ட்களுடன் இணையும். உறுப்பினர்கள் உங்கள் பெயரைப் பார்ப்பார்கள்; இந்த ஃபோனை எப்படி அடைவது என்பது ஹோஸ்ட்களுக்கு மட்டுமே தெரியும். இதற்கு ஒரு நிமிடம் வரை ஆகலாம்."
          }
        }
      }
    },
