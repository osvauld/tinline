    "people_profile_availability_note": {
      "comment": "Note under the availability section.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার পরিচিতিরা এটা দেখতে পান, আর আপনার সব ডিভাইসে এটা একই থাকে। কল আপনার কাছে পৌঁছাবে কি না, তা এর ওপর নির্ভর করে; আপনি অনলাইনে আছেন কি না, তার থেকে এটা আলাদা।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kontakte sehen das, und es ist auf all deinen Geräten gleich. Es bestimmt, ob Anrufe dich erreichen, und ist getrennt davon, ob du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts can see this, and it’s the same on all your devices. It affects whether calls reach you, and it’s separate from whether you’re online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteystietosi näkevät tämän, ja se on sama kaikilla laitteillasi. Se vaikuttaa siihen, tulevatko puhelut perille, eikä se riipu siitä, oletko verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos contacts peuvent voir ceci, et c’est pareil sur tous vos appareils. Cela détermine si les appels vous parviennent, indépendamment du fait d’être en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह आपके संपर्कों को दिखता है और आपके सभी डिवाइस पर एक जैसा रहता है। इससे तय होता है कि कॉल आप तक पहुँचें या नहीं, और यह आपके ऑनलाइन होने से अलग है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ കോൺടാക്റ്റുകൾക്ക് ഇത് കാണാം, നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഇത് ഒന്നുതന്നെയാണ്. കോളുകൾ നിങ്ങളിലേക്ക് എത്തുമോ എന്നതിനെ ഇത് ബാധിക്കും, നിങ്ങൾ ഓൺലൈനിലാണോ എന്നതിൽ നിന്ന് ഇത് വ്യത്യസ്തമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या संपर्कांना हे दिसते, आणि तुमच्या सर्व डिव्हाइसवर ते सारखेच असते. कॉल तुमच्यापर्यंत पोहोचतात की नाही यावर याचा परिणाम होतो, आणि तुम्ही ऑनलाइन आहात की नाही यापेक्षा हे वेगळे आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இதை உங்கள் தொடர்புகள் பார்க்க முடியும், உங்கள் எல்லாச் சாதனங்களிலும் இது ஒன்றே. அழைப்புகள் உங்களை அடைகின்றனவா என்பதை இது தீர்மானிக்கும்; நீங்கள் ஆன்லைனில் இருக்கிறீர்களா என்பதிலிருந்து இது தனி."
          }
        }
      }
    },
