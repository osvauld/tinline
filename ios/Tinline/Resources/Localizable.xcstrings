    "settings_about_note": {
      "comment": "Note on the About page.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-এ কোনো বিজ্ঞাপন বা ট্র্যাকিং নেই। আপনার মেসেজ আর কল যায় আপনার ডিভাইস আর আপনি যাঁদের সঙ্গে কথা বলেন, তাঁদের মধ্যে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline hat keine Werbung und kein Tracking. Deine Nachrichten und Anrufe gehen zwischen deinen Geräten und den Leuten, mit denen du sprichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline has no ads and no tracking. Your messages and calls go between your devices and the people you talk to."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinlinessa ei ole mainoksia eikä seurantaa. Viestisi ja puhelusi kulkevat laitteidesi ja niiden ihmisten välillä, joiden kanssa puhut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline n’a ni publicité ni pistage. Vos messages et appels circulent entre vos appareils et les personnes avec qui vous parlez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline में न विज्ञापन हैं, न ट्रैकिंग। आपके संदेश और कॉल आपके डिवाइस और उन लोगों के बीच जाते हैं जिनसे आप बात करते हैं।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-ൽ പരസ്യങ്ങളോ ട്രാക്കിംഗോ ഇല്ല. നിങ്ങളുടെ സന്ദേശങ്ങളും കോളുകളും നിങ്ങളുടെ ഉപകരണങ്ങൾക്കും നിങ്ങൾ സംസാരിക്കുന്നവർക്കും ഇടയിലാണ് പോകുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline मध्ये जाहिराती आणि ट्रॅकिंग नाही. तुमचे संदेश आणि कॉल तुमची डिव्हाइस आणि तुम्ही ज्यांच्याशी बोलता ते लोक यांच्यातच जातात."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-இல் விளம்பரங்களும் இல்லை, கண்காணிப்பும் இல்லை. உங்கள் செய்திகளும் அழைப்புகளும் உங்கள் சாதனங்களுக்கும் நீங்கள் பேசுபவர்களுக்கும் இடையே மட்டுமே செல்கின்றன."
          }
        }
      }
    },
