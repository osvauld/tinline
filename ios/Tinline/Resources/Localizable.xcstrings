        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने उनके संदेश कब पढ़े, यह लोगों को दिखता है"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ അവരുടെ സന്ദേശങ്ങൾ വായിച്ചോ എന്ന് ആളുകൾക്ക് കാണാം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही त्यांचे संदेश वाचल्यावर लोकांना कळते"
          }
        },
        "ta": {
