    },
    "group_left_footer": {
      "comment": "Footer of a group chat after the user left.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast diese Gruppe verlassen. Die Nachrichten bleiben hier, nur zum Lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left this group. Its messages stay here, read-only."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poistuit tästä ryhmästä. Sen viestit jäävät tänne luettaviksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez quitté ce groupe. Ses messages restent ici, en lecture seule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने यह ग्रुप छोड़ दिया है। इसके संदेश यहाँ रहेंगे, सिर्फ़ पढ़ने के लिए।"
          }
        }
      }
    },
    "group_link_hint": {
      "comment": "Hint above the group invite link QR. {group} is the group's name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle mit diesem Link oder QR-Code können %1$@ 7 Tage lang beitreten. Teile ihn über eine App, der du vertraust; du siehst, wer beigetreten ist, und kannst Leute per Markierung entfernen. Um deine Kontakte direkt einzuladen, nutze „Mitglieder hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this link or QR can join %1$@ for 7 days. Share it over an app you trust; you see who joined and can flag them out. To invite your contacts directly, use Add members."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuka tahansa, jolla on tämä linkki tai QR-koodi, voi liittyä ryhmään %1$@ 7 päivän ajan. Jaa se sovelluksella, johon luotat; näet, kuka liittyi, ja voit merkitä hänet poistettavaksi. Jos haluat kutsua yhteystietojasi suoraan, käytä kohtaa Lisää jäseniä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne qui a ce lien ou ce QR code peut rejoindre %1$@ pendant 7 jours. Partagez-le via une app de confiance ; vous voyez qui a rejoint et pouvez les signaler pour retrait. Pour inviter directement vos contacts, utilisez Ajouter des membres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस लिंक या QR वाला कोई भी 7 दिन तक %1$@ से जुड़ सकता है। इसे किसी भरोसेमंद ऐप से शेयर करें; कौन जुड़ा यह आपको दिखेगा और आप उन्हें फ़्लैग करके हटा सकते हैं। अपने संपर्कों को सीधे आमंत्रित करने के लिए “सदस्य जोड़ें” का इस्तेमाल करें।"
          }
        }
      }
    },
    "group_link_hint_unnamed": {
      "comment": "Hint above the group invite link QR when the group's name is not known.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle mit diesem Link oder QR-Code können dieser Gruppe 7 Tage lang beitreten. Teile ihn über eine App, der du vertraust; du siehst, wer beigetreten ist, und kannst Leute per Markierung entfernen. Um deine Kontakte direkt einzuladen, nutze „Mitglieder hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this link or QR can join this group for 7 days. Share it over an app you trust; you see who joined and can flag them out. To invite your contacts directly, use Add members."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuka tahansa, jolla on tämä linkki tai QR-koodi, voi liittyä tähän ryhmään 7 päivän ajan. Jaa se sovelluksella, johon luotat; näet, kuka liittyi, ja voit merkitä hänet poistettavaksi. Jos haluat kutsua yhteystietojasi suoraan, käytä kohtaa Lisää jäseniä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne qui a ce lien ou ce QR code peut rejoindre ce groupe pendant 7 jours. Partagez-le via une app de confiance ; vous voyez qui a rejoint et pouvez les signaler pour retrait. Pour inviter directement vos contacts, utilisez Ajouter des membres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस लिंक या QR वाला कोई भी 7 दिन तक इस ग्रुप से जुड़ सकता है। इसे किसी भरोसेमंद ऐप से शेयर करें; कौन जुड़ा यह आपको दिखेगा और आप उन्हें फ़्लैग करके हटा सकते हैं। अपने संपर्कों को सीधे आमंत्रित करने के लिए “सदस्य जोड़ें” का इस्तेमाल करें।"
          }
