    "devices_unlink_body": {
      "comment": "Body of the unlink dialog.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এতে সিঙ্ক বন্ধ হয়ে যাবে, আর আপনার কলে আর রিং হবে না। এটা অনলাইনে থাকলে নিজের থেকে আপনার অ্যাকাউন্ট সরিয়ে দেবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es hört auf abzugleichen und klingelt nicht mehr bei deinen Anrufen. Wenn es online ist, entfernt es dein Konto von sich selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stops syncing and stops ringing for your calls. If it’s online, it removes your account from itself."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se lopettaa synkronoinnin eikä enää soi puheluillesi. Jos se on verkossa, se poistaa tilisi itseltään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il cesse de se synchroniser et de sonner pour vos appels. S’il est en ligne, il retire lui-même votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह सिंक होना और आपकी कॉल पर घंटी बजना बंद कर देगा। अगर यह ऑनलाइन है, तो यह आपका खाता अपने यहाँ से हटा देगा।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "അത് സിങ്ക് ചെയ്യുന്നതും നിങ്ങളുടെ കോളുകൾക്ക് റിംഗ് ചെയ്യുന്നതും നിർത്തും. അത് ഓൺലൈനിലാണെങ്കിൽ, നിങ്ങളുടെ അക്കൗണ്ട് സ്വയം നീക്കം ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते सिंक होणे आणि तुमच्या कॉलसाठी रिंग होणे थांबवते. ते ऑनलाइन असेल, तर ते स्वतःवरून तुमचे खाते काढून टाकते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அது ஒத்திசைப்பதையும் உங்கள் அழைப்புகளுக்கு ஒலிப்பதையும் நிறுத்தும். அது ஆன்லைனில் இருந்தால், உங்கள் கணக்கைத் தன்னிடமிருந்து அகற்றும்."
          }
        }
      }
    },
