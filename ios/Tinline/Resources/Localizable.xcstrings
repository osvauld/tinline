    },
    "group_ask_text1": {
      "comment": "First paragraph of the private-chat request. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ আপনার নাম আর গ্রুপটি দেখতে পাবেন। অনুরোধটি সিল করা অবস্থায় গ্রুপের হোস্টের মাধ্যমে যায়, তাই হোস্ট এটা পড়তে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ sieht deinen Namen und die Gruppe. Die Anfrage geht versiegelt über den Host der Gruppe, sodass der Host sie nicht lesen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sees your name and the group. The request goes through the group’s host, sealed, so the host can’t read it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ näkee nimesi ja ryhmän. Pyyntö kulkee ryhmän isäntälaitteen kautta sinetöitynä, joten isäntälaite ei voi lukea sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ voit votre nom et le groupe. La demande passe par l’hôte du groupe, scellée, donc l’hôte ne peut pas la lire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ को आपका नाम और ग्रुप दिखेगा। अनुरोध ग्रुप के होस्ट से होकर बंद लिफ़ाफ़े की तरह जाता है, इसलिए होस्ट उसे पढ़ नहीं सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ നിങ്ങളുടെ പേരും ഗ്രൂപ്പും കാണും. അഭ്യർത്ഥന ഗ്രൂപ്പിന്റെ ഹോസ്റ്റ് വഴി സീൽ ചെയ്ത് അയയ്ക്കുന്നു, അതിനാൽ ഹോസ്റ്റിന് അത് വായിക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ला तुमचे नाव आणि ग्रुप दिसतात. विनंती ग्रुपच्या होस्टमार्फत सीलबंद स्वरूपात जाते, त्यामुळे होस्ट ती वाचू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் பெயரையும் குழுவையும் %1$@ பார்ப்பார். கோரிக்கை குழுவின் ஹோஸ்ட் வழியாக முத்திரையிடப்பட்டுச் செல்லும், எனவே ஹோஸ்ட் அதைப் படிக்க முடியாது."
          }
        }
      }
    },
    "group_ask_text2": {
      "comment": "Second paragraph. {name} is the member’s first name.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ গ্রহণ করলে আপনারা সরাসরি একে অপরকে মেসেজ করতে পারবেন। আপনাদের কেউ একজন অনুমতি না দেওয়া পর্যন্ত কল বন্ধ থাকবে। অনুরোধের মেয়াদ 7 দিন পরে শেষ হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn %1$@ annimmt, könnt ihr euch direkt schreiben. Anrufe bleiben aus, bis einer von euch sie erlaubt. Eine Anfrage läuft nach 7 Tagen ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If %1$@ accepts, you can message each other directly. Calls stay off until one of you allows them. A request expires after 7 days."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jos %1$@ hyväksyy, voitte lähettää viestejä suoraan toisillenne. Puhelut pysyvät pois päältä, kunnes jompikumpi teistä sallii ne. Pyyntö vanhenee 7 päivän kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si %1$@ accepte, vous pourrez vous écrire directement. Les appels restent désactivés jusqu’à ce que l’un de vous les autorise. Une demande expire au bout de 7 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर %1$@ स्वीकार करते हैं, तो आप एक-दूसरे को सीधे संदेश भेज सकेंगे। कॉल तब तक बंद रहेंगी जब तक आप में से कोई उन्हें अनुमति न दे। अनुरोध 7 दिन बाद खत्म हो जाता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ സ്വീകരിച്ചാൽ നിങ്ങൾക്ക് പരസ്പരം നേരിട്ട് സന്ദേശം അയയ്ക്കാം. നിങ്ങളിലൊരാൾ അനുവദിക്കുന്നതുവരെ കോളുകൾ ഓഫായിരിക്കും. ഒരു അഭ്യർത്ഥനയുടെ കാലാവധി 7 ദിവസമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ने स्वीकारल्यास तुम्ही एकमेकांना थेट संदेश पाठवू शकता. तुमच्यापैकी कोणीतरी परवानगी देईपर्यंत कॉल बंद राहतात. विनंतीची मुदत 7 दिवसांनी संपते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ஏற்றுக்கொண்டால், நீங்கள் இருவரும் நேரடியாகச் செய்தி அனுப்பலாம். உங்களில் ஒருவர் அனுமதிக்கும் வரை அழைப்புகள் முடக்கத்தில் இருக்கும். கோரிக்கை 7 நாட்களுக்குப் பிறகு காலாவதியாகும்."
          }
        }
      }
    },
