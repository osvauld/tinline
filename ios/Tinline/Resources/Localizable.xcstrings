    "people_pic_bad_type": {
      "comment": "Picture refused: not PNG, JPEG or WebP.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline PNG, JPEG বা WebP ছবি ব্যবহার করতে পারে। এই ফাইলটি অন্য ধরনের।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline kann PNG-, JPEG- oder WebP-Bilder verwenden. Diese Datei hat ein anderes Format."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinline can use PNG, JPEG or WebP pictures. That file is a different kind of file."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline voi käyttää PNG-, JPEG- tai WebP-kuvia. Tämä tiedosto on eri tyyppiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline accepte les images PNG, JPEG ou WebP. Ce fichier est d’un autre type."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline में PNG, JPEG या WebP फ़ोटो चलती हैं। वह फ़ाइल किसी और तरह की है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline-ന് PNG, JPEG, WebP ഫോട്ടോകൾ ഉപയോഗിക്കാം. ആ ഫയൽ മറ്റൊരു തരത്തിലുള്ളതാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline PNG, JPEG किंवा WebP फोटो वापरू शकते. ती फाइल वेगळ्या प्रकारची आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tinline PNG, JPEG அல்லது WebP படங்களைப் பயன்படுத்தலாம். அந்தக் கோப்பு வேறு வகையைச் சேர்ந்தது."
          }
        }
      }
    },
    "people_pic_too_big": {
      "comment": "Picture refused: too big. {size} is the file size in MB, {max} the limit in MB.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ছবিটি %1$@ MB। ছবি %2$@ MB পর্যন্ত হতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Bild hat %1$@ MB. Bilder dürfen bis zu %2$@ MB groß sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That picture is %1$@ MB. Pictures can be up to %2$@ MB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvan koko on %1$@ Mt. Kuva voi olla enintään %2$@ Mt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette image fait %1$@ Mo. Les images peuvent faire jusqu’à %2$@ Mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह फ़ोटो %1$@ MB की है। फ़ोटो %2$@ MB तक की हो सकती है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ ഫോട്ടോയുടെ വലുപ്പം %1$@ MB ആണ്. ഫോട്ടോകൾക്ക് പരമാവധി %2$@ MB വരെയാകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तो फोटो %1$@ MB आहे. फोटो जास्तीत जास्त %2$@ MB असू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்தப் படம் %1$@ MB. படங்கள் %2$@ MB வரை இருக்கலாம்."
          }
        }
      }
    },
    "people_pic_too_large_px": {
      "comment": "Picture refused: too many pixels. {w} and {h} are its width and height, {max} the limit per side.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ছবিটি %1$@ × %2$@ পিক্সেল। Tinline প্রতিটি দিকে %3$@ পিক্সেল পর্যন্ত নেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Bild hat %1$@ × %2$@ Pixel. Tinline nimmt bis zu %3$@ Pixel pro Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That picture is %1$@ × %2$@ pixels. Tinline accepts up to %3$@ pixels on a side."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvan koko on %1$@ × %2$@ pikseliä. Tinline hyväksyy enintään %3$@ pikseliä sivua kohden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette image fait %1$@ × %2$@ pixels. Tinline accepte jusqu’à %3$@ pixels de côté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह फ़ोटो %1$@ × %2$@ पिक्सेल की है। Tinline हर तरफ़ %3$@ पिक्सेल तक लेता है।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ ഫോട്ടോയുടെ വലുപ്പം %1$@ × %2$@ പിക്സൽ ആണ്. ഓരോ വശത്തും പരമാവധി %3$@ പിക്സൽ വരെ Tinline സ്വീകരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तो फोटो %1$@ × %2$@ पिक्सेल आहे. Tinline एका बाजूला जास्तीत जास्त %3$@ पिक्सेल स्वीकारते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்தப் படம் %1$@ × %2$@ பிக்சல்கள். ஒரு பக்கத்துக்கு %3$@ பிக்சல்கள் வரை Tinline ஏற்கும்."
          }
        }
      }
    },
    "people_pic_unreadable": {
      "comment": "Picture refused: it could not be decoded.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফাইলটি ছবি হিসেবে পড়া গেল না। হয়তো এটি নষ্ট হয়ে গেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Datei ließ sich nicht als Bild lesen. Vielleicht ist sie beschädigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file couldn’t be read as a picture. It may be damaged."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiedostoa ei voitu lukea kuvana. Se voi olla vioittunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier n’a pas pu être lu comme une image. Il est peut-être endommagé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह फ़ाइल फ़ोटो के रूप में पढ़ी नहीं जा सकी। हो सकता है वह खराब हो।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ ഫയൽ ഒരു ഫോട്ടോയായി വായിക്കാൻ കഴിഞ്ഞില്ല. അത് കേടായിരിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ती फाइल फोटो म्हणून वाचता आली नाही. ती खराब झालेली असू शकते."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்தக் கோப்பைப் படமாகப் படிக்க முடியவில்லை. அது சேதமடைந்திருக்கலாம்."
          }
        }
      }
    },
    "people_picture_help": {
      "comment": "Explains what removing or replacing the profile picture can and cannot do.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ছবি বদলালে বা সরালে, আপনার লিঙ্ক করা ডিভাইস আর পরিচিতিরা সিঙ্ক করার সময় আগের ক্যাশ করা কপি মুছে ফেলার অনুরোধ যায়। স্ক্রিনশট, ব্যাকআপ, আর পরিবর্তিত ক্লায়েন্টে রেখে দেওয়া কপি অ্যাপ মুছতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du dein Bild ersetzt oder entfernst, wird beim nächsten Abgleich darum gebeten, die vorher zwischengespeicherte Kopie auf deinen verknüpften Geräten und bei deinen Kontakten zu löschen. Screenshots, Backups und Kopien, die veränderte Apps behalten, kann die App nicht löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacing or removing your picture requests deletion of the previous cached copy on your linked devices and contacts when they sync. Screenshots, backups, and copies retained by modified clients cannot be erased by the app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvan vaihtaminen tai poistaminen pyytää linkitettyjä laitteitasi ja yhteystietojasi poistamaan aiemman välimuistikopion, kun ne synkronoituvat. Sovellus ei voi poistaa kuvakaappauksia, varmuuskopioita eikä muokattujen sovellusten säilyttämiä kopioita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remplacer ou retirer votre photo demande la suppression de l’ancienne copie en cache sur vos appareils associés et chez vos contacts lors de leur synchronisation. Les captures d’écran, les sauvegardes et les copies conservées par des clients modifiés ne peuvent pas être effacées par l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोटो बदलने या हटाने पर, आपके लिंक किए गए डिवाइस और संपर्कों से सिंक होते समय पिछली सहेजी कॉपी मिटाने का अनुरोध जाता है। स्क्रीनशॉट, बैकअप और बदले हुए ऐप में रखी गई कॉपी यह ऐप नहीं मिटा सकता।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ ഫോട്ടോ മാറ്റുകയോ നീക്കം ചെയ്യുകയോ ചെയ്യുമ്പോൾ, ലിങ്ക് ചെയ്ത ഉപകരണങ്ങളും കോൺടാക്റ്റുകളും സിങ്ക് ചെയ്യുന്ന സമയത്ത് അവരുടെ പക്കലുള്ള പഴയ പകർപ്പ് ഇല്ലാതാക്കാൻ അഭ്യർത്ഥിക്കും. സ്ക്രീൻഷോട്ടുകൾ, ബാക്കപ്പുകൾ, മാറ്റം വരുത്തിയ ആപ്പുകൾ സൂക്ഷിക്കുന്ന പകർപ്പുകൾ എന്നിവ ഇല്ലാതാക്കാൻ ആപ്പിന് കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमचा फोटो बदलल्यावर किंवा काढल्यावर, तुमची लिंक केलेली डिव्हाइस आणि संपर्क सिंक होताना त्यांच्याकडील आधीची साठवलेली प्रत हटवण्याची विनंती केली जाते. स्क्रीनशॉट, बॅकअप आणि बदल केलेल्या क्लायंटनी ठेवलेल्या प्रती ॲप पुसू शकत नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் படத்தை மாற்றினாலோ அகற்றினாலோ, உங்கள் இணைக்கப்பட்ட சாதனங்களும் தொடர்புகளும் ஒத்திசைக்கும்போது முந்தைய தற்காலிக நகலை நீக்கும்படி கோரிக்கை அனுப்பப்படும். ஸ்கிரீன்ஷாட்கள், காப்புப்பிரதிகள், மாற்றியமைக்கப்பட்ட ஆப்கள் வைத்திருக்கும் நகல்கள் ஆகியவற்றை இந்த ஆப்பால் அழிக்க முடியாது."
          }
        }
      }
    },
