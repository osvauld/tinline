    "onboarding_exists_body": {
      "comment": "Dialog body when the restored account is already on this phone.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই রিকভারি শব্দগুলো এমন একটি অ্যাকাউন্টের, যা এখানে আগে থেকেই আছে। আবার যোগ না করে সেটিতে বদলে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Wiederherstellungswörter gehören zu einem Konto, das schon hier ist. Wechsle dorthin, statt es nochmal hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That recovery phrase belongs to an account that is already here. Switch to it instead of adding it again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nämä palautussanat kuuluvat tilille, joka on jo täällä. Vaihda siihen sen sijaan, että lisäisit sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces mots de récupération appartiennent à un compte déjà présent ici. Passez plutôt à ce compte au lieu de l’ajouter à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ये रिकवरी शब्द ऐसे खाते के हैं जो पहले से यहाँ है। इसे फिर से जोड़ने के बजाय उस खाते पर जाएँ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ആ വീണ്ടെടുക്കൽ വാക്കുകൾ ഇവിടെ ഇതിനകമുള്ള ഒരു അക്കൗണ്ടിന്റേതാണ്. വീണ്ടും ചേർക്കുന്നതിനു പകരം അതിലേക്ക് മാറുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ते रिकव्हरी शब्द आधीच इथे असलेल्या खात्याचे आहेत. ते पुन्हा जोडण्याऐवजी त्या खात्यावर स्विच करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அந்த மீட்பு வார்த்தைகள் ஏற்கெனவே இங்கே உள்ள ஒரு கணக்குக்கு உரியவை. அதை மீண்டும் சேர்ப்பதற்குப் பதிலாக அதற்கு மாறுங்கள்."
          }
        }
      }
    },
