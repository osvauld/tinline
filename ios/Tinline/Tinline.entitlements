<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- The app's own Keychain group (the unlock key). Without it an unsigned simulator build gets errSecMissingEntitlement. -->
  <key>keychain-access-groups</key>
  <array><string>$(AppIdentifierPrefix)com.osvauld.tinline</string></array>
</dict></plist>
